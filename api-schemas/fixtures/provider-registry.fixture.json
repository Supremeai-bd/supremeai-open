          { "code": "provider_unavailable", "upstream_status": 503, "action": "failover" },
          { "code": "context_overflow", "upstream_status": 400, "upstream_pattern": "context length", "action": "abort" },
          { "code": "content_filter", "upstream_status": 400, "upstream_pattern": "content policy", "action": "abort" }
        ]
      },
      "failover": {
        "priority": 1,
        "fallback_ids": ["anthropic", "gemini", "groq", "openrouter", "mistral", "deepseek"],
        "retry_policy": { "max_retries": 2, "backoff_base_ms": 2000, "backoff_multiplier": 2, "retry_on": ["rate_limited", "timeout"] }
