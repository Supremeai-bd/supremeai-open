      "status": "active",
      "base_url": "https://api.openai.com",
      "auth": { "scheme": "bearer", "env_var": "OPENAI_API_KEY" },
      "capabilities": {
        "streaming": true,
        "tool_calling": true,
        "reasoning_tokens": true,
        "json_mode": true,
        "max_context_tokens": 128000,
        "rate_limits": { "requests_per_minute": 500, "tokens_per_minute": 300000, "concurrent_requests": 10 }
      },
      "errors": {
        "mappings": [
          { "code": "rate_limited", "upstream_status": 429, "upstream_pattern": "rate limit", "action": "backoff_then_retry" },
          { "code": "quota_exhausted", "upstream_status": 429, "upstream_pattern": "quota", "action": "failover" },
          { "code": "auth_failure", "upstream_status": 401, "action": "failover" },
          { "code": "auth_failure", "upstream_status": 403, "action": "failover" },
