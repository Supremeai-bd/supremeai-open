{
  "$schema": "https://json.schemastore.org/mcp",
  "mcpServers": {
    "github-reader": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_READONLY_TOKEN}"
      }
    },
    "supremeai-tower": {
      "url": "https://supremeai-mcp-tower.onrender.com/mcp",
      "headers": {
        "Authorization": "Bearer ${SUPREMEAI_TOWER_TOKEN}"
      }
    }
  }
}
