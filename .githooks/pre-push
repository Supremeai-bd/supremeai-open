#!/bin/sh
# SupremeAI — Zero-Force-Push / Stale-Base / Ingress pre-push guard (issue #161)
#
# Poka-yoke for the security policy codified in docs/INGRESS_SECURITY_POLICY.md.
# Fail-closed local barrier in front of the authoritative server-side
# enforcement (GitHub branch protection + CI guards). It stops accidents, not
# authorities: admins may bypass deliberately with `git push --no-verify`,
# exactly like stepping around any physical guard.
#
# Enforced (only for remotes of the SupremeAI federation core repos):
#   1. No branch deletions of `main`.
#   2. No direct pushes to `main` (landing authority = constitutional gates:
#      Merge Gate on supremeai-open, internal PR gates on supremeai).
#   3. No history rewrites (force pushes / non-fast-forward updates) —
#      commit provenance is immutable.
#   4. No stale branches: if origin/main advanced past the branch's merge-base,
#      the push is rejected until the branch is rebased (Board-Freshness #4177).
#
# Install:   git config core.hooksPath .githooks
# Self-test: sh .githooks/pre-push --self-test   (offline, uses a temp sandbox)

set -u

ZERO_TEST() {
    # all-zero object id (works for SHA-1 and SHA-256 repos)
    test "$(printf '%s' "$1" | tr -d '0')" = ""
}

FEDERATED_REMOTE() {
    # Apply the guard only to SupremeAI federation core repos
    # (Supremeai-bd/supremeai and Supremeai-bd/supremeai-open, any protocol).
    printf '%s' "$1" | tr 'A-Z' 'a-z' | grep -Eq 'supremeai-bd/supremeai(-open)?(\.git)?/?$'
}

reject() {
    echo >&2 ""
    echo >&2 "┌──────────────────────────────────────────────────────────────"
    echo >&2 "│ INGRESS GUARD (docs/INGRESS_SECURITY_POLICY.md, #161): $1"
    echo >&2 "└──────────────────────────────────────────────────────────────"
    shift
    for line in "$@"; do echo >&2 "│ $line"; done
    echo >&2 ""
    exit 1
}

# ---------------------------------------------------------------------------
# Self-test mode: guard-the-guard, offline fixtures (same pattern as
# scripts/ci/boundary_sanitization_guard.py). No network, no repo mutation.
# ---------------------------------------------------------------------------
if test "${1:-}" = "--self-test"; then
    # Resolve the hook's own path to an ABSOLUTE location before the sandbox
    # subshell changes directory (relative $0 would break inside the sandbox
    # and silently turn every scenario into a false pass/fail).
    HOOK_ABS="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    sandbox="$(mktemp -d)" || exit 2
    mkdir "$sandbox/work" "$sandbox/remote.git"
    (
        cd "$sandbox/work" || exit 2
        fails=0   # fail-closed tally: any scenario FAIL must reach the exit code
        git init -q --bare ../remote.git
        git init -q .
        # Pin the branch name to main regardless of git's init.defaultBranch.
        git symbolic-ref HEAD refs/heads/main
        git config user.email guard-selftest@example.invalid
        git config user.name "Ingress Guard Self-Test"
        git remote add origin ../remote.git
        echo a > a.txt && git add a.txt && git commit -qm A
        A=$(git rev-parse HEAD)
        git push -q --no-verify origin main

        HOOK="$HOOK_ABS"
        # Real git passes the remote's configured URL as argv[2] while all git
        # operations (fetch/merge-base) resolve via the remote NAME. Mirror that
        # shape: the sandbox origin is a local path, but the hook invocation
        # presents a federated URL so the applicability gate is exercised.
        FED_URL="https://github.com/Supremeai-bd/supremeai-open.git"

        # S2: fresh, up-to-date feature branch -> ACCEPT
        git checkout -qb feature-fresh
        echo d > d.txt && git add d.txt && git commit -qm D
        D=$(git rev-parse HEAD)
        printf 'refs/heads/feature-fresh %s refs/heads/feature-fresh %s\n' "$D" "$A" \
            | sh "$HOOK" origin "$FED_URL" >/dev/null 2>&1 \
            && echo "PASS fresh-branch-accepted" || { echo "FAIL fresh-branch-accepted"; fails=$((fails + 1)); }

        # S3: stale branch (main advanced past the branch point) -> REJECT
        git checkout -q main
        git checkout -qb feature-stale "$A"
        echo b > b.txt && git add b.txt && git commit -qm B
        B=$(git rev-parse HEAD)
        git checkout -q main
        echo c > c.txt && git add c.txt && git commit -qm C
        git push -q --no-verify origin main
        printf 'refs/heads/feature-stale %s refs/heads/feature-stale %s\n' "$B" "$A" \
            | sh "$HOOK" origin "$FED_URL" >/dev/null 2>&1 \
            && { echo "FAIL stale-branch-rejected"; fails=$((fails + 1)); } || echo "PASS stale-branch-rejected"

        # S4: non-fast-forward update (history rewrite = force) -> REJECT
        git checkout -qb feature-force "$A"
        echo e > e.txt && git add e.txt && git commit -qm E
        git push -q --no-verify origin feature-force
        E_OLD=$(git rev-parse feature-force)
        # Amend REWRITES E (same parent, new object) — E_OLD becomes a sibling,
        # not an ancestor: exactly what a force push would land.
        echo e2 > e.txt && git add e.txt && git commit -q --amend -m E2
        E_NEW=$(git rev-parse HEAD)
        printf 'refs/heads/feature-force %s refs/heads/feature-force %s\n' "$E_NEW" "$E_OLD" \
            | sh "$HOOK" origin "$FED_URL" >/dev/null 2>&1 \
            && { echo "FAIL force-push-rejected"; fails=$((fails + 1)); } || echo "PASS force-push-rejected"

        # S5: direct push to main -> REJECT
        C=$(git rev-parse main)
        printf 'refs/heads/main %s refs/heads/main %s\n' "$C" "$A" \
            | sh "$HOOK" origin "$FED_URL" >/dev/null 2>&1 \
            && { echo "FAIL direct-main-rejected"; fails=$((fails + 1)); } || echo "PASS direct-main-rejected"

        # S6: deletion of main -> REJECT
        printf 'refs/heads/main %s refs/heads/main %s\n' \
            0000000000000000000000000000000000000000 "$C" \
            | sh "$HOOK" origin "$FED_URL" >/dev/null 2>&1 \
            && { echo "FAIL main-deletion-rejected"; fails=$((fails + 1)); } || echo "PASS main-deletion-rejected"

        # S7: unrelated remote -> ACCEPT (guard not applicable)
        printf 'refs/heads/feature-fresh %s refs/heads/feature-fresh %s\n' "$D" "$A" \
            | sh "$HOOK" origin https://example.com/other/repo.git >/dev/null 2>&1 \
            && echo "PASS unrelated-remote-accepted" || { echo "FAIL unrelated-remote-accepted"; fails=$((fails + 1)); }

        if test "$fails" -eq 0; then
            echo "self-test: 6/6 scenarios PASS"
        else
            echo "self-test: $fails scenario(s) FAILED"
        fi
        test "$fails" -eq 0
    )
    rc=$?
    rm -rf "$sandbox"
    echo "self-test sandbox cleaned (exit $rc)"
    exit $rc
fi

# ---------------------------------------------------------------------------
# Normal hook invocation: argv[1]=remote name, argv[2]=remote URL.
# ---------------------------------------------------------------------------
remote_name="${1:-origin}"
remote_url="${2:-}"

if [ -z "$remote_url" ] || ! FEDERATED_REMOTE "$remote_url"; then
    exit 0   # guard not applicable to this remote
fi

updates="$(cat)"
[ -n "$updates" ] || exit 0

# Iterate in the MAIN shell (no pipe subshell) so reject/exit actually stops
# the push. IFS is narrowed to newline so each line stays whole; ref names and
# object ids cannot contain glob characters, so unquoted expansion is safe.
nl="
"
OIFS="$IFS"
IFS="$nl"
for line in $updates; do
    IFS="$OIFS"
    # shellcheck disable=SC2086
    set -- $line
    local_ref="${1:-}"; local_sha="${2:-}"; remote_ref="${3:-}"; remote_sha="${4:-}"
    [ -n "$local_ref" ] || { IFS="$nl"; continue; }

    # 1+2. Landing authority: main is written by the constitutional gates only.
    case "$remote_ref" in
        refs/heads/main)
            if ZERO_TEST "$local_sha"; then
                reject "main deletion is forbidden (Zero-Force-Push mandate, #161)" \
                    "Deletion of main is irreversible damage; restore paths go through an administrator." \
                    "Deliberate admin bypass: git push --no-verify."
            fi
            reject "direct push to main is forbidden (Public-First Ingress, #161)" \
                "Landing authority belongs to the constitutional gates (Merge Gate / internal PR gates)." \
                "Correct lanes: bridge_submit_patch (Pathway 1) or fork + PR (Pathway 2)." \
                "Deliberate admin bypass: git push --no-verify."
            ;;
    esac

    # 3. History-rewrite (force push / non-fast-forward) rejection.
    if ! ZERO_TEST "$remote_sha" && ! ZERO_TEST "$local_sha"; then
        if git cat-file -e "$remote_sha" 2>/dev/null; then
            if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
                reject "history rewrite (force push) is forbidden (Zero-Force-Push mandate, #161)" \
                    "Remote tip $remote_sha is not an ancestor of $local_sha." \
                    "Commit provenance must stay immutable; never rewrite pushed history." \
                    "If the remote tip is genuinely obsolete, route an admin-reviewed fix instead."
            fi
        fi
        # Object not present locally: cannot verify ancestry here — the
        # server-side branch protection remains the authoritative barrier.
    fi

    # 4. Stale-base rejection (Board-Freshness #4177). Applies to new branches
    #    (remote_sha all-zero) and updates alike — a new branch from a stale
    #    base is exactly the defect this guard exists to stop.
    if ! ZERO_TEST "$local_sha"; then
        git fetch --quiet "$remote_name" main 2>/dev/null
        main_ref="$(git rev-parse --verify --quiet "refs/remotes/$remote_name/main" 2>/dev/null)" || main_ref=""
        if [ -n "$main_ref" ]; then
            base="$(git merge-base "$local_sha" "$main_ref" 2>/dev/null)" || base=""
            if [ -n "$base" ]; then
                behind="$(git rev-list --count "$base..$main_ref" 2>/dev/null || echo 0)"
                if [ "$behind" -gt 0 ]; then
                    reject "stale branch: main advanced $behind commit(s) past your merge-base (#161, #4177)" \
                        "Rebase onto latest main before submission:" \
                        "  git fetch $remote_name main && git rebase $remote_name/main" \
                        "Landing a stale branch silently reverts recent fixes and reintroduces resolved bugs."
                fi
            fi
            # No merge-base (unrelated history): the CI stale guard and gate
            # chain will judge it; this hook does not guess.
        fi
        # No origin/main ref and fetch failed: freshness cannot be verified
        # offline — honest degradation; the CI stale-base guard is authoritative.
    fi

    # 5. NO CLAIM -> NO PUSH (AGENTS.md Step 4 / #430).
    # Task/issue branches must carry an active claim before pushing to remote.
    # Invariant: No claim -> no branch; no branch -> no push.
    # Deliberate admin bypass: git push --no-verify or non-issue branch.
    if ! ZERO_TEST "$local_sha"; then
        issue_token=$(printf '%s' "$local_ref" | grep -oE '(issue-?|#)[0-9]+' | grep -oE '[0-9]+' | head -n1 || true)
        if [ -n "$issue_token" ] && command -v gh >/dev/null 2>&1; then
            claim_json=$(gh issue view "$issue_token" --repo Supremeai-bd/supremeai-open --json labels,comments 2>/dev/null || echo "")
            if [ -n "$claim_json" ]; then
                has_claim=$(printf '%s' "$claim_json" | grep -Eq '"status:claimed"|"status:in-progress"|<!-- atomic-claim -->' && echo "true" || echo "false")
                if [ "$has_claim" != "true" ]; then
                    reject "NO CLAIM -> NO PUSH (AGENTS.md Step 4 / #430)"                         "Branch '$local_ref' targets Issue #$issue_token, but Issue #$issue_token has NO active claim."                         "Per the Two-Tier Ingress Invariant: No claim -> no branch; no branch -> no push."                         "Claim the issue on GitHub before pushing: gh issue edit $issue_token --add-label status:claimed"                         "Deliberate admin bypass: git push --no-verify."
                fi
            fi
        fi
    fi
    # 6. BOUNDARY SANITIZATION GUARD (#107, #508).
    # Prevent unauthorized root files or invalid domain mirroring (e.g. root service/ or packages/) before push.
    if ! ZERO_TEST "$local_sha" && [ -f scripts/ci/boundary_sanitization_guard.py ]; then
        if ZERO_TEST "$remote_sha"; then
            # New branch push — diff against main
            changed_files=$(git diff --name-only "refs/remotes/$remote_name/main...$local_sha" 2>/dev/null || git diff --name-only "origin/main...$local_sha" 2>/dev/null || true)
        else
            # Existing branch update — diff against remote tip
            changed_files=$(git diff --name-only "$remote_sha..$local_sha" 2>/dev/null || true)
        fi
        if [ -n "$changed_files" ]; then
            # Filter to existing files in worktree
            valid_scan_files=""
            for f in $changed_files; do
                if [ -f "$f" ]; then
                    valid_scan_files="$valid_scan_files $f"
                fi
            done
            if [ -n "$valid_scan_files" ]; then
                py_cmd=""
                if python3 -c "import sys" >/dev/null 2>&1; then
                    py_cmd="python3"
                elif python -c "import sys" >/dev/null 2>&1; then
                    py_cmd="python"
                elif py -3 -c "import sys" >/dev/null 2>&1; then
                    py_cmd="py -3"
                fi
                if [ -n "$py_cmd" ]; then
                    if ! $py_cmd scripts/ci/boundary_sanitization_guard.py --files $valid_scan_files; then
                        reject "BOUNDARY SANITIZATION GUARD (#107, #508) FAILED" \
                            "Changed files violate the public surface registry or proprietary path boundaries." \
                            "Do not place satellite code at root (e.g. root service/ or packages/)." \
                            "Use proper domain mirrors (gateway/service/, studio/packages/, etc.)." \
                            "Deliberate admin bypass: git push --no-verify."
                    fi
                fi
            fi
        fi
    fi

    # 7. Ruff strict name/syntax check (Federation CI Parity) on gateway/ and core/.
    if command -v ruff >/dev/null 2>&1; then
        for d in gateway core; do
            if [ -d "$d" ]; then
                if ! ruff check "$d" --select=E9,F63,F7,F82; then
                    reject "ruff check failed on $d/ (Federation CI Parity)" \
                        "Undefined names / syntax errors would break supremeai-api CI on dispatch." \
                        "Fix the reported ruff errors before pushing." \
                        "Deliberate admin bypass: git push --no-verify."
                fi
            fi
        done
    fi

    # 8. MCP Tower & Studio TypeScript Typecheck + Lockfile check
    if command -v npm >/dev/null 2>&1; then
        if [ -d "infrastructure/mcp-control-plane" ]; then
            if ! npm --prefix infrastructure/mcp-control-plane run typecheck >/dev/null 2>&1; then
                reject "TypeScript typecheck failed in infrastructure/mcp-control-plane" \
                    "Run 'npm --prefix infrastructure/mcp-control-plane run typecheck' to inspect errors." \
                    "Ensure all exported tools and adapters have strict TypeScript types." \
                    "Deliberate admin bypass: git push --no-verify."
            fi
        fi
    fi
    if [ -f "studio/package.json" ] && [ -f "studio/pnpm-lock.yaml" ]; then
        if ZERO_TEST "$remote_sha"; then
            pkg_diff=$(git diff --name-only "refs/remotes/$remote_name/main...$local_sha" -- studio/ 2>/dev/null || git diff --name-only "origin/main...$local_sha" -- studio/ 2>/dev/null || true)
        else
            pkg_diff=$(git diff --name-only "$remote_sha..$local_sha" -- studio/ 2>/dev/null || true)
        fi
        if echo "$pkg_diff" | grep -q 'studio/package\.json'; then
            if ! echo "$pkg_diff" | grep -q 'studio/pnpm-lock\.yaml'; then
                reject "STUDIO LOCKFILE OUTDATED: studio/package.json modified without studio/pnpm-lock.yaml" \
                    "CI runs pnpm install with --frozen-lockfile and will fail (ERR_PNPM_OUTDATED_LOCKFILE)." \
                    "Run 'cd studio && pnpm install --lockfile-only' and commit studio/pnpm-lock.yaml before pushing." \
                    "Deliberate admin bypass: git push --no-verify."
            fi
        fi
    fi

    # 9. OPENAPI BREAKING-CHANGE GUARD (#1711).
    # Machine revision-diff of the stable external contract
    # api-schemas/gateway.openapi.yaml (oasdiff). Engages ONLY when the push
    # touches the contract file; skips-with-evidence when the differ binary is
    # absent (honest degradation, same pattern as the loop's gh handling);
    # fail-closed on detected breaking changes. Intentional breaks pass via an
    # admin-reviewed 'contract-break-approved:' trailer commit in the range.
    # Self-contained under `set -u`: never leans on section-6 state.
    if ! ZERO_TEST "$local_sha" && [ -f scripts/ci/openapi_breaking_guard.py ]; then
        if ZERO_TEST "$remote_sha"; then
            # New branch push — diff against main
            contract_changed=$(git diff --name-only "refs/remotes/$remote_name/main...$local_sha" 2>/dev/null || git diff --name-only "origin/main...$local_sha" 2>/dev/null || true)
        else
            # Existing branch update — diff against remote tip
            contract_changed=$(git diff --name-only "$remote_sha..$local_sha" 2>/dev/null || true)
        fi
        if printf '%s\n' "$contract_changed" | grep -qx 'api-schemas/gateway.openapi.yaml'; then
            hook_py=""
            if python3 -c "import sys" >/dev/null 2>&1; then
                hook_py="python3"
            elif python -c "import sys" >/dev/null 2>&1; then
                hook_py="python"
            elif py -3 -c "import sys" >/dev/null 2>&1; then
                hook_py="py -3"
            fi
            if [ -n "$hook_py" ]; then
                if ! $hook_py scripts/ci/openapi_breaking_guard.py --files $contract_changed; then
                    reject "OPENAPI BREAKING-CHANGE GUARD (#1711) FAILED" \
                        "api-schemas/gateway.openapi.yaml revision introduces breaking changes for external consumers." \
                        "Fix the revision, or land an admin-reviewed 'contract-break-approved:' trailer commit in this range." \
                        "Evidence lines above carry the [openapi-breaking-guard] tag." \
                        "Deliberate admin bypass: git push --no-verify."
                fi
            fi
        fi
    fi

    # 10. LICENSE SSOT GUARD (#1773).
    # Machine declared-vs-actual gate for ECOSYSTEM_MAP §2.3 (the open-core
    # Embassy Model legal boundary). Engages ONLY when the push touches the
    # map, a package.json, or a LICENSE/NOTICE file. Ratchet mode: the dated
    # KNOWN_DRIFTS baseline reports without blocking (shrink-only), while any
    # NEW license drift fail-closes the push. --strict (admin, post-fix)
    # flips to fail-closed-on-any-finding. Self-contained under `set -u`.
    if ! ZERO_TEST "$local_sha" && [ -f scripts/ci/license_ssot_guard.py ]; then
        if ZERO_TEST "$remote_sha"; then
            license_changed=$(git diff --name-only "refs/remotes/$remote_name/main...$local_sha" 2>/dev/null || git diff --name-only "origin/main...$local_sha" 2>/dev/null || true)
        else
            license_changed=$(git diff --name-only "$remote_sha..$local_sha" 2>/dev/null || true)
        fi
        if printf '%s\n' "$license_changed" | grep -qE '(^ECOSYSTEM_MAP\.md$|/package\.json$|^package\.json$|(^|/)LICENSE(\.|$)|(^|/)NOTICE(\.|$))'; then
            hook_py=""
            if python3 -c "import sys" >/dev/null 2>&1; then
                hook_py="python3"
            elif python -c "import sys" >/dev/null 2>&1; then
                hook_py="python"
            elif py -3 -c "import sys" >/dev/null 2>&1; then
                hook_py="py -3"
            fi
            if [ -n "$hook_py" ]; then
                if ! $hook_py scripts/ci/license_ssot_guard.py --check; then
                    reject "LICENSE SSOT GUARD (#1773) FAILED" \
                        "The push introduces NEW license drift against the ECOSYSTEM_MAP §2.3 declared-vs-actual SSOT." \
                        "Fix the finding above (missing license field / LICENSE file, or a declared-model contradiction)." \
                        "Evidence lines carry the [license-ssot-guard] tag. Deliberate admin bypass: git push --no-verify."
                fi
            fi
        fi
    fi

    # 11. CONTRACT CODEGEN GUARD (#1846).
    # Contract -> generated-consumer viability gate for the stable external
    # contract (api-schemas/gateway.openapi.yaml). Engages ONLY when the push
    # touches the contract or its generated surface (api-schemas/generated/).
    # Regenerates the committed artifact with the pinned datamodel-codegen in
    # a tempdir and byte-compares (CRLF-normalized): any drift = the contract
    # changed without regenerating its consumer surface. Honest skip when the
    # pinned binary is absent or the installed version differs from the pin.
    # Self-contained under `set -u`; never touches the YAML or the artifact.
    if ! ZERO_TEST "$local_sha" && [ -f scripts/ci/contract_codegen_guard.py ]; then
        if ZERO_TEST "$remote_sha"; then
            codegen_changed=$(git diff --name-only "refs/remotes/$remote_name/main...$local_sha" 2>/dev/null || git diff --name-only "origin/main...$local_sha" 2>/dev/null || true)
        else
            codegen_changed=$(git diff --name-only "$remote_sha..$local_sha" 2>/dev/null || true)
        fi
        if printf '%s\n' "$codegen_changed" | grep -qE '(^api-schemas/gateway\.openapi\.yaml$|^api-schemas/generated/)'; then
            hook_py=""
            if python3 -c "import sys" >/dev/null 2>&1; then
                hook_py="python3"
            elif python -c "import sys" >/dev/null 2>&1; then
                hook_py="python"
            elif py -3 -c "import sys" >/dev/null 2>&1; then
                hook_py="py -3"
            fi
            if [ -n "$hook_py" ]; then
                if ! $hook_py scripts/ci/contract_codegen_guard.py --check; then
                    reject "CONTRACT CODEGEN GUARD (#1846) FAILED" \
                        "The push drifts the contract from its committed consumer artifact (api-schemas/generated/gateway_models.py)." \
                        "Regenerate the artifact with the pinned generator and commit it (never hand-edit)." \
                        "Evidence lines carry the [contract-codegen-guard] tag. Deliberate admin bypass: git push --no-verify."
                fi
            fi
        fi
    fi

    # 12. BANDIT SAST GUARD (#1809).
    # Python source static-security ratchet over the non-test surface
    # (core scripts gateway browser skills examples infrastructure evals).
    # Engages ONLY when the push touches .py files inside the scan targets.
    # Shrink-only baseline (scripts/ci/bandit_sast_baseline.json): NEW or
    # GROWN (path, test_id) findings under scripts/** fail-close the push
    # (agent-bridge-able); drift under the satellite mirrors is report-only
    # routing to the owning domain. Skips-with-evidence when bandit is not
    # installed (honest degradation, #1760 oasdiff pattern). Self-contained
    # under `set -u`.
    if ! ZERO_TEST "$local_sha" && [ -f scripts/ci/bandit_sast_guard.py ]; then
        if ZERO_TEST "$remote_sha"; then
            sast_changed=$(git diff --name-only "refs/remotes/$remote_name/main...$local_sha" 2>/dev/null || git diff --name-only "origin/main...$local_sha" 2>/dev/null || true)
        else
            sast_changed=$(git diff --name-only "$remote_sha..$local_sha" 2>/dev/null || true)
        fi
        sast_py_files=$(printf '%s\n' "$sast_changed" | grep -E '\.py$' | grep -E '^(core|scripts|gateway|browser|skills|examples|infrastructure|evals)/' || true)
        if [ -n "$sast_py_files" ]; then
            hook_py=""
            if python3 -c "import sys" >/dev/null 2>&1; then
                hook_py="python3"
            elif python -c "import sys" >/dev/null 2>&1; then
                hook_py="python"
            elif py -3 -c "import sys" >/dev/null 2>&1; then
                hook_py="py -3"
            fi
            if [ -n "$hook_py" ]; then
                if ! $hook_py scripts/ci/bandit_sast_guard.py --files $sast_py_files; then
                    reject "BANDIT SAST GUARD (#1809) FAILED" \
                        "The push introduces NEW or GROWN Python-source security findings under scripts/." \
                        "Fix the finding (see the [bandit-sast-guard] evidence lines above) — the baseline may never grow." \
                        "Satellite-mirror findings are report-only and route to their owning domain." \
                        "Deliberate admin bypass: git push --no-verify."
                fi
            fi
        fi
    fi

    # 13. JS-DEP CVE GUARD (#1913).
    # JavaScript dependency vulnerability ratchet over studio/pnpm-lock.yaml
    # (the unique (name, version) pin set, both lockfile sections, deduped).
    # Engages ONLY when the push touches the studio dependency surface
    # (studio/package.json or studio/pnpm-lock.yaml). Shrink-only baseline
    # (scripts/ci/js_dep_cve_baseline.json): a NEW advisory pair or a NEW
    # advisory id fail-closes the push; resolved ids route to baseline-shrink
    # hints. Skips-with-evidence when the OSV API (api.osv.dev, zero-
    # credential SSOT) is unreachable (honest degradation, #1760 pattern).
    # Self-contained under `set -u`.
    if ! ZERO_TEST "$local_sha" && [ -f scripts/ci/js_dep_cve_guard.py ]; then
        if ZERO_TEST "$remote_sha"; then
            jsdep_changed=$(git diff --name-only "refs/remotes/$remote_name/main...$local_sha" 2>/dev/null || git diff --name-only "origin/main...$local_sha" 2>/dev/null || true)
        else
            jsdep_changed=$(git diff --name-only "$remote_sha..$local_sha" 2>/dev/null || true)
        fi
        jsdep_surface=$(printf '%s\n' "$jsdep_changed" | grep -E '^studio/(package\.json|pnpm-lock\.yaml)$' || true)
        if [ -n "$jsdep_surface" ]; then
            hook_py=""
            if python3 -c "import sys" >/dev/null 2>&1; then
                hook_py="python3"
            elif python -c "import sys" >/dev/null 2>&1; then
                hook_py="python"
            elif py -3 -c "import sys" >/dev/null 2>&1; then
