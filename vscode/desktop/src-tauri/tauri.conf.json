{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SupremeAI Desktop",
  "version": "0.1.0",
  "identifier": "com.supremeai.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SupremeAI Workstation",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
