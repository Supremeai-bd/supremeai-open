{
  "name": "supremeai-client-hub",
  "version": "1.0.0",
  "private": true,
  "description": "SupremeAI Unified Client Hub — VS Code Extension, Desktop (Tauri/Electron), and Mobile (React Native)",
  "workspaces": [
    "extension",
    "desktop",
    "mobile"
  ],
  "scripts": {
    "build:extension": "npm run compile --workspace=extension",
    "build:desktop": "npm run build --workspace=desktop",
    "build:mobile": "npm run build --workspace=mobile",
    "build:all": "npm run build:extension",
    "test": "npm run test --workspace=extension"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
