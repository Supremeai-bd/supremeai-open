{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KnowledgeRecord",
  "description": "One verifiable unit of knowledge with provenance. Validated by scripts/validate_record.py (stdlib only; this file documents the contract).",
  "type": "object",
  "required": ["id", "kind", "claim", "topic", "source", "confidence", "verification", "risk", "applicability", "limitations", "created_at"],
  "properties": {
    "id": {"type": "string", "description": "Stable unique id, e.g. kr-2026-10-18-001"},
    "kind": {"enum": ["fact", "opinion", "hypothesis", "recommendation", "lesson"]},
    "claim": {"type": "string", "description": "The knowledge, faithfully stated, one idea per record"},
    "topic": {"type": "string"},
    "rationale": {"type": "string", "description": "Short checkable explanation given by the source. Never hidden chain-of-thought."},
    "source": {
      "type": "object",
      "required": ["name", "method"],
      "properties": {
        "name": {"type": "string", "description": "Provider or agent, e.g. gemini, chatgpt, supremeai-agent:planner, human"},
        "model": {"type": "string"},
        "method": {"enum": ["copy_paste", "api", "mcp", "agent", "human", "own_analysis"]},
        "retrieved_at": {"type": "string"},
        "prompt_ref": {"type": "string"}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "quality"],
        "properties": {
          "type": {"enum": ["primary_source", "test_result", "documentation", "data", "reasoning_only", "other_ai_claim"]},
          "ref": {"type": "string"},
          "quality": {"enum": ["strong", "moderate", "weak"]},
          "independent": {"type": "boolean", "description": "true if obtained separately from the source of the claim"}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "uncertainty": {"type": "string"},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}, "description": "May be empty only if truly none; state it explicitly."},
    "applicability": {
      "type": "object",
      "required": ["contexts"],
      "properties": {
        "contexts": {"type": "array", "items": {"type": "string"}},
        "not_applicable": {"type": "array", "items": {"type": "string"}}
      }
    },
    "counterarguments": {"type": "array", "items": {"type": "string"}},
    "verification": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["unverified", "corroborated", "verified", "disputed", "superseded"]},
        "how_to_verify": {"type": "string"},
        "checked_by": {"type": "string"},
        "checked_at": {"type": "string"}
      }
    },
    "risk": {
      "type": "object",
      "required": ["impact"],
      "properties": {
        "impact": {"enum": ["low", "medium", "high"]},
        "areas": {"type": "array", "items": {"enum": ["security", "privacy", "policy", "architecture", "core_philosophy", "money", "legal", "none"]}},
        "reversible": {"type": "boolean"}
      }
    },
    "conflicts_with": {"type": "array", "items": {"type": "string"}, "description": "ids of records this disagrees with"},
    "supersedes": {"type": "array", "items": {"type": "string"}},
    "outcome": {
      "type": "object",
      "description": "Only for kind=lesson: filled after a result is known",
      "properties": {
        "objective": {"type": "string"},
        "expected": {"type": "string"},
        "actual": {"type": "string"},
        "root_cause": {"type": "string"},
        "root_cause_supported": {"type": "boolean"},
        "repeat": {"type": "array", "items": {"type": "string"}},
        "change": {"type": "array", "items": {"type": "string"}},
        "avoid": {"type": "array", "items": {"type": "string"}}
      }
    },
    "flags": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Concerns about how the content arrived. Known values: injection_suspected (source content contained instruction-like text aimed at the assistant; forces needs_review), unverified_citation (cited URL or source not opened; prevents auto_store_ok), fabricated_specifics_suspected (exact numbers or quotes without a source)."
    },
    "review_after": {"type": "string", "description": "ISO date for time-sensitive claims"},
    "created_at": {"type": "string"}
  },
  "additionalProperties": false
}
