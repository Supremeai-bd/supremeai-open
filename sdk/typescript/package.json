{
  "name": "@supremeai/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript client for the SupremeAI Unified Gateway: typed endpoints, SSE streaming, automatic failover retry.",
  "license": "MIT",
  "type": "module",
  "main": "./src/client.ts",
  "types": "./src/client.ts",
  "exports": {
    ".": "./src/client.ts",
    "./streaming": "./src/streaming.ts",
    "./types": "./src/types/generated.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/test_ts_client.ts"
  },
  "keywords": [
    "supremeai",
    "gateway",
    "sse",
    "streaming",
    "client"
  ],
  "files": [
    "src"
  ]
}
