+#!/usr/bin/env python3
+"""Regression test: agent_identity CLI `resolve --model` must reach the implementation.
+
+বাংলা (#bridge-20261030-agent-identity-cli-model-forward):
+`_cli_resolve` আগে args.model ফরওয়ার্ড করত না — parser ফ্ল্যাগ পার্স করত কিন্তু
+`resolve_agent_identity(args.preferred)`-এ শুধু preferred যেত, ফলে CLI দিয়ে
+`--model glm5.2` দিলেও agent name সবসময় `unknown-` namespace-এ claim হতো
+(model-scoped CAS namespace, #2950-followup — ভুল namespace = cross-model drift)।
+
+এই টেস্ট তিনটি চুক্তি আটকে রাখে:
+  1. CLI-পার্স করা model মান implementation-এ পৌঁছায় (namespace সততা)।
+  2. model=None হলে implementation-এর parameter→env→"unknown" ফলব্যাক চেইন
+     অক্ষত থাকে (backward-compatible আচরণ)।
+  3. পুরো CLI পাইপলাইন এন্ড-টু-এন্ড: `resolve --model glm5.2` চালালে
+     identity.json-এ model="glm5.2" এবং নাম সঠিক namespace-প্রিফিক্সড হয়।
+
+সব টেস্ট hermetic/offline — subprocess.run ব্যর্থ-ফলাফলে স্টাব করা (কোনো git
+fetch/push বা gh api নেটওয়ার্ক কল নেই), identity ফাইল temp dir-এ।
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+_ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(_ROOT / "scripts" / "agents"))
+
+import agent_identity as ai  # noqa: E402
+
+
+def _fake_identity(model: str | None) -> ai.AgentIdentity:
+    resolved = model or "unknown"
+    return ai.AgentIdentity(
+        agent_name=f"{resolved}-coder-1",
+        machine_id="test-machine",
+        created_at=0.0,
+        last_active=0.0,
+        model=resolved,
+    )
+
+
+class TestCliResolveForwardsModel(unittest.TestCase):
+    """_cli_resolve → resolve_agent_identity forwarding contract (unit plane)."""
+
+    def _run_cli(self, preferred, model, capture):
+        def fake_resolve(preferred=None, model=None):
+            capture["preferred"] = preferred
+            capture["model"] = model
+            return _fake_identity(model)
+
+        ns = argparse.Namespace(preferred=preferred, model=model)
+        with mock.patch.object(ai, "resolve_agent_identity", side_effect=fake_resolve):
+            rc = ai._cli_resolve(ns)
+        return rc
+
+    def test_cli_model_flag_reaches_implementation(self):
+        # বাংলা: --model glm5.2 দিলে implementation model="glm5.2" পাবে — নাম তখন
+        # সঠিক model namespace-এ (glm5.2-coder-N) claim হয়, unknown-এ নয়।
+        capture: dict = {}
+        rc = self._run_cli("coder", "glm5.2", capture)
+        self.assertEqual(rc, 0)
+        self.assertEqual(capture["model"], "glm5.2")
+        self.assertEqual(capture["preferred"], "coder")
+
+    def test_cli_without_model_keeps_none_fallback_chain(self):
+        # বাংলা: model=None ফরওয়ার্ড হলে resolve_agent_identity নিজেই
+        # parameter→env→"unknown" চেইন চালায় — CLI None-কে "unknown"-এ
+        # কোলাপস করবে না (নইলে env fallback মারা যায়)।
+        capture: dict = {}
+        rc = self._run_cli(None, None, capture)
+        self.assertEqual(rc, 0)
+        self.assertIsNone(capture["model"])
+
+
+class _FailingProc:
+    """subprocess.run স্টাব: সব git/gh কল ব্যর্থ দেখায় (offline hermetic)।"""
+
+    returncode = 1
+    stdout = ""
+    stderr = ""
+
+
+class TestCliResolveEndToEnd(unittest.TestCase):
+    """Full pipeline: argparse → _cli_resolve → resolve_agent_identity → identity.json.
+
+    বাংলা: আসল main() argv-সহ চালানো হয়; git/gh subprocess ব্যর্থ-স্টাব হওয়ায়
+    name-claim ফলব্যাক পথ (uuid suffix) নেয় — সেটাও {model}-{role}-{suffix}
+    ফরম্যাট মানে। ফিক্স-পূর্বে এই টেস্ট ব্যর্থ হত (নাম "unknown-coder-…",
+    model "unknown") — ফিক্স-পরে পাস।
+    """
+
+    def setUp(self):
+        os.environ.pop("AGENT_MODEL", None)  # বাংলা: মানটি যেন --model ফ্ল্যাগ থেকেই আসে
+
+    def test_full_cli_pipeline_model_namespaces_identity(self):
+        with tempfile.TemporaryDirectory() as td:
+            tmp = Path(td)
+            id_file = tmp / "identity.json"
+            with (
+                mock.patch.object(ai, "IDENTITY_DIR", tmp),
+                mock.patch.object(ai, "IDENTITY_FILE", id_file),
+                mock.patch.object(ai.subprocess, "run", return_value=_FailingProc()),
+                mock.patch.object(ai, "_authenticated_login", return_value=None),
+                mock.patch.object(sys, "argv", [
+                    "agent_identity.py", "resolve",
+                    "--preferred", "coder", "--model", "glm5.2",
+                ]),
+            ):
+                rc = ai.main()
+            self.assertEqual(rc, 0)
+            self.assertTrue(id_file.exists(), "CLI must persist identity.json")
+            data = json.loads(id_file.read_text(encoding="utf-8"))
+            self.assertEqual(data["model"], "glm5.2")
+            self.assertTrue(
+                data["agent_name"].startswith("glm5.2-coder-"),
+                f"agent name must carry the --model namespace, got: {data['agent_name']}",
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
