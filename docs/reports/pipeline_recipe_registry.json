{
  "version": "1.0.0",
  "recipes": [
    {
      "recipe_id": "repair.async_timeout",
      "recipe_name": "Self-Heal: Asyncio Timeout / Execution Timeout",
      "intent": "REPAIR",
      "trigger_patterns": [
        "asyncio.TimeoutError",
        "execution timeout",
        "task timeout exceeded",
        "TimeoutError",
        "deadline exceeded",
        "step timed out"
      ],
      "problem_description": "A runtime asyncio or execution timeout error has occurred. The tool chain identifies root cause, discovers an open-source resilience pattern, validates it in sandbox, and applies a governance-approved patch.",
      "pipeline_chain": [
        {
          "tool_id": "radar.gap_miner.incident_replay",
          "purpose": "Parse error log to extract timeout root cause",
          "inputs_from_prev": [],
          "outputs_key": "incident_fingerprint",
          "can_skip_if": null,
          "timeout_seconds": 60
        },
        {
          "tool_id": "engine.discovery_fabric.source_scout",
          "purpose": "Find open-source async retry/timeout patterns",
          "inputs_from_prev": [
            "incident_fingerprint.affected_component"
          ],
          "outputs_key": "candidates",
          "can_skip_if": null,
          "timeout_seconds": 60
        },
        {
          "tool_id": "engine.discovery_fabric.trust_engine",
          "purpose": "Score and rank candidates by trust/license",
          "inputs_from_prev": [
            "candidates"
          ],
          "outputs_key": "ranked_candidates",
          "can_skip_if": null,
          "timeout_seconds": 60
        },
        {
          "tool_id": "knowledge_os.knowledge_quarantine",
          "purpose": "Quarantine and verify top candidate",
          "inputs_from_prev": [
            "ranked_candidates[0]"
          ],
          "outputs_key": "quarantine_result",
          "can_skip_if": null,
          "timeout_seconds": 60
        },
        {
          "tool_id": "shield.governance_policy",
          "purpose": "Validate target file is allowlisted for modification",
          "inputs_from_prev": [
            "incident_fingerprint.target_file"
          ],
          "outputs_key": "governance_result",
          "can_skip_if": "quarantine_result.status != PASSED",
          "timeout_seconds": 60
        },
        {
          "tool_id": "engine.solution_synthesizer",
          "purpose": "Synthesize minimal patch and test in sandbox",
          "inputs_from_prev": [
            "incident_fingerprint",
            "quarantine_result",
            "governance_result"
          ],
          "outputs_key": "patch_result",
          "can_skip_if": null,
          "timeout_seconds": 60
        }
      ],
      "merge_strategy": "sequential",
      "success_criteria": [
        "patch_result.verified_in_sandbox == True",
        "governance_result.is_allowed == True",
        "quarantine_result.status == PASSED"
      ],
      "failure_fallback": "repair.generic_static_fix",
      "avg_confidence": 0.96,
      "avg_duration_seconds": 45,
      "token_budget": "low",
      "requires_network": true,
      "tags": [
        "repair",
        "async",
        "timeout",
        "self-healing"
      ]
    },
