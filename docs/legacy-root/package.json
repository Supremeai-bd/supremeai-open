{
  "name": "supremeai-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "SupremeAI 2.0 \u2014 Universal Self-Learning AI Agent (Monorepo)",
  "scripts": {
    "build": "turbo run build",
    "build:affected": "turbo run build --filter=[origin/main]",
    "test": "turbo run test",
    "test:affected": "turbo run test --filter=[origin/main]",
    "test:e2e": "playwright test",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint:fix": "turbo run lint -- --fix",
    "test:coverage": "turbo run test --coverage",
    "security:audit": "pnpm audit",
    "qa:validate": "node scripts/ci/validate_qa_checklist.mjs",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean",
    "clean:full": "echo \"\u26a0\ufe0f  \u098f\u099f\u09be node_modules \u09a1\u09bf\u09b2\u09bf\u099f \u0995\u09b0\u09ac\u09c7\u0964 \u0995\u09a8\u09ab\u09be\u09b0\u09cd\u09ae \u0995\u09b0\u09a4\u09c7: pnpm run clean:full:confirm\"",
    "clean:full:confirm": "rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "backend:dev": "cd backend && poetry run uvicorn core.app:app --reload",
    "backend:test": "cd backend && poetry run pytest",
    "docker:build": "docker-compose -f docker-compose.yml build",
    "docker:up": "docker-compose -f docker-compose.yml up -d",
    "deploy:gcp": "python3 scripts/deploy_all_services.py",
    "deploy:frontend": "pnpm --filter supremeai-studio-client build && python3 scripts/deploy/generate_firebase_config.py --require-build && firebase deploy --only hosting",
    "deploy:firestore": "python3 scripts/deploy/generate_firebase_config.py && firebase deploy --only firestore",
    "deploy": "pnpm deploy:frontend && pnpm deploy:firestore",
    "desktop:dev": "pnpm --filter supremeai-studio-client electron:dev",
    "desktop:build": "pnpm --filter supremeai-studio-client electron:build",
    "seed:load": "python backend/scripts/load_seed_data.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint-visitor-keys": "^5.0.1",
    "miniflare": "^2.14.4",
    "prettier": "^3.9.8",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wait-on": "^7.2.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@10.15.0",
  "overrides": {
    "js-yaml@<4.3.2": "^4.3.2",
    "sharp": "^0.35.4",
    "deepmerge-ts@<8.0.0": ">=8.0.0",
    "@tanstack/react-query": "^5.103.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "7.3.5",
    "firebase": "^12.15.0",
    "ioredis": "^5.11.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.15.0"
  },
  "dependencies": {
    "@types/ioredis": "^5.0.0",
    "@types/node": "^24.13.3",
    "@webcontainer/api": "^1.6.4",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "rollup": "^4.63.0"
  }
}
