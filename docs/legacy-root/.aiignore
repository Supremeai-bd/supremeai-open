# SupremeAI AI Assistant Ignore Rules
# Applies to: Cline, Kilo, Qoder, CodeGeeX, Cursor, Antigravity AI Agents
# Only ignores noisy caches, temporary build artifacts, and heavy archive zips.
# Core scripts (scripts/ai/*, scripts/checkpoint_update.py) and documentation remain fully accessible!

# ── Dependencies & Virtual Environments ──────────────────────────
node_modules/
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# ── Build Outputs & Package Artifacts ────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.turbo/
target/
*.tsbuildinfo
*.vsix
*.egg-info/

# ── Heavy Archive Files & Temp Backups Only ───────────────────────
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.bak
*.patch
scripts/backups/
scripts/temp/

# ── Temporary Reports & Test Coverage Bloat ──────────────────────
backend/reports/
reports/
_archive/
archive/
scratch/
htmlcov/
test-results/
playwright-report/
.coverage
coverage.xml

# ── IDE, Agent Logs & Temporary Metadata ────────────────────────
.gemini/
.antigravity/
.cline/
.cursor/
brain/
tmp/
.system_generated/
*.log
ci_log.txt
render_deployment_failure_logs.md
error_trace.log
env_key_scan_results.json

# ── Binary Datasets & Large Media Assets ────────────────────────
*.png
*.jpg
*.jpeg
*.svg
*.webp
*.ico
*.mp4
*.pdf
*.db
*.sqlite
*.sqlite3
*.parquet
