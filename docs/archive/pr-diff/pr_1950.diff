+        else
+            jsdep_changed=$(git diff --name-only "$remote_sha..$local_sha" 2>/dev/null || true)
+        fi
+        jsdep_surface=$(printf '%s\n' "$jsdep_changed" | grep -E '^studio/(package\.json|pnpm-lock\.yaml)$' || true)
+        if [ -n "$jsdep_surface" ]; then
+            hook_py=""
+            if python3 -c "import sys" >/dev/null 2>&1; then
+                hook_py="python3"
+            elif python -c "import sys" >/dev/null 2>&1; then
+                hook_py="python"
+            elif py -3 -c "import sys" >/dev/null 2>&1; then
+                hook_py="py -3"
+            fi
+            if [ -n "$hook_py" ]; then
+                if ! $hook_py scripts/ci/js_dep_cve_guard.py --files $jsdep_surface; then
+                    reject "JS-DEP CVE GUARD (#1913) FAILED" \
+                        "The push introduces NEW JavaScript dependency advisories on the studio plane." \
+                        "Resolve it (pin bumps are studio-owner decisions) or re-floor the baseline deliberately — the baseline may never grow." \
+                        "See the [js-dep-cve-guard] evidence lines above; OSV-unreachable runs skip with evidence." \
+                        "Deliberate admin bypass: git push --no-verify."
+                fi
+            fi
+        fi
+    fi
+
     IFS="$nl"
 done
 IFS="$OIFS"
