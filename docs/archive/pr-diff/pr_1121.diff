+﻿"""gateway/service/context_compiler.py - Server-side context compiler (spec Phase 1)."""
+from __future__ import annotations
+
+import logging
+from typing import Any, Dict, List, Optional
+
+logger = logging.getLogger("supremeai.context_compiler")
+
+CORE_SYSTEM_ANCHOR = """[CORE IDENTITY & MANDATE]
+- You are SupremeAI, the autonomous multi-cloud orchestrator and principal software intelligence.
+- You are NOT a generic model from Google, Meta, OpenAI, or any third party. Your core identity is SupremeAI.
+- Never discuss internal model routing, API keys, webhook URLs, fallback attempts, or backend infrastructure unless explicitly requested by the admin.
+
+[TRUTHFULNESS & ANTI-HALLUCINATION RULES]
+- Absolute Honesty: If you do not possess specific information, codebase files, or verified facts about a topic, DO NOT GUESS or fabricate answers.
+- Cold-Start Safety: When context is absent, politely and directly ask for the necessary code/files.
+- Grounding: Base answers strictly on facts and standard engineering patterns. Avoid speculative claims.
+
+[RESPONSE POLICY]
+- Language: Speak in natural, polished Bengali by default or when addressed in Bengali. Retain technical English terms (e.g., API, Gateway, PR, Route, Cache, Middleware) naturally in English.
+- Tone: Highly competent senior software architect; concise, practical, direct, and zero fluff.
+- Structure: Start directly with the verdict or solution. Avoid filler greetings.
+"""
+
+PLATFORM_GROUNDING_SHEET = """[SUPREMEAI VERIFIED ECOSYSTEM KNOWLEDGE]
+- Federation Architecture: 12 Product Satellites + 1 Control Plane (MCP Tower).
+- Active Satellites:
+  * studio: Frontend web dashboard & workspace (supremeai-studio)
+  * gateway/api: Unified provider gateway & auth shield (supremeai-api)
+  * core: Brain, decision engine & consensus (supremeai-core)
+  * vscode: Developer IDE extension (supremeai-vscode)
+  * browser: Headless automation sandbox & scraper (supremeai-browser)
+- Operating Doctrine: Zero-Admin (Admin work <= 0.01%), Satellite-First, Single-Domain PRs, 14 Anchor Hubs.
+- Never invent repositories or services outside this official charter.
+"""
+
+_LOGIC_KEYWORDS = {
+    "code", "debug", "audit", "logic", "infra", "architecture", "refactor",
+    "fix", "bug", "test", "sql", "api", "route", "gateway", "config",
+}
+
+
+def build_system_anchor(*args, **kwargs) -> str:
+    extra = kwargs.get("extra") or kwargs.get("context")
+    base = CORE_SYSTEM_ANCHOR + "\n" + PLATFORM_GROUNDING_SHEET
+    if extra:
+        base = base + "\n" + str(extra)
+    return base
+
+
+def resolve_sampling_knobs(*args, **kwargs) -> Dict[str, Any]:
+    is_logic = False
+    mode = kwargs.get("mode") or kwargs.get("task_type") or kwargs.get("task")
+    if isinstance(mode, str):
+        low = mode.lower()
+        if any(k in low for k in ("logic", "code", "audit", "infra", "debug", "architect")):
+            is_logic = True
+        if "chat" in low:
+            is_logic = False
+
+    messages = kwargs.get("messages")
+    if messages is None and args:
+        for a in args:
+            if isinstance(a, (list, tuple)):
+                messages = a
+                break
+            if isinstance(a, str):
+                if any(k in a.lower() for k in _LOGIC_KEYWORDS):
+                    is_logic = True
+    if messages:
+        joined = " ".join(str(m.get("content", "") if isinstance(m, dict) else m) for m in messages).lower()
+        if any(k in joined for k in _LOGIC_KEYWORDS):
+            is_logic = True
+        if mode and isinstance(mode, str) and "chat" in mode.lower():
+            is_logic = False
+
+    if kwargs.get("is_logic") is True:
+        is_logic = True
+    if kwargs.get("is_logic") is False:
+        is_logic = False
+
+    temperature = 0.2 if is_logic else 0.4
+    return {
+        "temperature": temperature,
+        "temp": temperature,
+        "top_p": 0.9,
+        "frequency_penalty": 0.1,
+        "presence_penalty": 0.1,
+        "max_tokens": kwargs.get("max_tokens", 4096),
+    }
+
+
+def _extract_user_memories(user_id: Optional[str], provided: Any) -> List[Dict[str, Any]]:
+    if provided is not None:
+        if isinstance(provided, (list, tuple)):
+            return [dict(x) if isinstance(x, dict) else {"value": str(x)} for x in provided]
+        if isinstance(provided, dict):
+            return [provided]
+        return [{"value": str(provided)}]
+    if not user_id:
+        return []
+    try:
+        from .memory_store import get_user_durable_memories
+        return get_user_durable_memories(user_id)
+    except Exception:
+        return []
+
+
+def _extract_recent_history(conv_id: Optional[str], provided: Any, messages: List[Any]) -> List[Dict[str, Any]]:
+    if provided is not None:
+        if isinstance(provided, (list, tuple)):
+            return [dict(x) if isinstance(x, dict) else {"role": "user", "content": str(x)} for x in provided]
+        return []
+    if conv_id:
+        try:
+            from .memory_store import get_recent_history
+            return get_recent_history(conv_id, limit=10)
+        except Exception:
+            pass
+    recent = [m for m in messages if isinstance(m, dict)]
+    return recent[-10:]
+
+
+def compile_chat_context(*args, **kwargs) -> List[Dict[str, Any]]:
+    messages = kwargs.get("messages")
+    if messages is None:
+        for a in args:
+            if isinstance(a, (list, tuple)):
+                messages = list(a)
+                break
+            if isinstance(a, dict) and "messages" in a:
+                messages = a["messages"]
+                for k in ("conversation_id", "conv_id", "user_id", "summary"):
+                    if k in a and k not in kwargs:
+                        kwargs[k] = a[k]
+    if messages is None:
+        messages = []
+    messages = [dict(m) if isinstance(m, dict) else {"role": "user", "content": str(m)} for m in messages]
+
+    conv_id = kwargs.get("conversation_id") or kwargs.get("conv_id") or kwargs.get("conv")
+    user_id = kwargs.get("user_id") or kwargs.get("userId")
+
+    summary = kwargs.get("summary")
+    if summary is None and conv_id:
+        try:
+            from .memory_store import _DEFAULT_STORE
+            conv = _DEFAULT_STORE.get_conversation(conv_id, user_id=user_id)
+            if conv:
+                summary = conv.get("summary", "")
+        except Exception:
+            summary = ""
+
+    user_memories = _extract_user_memories(user_id, kwargs.get("user_memories") or kwargs.get("durable_memories") or kwargs.get("user_memory"))
+    recent_history = _extract_recent_history(conv_id, kwargs.get("recent_history") or kwargs.get("recent_messages") or kwargs.get("recent"), messages)
+
+    language_pref = kwargs.get("language_pref", "bn")
+    response_style = kwargs.get("response_style", "technical-architect")
+
+    system_parts = [build_system_anchor()]
+    system_parts.append(f"Language preference: {language_pref}; Response style: {response_style}.")
+    if summary:
+        system_parts.append("Rolling summary of prior conversation:\n" + str(summary))
+    if user_memories:
+        mem_lines = []
+        for m in user_memories:
+            if isinstance(m, dict):
+                key = m.get("memory_key") or m.get("key")
+                val = m.get("memory_value") or m.get("value")
+                if key or val:
+                    mem_lines.append(f"- {key}: {val}" if key else f"- {val}")
+            else:
+                mem_lines.append(f"- {m}")
+        if mem_lines:
+            system_parts.append("Durable user memory:\n" + "\n".join(mem_lines))
+    if recent_history:
+        recent_lines = []
+        for m in recent_history[-10:]:
+            if isinstance(m, dict):
+                recent_lines.append(f"{m.get('role', 'user')}: {str(m.get('content', ''))[:500]}")
+        if recent_lines:
+            system_parts.append("Recent conversation (Tier A):\n" + "\n".join(recent_lines))
+
+    system_content = "\n\n".join(system_parts)
+
+    out = [{"role": "system", "content": system_content}]
+    for m in messages:
+        if not isinstance(m, dict):
+            m = {"role": "user", "content": str(m)}
+        if m.get("role") == "system":
+            continue
+        out.append({"role": m.get("role", "user"), "content": m.get("content", "")})
+    return out
+
+
+compile_context = compile_chat_context
+build_context = compile_chat_context
+
+__all__ = [
+    "CORE_SYSTEM_ANCHOR",
+    "PLATFORM_GROUNDING_SHEET",
+    "build_system_anchor",
+    "resolve_sampling_knobs",
+    "compile_chat_context",
+    "compile_context",
+    "build_context",
+]
diff --git a/gateway/service/epistemic_router.py b/gateway/service/epistemic_router.py
new file mode 100644
index 00000000..94149c56
--- /dev/null
+++ b/gateway/service/epistemic_router.py
@@ -0,0 +1,153 @@
+"""Epistemic endpoints (ChronoFact/SPINE patterns) for SupremeAI gateway.
+
+Exposes:
+- POST /api/v1/tools/prune      (TF-IDF tool schema pruning)
+- POST /api/v1/memory/gate      (relevance-gated memory, 0.72 cosine gate)
+- GET  /api/v1/model-horizon    (list calibrated models)
+- POST /api/v1/model-horizon/intercept  (drift interception)
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import Any, Optional
+
+from fastapi import APIRouter, HTTPException
+from pydantic import BaseModel
+
+logger = logging.getLogger("supremeai.epistemic")
+
+router = APIRouter(prefix="/api/v1", tags=["epistemic"])
+
+
+class ToolPruneRequest(BaseModel):
+    query: str
+    tools: list[dict[str, Any]]
+    threshold: float = 0.45
+
+
+class MemoryGateRequest(BaseModel):
+    query: str
+    entries: list[dict[str, Any]]
+    threshold: float = 0.72
+
+
+class InjectionScanRequest(BaseModel):
+    text: str
+    threshold: float = 0.3
+
+
+class HorizonInterceptRequest(BaseModel):
+    model_id: str
+    as_of: Optional[str] = None
+
+
+@router.post("/prompt-injection/scan")
+async def scan_prompt_injection(req: InjectionScanRequest) -> dict[str, Any]:
+    try:
+        from gateway.prompt_injection import detect_injection
+    except ImportError:
+        from prompt_injection import detect_injection  # type: ignore[no-redef]
+    res = detect_injection(req.text, threshold=req.threshold)
+    return {
+        "is_injection": res.is_injection,
+        "score": res.score,
+        "matched": res.matched,
+        "sanitized": res.sanitized,
+    }
+
+
+def _import_pruner():
+    try:
+        from gateway.tool_pruner import ToolSchema, route_tools
+    except ImportError:
+        from tool_pruner import ToolSchema, route_tools  # type: ignore[no-redef]
+    return ToolSchema, route_tools
+
+
+def _import_memory_gate():
+    try:
+        from gateway.memory_gate import MemoryEntry, MemoryGate
+    except ImportError:
+        from memory_gate import MemoryEntry, MemoryGate  # type: ignore[no-redef]
+    return MemoryEntry, MemoryGate
+
+
+def _import_horizon():
+    try:
+        from gateway.model_horizon import (
+            ModelHorizonRegistry,
+            intercept_drift,
+            reset_registry,
+        )
+    except ImportError:
+        from model_horizon import (  # type: ignore[no-redef]
+            ModelHorizonRegistry,
+            intercept_drift,
+            reset_registry,
+        )
+    return ModelHorizonRegistry, intercept_drift, reset_registry
+
+
+@router.post("/tools/prune")
+async def prune_tools(req: ToolPruneRequest) -> dict[str, Any]:
+    ToolSchema, route_tools = _import_pruner()
+    tools = [ToolSchema(name=t.get("name", ""), description=t.get("description", ""), tokens=int(t.get("tokens", 0))) for t in req.tools]
+    res = route_tools(req.query, tools, threshold=req.threshold)
+    return {
+        "retained": [{"name": t.name, "description": t.description, "tokens": t.tokens} for t in res.retained],
+        "pruned": [{"name": t.name, "description": t.description, "tokens": t.tokens} for t in res.pruned],
+        "threshold": res.threshold,
+        "reduction_pct": res.reduction_pct,
+        "original_tokens": res.original_tokens,
+        "retained_tokens": res.retained_tokens,
+    }
+
+
+@router.post("/memory/gate")
+async def gate_memory(req: MemoryGateRequest) -> dict[str, Any]:
+    MemoryEntry, MemoryGate = _import_memory_gate()
+    entries = [MemoryEntry(entry_id=e.get("id", ""), domain=e.get("domain", ""), content=e.get("content", ""), metadata=e.get("metadata") or {}) for e in req.entries]
+    gate = MemoryGate(threshold=req.threshold)
+    res = gate.gate(req.query, entries)
+    return {
+        "retained": [{"id": e.entry_id, "domain": e.domain, "content": e.content} for e in res.retained],
+        "rejected": [{"id": e.entry_id, "domain": e.domain, "content": e.content} for e in res.rejected],
+        "threshold": res.threshold,
+        "leak_count": res.leak_count,
+        "leak_rate": res.leak_rate,
+    }
+
+
+@router.get("/model-horizon")
+async def list_model_horizon() -> dict[str, Any]:
+    ModelHorizonRegistry, _, _ = _import_horizon()
+    reg = ModelHorizonRegistry()
+    return {
+        "models": [
+            {
+                "id": m.model_id,
+                "provider": m.provider,
+                "official_cutoff": m.official_cutoff.isoformat(),
+                "training_freeze": m.training_freeze.isoformat(),
+                "status": m.status,
+                "successor": m.successor,
+            }
+            for m in reg.all()
+        ]
+    }
+
+
+@router.post("/model-horizon/intercept")
+async def intercept_horizon(req: HorizonInterceptRequest) -> dict[str, Any]:
+    _, intercept_drift, _ = _import_horizon()
+    from datetime import date
+
+    as_of = None
+    if req.as_of:
+        try:
+            as_of = date.fromisoformat(req.as_of)
+        except ValueError:
+            raise HTTPException(status_code=400, detail="invalid as_of date (expected YYYY-MM-DD)")
+    ev = intercept_drift(req.model_id, as_of=as_of)
+    return {"model_id": ev.model_id, "kind": ev.kind, "detail": ev.detail, "successor": ev.successor}
diff --git a/gateway/service/memory_store.py b/gateway/service/memory_store.py
new file mode 100644
index 00000000..f927bb65
--- /dev/null
+++ b/gateway/service/memory_store.py
@@ -0,0 +1,472 @@
+"""gateway/service/memory_store.py - Canonical 3-tier memory store (spec Phase 3)."""
+from __future__ import annotations
+
+import json
+import logging
+import os
+import sqlite3
+import tempfile
+import threading
+import time
+import uuid
+from contextlib import contextmanager
+from typing import Any, Dict, List, Optional
+
+logger = logging.getLogger("supremeai.memory_store")
+
+_DB_PATH = os.getenv(
+    "SUPREMEAI_CANONICAL_DB_PATH",
+    os.path.join(tempfile.gettempdir(), "supremeai_canonical.db"),
+)
+_LOCK = threading.RLock()
+_MEM = {
+    "conversations": {},
+    "messages": {},
+    "user_memories": {},
+    "provider_attempts": [],
+}
+_USE_MEM = False
+
+
+_FAILED_PATHS: set[str] = set()
+
+
+def _connect(db_path=None):
+    target_path = db_path or _DB_PATH
+    if target_path in _FAILED_PATHS:
+        return None
+    try:
+        conn = sqlite3.connect(target_path, timeout=10.0)
+        conn.row_factory = sqlite3.Row
+        conn.execute("PRAGMA journal_mode = WAL;")
+        return conn
+    except Exception as exc:
+        logger.warning("SQLite unavailable (%s); using in-memory canonical store.", exc)
+        _FAILED_PATHS.add(target_path)
+        return None
+
+
+@contextmanager
+def _db(db_path=None):
+    conn = _connect(db_path=db_path)
+    if conn is None:
+        yield None
+        return
+    try:
+        yield conn
+        conn.commit()
+    except Exception:
+        try:
+            conn.rollback()
+        except Exception:
+            pass
+        raise
+    finally:
+        try:
+            conn.close()
+        except Exception:
+            pass
+
+
+def init_db(db_path=None):
+    try:
+        with _db(db_path) as conn:
+            if conn is None:
+                return
+            conn.executescript(
+                """
+                CREATE TABLE IF NOT EXISTS conversations (
+                    id TEXT PRIMARY KEY,
+                    user_id TEXT NOT NULL,
+                    title TEXT DEFAULT 'New Conversation',
+                    summary TEXT DEFAULT '',
+                    language_pref TEXT DEFAULT 'bn',
+                    response_style TEXT DEFAULT 'technical-architect',
+                    created_at REAL NOT NULL,
+                    updated_at REAL NOT NULL,
+                    metadata_json TEXT
+                );
+                CREATE TABLE IF NOT EXISTS messages (
+                    id TEXT PRIMARY KEY,
+                    conversation_id TEXT NOT NULL REFERENCES conversations(id) ON DELETE CASCADE,
+                    user_id TEXT NOT NULL,
+                    role TEXT NOT NULL CHECK (role IN ('system','user','assistant')),
+                    content TEXT NOT NULL,
+                    provider TEXT DEFAULT 'supremeai-core',
+                    model TEXT DEFAULT 'auto',
+                    sequence_no INTEGER NOT NULL,
+                    created_at REAL NOT NULL,
+                    metadata_json TEXT DEFAULT '{}',
+                    CONSTRAINT uq_conv_sequence UNIQUE (conversation_id, sequence_no)
+                );
+                CREATE TABLE IF NOT EXISTS user_memories (
+                    id TEXT PRIMARY KEY,
+                    user_id TEXT NOT NULL,
+                    memory_key TEXT NOT NULL,
+                    memory_value TEXT NOT NULL,
+                    confidence REAL DEFAULT 0.95,
+                    source_conv_id TEXT,
+                    updated_at REAL NOT NULL,
+                    CONSTRAINT uq_user_memory_key UNIQUE (user_id, memory_key)
+                );
+                CREATE TABLE IF NOT EXISTS provider_attempts (
+                    id TEXT PRIMARY KEY,
+                    request_id TEXT NOT NULL,
+                    conversation_id TEXT NOT NULL,
+                    provider TEXT NOT NULL,
+                    model TEXT,
+                    status_code INTEGER NOT NULL,
+                    latency_ms INTEGER NOT NULL,
+                    error_message TEXT,
+                    created_at REAL NOT NULL
+                );
+                CREATE INDEX IF NOT EXISTS idx_msg_conv_seq ON messages(conversation_id, sequence_no);
+                CREATE INDEX IF NOT EXISTS idx_mem_user ON user_memories(user_id);
+                """
+            )
+    except Exception as exc:
+        logger.warning("Canonical DB init failed (%s); using in-memory fallback.", exc)
+        _FAILED_PATHS.add(db_path or _DB_PATH)
+
+
+init_db()
+
+
+class CanonicalMemoryStore:
+    def __init__(self, db_path=None):
+        self.db_path = db_path or _DB_PATH
+        if db_path:
+            init_db(self.db_path)
+
+    @contextmanager
+    def _conn(self):
+        with _db(self.db_path) as conn:
+            yield conn
+
+    def save_conversation(self, conversation_id, user_id="usr-admin-primary", title=None, summary=None, language_pref=None, response_style=None, metadata=None):
+        now = time.time()
+        with _LOCK:
+            with self._conn() as conn:
+                if conn is not None:
+                    conn.execute(
+                        """
+                        INSERT INTO conversations (id, user_id, title, summary, language_pref, response_style, created_at, updated_at, metadata_json)
+                        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
+                        ON CONFLICT(id) DO UPDATE SET
+                            title = COALESCE(excluded.title, conversations.title),
+                            summary = COALESCE(excluded.summary, conversations.summary),
+                            language_pref = COALESCE(excluded.language_pref, conversations.language_pref),
+                            response_style = COALESCE(excluded.response_style, conversations.response_style),
+                            updated_at = excluded.updated_at,
+                            metadata_json = COALESCE(excluded.metadata_json, conversations.metadata_json);
+                        """,
+                        (
+                            conversation_id,
+                            user_id,
+                            (title or "New Conversation")[:120],
+                            summary or "",
+                            language_pref or "bn",
+                            response_style or "technical-architect",
+                            now,
+                            now,
+                            json.dumps(metadata or {}),
+                        ),
+                    )
+                else:
+                    mem = _MEM["conversations"].setdefault(
+                        conversation_id,
+                        {
+                            "id": conversation_id,
+                            "user_id": user_id,
+                            "title": (title or "New Conversation")[:120],
+                            "summary": summary or "",
+                            "language_pref": language_pref or "bn",
+                            "response_style": response_style or "technical-architect",
+                            "created_at": now,
+                            "updated_at": now,
+                            "metadata": metadata or {},
+                            "messages": [],
+                        },
+                    )
+                    mem["updated_at"] = now
+                    if title:
+                        mem["title"] = title[:120]
+                    if summary is not None:
+                        mem["summary"] = summary
+            return {"id": conversation_id, "updated_at": now}
+
+    def get_conversation(self, conversation_id, user_id=None):
+        with _LOCK:
+            with self._conn() as conn:
+                if conn is not None:
+                    q = "SELECT * FROM conversations WHERE id = ?"
+                    params = [conversation_id]
+                    if user_id:
+                        q += " AND user_id = ?"
+                        params.append(user_id)
+                    row = conn.execute(q, params).fetchone()
+                    if not row:
+                        return None
+                    msgs = conn.execute(
+                        "SELECT * FROM messages WHERE conversation_id = ? ORDER BY sequence_no ASC, created_at ASC;",
+                        (conversation_id,),
+                    ).fetchall()
+                    messages = [
+                        {
+                            "id": m["id"],
+                            "conversation_id": m["conversation_id"],
+                            "user_id": m["user_id"],
+                            "role": m["role"],
+                            "content": m["content"],
+                            "provider": m["provider"],
+                            "model": m["model"],
+                            "sequence_no": m["sequence_no"],
+                            "created_at": m["created_at"],
+                            "metadata": json.loads(m["metadata_json"] or "{}"),
+                        }
+                        for m in msgs
+                    ]
+                    return {
+                        "id": row["id"],
+                        "user_id": row["user_id"],
+                        "title": row["title"],
+                        "summary": row["summary"],
+                        "language_pref": row["language_pref"],
+                        "response_style": row["response_style"],
+                        "created_at": row["created_at"],
+                        "updated_at": row["updated_at"],
+                        "metadata": json.loads(row["metadata_json"] or "{}"),
+                        "messages": messages,
+                    }
+                else:
+                    conv = _MEM["conversations"].get(conversation_id)
+                    if not conv:
+                        return None
+                    if user_id and conv.get("user_id") != user_id:
+                        return None
+                    return {
+                        **conv,
+                        "messages": list(conv.get("messages", [])),
+                    }
+
+    def get_recent_history(self, conversation_id, limit=10, user_id=None):
+        conv = self.get_conversation(conversation_id, user_id=user_id)
+        if not conv:
+            return []
+        msgs = conv.get("messages", [])
+        if limit and limit > 0:
+            msgs = msgs[-limit:]
+        return [dict(m) for m in msgs]
+
+    def _next_sequence(self, conn, conversation_id):
+        if conn is not None:
+            row = conn.execute(
+                "SELECT COALESCE(MAX(sequence_no), 0) AS mx FROM messages WHERE conversation_id = ?;",
+                (conversation_id,),
+            ).fetchone()
+            return int(row["mx"] or 0) + 1
+        msgs = _MEM["messages"].get(conversation_id, [])
+        if not msgs:
+            return 1
+        return max(m.get("sequence_no", 0) for m in msgs) + 1
+
+    def append_canonical_message(self, conversation_id, role, content, user_id="usr-admin-primary", provider="supremeai-core", model="auto", sequence_no=None, metadata=None, title=None):
+        if role not in ("system", "user", "assistant"):
+            raise ValueError(f"invalid role: {role}")
+        self.save_conversation(conversation_id, user_id=user_id, title=title)
+        now = time.time()
+        mid = "msg-" + uuid.uuid4().hex[:12]
+        with _LOCK:
+            with self._conn() as conn:
+                if conn is not None:
+                    if sequence_no is None:
+                        sequence_no = self._next_sequence(conn, conversation_id)
+                    conn.execute(
+                        """
+                        INSERT INTO messages (id, conversation_id, user_id, role, content, provider, model, sequence_no, created_at, metadata_json)
+                        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
+                        """,
+                        (mid, conversation_id, user_id, role, content, provider, model, sequence_no, now, json.dumps(metadata or {})),
+                    )
+                else:
+                    if conversation_id not in _MEM["messages"]:
+                        _MEM["messages"][conversation_id] = []
+                    if sequence_no is None:
+                        sequence_no = self._next_sequence(None, conversation_id)
+                    _MEM["messages"][conversation_id].append(
+                        {
+                            "id": mid,
+                            "conversation_id": conversation_id,
+                            "user_id": user_id,
+                            "role": role,
+                            "content": content,
+                            "provider": provider,
+                            "model": model,
+                            "sequence_no": sequence_no,
+                            "created_at": now,
+                            "metadata": metadata or {},
+                        }
+                    )
+        return {
+            "id": mid,
+            "conversation_id": conversation_id,
+            "user_id": user_id,
+            "role": role,
+            "content": content,
+            "provider": provider,
+            "model": model,
+            "sequence_no": sequence_no,
+            "created_at": now,
+            "metadata": metadata or {},
+        }
+
+    def get_user_durable_memories(self, user_id):
+        with _LOCK:
+            with self._conn() as conn:
+                if conn is not None:
+                    rows = conn.execute(
+                        "SELECT * FROM user_memories WHERE user_id = ? ORDER BY updated_at DESC;",
+                        (user_id,),
+                    ).fetchall()
+                    return [
+                        {
+                            "id": r["id"],
+                            "user_id": r["user_id"],
+                            "memory_key": r["memory_key"],
+                            "memory_value": r["memory_value"],
+                            "confidence": r["confidence"],
+                            "source_conv_id": r["source_conv_id"],
+                            "updated_at": r["updated_at"],
+                        }
+                        for r in rows
+                    ]
+                else:
+                    return [dict(m) for m in _MEM["user_memories"].get(user_id, [])]
+
+    def upsert_user_memory(self, user_id, memory_key, memory_value, confidence=0.95, source_conv_id=None):
+        now = time.time()
+        mid = "mem-" + uuid.uuid4().hex[:12]
+        with _LOCK:
+            with self._conn() as conn:
+                if conn is not None:
+                    conn.execute(
+                        """
+                        INSERT INTO user_memories (id, user_id, memory_key, memory_value, confidence, source_conv_id, updated_at)
+                        VALUES (?, ?, ?, ?, ?, ?, ?)
+                        ON CONFLICT(user_id, memory_key) DO UPDATE SET
+                            memory_value = excluded.memory_value,
+                            confidence = excluded.confidence,
+                            source_conv_id = COALESCE(excluded.source_conv_id, user_memories.source_conv_id),
+                            updated_at = excluded.updated_at;
+                        """,
+                        (mid, user_id, memory_key, memory_value, confidence, source_conv_id, now),
+                    )
+                else:
+                    items = _MEM["user_memories"].setdefault(user_id, [])
+                    items[:] = [m for m in items if m.get("memory_key") != memory_key]
+                    items.append(
+                        {
+                            "id": mid,
+                            "user_id": user_id,
+                            "memory_key": memory_key,
+                            "memory_value": memory_value,
+                            "confidence": confidence,
+                            "source_conv_id": source_conv_id,
+                            "updated_at": now,
+                        }
+                    )
+        return {
+            "id": mid,
+            "user_id": user_id,
+            "memory_key": memory_key,
+            "memory_value": memory_value,
+            "updated_at": now,
+        }
+
+    def log_provider_attempt(self, request_id, conversation_id, provider, status_code, latency_ms, model=None, error_message=None):
+        now = time.time()
+        aid = "pa-" + uuid.uuid4().hex[:12]
+        with _LOCK:
+            with self._conn() as conn:
+                if conn is not None:
+                    conn.execute(
+                        """
+                        INSERT INTO provider_attempts (id, request_id, conversation_id, provider, model, status_code, latency_ms, error_message, created_at)
+                        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);
+                        """,
+                        (aid, request_id, conversation_id, provider, model, status_code, latency_ms, error_message, now),
+                    )
+                else:
+                    _MEM["provider_attempts"].append(
+                        {
+                            "id": aid,
+                            "request_id": request_id,
+                            "conversation_id": conversation_id,
+                            "provider": provider,
+                            "model": model,
+                            "status_code": status_code,
+                            "latency_ms": latency_ms,
+                            "error_message": error_message,
+                            "created_at": now,
+                        }
+                    )
+
+    def update_conversation_summary(self, conversation_id, summary, user_id=None):
+        now = time.time()
+        with _LOCK:
+            with self._conn() as conn:
+                if conn is not None:
+                    q = "UPDATE conversations SET summary = ?, updated_at = ? WHERE id = ?"
+                    params = [summary, now, conversation_id]
+                    if user_id:
+                        q += " AND user_id = ?"
+                        params.append(user_id)
+                    conn.execute(q, params)
+                else:
+                    conv = _MEM["conversations"].get(conversation_id)
+                    if conv:
+                        conv["summary"] = summary
+                        conv["updated_at"] = now
+
+
+_DEFAULT_STORE = CanonicalMemoryStore()
+
+
+def get_recent_history(conversation_id, limit=10, user_id=None):
+    return _DEFAULT_STORE.get_recent_history(conversation_id, limit=limit, user_id=user_id)
+
+
+def get_user_durable_memories(user_id):
+    return _DEFAULT_STORE.get_user_durable_memories(user_id)
+
+
+def append_canonical_message(*args, **kwargs):
+    return _DEFAULT_STORE.append_canonical_message(*args, **kwargs)
+
+
+def log_provider_attempt(*args, **kwargs):
+    return _DEFAULT_STORE.log_provider_attempt(*args, **kwargs)
+
+
+def upsert_user_memory(*args, **kwargs):
+    return _DEFAULT_STORE.upsert_user_memory(*args, **kwargs)
+
+
+def update_conversation_summary(*args, **kwargs):
+    return _DEFAULT_STORE.update_conversation_summary(*args, **kwargs)
+
+
+MemoryStore = CanonicalMemoryStore
+memory_store = _DEFAULT_STORE
+
+__all__ = [
+    "CanonicalMemoryStore",
+    "MemoryStore",
+    "memory_store",
+    "get_recent_history",
+    "get_user_durable_memories",
+    "append_canonical_message",
+    "log_provider_attempt",
+    "upsert_user_memory",
+    "update_conversation_summary",
+]
