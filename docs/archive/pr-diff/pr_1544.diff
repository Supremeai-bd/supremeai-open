+    for marker, tier in (("p0", 0), ("p1", 1), ("p2", 2), ("p3", 3)):
+        if any(name == marker or name.startswith(marker + "-") or name.startswith(marker + " ") for name in names):
+            return PRIORITY_TIER_LABELS[tier]
+    return "P4"
