+  // key=value / key: value secret assignments (requires explicit = or :)
+  {
+    pattern: /\b(api[_-]?key|secret|token|password|passwd|pwd|credential)[\s"']*[:=]\s*["']?([A-Za-z0-9._~+/=-]{8,})/gi,
