index 7c5ac198..7a4383e9 100644
--- a/.github/workflows/pipeline.yml
+++ b/.github/workflows/pipeline.yml
@@ -363,10 +363,12 @@ jobs:
           TARGET_ISSUES=$(echo "$PR_TITLE $PR_BODY" | grep -ioE '(closes|fixes|resolves) #[0-9]+' | grep -oE '#[0-9]+' || true)
           BRANCH_ISSUES=$(echo "${{ github.head_ref }}" | grep -oE 'issue-?[0-9]+' | grep -oE '[0-9]+' | sed 's/^/#/' || true)
           ISSUES=$(printf "%s\n%s" "$TARGET_ISSUES" "$BRANCH_ISSUES" | grep -E '^#[0-9]+' | sort -u || true)
-          if [ -z "$ISSUES" ]; then
-            # Fallback to general issue references if no explicit target
-            ISSUES=$(echo "$PR_TITLE $PR_BODY" | grep -oE '#[0-9]+' | sort -u || true)
-          fi
+          # (#1764/#1777 fix) Claims ONLY ΓÇö mentions are not claims.
+          # The removed mention-fallback ("general issue references") turned
+          # every `#N` citation in a title/body into a task claim, causing
