+"""Official MCP Registry catalog sync for the mcp_plugins BYO flow (#1686).
+
+Read-only, cache-first source adapter for registry.modelcontextprotocol.io.
+A registry outage degrades to stale cached rows and never blocks the
+marketplace; only `streamable-http` remotes are offered for one-click
+connect (fail-closed); every row records its `$schema` version and records
+whose schema this module cannot validate are rejected at ingest; no
+auto-registration and no credential handling ever happen here (GET-only,
+stdlib-only, zero-credential).
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import re
+import sys
+import tempfile
+import urllib.error
+import urllib.request
+from dataclasses import dataclass, asdict
+from datetime import datetime, timezone
+from typing import Any, Callable, Dict, List, Optional, Tuple
+
+REGISTRY_BASE = "https://registry.modelcontextprotocol.io"
+SERVERS_PATH = "/v0/servers"          # /v0 verified live 2026-10-30 (scout R80); /v0.1 also serves
+PAGE_LIMIT = 100
+HTTP_TIMEOUT_S = 20
+UA = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
+      "(KHTML, like Gecko) Chrome/126.0 Safari/537.36")
+
+# $schema gate — records whose schema this module cannot validate are
+# REJECTED at ingest (fail-closed). Suffix match pins the schema VERSION,
+# so a new upstream revision is an explicit code change, not silent drift.
+ALLOWED_SCHEMA_SUFFIXES = ("/schemas/2025-12-11/server.schema.json",)
+
+# One-click connect transport gate: anything that is not EXACTLY this type
+# (sse, unknown, absent) is never offered — fail-closed per #1686.
+ONE_CLICK_REMOTE_TYPE = "streamable-http"
+
+TRUST_REPO_LINKED = "repo-linked"     # repository.url present -> provenance raw material for #1668
+TRUST_CATALOG_ONLY = "catalog-only"   # no repository -> human-approval lane per the census constraint
+
+CACHE_VERSION = 1
+
+
+class RegistryOutage(RuntimeError):
+    """Raised by the default fetcher on network/HTTP failure (sync degrades, callers never see this raise)."""
+
+
+# --------------------------------------------------------------------------- #
+# Normalization ($schema gate + transport gate + trust tier)
+# --------------------------------------------------------------------------- #
+
+def _meta_updated_at(record: Dict[str, Any], official_meta: Optional[Dict[str, Any]] = None) -> Optional[str]:
+    official = official_meta or {}
+    for cand in (record.get("updatedAt"), official.get("updatedAt"),
+                 official.get("statusChangedAt"), official.get("publishedAt")):
+        if isinstance(cand, str) and cand:
+            return cand
+    return None
+
+
+def _first_streamable_remote(record: Dict[str, Any]) -> Tuple[Optional[str], Optional[str], bool]:
+    """Return (url, type, one_click). Fail-closed: only EXACT type matches are offered."""
+    remotes = record.get("remotes")
+    if not isinstance(remotes, list):
+        return None, None, False
+    for r in remotes:
+        if not isinstance(r, dict):
+            continue
+        rtype = r.get("type")
+        url = r.get("url")
+        if rtype == ONE_CLICK_REMOTE_TYPE and isinstance(url, str) and url.startswith("https://"):
+            return url, rtype, True
+    return None, None, False
+
+
+def normalize(record: Any, official_meta: Optional[Dict[str, Any]] = None) -> Tuple[Optional[Dict[str, Any]], Optional[str]]:
+    """registry record -> normalized catalog row, or (None, reject_reason).
+
+    Accepts the live envelope's nested record plus its official metadata block
+    (status/updatedAt live under _meta.io.modelcontextprotocol.registry/official
+    on the wire) or a flat record for fixtures. Reject reasons (all
+    fail-closed, counted by the caller):
+      "not-an-object" | "no-name" | "schema-unknown" | "schema-missing".
+    """
+    if not isinstance(record, dict):
+        return None, "not-an-object"
+    name = record.get("name")
+    if not isinstance(name, str) or not name.strip():
+        return None, "no-name"
+    schema = record.get("$schema")
+    if not isinstance(schema, str) or not schema:
+        return None, "schema-missing"
+    if not any(schema.endswith(sfx) for sfx in ALLOWED_SCHEMA_SUFFIXES):
+        return None, "schema-unknown"
+    url, rtype, one_click = _first_streamable_remote(record)
+    repo = record.get("repository")
+    repo_url = repo.get("url") if isinstance(repo, dict) else None
+    tier = TRUST_REPO_LINKED if isinstance(repo_url, str) and repo_url else TRUST_CATALOG_ONLY
+    rid = record.get("id")
+    if not isinstance(rid, str) or not rid:
+        rid = "sha1:" + hashlib.sha1(name.encode("utf-8")).hexdigest()[:16]
+    row = {
+        "id": rid,
+        "name": name,
+        "description": record.get("description") if isinstance(record.get("description"), str) else "",
+        "version": record.get("version") if isinstance(record.get("version"), str) else "0",
+        "status": record.get("status") if isinstance(record.get("status"), str) else "unknown",
+        "schema_url": schema,
+        "remote_url": url,
+        "remote_type": rtype,
+        "one_click": one_click,
+        "trust_tier": tier,
+        "repository_url": repo_url if isinstance(repo_url, str) else None,
+        "updated_at": _meta_updated_at(record, official_meta),
+    }
+    return row, None
+
+
+def _page_items(page: Dict[str, Any]) -> List[Tuple[Dict[str, Any], Dict[str, Any]]]:
+    """Registry page -> [(record, official_meta)] — supports the live envelope
+    ({servers: [{server, _meta}]}, verified live 2026-10-30) and flat records."""
+    items = page.get("servers") if isinstance(page.get("servers"), list) else \
+        (page.get("records") if isinstance(page.get("records"), list) else [])
+    out: List[Tuple[Dict[str, Any], Dict[str, Any]]] = []
+    for it in items:
+        if isinstance(it, dict) and isinstance(it.get("server"), dict):
+            meta = it.get("_meta") or {}
+            official = meta.get("io.modelcontextprotocol.registry/official") \
+                if isinstance(meta, dict) else {}
+            out.append((it["server"], official if isinstance(official, dict) else {}))
+        elif isinstance(it, dict):
+            out.append((it, {}))
+    return out
+
+
+def _page_cursor(page: Dict[str, Any]) -> Optional[str]:
+    """Live pagination cursor lives at metadata.nextCursor (verified live)."""
+    md = page.get("metadata")
+    cur = md.get("nextCursor") if isinstance(md, dict) else None
+    return cur if isinstance(cur, str) and cur else None
+
+
+def watermark_of(rows: List[Dict[str, Any]]) -> Optional[str]:
+    """Max updatedAt across rows — the incremental-refresh cursor candidate."""
+    stamps = [r["updated_at"] for r in rows if r.get("updated_at")]
+    return max(stamps) if stamps else None
+
+
+# --------------------------------------------------------------------------- #
+# Fetch layer (GET-only, zero-credential, injectable for offline tests)
+# --------------------------------------------------------------------------- #
+
+FetchPage = Callable[[Optional[str], Optional[str]], Dict[str, Any]]
+
+
+def fetch_page_live(cursor: Optional[str], updated_since: Optional[str]) -> Dict[str, Any]:
+    """GET one page of {records, cursor}. GET-only by construction; no auth headers."""
+    params = [f"limit={PAGE_LIMIT}"]
+    if cursor:
+        params.append(f"cursor={urllib.request.quote(cursor, safe='')}")
+    if updated_since:
+        params.append(f"updated_since={urllib.request.quote(updated_since, safe='')}")
+    url = REGISTRY_BASE + SERVERS_PATH + "?" + "&".join(params)
+    req = urllib.request.Request(url, headers={"User-Agent": UA}, method="GET")  # GET-only: no auto-registration path exists
+    try:
+        with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT_S) as resp:
+            body = json.loads(resp.read().decode("utf-8", "replace"))
+    except urllib.error.HTTPError as exc:
+        raise RegistryOutage(f"registry HTTP {exc.code}") from exc
+    except Exception as exc:  # DNS, timeout, JSON — all degrade to stale-cache behavior upstream
+        raise RegistryOutage(f"registry unreachable: {exc.__class__.__name__}") from exc
+    if not isinstance(body, dict):
+        raise RegistryOutage("registry returned non-object page")
+    return body
+
+
+def probe_updated_since(fetch: FetchPage = fetch_page_live) -> bool:
+    """Verify registry-side updated_since filter support before committing to
+    incremental refresh (census constraint). 400/422 => unsupported."""
+    try:
+        fetch(None, "1970-01-01T00:00:00Z")
+        return True
+    except RegistryOutage as exc:
+        return "HTTP 400" in str(exc) or "HTTP 422" in str(exc)
+
+
+# --------------------------------------------------------------------------- #
+# Sync (cursor-exhaustion walk + atomic cache + outage degrade)
+# --------------------------------------------------------------------------- #
+
+def sync(cache_path: str, fetch: FetchPage = fetch_page_live,
+         max_pages: Optional[int] = None, updated_since: Optional[str] = None,
+         now: Optional[str] = None) -> Dict[str, Any]:
+    """Walk /v0/servers until the registry cursor is EXHAUSTED (the primary
+    termination condition — a max_pages cap is an explicit caller budget, not
+    the contract), normalize rows through the gates, and atomically replace
+    the cache. On a total outage the existing cache is left untouched and the
+    returned stats carry degraded=True (stale rows keep serving; the
+    marketplace is never blocked)."""
+    prev = load_cache(cache_path)
+    stats: Dict[str, Any] = {
+        "pages": 0, "fetched": 0, "accepted": 0,
+        "rejected_schema_missing": 0, "rejected_schema_unknown": 0,
+        "rejected_no_name": 0, "rejected_not_an_object": 0,
+        "one_click": 0, "repo_linked": 0, "catalog_only": 0,
+        "cursor_exhausted": False, "page_budget_capped": False,
+        "degraded": False, "degrade_reason": None,
+        "updated_since_requested": updated_since,
+    }
+    rows: List[Dict[str, Any]] = []
+    cursor: Optional[str] = None
+    while True:
+        try:
+            page = fetch(cursor, updated_since)
+        except RegistryOutage as exc:
+            if stats["pages"] == 0:
+                # Total outage with zero new pages: degrade to the stale cache.
+                stats["degraded"] = True
+                stats["degrade_reason"] = str(exc)
+                stats["cursor_exhausted"] = bool(prev and prev.get("stats", {}).get("cursor_exhausted"))
+                return finalize_sync(cache_path, prev.get("rows", []) if prev else [],
+                                     prev, stats, now=now, touch=False)
+            # Partial outage mid-walk: keep what was gathered, mark not-exhausted.
+            stats["degraded"] = True
+            stats["degrade_reason"] = str(exc) + " (mid-walk; resumable cursor kept)"
+            stats["cursor_exhausted"] = False
+            return finalize_sync(cache_path, rows, prev, stats, now=now)
+        stats["pages"] += 1
+        items = _page_items(page)
+        stats["fetched"] += len(items)
+        for rec, official in items:
+            row, reason = normalize(rec, official)
+            if row is None:
+                key = "rejected_" + (reason or "unknown").replace("-", "_")
+                stats[key] = stats.get(key, 0) + 1
+                continue
+            rows.append(row)
+            stats["accepted"] += 1
+            if row["one_click"]:
+                stats["one_click"] += 1
+            stats[row["trust_tier"].replace("-", "_")] += 1
+        cursor = _page_cursor(page)
+        if cursor is None:
+            stats["cursor_exhausted"] = True
+            break
+        if max_pages is not None and stats["pages"] >= max_pages:
+            stats["page_budget_capped"] = True
+            break
+    return finalize_sync(cache_path, rows, prev, stats, now=now)
+
+
+def finalize_sync(cache_path: str, rows: List[Dict[str, Any]],
+                  prev: Optional[Dict[str, Any]], stats: Dict[str, Any],
+                  now: Optional[str] = None, touch: bool = True) -> Dict[str, Any]:
+    doc = {
+        "version": CACHE_VERSION,
+        "generated_at": now or datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
+        "watermark": watermark_of(rows) or (prev or {}).get("watermark"),
+        "rows": rows,
+        "stats": stats,
+    }
+    if touch:
+        _atomic_write_json(cache_path, doc)
+    return {"cache": cache_path, "watermark": doc["watermark"], **stats}
+
+
+def _atomic_write_json(path: str, doc: Dict[str, Any]) -> None:
+    d = os.path.dirname(os.path.abspath(path)) or "."
+    os.makedirs(d, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(prefix=".registry_cache_", dir=d)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as fh:
+            json.dump(doc, fh, ensure_ascii=False, separators=(",", ":"))
+        os.replace(tmp, path)
+    finally:
+        if os.path.exists(tmp):
+            try:
+                os.remove(tmp)
+            except OSError:
+                pass
+
+
+def load_cache(cache_path: str) -> Optional[Dict[str, Any]]:
+    try:
+        with open(cache_path, "r", encoding="utf-8") as fh:
+            doc = json.load(fh)
+        return doc if isinstance(doc, dict) and isinstance(doc.get("rows"), list) else None
+    except Exception:
+        return None
+
+
+def load_rows(cache_path: str, max_age_s: Optional[int] = None,
+              now: Optional[datetime] = None) -> Tuple[List[Dict[str, Any]], Dict[str, Any]]:
+    """Cache-first read for the BYO listing: NEVER raises. A missing or corrupt
+    cache degrades to ([], degraded=True) — the marketplace renders empty
+    rather than erroring; a registry outage never reaches this path."""
+    doc = load_cache(cache_path)
+    if doc is None:
+        return [], {"degraded": True, "reason": "no-cache", "stale": False, "count": 0}
+    meta: Dict[str, Any] = {"degraded": False, "stale": False, "count": len(doc["rows"]),
+                            "watermark": doc.get("watermark"),
+                            "generated_at": doc.get("generated_at")}
+    if max_age_s is not None:
+        try:
+            gen = datetime.strptime(doc.get("generated_at", ""), "%Y-%m-%dT%H:%M:%SZ")
+            now = now or datetime.now(timezone.utc)
+            if (now - gen).total_seconds() > max_age_s:
+                meta["stale"] = True
+        except ValueError:
+            meta["stale"] = True
+    return doc["rows"], meta
+
+
+# --------------------------------------------------------------------------- #
+# Offline self-tests (deterministic fixtures — no network)
+# --------------------------------------------------------------------------- #
+
+def _rec(name="srv/a", schema="https://example.com/schemas/2025-12-11/server.schema.json",
+         remotes=None, repo=None, updated="2026-10-30T00:00:00Z", status="active", **over):
+    r = {"id": ("id-" + name.replace("/", "-")) if isinstance(name, str) else None,
+         "name": name, "description": "d", "version": "1.0.0",
+         "$schema": schema, "updatedAt": updated}
+    if remotes is not None:
+        r["remotes"] = remotes
+    if repo is not None:
+        r["repository"] = repo
+    r.update(over)
+    return r
+
+
+def _wrap(recs, next_cursor=None):
+    """Build a live-shaped registry page ({servers: [{server, _meta}], metadata:{nextCursor}})
+    from flat fixture records — mirrors the wire shape verified 2026-10-30."""
+    return {"servers": [
+                {"server": r,
+                 "_meta": {"io.modelcontextprotocol.registry/official": {
+                     "status": r.get("status", "active"),
+                     "updatedAt": r.get("updatedAt")}}}
+                for r in recs],
+            "metadata": {"nextCursor": next_cursor, "count": len(recs)}}
+
+
+def selftest() -> int:
+    checks: List[Tuple[str, bool]] = []
+
+    def ck(name, cond):
+        checks.append((name, bool(cond)))
+
+    # T1 schema gate: known schema accepted; unknown revision rejected; missing rejected.
+    row, why = normalize(_rec())
+    ck("T1a known-schema accepted", row is not None and why is None)
+    ck("T1b schema recorded per row", row and row["schema_url"].endswith("2025-12-11/server.schema.json"))
+    ck("T1c unknown revision rejected fail-closed",
+       normalize(_rec(schema=".../schemas/2099-01-01/server.schema.json")) == (None, "schema-unknown"))
+    ck("T1d missing schema rejected", normalize(_rec(schema=None)) == (None, "schema-missing"))
+    # T2 transport gate: only exact streamable-http offered; sse/unknown never.
+    row, _ = normalize(_rec(remotes=[{"type": "sse", "url": "https://x/sse"}]))
+    ck("T2a sse-only row one_click=False", row and row["one_click"] is False and row["remote_url"] is None)
+    row, _ = normalize(_rec(remotes=[{"type": "weird", "url": "https://x/w"}, {"type": "streamable-http", "url": "https://x/m"}]))
+    ck("T2b exact-type match offered", row and row["one_click"] and row["remote_url"] == "https://x/m")
+    row, _ = normalize(_rec(remotes=[{"type": "streamable-http", "url": "http://insecure/x"}]))
+    ck("T2c non-https streamable never offered (fail-closed)", row and not row["one_click"])
+    # T3 trust tiers (#1668 raw material).
+    ck("T3a repo-linked tier", normalize(_rec(repo={"url": "https://github.com/a/b"}))[0]["trust_tier"] == "repo-linked")
+    ck("T3b catalog-only tier", normalize(_rec())[0]["trust_tier"] == "catalog-only")
+    # T4 cursor-exhaustion walk: exhaustion is the termination condition.
+    pages = {None: _wrap([_rec("a"), _rec("b")], "c1"),
+             "c1": _wrap([_rec("c")], "c2"),
+             "c2": _wrap([], None)}
+    cache = os.path.join(tempfile.mkdtemp(), "cache.json")
+    st = sync(cache, fetch=lambda cur, us: pages[cur], now="2026-10-30T01:00:00Z")
+    ck("T4a walk ends at cursor exhaustion", st["cursor_exhausted"] and not st["page_budget_capped"])
+    ck("T4b all pages consumed", st["pages"] == 3 and st["accepted"] == 3)
+    # T5 watermark = max updatedAt, persisted and reusable as incremental cursor.
+    ck("T5a watermark persisted", st["watermark"] == "2026-10-30T00:00:00Z")
+    rows, meta = load_rows(cache)
+    ck("T5b cache-first load never raises", meta["count"] == 3 and not meta["degraded"])
+    # T6 page budget is an explicit caller cap, marked honestly.
+    st2 = sync(cache, fetch=lambda cur, us: pages[cur], max_pages=1, now="2026-10-30T01:01:00Z")
+    ck("T6 budget cap flagged, not exhausted", st2["page_budget_capped"] and not st2["cursor_exhausted"])
+    # T7 total outage => stale cache survives, degraded=True, marketplace unblocked.
+    before_rows, before_meta = load_rows(cache)
+    def boom(cur, us):
+        raise RegistryOutage("registry HTTP 503")
+    st3 = sync(cache, fetch=boom, now="2026-10-30T01:02:00Z")
+    rows3, meta3 = load_rows(cache)
+    ck("T7a outage degrades to stale rows", st3["degraded"] and rows3 == before_rows)
+    ck("T7b outage never blocks the caller", meta3["count"] == before_meta["count"])
+    # T8 missing/corrupt cache => empty listing, loud meta, still no raise.
+    rows4, meta4 = load_rows(os.path.join(tempfile.mkdtemp(), "absent.json"))
+    ck("T8a missing cache degrades empty", rows4 == [] and meta4["degraded"])
+    corrupt = os.path.join(tempfile.mkdtemp(), "c.json"); open(corrupt, "w").write("{nope")
+    ck("T8b corrupt cache degrades empty", load_rows(corrupt)[1]["degraded"])
+    # T9 incremental refresh: updated_since flows to the fetcher when supported.
+    seen = {}
+    def spy(cur, us):
+        seen["cursor"], seen["us"] = cur, us
+        return _wrap([_rec("inc", updated="2026-10-30T02:00:00Z")], None)
+    sync(cache, fetch=spy, updated_since="2026-10-30T00:00:00Z", now="2026-10-30T02:01:00Z")
+    ck("T9 watermark passed as updated_since", seen["us"] == "2026-10-30T00:00:00Z")
+    src = open(__file__, "r", encoding="utf-8").read()
+    # T10 static safety: GET-only, no credentials, no auto-registration surface
+    # (scan the implementation segment only — the selftest below mentions the
+    # guard literals by name, which would self-reference the check).
+    src_impl = src.split("def selftest", 1)[0]
+    ck("T10a GET-only fetch", 'method="GET"' in src_impl and 'method="POST"' not in src_impl)
+    ck("T10b no credential/auth surface", "Authorization" not in src_impl and "api_key" not in src_impl.lower())
+    ck("T10c never imports connection_registry (no auto-registration)", "connection_registry" not in src_impl)
+    # T11 reject accounting.
+    st11 = sync(os.path.join(tempfile.mkdtemp(), "r.json"),
+                fetch=lambda cur, us: _wrap([_rec("ok"), _rec(schema=None), _rec(name=None)], None),
+                now="2026-10-30T03:00:00Z")
+    ck("T11 rejects counted per reason", st11["rejected_schema_missing"] == 1 and st11["rejected_no_name"] == 1 and st11["accepted"] == 1)
+
+    failed = [n for n, ok in checks if not ok]
+    for n, ok in checks:
+        print(f"  {'PASS' if ok else 'FAIL'}  {n}")
+    print(f"selftest: {len(checks) - len(failed)}/{len(checks)} PASS" + (f"; FAILED: {failed}" if failed else ""))
+    return 0 if not failed else 1
+
+
+# --------------------------------------------------------------------------- #
+# CLI
+# --------------------------------------------------------------------------- #
+
+def main(argv: Optional[List[str]] = None) -> int:
+    p = argparse.ArgumentParser(description="Official MCP Registry catalog sync (read-only, cache-first, fail-closed; #1686)")
+    p.add_argument("--probe", action="store_true", help="zero-credential live capability probe (1 page + updated_since support)")
+    p.add_argument("--sync", action="store_true", help="walk the registry and refresh the cache")
+    p.add_argument("--rows", action="store_true", help="print normalized rows + meta from the cache (marketplace read path)")
+    p.add_argument("--cache", default=os.environ.get("SUPREMEAI_REGISTRY_CACHE", "cache/mcp_registry_catalog.json"))
+    p.add_argument("--max-pages", type=int, default=None, help="explicit caller budget; exhaustion remains the default contract")
+    p.add_argument("--updated-since", default=None, help="incremental refresh watermark (use with --sync)")
+    p.add_argument("--selftest", action="store_true", help="offline deterministic self-tests")
+    a = p.parse_args(argv)
+    if a.selftest:
+        return selftest()
+    if a.probe:
+        def one(cur, us):
+            return fetch_page_live(cur, us)
+        try:
+            page = one(None, None)
+            items = _page_items(page)
+            print(json.dumps({"registry": REGISTRY_BASE, "page1_records": len(items),
+                              "cursor_present": bool(_page_cursor(page)),
+                              "updated_since_supported": probe_updated_since(one)}, indent=1))
+            return 0
+        except RegistryOutage as exc:
+            print(json.dumps({"registry": REGISTRY_BASE, "degraded": True, "reason": str(exc)}, indent=1))
+            return 2
+    if a.sync:
+        st = sync(a.cache, max_pages=a.max_pages, updated_since=a.updated_since)
+        print(json.dumps(st, indent=1))
+        return 0
+    if a.rows:
+        rows, meta = load_rows(a.cache)
+        print(json.dumps({"meta": meta, "rows": rows}, ensure_ascii=False, indent=1))
+        return 0
+    p.print_help()
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
