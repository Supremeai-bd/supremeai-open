+export function extractRequiredReflectionFields(templateContent: string): string[] {
+  if (!templateContent.includes("## Reflection Evidence")) {
+    return [];
+  }
+  const fields: string[] = [];
+  if (/-\s+\*\*why:\*\*/.test(templateContent)) {
