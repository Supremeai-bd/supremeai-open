-# =============================================================================
-# SupremeAI Skill Package — bangla_voice (#540)
-# =============================================================================
-# Zero-Compute High-Fidelity Bangla Voice Service via Edge-TTS.
-# Synthesis is LEASED over the Microsoft Edge Neural TTS WebSocket protocol
-# by the optional `edge-tts` client — zero local model weights, zero GPU,
-# 0 MB memory bloat. Without the optional client the skill degrades LOUDLY
-# (VoiceServiceUnavailable), never silently.
-# =============================================================================
-
-apiVersion: supremeai.ai/v1
-kind: Skill
-metadata:
-  name: bangla-voice
-  title: Bangla Voice (Zero-Compute Edge Neural TTS)
-  version: 1.0.0
-  description: >-
-    High-fidelity Bangla speech synthesis for the omnichannel admin control
-    surface: audible runway status, critical alerts, and conversational voice
-    notes. Streams MP3 from the Edge Neural TTS WebSocket protocol with an
-    ephemeral SHA-256 cache eliminating redundant round-trips for repeated
-    phrases (e.g. "সিস্টেম সম্পূর্ণ স্বাভাবিক আছে").
-  labels:
-    domain: agent-orchestration
-    layer: tools-workers-sidecars
-    language: bn
-    zero-compute: "true"
-  upstream:
-    issue: "https://github.com/Supremeai-bd/supremeai-open/issues/540"
-    repository: Supremeai-bd/supremeai-command
-    architecture: docs/VOICE_SERVICE_ARCHITECTURE.md
-
-spec:
-  runtime: python3
-  entrypoint: src/services/voice_service.py
-  dependencies:
-    required: []            # stdlib-only core (boundary limit 5)
-    optional:
-      - name: edge-tts
-        version: ">=7.0.0"
-        install: pip3 install edge-tts
-        on_missing: fail_loud   # VoiceServiceUnavailable — never a silent stub
-
-  # ------------------------------------------------------------------ contract
-  contract:
-    function: speak_bangla
-    signature: "speak_bangla(text: str, voice: str = \"bn-BD-PradeepNeural\") -> bytes"
-    returns:
-      type: bytes
-      format: audio/mpeg
-      transport: streamed-chunks-assembled
-    errors:
-      - class: VoiceRequestError
-        when: empty/oversized text, unknown voice, malformed rate/pitch
-      - class: VoiceServiceUnavailable
-        when: optional edge-tts client not installed (loud degradation)
-      - class: VoiceSynthesisError
-        when: protocol failure, wall-clock timeout, zero-byte output
-
-  # ------------------------------------------------------------------- catalog
-  voices:
-    default: bn-BD-PradeepNeural
-    entries:
-      - id: bn-BD-PradeepNeural
-        gender: male
-        dialect: bn-BD
-        role: authoritative system broadcasts / status reports
-        aliases: [pradeep]
-      - id: bn-BD-NabanitaNeural
-        gender: female
-        dialect: bn-BD
-        role: interactive conversational assistant
-        aliases: [nabanita]
-      - id: bn-IN-BashkarNeural
-        gender: male
-        dialect: bn-IN
-        role: alternate dialect fallback
-        aliases: [bashkar]
-      - id: bn-IN-TanishaaNeural
-        gender: female
-        dialect: bn-IN
-        role: alternate dialect fallback
-        aliases: [tanishaa]
-    parameters:
-      rate:
-        pattern: '^[+-]\d{1,3}%$'
-        default: "+0%"
-        example: "+10%"
-      pitch:
-        pattern: '^[+-]\d{1,4}Hz$'
-        default: "+0Hz"
-        example: "+5Hz"
-      max_text_chars: 4000
-
-  # -------------------------------------------------------------------- cache
-  cache:
-    key: sha256(text | voice | rate | pitch)   # \x1f field separator
-    backends: [memory, temp]
-    defaults:
-      backend: memory
-      max_entries: 128
-      ttl_s: 3600
-    guarantees:
-      - hit is byte-equivalent to fresh synthesis (key covers all inputs)
-      - ephemeral by contract — never persisted, never a source of truth
-      - populated without a second network round-trip (buffered streaming)
-
-  # ------------------------------------------------------------------- wiring
-  telegram:
-    commands:
-      - /voice <text>     # on-demand Bangla voice note (superadmin only)
-      - /voiceon          # attach voice notes to /status summaries
-      - /voiceoff         # disable status voice notes
-    rbac: inherited (fail-closed superadmin gate fires before synthesis)
-
-  # ----------------------------------------------------------- verification
-  verification:
-    reflection: 'git grep -n "edge_tts\|bn-BD-PradeepNeural" src/'
-    boot_smoke: "python3 -c \"import edge_tts; print('Edge-TTS ready')\""
-    tests: python3 -m pytest tests/test_voice_service.py -v
-    minimum_passing: 8
-    suite_size: 33
