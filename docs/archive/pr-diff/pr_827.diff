-
-
-def _text_fields(rec):
-    out = []
-    for k in ("claim", "rationale", "uncertainty"):
-        if isinstance(rec.get(k), str):
-            out.append(rec[k])
-    for k in ("assumptions", "limitations", "counterarguments"):
-        v = rec.get(k)
-        if isinstance(v, list):
-            out += [x for x in v if isinstance(x, str)]
