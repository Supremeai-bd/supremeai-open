+                  <div className="bg-slate-900 rounded-sm" />
+                  <div className="bg-transparent" />
+                  <div className="bg-slate-900 rounded-sm" />
+                  <div className="bg-transparent" />
+                  <div className="bg-slate-900 rounded-sm" />
+                  <div className="bg-transparent" />
