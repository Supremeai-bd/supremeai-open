-    ports:
-      - "127.0.0.1:16686:16686" # Jaeger UI (loopback-only, same posture as prometheus/grafana)
-    networks:
-      - supremeai-network
-    logging:
-      driver: json-file
-      options:
-        max-size: "20m"
-        max-file: "3"
