-
-```typescript
-// Good: Explicit types, interfaces, async/await
-interface Agent {
-  id: string;
-  name: string;
-  status: AgentStatus;
-  createdAt: Date;
-}
-
-async function fetchAgent(id: string): Promise<Agent> {
