+        with self.assertRaises(srt.TrainError):
+            srt.plan_consolidation("core", (head,), ("core/x.py",),
+                                   last_synced=None, target_head=None)
+        with self.assertRaises(srt.TrainError):
+            srt.plan_consolidation("studio", (), ("studio/x.tsx",),
+                                   last_synced=None, target_head=None)
