+        parent = parents.get(cur)
+        if parent is None:
+            raise FreshnessViolation(
+                f"unknown SHA {cur[:8]} — cannot prove {head[:8]} descends from {base[:8]}"
+            )
+        seen.add(cur)
+        cur = parent
+    return True
