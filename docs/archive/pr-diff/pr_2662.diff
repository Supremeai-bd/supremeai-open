+def test_screen_handles_empty_and_none_without_raising():
+    for fn in (screen_scraped, screen_page):
+        for bad in (None, "", "   "):
+            res = fn(bad)  # type: ignore[arg-type]
+            assert res.is_injection is False
+            assert res.matched == []
+
