@@ -488,6 +488,45 @@ for line in $updates; do
         fi
     fi
 
+
+    # 14. PY-DEP CVE GUARD (#1969).
+    # Python dependency vulnerability ratchet over every tracked
+    # requirements*.txt manifest (pip-audit requirements mode, PyPA
+    # zero-credential SSOT). Engages ONLY when the push touches a
+    # requirements manifest. Shrink-only baseline
+    # (scripts/ci/py_dep_cve_baseline.json): a NEW advisory pair or a NEW
+    # advisory id fail-closes the push; resolved ids route to baseline-shrink
+    # hints. Skips-with-evidence when pip-audit is not installed or PyPI is
+    # unreachable (honest degradation, #1760 pattern). Self-contained under
+    # `set -u`.
+    if ! ZERO_TEST "$local_sha" && [ -f scripts/ci/py_dep_cve_guard.py ]; then
+        if ZERO_TEST "$remote_sha"; then
+            pydep_changed=$(git diff --name-only "refs/remotes/$remote_name/main...$local_sha" 2>/dev/null || git diff --name-only "origin/main...$local_sha" 2>/dev/null || true)
+        else
+            pydep_changed=$(git diff --name-only "$remote_sha..$local_sha" 2>/dev/null || true)
+        fi
+        pydep_surface=$(printf '%s\n' "$pydep_changed" | grep -E 'requirements[^/]*\.txt$' || true)
+        if [ -n "$pydep_surface" ]; then
+            hook_py=""
+            if python3 -c "import sys" >/dev/null 2>&1; then
+                hook_py="python3"
+            elif python -c "import sys" >/dev/null 2>&1; then
+                hook_py="python"
+            elif py -3 -c "import sys" >/dev/null 2>&1; then
+                hook_py="py -3"
+            fi
+            if [ -n "$hook_py" ]; then
+                if ! $hook_py scripts/ci/py_dep_cve_guard.py --files $pydep_surface; then
+                    reject "PY-DEP CVE GUARD (#1969) FAILED" \
+                        "The push introduces NEW Python dependency advisories on a requirements plane." \
+                        "Resolve it (pin/range bumps are maintainer decisions) or re-floor the baseline deliberately — the baseline may never grow." \
+                        "See the [py-dep-cve-guard] evidence lines above; pip-audit-absent or offline runs skip with evidence." \
+                        "Deliberate admin bypass: git push --no-verify."
+                fi
+            fi
+        fi
+    fi
+
     IFS="$nl"
 done
 IFS="$OIFS"
