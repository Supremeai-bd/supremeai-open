diff --git a/.github/workflows/merge-gate.yml b/.github/workflows/merge-gate.yml
new file mode 100644
index 00000000..3def450d
--- /dev/null
+++ b/.github/workflows/merge-gate.yml
@@ -0,0 +1,115 @@
+# =============================================================================
+# SupremeAI Open — Merge Gate (Autonomous Auto-Merge Doctrine)
+# =============================================================================
+# Zero-Admin Doctrine: Admin manual effort budget <= 0.01%.
+# When all constitutional gates and validation tests pass on a Pull Request:
+#   1. Open Guards (Branch Naming, Issue Reference, Anti-Duplicate Guard)
+#   2. CI Multi-Platform Python Matrix (3.10 - 3.13)
+#   3. Secret Scanning (Gitleaks)
+# This workflow automatically executes squash-merge and deletes the branch.
+# =============================================================================
+
+name: 🚦 Merge Gate (Autonomous Auto-Merge)
+
+on:
+  workflow_run:
+    workflows: ["CI — Open Multi-Platform Validation"]
+    types: [completed]
+  workflow_dispatch:
+    inputs:
+      pr_number:
+        description: "PR number to evaluate and auto-merge (optional)"
+        required: false
+
+permissions:
+  contents: write
+  pull-requests: write
+  issues: write
+
+concurrency:
+  group: merge-gate-open
+  cancel-in-progress: false
+
+jobs:
+  auto-merge:
+    name: "🛬 Autonomous Auto-Landing"
+    runs-on: ubuntu-latest
+    if: github.event_name == 'workflow_dispatch' || github.event.workflow_run.conclusion == 'success'
+    timeout-minutes: 5
+    steps:
+      - name: Determine Target PR
+        id: target_pr
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          DISPATCH_PR: ${{ github.event.inputs.pr_number }}
+        run: |
+          PR_NUM=""
+          if [ -n "$DISPATCH_PR" ]; then
+            PR_NUM="$DISPATCH_PR"
+          else
+            # Extract PR number from workflow_run payload or head branch
+            HEAD_BRANCH="${{ github.event.workflow_run.head_branch }}"
+            PR_NUM=$(gh pr list --repo "${{ github.repository }}" --head "$HEAD_BRANCH" --state open --json number -q '.[0].number')
+          fi
+
+          if [ -z "$PR_NUM" ] || [ "$PR_NUM" = "null" ]; then
+            echo "No open PR associated with this run (branch: ${{ github.event.workflow_run.head_branch }}). Skipping."
+            echo "has_pr=false" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+
+          echo "Found open PR #${PR_NUM}."
+          echo "pr_number=${PR_NUM}" >> "$GITHUB_OUTPUT"
+          echo "has_pr=true" >> "$GITHUB_OUTPUT"
+
+      - name: Evaluate Constitutional Gates & Auto-Merge
+        if: steps.target_pr.outputs.has_pr == 'true'
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          PR_NUM: ${{ steps.target_pr.outputs.pr_number }}
+        run: |
+          echo "Evaluating PR #${PR_NUM} for autonomous auto-merge..."
+          
+          # Fetch PR status and checks
+          PR_JSON=$(gh pr view "$PR_NUM" --repo "${{ github.repository }}" --json isDraft,mergeable,state,statusCheckRollup)
+          IS_DRAFT=$(echo "$PR_JSON" | jq -r '.isDraft')
+          MERGEABLE=$(echo "$PR_JSON" | jq -r '.mergeable')
+          STATE=$(echo "$PR_JSON" | jq -r '.state')
+
+          if [ "$STATE" != "OPEN" ]; then
+            echo "PR #${PR_NUM} is not open (state: $STATE). Skipping."
+            exit 0
+          fi
+
+          if [ "$IS_DRAFT" = "true" ]; then
+            echo "PR #${PR_NUM} is marked as draft. Skipping auto-merge."
+            exit 0
+          fi
+
+          if [ "$MERGEABLE" = "CONFLICTING" ]; then
+            echo "::error::PR #${PR_NUM} has merge conflicts. Cannot auto-merge."
+            gh pr comment "$PR_NUM" --repo "${{ github.repository }}" --body "## 🚦 Merge Gate — **BLOCKED**\n\nMerge conflicts detected against \`main\`. Please rebase and resolve conflicts."
+            exit 1
+          fi
+
+          # Verify all checks have passed (no failing or pending checks)
+          FAILING_CHECKS=$(echo "$PR_JSON" | jq -r '[.statusCheckRollup[]? | select(.conclusion == "FAILURE" or .conclusion == "TIMED_OUT")] | length')
+          if [ "$FAILING_CHECKS" -gt 0 ]; then
+            echo "::error::PR #${PR_NUM} has failing checks ($FAILING_CHECKS failures). Holding landing."
+            exit 1
+          fi
+
+          echo "✅ All required checks passed! Executing autonomous squash-merge..."
+          
+          gh pr merge "$PR_NUM" \
+            --repo "${{ github.repository }}" \
+            --squash \
+            --delete-branch \
+            --subject "Auto-merged PR #${PR_NUM} via Merge Gate"
+
+          # Post landing comment
+          gh pr comment "$PR_NUM" \
+            --repo "${{ github.repository }}" \
+            --body "## 🚦 Merge Gate — **LANDED** ✓\n\n- PR #${PR_NUM} met all constitutional gate contracts.\n- Auto-merged autonomously into \`main\` (Zero-Admin Policy, Admin Effort <= 0.01%)."
+
+          echo "✅ PR #${PR_NUM} successfully auto-merged."
