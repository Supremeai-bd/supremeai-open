+"""Docs-surface lockdown tests (route-inventory exposure residual, 2026-10-28).
+
+The gateway disables /docs and /redoc on both FastAPI apps, but left the
+``openapi_url`` default — so the live edge served the FULL OpenAPI route
+inventory (70 paths incl. admin route names) to unauthenticated callers at
+``GET /openapi.json`` (live-verified 200 + ~56KB on the deployed edge,
+2026-10-28T01:39Z boundary probe). These tests pin the completed lockdown:
+
+- gateway.main.create_app(): docs_url / redoc_url / openapi_url all None
+- gateway.service.app (the deployed satellite edge app): same triple pin
+- Behavior: GET /openapi.json, /docs, /redoc all 404 on a live TestClient
+
+The checked-in contract spec (api-schemas/gateway.openapi.yaml) and the CI
+codegen guards are unaffected — they read the static file, never the app's
+dynamic endpoint.
+"""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import pytest
+from fastapi.testclient import TestClient
+
+_GATEWAY_DIR = next(
+    (
+        p
+        for p in Path(__file__).resolve().parents
+        if (p / "main.py").is_file() and (p / "routing_policy.json").is_file()
+    ),
+    None,
+)
+if _GATEWAY_DIR is not None:
+    # Repo root ONLY (tests/conftest.py also does this). Never insert the
+    # gateway/ package dir itself: it forks gateway.service.* into duplicate
+    # module objects (split-brain singletons — drift class F-K). The laddered
+    # imports below fall back to gateway.* forms.
+    if str(_GATEWAY_DIR.parent) not in sys.path:
+        sys.path.insert(0, str(_GATEWAY_DIR.parent))
+
+try:
+    from tests.test_streaming_gateway import base_config
+except ImportError:
+    from gateway.tests.test_streaming_gateway import base_config
+
+try:
+    from main import create_app
+except ImportError:
+    from gateway.main import create_app
+
+
+def _assert_lockdown(app) -> None:
+    assert app.docs_url is None, "docs_url must stay disabled"
+    assert app.redoc_url is None, "redoc_url must stay disabled"
+    assert app.openapi_url is None, (
+        "openapi_url must be None — the default served the full route "
+        "inventory (incl. admin route names) to unauthenticated callers"
+    )
+
+
+def test_create_app_docs_surface_lockdown():
+    app = create_app(base_config())
+    _assert_lockdown(app)
+
+
+def test_satellite_edge_app_docs_surface_lockdown():
+    # The app the satellite Dockerfile actually serves
+    # (uvicorn gateway.service.app:app). Import is side-effect-light: all
+    # network clients are lazy (inside handlers).
+    try:
+        from gateway.service.app import app as edge_app
+    except ImportError:  # pragma: no cover - flat-layout satellites
+        from service.app import app as edge_app
+    _assert_lockdown(edge_app)
+
+
+def test_openapi_endpoint_behaves_404():
+    app = create_app(base_config())
+    client = TestClient(app)
+    for surface in ("/openapi.json", "/docs", "/redoc"):
+        resp = client.get(surface)
+        assert resp.status_code == 404, f"GET {surface} must be 404 after lockdown, got {resp.status_code}"
+
+
+if __name__ == "__main__":  # pragma: no cover
+    sys.exit(pytest.main([__file__]))
