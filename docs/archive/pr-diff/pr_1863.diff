+    # touches the contract or its generated surface (api-schemas/generated/).
+    # Regenerates the committed artifact with the pinned datamodel-codegen in
+    # a tempdir and byte-compares (CRLF-normalized): any drift = the contract
+    # changed without regenerating its consumer surface. Honest skip when the
+    # pinned binary is absent or the installed version differs from the pin.
+    # Self-contained under `set -u`; never touches the YAML or the artifact.
+    if ! ZERO_TEST "$local_sha" && [ -f scripts/ci/contract_codegen_guard.py ]; then
+        if ZERO_TEST "$remote_sha"; then
+            codegen_changed=$(git diff --name-only "refs/remotes/$remote_name/main...$local_sha" 2>/dev/null || git diff --name-only "origin/main...$local_sha" 2>/dev/null || true)
+        else
