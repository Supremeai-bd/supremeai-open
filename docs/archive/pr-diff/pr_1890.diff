-        "Format your response exactly as follows:\n\n"
-        "STEP 1: <reasoning>\n"
-        "STEP 2: <reasoning>\n"
-        "...\n"
-        "ANSWER: <final answer>\n"
-        "CONFIDENCE: <a float between 0.0 and 1.0>"
-    )
-
-    try:
-        response = await llm_gateway.acompletion(
-            messages=[
-                {"role": "system", "content": system_msg},
