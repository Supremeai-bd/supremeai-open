-        "monitoring": {"x": 400, "y": 450},
-        "secrets": {"x": 100, "y": 450},
-    }
-
-    # Create nodes
-    for svc in services:
-        pos = category_positions.get(svc.category, {"x": 300, "y": 300})
-        nodes.append(
-            {
-                "id": svc.name,
-                "label": svc.display_name,
-                "category": svc.category,
-                "status": svc.status.value,
-                "critical": svc.critical,
