-    """
-    user_id = str(token_payload.get("sub") or "")
-    redirect_uri = _build_github_redirect_uri()
-    expires_at = int(time.time()) + _OAUTH_STATE_TTL_SECONDS
-    state = _sign_oauth_state(user_id, expires_at)
-    params = {
