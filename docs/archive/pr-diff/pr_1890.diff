-def _get_websocket_base_url() -> str:
-    """Convert HTTP base URL to WebSocket URL."""
-    http_base = _get_public_base_url()
-    # Convert protocol: http -> ws, https -> wss
-    ws_base = http_base.replace("https://", "wss://").replace("http://", "ws://")
-    return ws_base
