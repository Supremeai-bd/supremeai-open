-def _format_timestamp(ts: str | None) -> str:
-    """Parse an ISO timestamp and return a human-readable string."""
-    if not ts:
-        return "Unknown time"
-    try:
-        dt = datetime.fromisoformat(ts)
-        return dt.strftime("%Y-%m-%d %H:%M:%S UTC")
-    except (ValueError, TypeError):
-        return ts
