-    try:
-        from datetime import datetime
-
-        embedding = get_embedding(summary)
-        supabase = _get_supabase()
-        now = datetime.now(UTC).isoformat()
-        record = {
-            "user_id": user_id,
-            "session_id": session_id,
-            "agent_type": agent_type,
-            "task_type": task_type,
-            "summary": summary,
-            "embedding": embedding,
-            "metadata": metadata or {},
-            "created_at": now,
-        }
-
-        if supabase:
-            try:
