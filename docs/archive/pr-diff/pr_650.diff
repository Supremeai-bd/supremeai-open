+        log("ℹ️", "Report-only mode: the tree is never mutated here (governance PRs "
+                 "intentionally carry constitution changes).")
+
+    _print_rule_version_and_checklist()
+    log("✅", "Rules loaded. Zero-Admin & Scope rules active.")
     return True
 
 
