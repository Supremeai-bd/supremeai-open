diff --git a/api-schemas/dashboard.schema.json b/api-schemas/dashboard.schema.json
new file mode 100644
index 00000000..d4c6b899
--- /dev/null
+++ b/api-schemas/dashboard.schema.json
@@ -0,0 +1,284 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://supremeai.ai/schemas/dashboard.schema.json",
+  "title": "SupremeAI Studio Dashboard — Federation Status & Live Agent Telemetry Contracts",
+  "description": "Layer-5 (Frontend & Client UI) contract for SupremeAI Studio: one DashboardSnapshot document carrying (a) DesignTokens — the dark-mode glassmorphism palette (hex colors + rgba glass surfaces), typography scale, radii and micro-animation motion values, so every rendered surface is token-driven rather than ad-hoc; (b) FederationStatus — per-repo health for the multi-repo federation (closed health/ci_status enums, open PR/issue counters, RFC 3339 last_sync); and (c) AgentTelemetryCard — live agent telemetry (closed state enum, progress 0-100, token spend, last_event instant). Design guidelines (fast/accessible/responsive) are normative here: renderers MUST honor prefers-reduced-motion (disable non-essential animation), MUST keep body text contrast >= 4.5:1 against the glass surface, MUST keep all interactive targets >= 44px, MUST be keyboard-operable with visible focus indicators, and MUST use a mobile-first fluid grid (single column < 640px, two columns >= 640px, three+ >= 1024px). Performance budget: first paint with zero third-party network requests (vanilla JS/CSS only, fonts system-stack). Fail-closed: enums are closed, counters bounded, instants carry an explicit RFC 3339 pattern (format is annotation-only in Draft 2020-12), and unknown fields are rejected everywhere (additionalProperties false). The reference renderer lives in examples/dashboard-preview/ (vanilla HTML/CSS/JS, zero dependencies) and validates its embedded snapshot against these constraints at boot, rendering a fail-closed error banner on any violation. See issue #24.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["schema_version", "generated_at", "tokens", "federation", "agents"],
+  "properties": {
+    "schema_version": {
+      "type": "string",
+      "pattern": "^\\d+\\.\\d+$",
+      "description": "Semantic version of this contract document."
+    },
+    "generated_at": {
+      "type": "string",
+      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?([Zz]|[+-]\\d{2}:\\d{2})$",
+      "description": "Snapshot instant, explicit RFC 3339 pattern (format is annotation-only in Draft 2020-12)."
+    },
+    "tokens": {
+      "$ref": "#/$defs/DesignTokens"
+    },
+    "federation": {
+      "$ref": "#/$defs/FederationStatus"
+    },
+    "agents": {
+      "type": "array",
+      "maxItems": 64,
+      "items": {
+        "$ref": "#/$defs/AgentTelemetryCard"
+      },
+      "description": "Live agent telemetry cards; bounded to keep render cost O(1) per frame budget."
+    }
+  },
+  "$defs": {
+    "DesignTokens": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "Token-driven design surface: renderers map these values 1:1 onto CSS custom properties. Colors are dark-mode-first; glass surfaces are rgba so the backdrop blur shows through.",
+      "required": ["color", "typography", "radius", "motion"],
+      "properties": {
+        "color": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": ["bg_base", "surface_glass", "surface_border", "text_primary", "text_secondary", "accent", "accent_soft", "success", "warning", "danger"],
+          "properties": {
+            "bg_base": {
+              "type": "string",
+              "pattern": "^#[0-9a-fA-F]{6}$",
+              "description": "Page background (near-black, dark mode first)."
+            },
+            "surface_glass": {
+              "type": "string",
+              "pattern": "^rgba\\((?:\\d{1,3}, ){2}\\d{1,3}, (?:0\\.\\d{1,3}|[01])\\)$",
+              "description": "Glass card surface: rgba(...) with alpha < 1 so backdrop-filter blur is visible."
+            },
+            "surface_border": {
+              "type": "string",
+              "pattern": "^rgba\\((?:\\d{1,3}, ){2}\\d{1,3}, (?:0\\.\\d{1,3}|[01])\\)$",
+              "description": "Hairline border of glass cards (rgba)."
+            },
+            "text_primary": {
+              "type": "string",
+              "pattern": "^#[0-9a-fA-F]{6}$",
+              "description": "Primary text; normative contrast >= 4.5:1 on surface_glass-over-bg_base."
+            },
+            "text_secondary": {
+              "type": "string",
+              "pattern": "^#[0-9a-fA-F]{6}$",
+              "description": "Secondary/muted text; normative contrast >= 4.5:1 for body, >= 3:1 for large text."
+            },
+            "accent": {
+              "type": "string",
+              "pattern": "^#[0-9a-fA-F]{6}$",
+              "description": "Primary accent (live states, progress, focus rings)."
+            },
+            "accent_soft": {
+              "type": "string",
+              "pattern": "^#[0-9a-fA-F]{6}$",
+              "description": "Soft accent for gradients and glows."
+            },
+            "success": {
+              "type": "string",
+              "pattern": "^#[0-9a-fA-F]{6}$",
+              "description": "Healthy/passing status."
+            },
+            "warning": {
+              "type": "string",
+              "pattern": "^#[0-9a-fA-F]{6}$",
+              "description": "Degraded/waiting status."
+            },
+            "danger": {
+              "type": "string",
+              "pattern": "^#[0-9a-fA-F]{6}$",
+              "description": "Down/failing/error status."
+            }
+          }
+        },
+        "typography": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": ["font_sans", "font_mono", "scale"],
+          "properties": {
+            "font_sans": {
+              "type": "string",
+              "minLength": 1,
+              "description": "System sans stack (zero network font requests)."
+            },
+            "font_mono": {
+              "type": "string",
+              "minLength": 1,
+              "description": "System mono stack for ids, counters, code."
+            },
+            "scale": {
+              "type": "array",
+              "minItems": 3,
+              "items": {
+                "type": "object",
+                "additionalProperties": false,
+                "required": ["token", "size"],
+                "properties": {
+                  "token": {
+                    "type": "string",
+                    "pattern": "^[a-z][a-z0-9-]{1,31}$",
+                    "description": "Type-scale token name (e.g. display, title, body, caption)."
+                  },
+                  "size": {
+                    "type": "string",
+                    "pattern": "^\\d+(\\.\\d+)?(px|rem)$",
+                    "description": "Font size in px or rem."
+                  }
+                }
+              },
+              "description": "Ordered type scale tokens."
+            }
+          }
+        },
+        "radius": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": ["sm", "md", "lg"],
+          "properties": {
+            "sm": {
+              "type": "string",
+              "pattern": "^\\d+(px|rem)$"
+            },
+            "md": {
+              "type": "string",
+              "pattern": "^\\d+(px|rem)$"
+            },
+            "lg": {
+              "type": "string",
+              "pattern": "^\\d+(px|rem)$"
+            }
+          }
+        },
+        "motion": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": ["duration_fast", "duration_base", "easing"],
+          "properties": {
+            "duration_fast": {
+              "type": "string",
+              "pattern": "^\\d+ms$",
+              "description": "Hover/focus micro-animation duration."
+            },
+            "duration_base": {
+              "type": "string",
+              "pattern": "^\\d+ms$",
+              "description": "Card enter/state-change duration."
+            },
+            "easing": {
+              "type": "string",
+              "pattern": "^(ease|ease-in|ease-out|ease-in-out|linear|cubic-bezier\\([0-9.]+, [0-9.]+, [0-9.]+, [0-9.]+\\))$",
+              "description": "Standard easing curve; renderers MUST disable non-essential motion under prefers-reduced-motion."
+            }
+          }
+        }
+      }
+    },
+    "FederationStatus": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "Multi-repo federation health for the status board.",
+      "required": ["repos"],
+      "properties": {
+        "repos": {
+          "type": "array",
+          "minItems": 1,
+          "maxItems": 128,
+          "items": {
+            "$ref": "#/$defs/FederationRepo"
+          }
+        }
+      }
+    },
+    "FederationRepo": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "One federated repository's dashboard status.",
+      "required": ["name", "health", "ci_status", "open_prs", "open_issues", "last_sync"],
+      "properties": {
+        "name": {
+          "type": "string",
+          "pattern": "^[A-Za-z0-9_.-]{1,100}$",
+          "description": "Repository name (owner/repo or bare name)."
+        },
+        "health": {
+          "enum": ["healthy", "degraded", "down", "unknown"],
+          "description": "Closed health vocabulary; unknown is a valid state (fail-honest), not an error."
+        },
+        "ci_status": {
+          "enum": ["passing", "failing", "running", "unknown"],
+          "description": "Closed CI vocabulary."
+        },
+        "open_prs": {
+          "type": "integer",
+          "minimum": 0,
+          "maximum": 10000
+        },
+        "open_issues": {
+          "type": "integer",
+          "minimum": 0,
+          "maximum": 10000
+        },
+        "last_sync": {
+          "type": "string",
+          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?([Zz]|[+-]\\d{2}:\\d{2})$",
+          "description": "Last federation sync instant, explicit RFC 3339 pattern."
+        }
+      }
+    },
+    "AgentTelemetryCard": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "One live agent telemetry card. Vocabulary aligns with the telemetry-log and websocket-events contracts.",
+      "required": ["agent_id", "state", "progress", "tokens_used", "last_event"],
+      "properties": {
+        "agent_id": {
+          "type": "string",
+          "pattern": "^agent-[a-zA-Z0-9_-]{1,64}$",
+          "description": "Agent identity (same vocabulary as telemetry-log.schema.json)."
+        },
+        "state": {
+          "enum": ["working", "waiting", "blocked", "done", "error"],
+          "description": "Closed agent state; drives card accent and the live pulse."
+        },
+        "task_id": {
+          "type": "string",
+          "maxLength": 128,
+          "description": "Current task, if any."
+        },
+        "current_issue": {
+          "type": "string",
+          "maxLength": 256,
+          "description": "Human-readable current objective (e.g. issue title)."
+        },
+        "progress": {
+          "type": "integer",
+          "minimum": 0,
+          "maximum": 100,
+          "description": "Task progress percentage; drives the progress bar."
+        },
+        "tokens_used": {
+          "type": "integer",
+          "minimum": 0,
+          "maximum": 100000000,
+          "description": "Cumulative token spend for this agent."
+        },
+        "events_per_min": {
+          "type": "number",
+          "minimum": 0,
+          "maximum": 10000,
+          "description": "Recent event throughput (live-ness indicator)."
+        },
+        "last_event": {
+          "type": "string",
+          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?([Zz]|[+-]\\d{2}:\\d{2})$",
+          "description": "Last event instant, explicit RFC 3339 pattern."
+        }
+      }
+    }
+  }
+}
diff --git a/examples/dashboard-preview/index.css b/examples/dashboard-preview/index.css
new file mode 100644
index 00000000..85b71cc6
--- /dev/null
+++ b/examples/dashboard-preview/index.css
@@ -0,0 +1,353 @@
+/*
+  SupremeAI Studio — Dashboard Preview styles (issue #24).
+  Token-driven dark glassmorphism. Every token below mirrors
+  api-schemas/dashboard.schema.json $defs.DesignTokens 1:1 — the schema is the
+  SSOT; this file is the reference mapping onto CSS custom properties.
+
+  Normative guidelines (see schema description + index.html header):
+  contrast >= 4.5:1 body text · 44px interactive targets · :focus-visible rings
+  · prefers-reduced-motion kills non-essential animation · mobile-first grid.
+*/
+
+:root {
+  /* color tokens ($defs.DesignTokens.color) */
+  --bg-base: #0a0f0d;
+  --surface-glass: rgba(22, 32, 27, 0.55);
+  --surface-border: rgba(148, 233, 194, 0.14);
+  --text-primary: #eef7f2;
+  --text-secondary: #9db8ab;
+  --accent: #10b981;
+  --accent-soft: #2dd4bf;
+  --success: #34d399;
+  --warning: #f59e0b;
+  --danger: #f87171;
+
+  /* typography tokens */
+  --font-sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
+  --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  --size-display: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem);
+  --size-title: clamp(1.05rem, 0.95rem + 0.5vw, 1.3rem);
+  --size-body: 0.95rem;
+  --size-caption: 0.78rem;
+
+  /* radius tokens */
+  --radius-sm: 8px;
+  --radius-md: 14px;
+  --radius-lg: 22px;
+
+  /* motion tokens (reduced-motion disables the showy ones) */
+  --duration-fast: 140ms;
+  --duration-base: 320ms;
+  --easing: cubic-bezier(0.22, 1, 0.36, 1);
+}
+
+* { box-sizing: border-box; }
+
+html { color-scheme: dark; }
+
+body {
+  margin: 0;
+  min-height: 100vh;
+  display: flex;
+  flex-direction: column;
+  background:
+    radial-gradient(1100px 500px at 85% -10%, rgba(45, 212, 191, 0.10), transparent 60%),
+    radial-gradient(900px 480px at -10% 110%, rgba(16, 185, 129, 0.08), transparent 55%),
+    var(--bg-base);
+  color: var(--text-primary);
+  font-family: var(--font-sans);
+  font-size: var(--size-body);
+  line-height: 1.55;
+  -webkit-font-smoothing: antialiased;
+}
+
+/* ---------- accessibility primitives ---------- */
+
+.skip-link {
+  position: absolute;
+  left: -9999px;
+  top: 0;
+  padding: 12px 18px;
+  border-radius: 0 0 var(--radius-sm) 0;
+  background: var(--accent);
+  color: #052e21;
+  font-weight: 700;
+  z-index: 10;
+}
+.skip-link:focus { left: 0; }
+
+:focus-visible {
+  outline: 2px solid var(--accent-soft);
+  outline-offset: 2px;
+  border-radius: var(--radius-sm);
+}
+
+/* ---------- top bar ---------- */
+
+.topbar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  flex-wrap: wrap;
+  padding: 18px clamp(16px, 4vw, 40px);
+  border-bottom: 1px solid var(--surface-border);
+  background: linear-gradient(180deg, rgba(22, 32, 27, 0.75), rgba(22, 32, 27, 0.35));
+  backdrop-filter: blur(14px);
+  -webkit-backdrop-filter: blur(14px);
+}
+
+.brand { display: flex; align-items: center; gap: 12px; }
+
+.brand-mark {
+  display: grid;
+  place-items: center;
+  width: 44px;
+  height: 44px;
+  border-radius: var(--radius-md);
+  border: 1px solid var(--surface-border);
+  background: linear-gradient(135deg, rgba(16, 185, 129, 0.25), rgba(45, 212, 191, 0.10));
+  color: var(--accent-soft);
+  font-size: 1.25rem;
+}
+
+.brand-name {
+  margin: 0;
+  font-size: var(--size-title);
+  font-weight: 800;
+  letter-spacing: 0.01em;
+}
+.brand-name span { color: var(--accent); }
+
+.brand-sub {
+  margin: 0;
+  font-size: var(--size-caption);
+  color: var(--text-secondary);
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.topbar-status { display: flex; align-items: center; gap: 12px; }
+
+.pill {
+  min-height: 44px;
+  display: inline-flex;
+  align-items: center;
+  padding: 6px 16px;
+  border-radius: 999px;
+  border: 1px solid var(--surface-border);
+  background: var(--surface-glass);
+  font-size: var(--size-caption);
+  font-weight: 700;
+  letter-spacing: 0.14em;
+  color: var(--accent-soft);
+}
+
+.live-dot {
+  width: 10px;
+  height: 10px;
+  border-radius: 50%;
+  background: var(--accent);
+  box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.5);
+  animation: pulse 2.2s var(--easing) infinite;
+}
+
+@keyframes pulse {
+  0%   { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.45); }
+  70%  { box-shadow: 0 0 0 12px rgba(16, 185, 129, 0); }
+  100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
+}
+
+.clock {
+  font-family: var(--font-mono);
+  font-size: var(--size-caption);
+  color: var(--text-secondary);
+  min-width: 9ch;
+}
+
+/* ---------- filters ---------- */
+
+.filters {
+  display: flex;
+  gap: 10px;
+  flex-wrap: wrap;
+  padding: 14px clamp(16px, 4vw, 40px);
+}
+
+.filter {
+  min-height: 44px;
+  padding: 8px 18px;
+  border-radius: 999px;
+  border: 1px solid var(--surface-border);
+  background: var(--surface-glass);
+  color: var(--text-secondary);
+  font: inherit;
+  font-size: var(--size-caption);
+  font-weight: 600;
+  cursor: pointer;
+  transition: color var(--duration-fast) var(--easing),
+              border-color var(--duration-fast) var(--easing),
+              transform var(--duration-fast) var(--easing);
+}
+.filter:hover { color: var(--text-primary); transform: translateY(-1px); }
+.filter.is-active {
+  color: #052e21;
+  background: var(--accent);
+  border-color: var(--accent);
+}
+
+/* ---------- layout & cards ---------- */
+
+.layout {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  gap: 28px;
+  width: 100%;
+  max-width: 1180px;
+  margin: 0 auto;
+  padding: 8px clamp(16px, 4vw, 40px) 36px;
+}
+
+.section-title {
+  margin: 0 0 14px;
+  font-size: var(--size-title);
+  font-weight: 700;
+  display: flex;
+  align-items: baseline;
+  gap: 10px;
+}
+
+.count {
+  font-family: var(--font-mono);
+  font-size: var(--size-caption);
+  color: var(--text-secondary);
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: 1fr;
+  gap: 16px;
+}
+@media (min-width: 640px)  { .grid { grid-template-columns: repeat(2, 1fr); } }
+@media (min-width: 1024px) { .grid { grid-template-columns: repeat(3, 1fr); } }
+
+.card {
+  position: relative;
+  padding: 18px;
+  border-radius: var(--radius-lg);
+  border: 1px solid var(--surface-border);
+  background: var(--surface-glass);
+  backdrop-filter: blur(16px) saturate(1.15);
+  -webkit-backdrop-filter: blur(16px) saturate(1.15);
+  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
+  transition: transform var(--duration-base) var(--easing),
+              border-color var(--duration-base) var(--easing);
+  animation: rise var(--duration-base) var(--easing) both;
+}
+.card:hover {
+  transform: translateY(-4px);
+  border-color: rgba(148, 233, 194, 0.30);
+}
+
+@keyframes rise {
+  from { opacity: 0; transform: translateY(10px); }
+  to   { opacity: 1; transform: translateY(0); }
+}
+
+.card-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  margin-bottom: 10px;
+}
+
+.card-title {
+  margin: 0;
+  font-size: var(--size-body);
+  font-weight: 700;
+  font-family: var(--font-mono);
+  word-break: break-all;
+}
+
+.badge {
+  flex-shrink: 0;
+  padding: 4px 12px;
+  min-height: 24px;
+  display: inline-flex;
+  align-items: center;
+  border-radius: 999px;
+  font-size: var(--size-caption);
+  font-weight: 700;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  border: 1px solid transparent;
+}
+.badge.healthy, .badge.passing, .badge.done    { color: var(--success); border-color: rgba(52, 211, 153, 0.4);  background: rgba(52, 211, 153, 0.10); }
+.badge.degraded, .badge.waiting, .badge.running, .badge.unknown,
+.badge.working                                  { color: var(--accent-soft); border-color: rgba(45, 212, 191, 0.4); background: rgba(45, 212, 191, 0.10); }
+.badge.warning                                  { color: var(--warning); border-color: rgba(245, 158, 11, 0.45); background: rgba(245, 158, 11, 0.10); }
+.badge.down, .badge.failing, .badge.error, .badge.blocked
+                                                { color: var(--danger); border-color: rgba(248, 113, 113, 0.45); background: rgba(248, 113, 113, 0.10); }
+
+.card-line {
+  display: flex;
+  justify-content: space-between;
+  gap: 12px;
+  font-size: var(--size-caption);
+  color: var(--text-secondary);
+  padding: 3px 0;
+}
+.card-line .mono { color: var(--text-primary); }
+
+.progress {
+  margin-top: 12px;
+  height: 8px;
+  border-radius: 999px;
+  background: rgba(148, 233, 194, 0.12);
+  overflow: hidden;
+}
+.progress-bar {
+  height: 100%;
+  border-radius: 999px;
+  background: linear-gradient(90deg, var(--accent), var(--accent-soft));
+  transition: width var(--duration-base) var(--easing);
+}
+
+/* ---------- error banner (fail-closed) ---------- */
+
+.error-banner {
+  padding: 16px 18px;
+  border-radius: var(--radius-md);
+  border: 1px solid rgba(248, 113, 113, 0.5);
+  background: rgba(248, 113, 113, 0.12);
+  color: #ffd9d9;
+  font-weight: 600;
+}
+
+/* ---------- footer (sticky) ---------- */
+
+.footer {
+  margin-top: auto;
+  padding: 18px clamp(16px, 4vw, 40px);
+  padding-bottom: calc(18px + env(safe-area-inset-bottom, 0px));
+  border-top: 1px solid var(--surface-border);
+  background: rgba(22, 32, 27, 0.5);
+  backdrop-filter: blur(10px);
+  -webkit-backdrop-filter: blur(10px);
+  font-size: var(--size-caption);
+  color: var(--text-secondary);
+}
+.footer p { margin: 2px 0; }
+.footer a { color: var(--accent-soft); }
+.footer-dim { opacity: 0.7; }
+
+.mono { font-family: var(--font-mono); }
+
+/* ---------- reduced motion (normative) ---------- */
+
+@media (prefers-reduced-motion: reduce) {
+  .live-dot, .card { animation: none; }
+  * { transition-duration: 0.01ms !important; }
+}
