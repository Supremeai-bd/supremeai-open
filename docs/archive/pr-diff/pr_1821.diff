diff --git a/.gitleaks.toml b/.gitleaks.toml
index 447ee752..7493d58f 100644
--- a/.gitleaks.toml
+++ b/.gitleaks.toml
@@ -89,9 +89,9 @@ paths = ['''^\.gitleaksignore$''']
 [[rules]]
 id = "supremeai-cloudflare-api-token"
 description = "Cloudflare API token (40-char base62, keyed by name)"
-# NOTE: Go/RE2 has no lookahead — use word-boundary semantics (same approach
-# as the upstream Cloudflare rule) to prevent over-extended matches.
-regex = '''(?i)\b[A-Za-z0-9_-]{40}\b'''
+# NOTE: Go/RE2 has no lookahead. Require token assignment or auth header context to
+# prevent false positives on arbitrary 40-char strings (e.g. git commit SHAs, markdown filenames).
+regex = '''(?i)(?:cloudflare|x-auth-bearer|api_token|CLOUDFLARE_API_TOKEN)[\s=:_'"-]{1,15}[A-Za-z0-9_-]{40}'''
 keywords = ["cloudflare", "x-auth-bearer", "api_token", "CLOUDFLARE_API"]
 [rules.allowlist]
 paths = ['''^\.gitleaksignore$''', '''^docs/FEDERATION_MATHEMATICAL_MODEL_AND_INVENTORY\.md$''']
