+  normalizeBackendUrl(process.env.VITE_API_URL) ||
+  normalizeBackendUrl(process.env.VITE_BACKEND_URL) ||
+  normalizeBackendUrl(process.env.VITE_USER_BACKEND) ||
+  normalizeBackendUrl(process.env.RENDER_SERVICE_URL) ||
