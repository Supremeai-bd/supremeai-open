+          buildType: 'unified', // single frontend build (no portal split)
+          userBackendUrl: USER_BACKEND,
+          adminBackendUrl: ADMIN_BACKEND || USER_BACKEND,
+          coopHeader: process.env.COOP_HEADER,
+          coepHeader: process.env.COEP_HEADER,
+        }
