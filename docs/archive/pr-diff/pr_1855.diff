-#### স্থায়ী প্রকৌশল সমাধান (Round-Robin Worker Pool):
-
-```python
-class WebSessionPoolRouter:
-    """Manages a fleet of isolated browser contexts for true concurrent multi-account routing."""
-
-    def __init__(self, contexts: list[BrowserContext]):
-        self.workers = [
-            {"id": i, "ctx": ctx, "busy": False, "lock": asyncio.Lock()}
-            for i, ctx in enumerate(contexts)
-        ]
-        self._queue = asyncio.Queue()
-
-    async def execute_chat(self, prompt: str) -> str:
-        idle_worker = None
-        for w in self.workers:
-            if not w["busy"]:
-                idle_worker = w
-                break
-
-        if not idle_worker:
-            idle_worker = await self._queue.get()
-
-        idle_worker["busy"] = True
-        try:
-            async with idle_worker["lock"]:
-                page = idle_worker["ctx"].pages[0]
-                return await self._dispatch_prompt(page, prompt)
-        finally:
-            idle_worker["busy"] = False
-            self._queue.put_nowait(idle_worker)
-```
