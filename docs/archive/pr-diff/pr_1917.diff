+def test_loopback_sign_verify(probe):
+    out = probe.stage_loopback()
+    assert out["pass"] is True
+    assert out["verified"] is True
+    assert "@authority" in out["covered_components"]
+    assert "signature-agent" in out["covered_components"]
+
