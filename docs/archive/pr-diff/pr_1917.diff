+#!/usr/bin/env python3
+"""Web Bot Auth explorer-lane probe (IETF WEBBOTAUTH WG).
+
+বাংলা: এটি supremeai-browser স্যাটেলাইটের explorer-lane প্রোব — stealth বিকল্প
+নয়, পরিপূরক। IETF Web Bot Auth (draft-ietf-webbotauth-httpsig-protocol-00)
+অনুযায়ী Ed25519 (RFC 8032) দিয়ে আউটবাউন্ড HTTP রিকোয়েস্ট ক্রিপ্টোগ্রাফিকভাবে
+সাইন করা যায় এবং /.well-known/http-message-signatures-directory-তে JWKS
+কী-ডিরেক্টরি প্রকাশ করা যায়। এই প্রোব কোনো রানটাইম আচরণ বদলায় না — শুধু
+পরিমাপ করে প্রমাণ ফেরত দেয় (কোনো নেটওয়ার্ক লেনদেন ছাড়া সম্পূর্ণ অফলাইন
+সেলফটেস্ট চালানো যায়)।
+
+Sub-commands:
+  selftest   Reproduce the draft's Ed25519 test vectors offline (deterministic).
+  keygen     Generate a fresh Ed25519 keypair, JWK + RFC 8037 thumbprint.
+  directory  Build a self-signed key directory (possession proof, Appendix B).
+  loopback   Sign a synthetic request, then verify it against the directory.
+  live       Sign a request with the published RFC 9421 test key and probe the
+             Cloudflare Research verification endpoint (network required).
+  all        selftest -> keygen -> directory -> loopback -> live (default).
+
+Exit code 0 = every executed check passed. Evidence JSON is printed to stdout
+(or written to --out). Network failures in `live` are reported honestly as
+errors — never fabricated as success.
+
+Dependencies: Python >= 3.10, `cryptography` (already a declared dependency of
+the supremeai-browser satellite in browser/pyproject.toml — zero new deps).
+Reference: https://datatracker.ietf.org/doc/draft-ietf-webbotauth-httpsig-protocol/
+"""
+from __future__ import annotations
+
+import argparse
+import base64
+import hashlib
+import json
+import os
+import secrets
+import socket
+import sys
+import time
+import urllib.error
+import urllib.request
+from datetime import datetime, timezone
+from typing import Any
+
+from cryptography.hazmat.primitives.asymmetric.ed25519 import (
+    Ed25519PrivateKey,
+    Ed25519PublicKey,
+)
+from cryptography.hazmat.primitives.serialization import (
+    Encoding,
+    PrivateFormat,
+    PublicFormat,
+    NoEncryption,
+)
+
+DEMO_ORIGIN = "https://http-message-signatures-example.research.cloudflare.com"
+DIRECTORY_PATH = "/.well-known/http-message-signatures-directory"
+DIRECTORY_MEDIA_TYPE = "application/http-message-signatures-directory+json"
+
+#: Published RFC 9421 Appendix B.1.4 Ed25519 test key (test-key-ed25519).
+#: PUBLIC test fixture — the draft and Cloudflare Research publish it openly
+#: for exactly this purpose. MUST NOT be used in production.
+RFC9421_ED25519_TEST_KEY = {
+    "kty": "OKP",
+    "crv": "Ed25519",
+    "kid": "test-key-ed25519",
+    "d": "n4Ni-HpISpVObnQMW0wOhCKROaIKqKtW_2ZYb2p9KcU",
+    "x": "JrQLj5P_89iXES9-vFgrIy29clF9CC_oPPsw3c5D0bs",
+}
+#: base64url JWK SHA-256 thumbprint of the test key (draft E.2 keyid).
+TEST_KEY_THUMBPRINT = "poqkLGiymh_W0uP6PZFw-dvez3QJT5SolqXBCW38r0U"
+
+# --- draft E.2.1 vector (EdDSA, Signature-Agent present) --------------------
+VEC_NONCE = (
+    "n9p433xm+NJ3ph3upfBIGmsuwHw387YV7Q/F+6BSpGCVjYCqQw6rznNA8PVVLySrA"
+    "Wsv0hQtFioQb6E1YsauiA=="
+)
+VEC_CREATED = 1735689600
+VEC_EXPIRES = 4889289600
+VEC_EXPECTED_SIGNATURE = (
+    "CGokAoY/FrPpyuzTe1Fb2kLTAH9Idw6qSFd1+D77r1firsMRCxeuLu5e6O+ek3zQ"
+    "gDMAzjiXtLVfqE00xnABCQ=="
+)
+VEC_AUTHORITY = "example.com"
+VEC_SIGNATURE_AGENT_URL = "https://signature-agent.test"
+VEC_LABEL = "sig2"
+
+# --- draft E.2.3 vector (signed directory response) -------------------------
+DIR_VEC_BODY = (
+    '{"keys":[{"kty":"OKP","crv":"Ed25519","kid":"poqkLGiymh_W0uP6PZFw-'
+    'dvez3QJT5SolqXBCW38r0U","x":"JrQLj5P_89iXES9-vFgrIy29clF9CC_oPPsw'
+    '3c5D0bs","use":"sig"}]}'
+).encode()
+DIR_VEC_DIGEST = "sha-256=:CADMT2aBdV/rqQr/NIru64ERQkCobVvllA4V0fLFDu0=:"
+DIR_VEC_AUTHORITY = "signature-agent.test"
+DIR_VEC_EXPECTED_SIGNATURE = (
+    "l6P8R67tm3kujAxbHWio7ll01qrEZ0dKD/WWlGhNYEmTnFZM8Wt0VQ9zqGfvo7T/"
+    "UMkBxsigzChM1Gpz7gOVBg=="
+)
+DIR_VEC_LABEL = "binding"
+DIR_VEC_TAG = "http-message-signatures-directory"
+
+
+# ---------------------------------------------------------------------------
+# Minimal RFC 8941 Structured Fields serialization (the subset web-bot-auth
+# needs: tokens, strings, integers, inner lists, dictionaries, parameters).
+# ---------------------------------------------------------------------------
+def sf_string(value: str) -> str:
+    out = value.replace("\\", "\\\\").replace('"', '\\"')
+    return '"' + out + '"'
+
+
+def _sf_params(params: list[tuple[str, Any]]) -> str:
+    parts = []
+    for key, val in params:
+        if val is True:
+            parts.append(";" + key)
+        elif isinstance(val, int):
+            parts.append(f";{key}={val}")
+        elif val is None or val is False:
+            raise ValueError(f"unsupported param {key}={val!r}")
+        else:
+            parts.append(f";{key}={sf_string(str(val))}")
+    return "".join(parts)
+
+
+def _component_id(cid: str, params: list[tuple[str, Any]]) -> str:
+    """RFC 9421 §2.3 step 3 (normative): covered component identifiers are
+    serialized as an ordered Inner List of STRING values — every identifier
+    quoted. Same choice as RFC 9421 B.2.6, draft E.2.1, and the reference
+    implementations (http-message-sig 0.1.0/0.3.0 buildSignatureInputString).
+    Note: the draft's E.2.3 directory vector prints "content-digest" unquoted
+    (sf-token) — a draft-vector inconsistency we reproduce only inside the
+    literal-vector check, never in production serialization."""
+    return sf_string(cid) + _sf_params(params)
+
+
+def sf_inner_list(items: list[tuple[str, list[tuple[str, Any]]]],
+                  params: list[tuple[str, Any]]) -> str:
+    inner = []
+    for cid, item_params in items:
+        inner.append(_component_id(cid, item_params))
+    return "(" + " ".join(inner) + ")" + _sf_params(params)
+
+
+def signature_input_header(label: str, component_ids: list[tuple[str, list[tuple[str, Any]]]],
+                           sig_params: list[tuple[str, Any]]) -> str:
+    """Signature-Input: label=(ids);params — draft wire format."""
+    return f"{label}={sf_inner_list(component_ids, sig_params)}"
+
+
+def signature_header(label: str, raw_sig: bytes) -> str:
+    b64 = base64.b64encode(raw_sig).decode()
+    return f"{label}=:{b64}:"
+
+
+def signature_agent_header(label: str, url: str, type_: str = "directory") -> str:
+    """Dictionary form per draft §5.2.1: label="url";type=directory."""
+    return f'{label}={sf_string(url)};type={type_}'
+
+
+# ---------------------------------------------------------------------------
+# Signature base construction (RFC 9421 §2.5, draft §5.2).
+# Param order mirrors the draft test vectors: created, keyid, alg, expires,
+# nonce, tag (requests) / created, expires, keyid, tag (directory proof).
+# ---------------------------------------------------------------------------
+def request_signature_base(
+    *,
+    authority: str,
+    signature_agent_member: str,
+    component_ids: list[tuple[str, list[tuple[str, Any]]]],
+    created: int,
+    keyid: str,
+    expires: int,
+    nonce: str,
+    tag: str = "web-bot-auth",
+    alg: str = "ed25519",
+    signature_agent_base_value: str | None = None,
+    method: str = "GET",
+    path: str = "/",
+) -> str:
+    """RFC 9421 §2.5 signature base for a request.
+
+    signature_agent_base_value: the value carried on the base line for the
+    "signature-agent";key=<label> component. RFC 9421 §2.1.2 (dictionary
+    member access — and draft E.2.1, and http-message-sig 0.3.0) uses the
+    member VALUE ("https://..."). The deployed http-message-sig 0.2.0 era
+    verifiers instead cover the FULL header field value (sig1="https://...").
+    Pass the full field value here for legacy-mode interop."""
+    sig_params = [
+        ("created", created),
+        ("keyid", keyid),
+        ("alg", alg),
+        ("expires", expires),
+        ("nonce", nonce),
+        ("tag", tag),
+    ]
+    lines = []
+    for cid, cid_params in component_ids:
+        if cid == "@authority":
+            value = authority.lower()
+        elif cid == "signature-agent":
+            # default: dictionary member value (RFC 9421 §2.1.2 / draft E.2.1);
+            # legacy verifiers (http-message-sig 0.2.0) expect the full field value.
+            value = signature_agent_base_value or signature_agent_member
+        elif cid == "@method":
+            value = method.upper()
+        elif cid == "@path":
+            value = path
+        else:
+            raise ValueError(f"unsupported component {cid}")
+        # RFC 9421 §2.5 ABNF: component-name = sf-string — base lines always
+        # quote the component name, parameters follow outside the quotes.
+        pfx = sf_string(cid) + _sf_params(cid_params)
+        lines.append(f'{pfx}: {value}')
+    lines.append('"@signature-params": ' + sf_inner_list(component_ids, sig_params))
+    return "\n".join(lines)
+
+
+def directory_signature_base(
+    *, authority: str, content_digest: str, created: int, expires: int, keyid: str
+) -> str:
+    component_ids: list[tuple[str, list[tuple[str, Any]]]] = [
+        ("@authority", [("req", True)]),
+        ("content-digest", []),
+    ]
+    sig_params = [
+        ("created", created),
+        ("expires", expires),
+        ("keyid", keyid),
+        ("tag", DIR_VEC_TAG),
+    ]
+    lines = [
+        f'"@authority";req: {authority.lower()}',
+        f'"content-digest": {content_digest}',
+        "@signature-params: " + sf_inner_list(component_ids, sig_params),
+    ]
+    return "\n".join(lines)
+
+
+# ---------------------------------------------------------------------------
+# Keys, thumbprints, digests.
+# ---------------------------------------------------------------------------
+def b64url_nopad(data: bytes) -> str:
+    return base64.urlsafe_b64encode(data).decode().rstrip("=")
+
+
+def jwk_thumbprint(jwk: dict[str, str]) -> str:
+    """RFC 8037 Appendix A.3 — Ed25519 thumbprint input is exactly these members."""
+    required = {"crv": jwk["crv"], "kty": jwk["kty"], "x": jwk["x"]}
+    canonical = json.dumps(required, sort_keys=True, separators=(",", ":"))
+    return b64url_nopad(hashlib.sha256(canonical.encode()).digest())
+
+
+def content_digest(body: bytes) -> str:
+    """RFC 9530 sha-256 Content-Digest: sha-256=:BASE64STD:"""
+    return "sha-256=:" + base64.b64encode(hashlib.sha256(body).digest()).decode() + ":"
+
+
+def generate_keypair() -> tuple[Ed25519PrivateKey, dict[str, str]]:
+    priv = Ed25519PrivateKey.generate()
+    pub_raw = priv.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)
+    jwk = {
+        "kty": "OKP",
+        "crv": "Ed25519",
+        "x": b64url_nopad(pub_raw),
+        "use": "sig",
+    }
+    # kid MUST be the base64url JWK thumbprint (draft §5.2 keyid rule),
+    # not a hash of the raw key bytes.
+    jwk["kid"] = jwk_thumbprint(jwk)
+    return priv, jwk
+
+
+def sign_base(priv: Ed25519PrivateKey, base: str) -> bytes:
+    return priv.sign(base.encode())
+
+
+def verify_base(pub: Ed25519PublicKey, base: str, sig: bytes) -> bool:
+    try:
+        pub.verify(sig, base.encode())
+        return True
+    except Exception:
+        return False
+
+
+def key_from_jwk(jwk: dict[str, str]):
+    """Import a JWK (d for private, x for public)."""
+    pad = lambda s: s + "=" * (-len(s) % 4)  # noqa: E731
+    if "d" in jwk:
+        return Ed25519PrivateKey.from_private_bytes(base64.urlsafe_b64decode(pad(jwk["d"])))
+    return Ed25519PublicKey.from_public_bytes(base64.urlsafe_b64decode(pad(jwk["x"])))
+
+
+def generate_nonce() -> str:
+    """64 random bytes, base64 (same shape as the reference implementation)."""
+    return base64.b64encode(secrets.token_bytes(64)).decode()
+
+
+# ---------------------------------------------------------------------------
+# Directory building (draft §5.5.1 format + Appendix B possession proof).
+# ---------------------------------------------------------------------------
+def build_directory_body(jwk: dict[str, str], nbf: int, exp: int) -> bytes:
+    entry = {k: jwk[k] for k in ("kty", "crv", "kid", "x")}
+    entry["use"] = "sig"
+    entry["nbf"] = nbf
+    entry["exp"] = exp
+    return json.dumps({"keys": [entry]}, separators=(",", ":")).encode()
+
+
+def sign_directory_response(
+    priv: Ed25519PrivateKey, *, directory_host: str, body: bytes,
+    created: int, expires: int, keyid: str,
+) -> dict[str, str]:
+    digest = content_digest(body)
+    base = directory_signature_base(
+        authority=directory_host, content_digest=digest,
+        created=created, expires=expires, keyid=keyid,
+    )
+    return {
+        "Content-Digest": digest,
+        "Signature-Input": signature_input_header(
+            DIR_VEC_LABEL, [("@authority", [("req", True)]), ("content-digest", [])],
+            [("created", created), ("expires", expires), ("keyid", keyid),
+             ("tag", DIR_VEC_TAG)],
+        ),
+        "Signature": signature_header(DIR_VEC_LABEL, sign_base(priv, base)),
+        "_base": base,
+    }
+
+
+# ---------------------------------------------------------------------------
+# Probe stages.
+# ---------------------------------------------------------------------------
+def stage_selftest() -> dict[str, Any]:
+    """Offline, deterministic: reproduce draft E.2.1 + E.2.3 byte-for-byte."""
+    out: dict[str, Any] = {"stage": "selftest", "network": False, "checks": []}
+
+    # thumbprint vector
+    got = jwk_thumbprint(RFC9421_ED25519_TEST_KEY)
+    out["checks"].append({
+        "name": "jwk-thumbprint (RFC 8037 A.3) matches draft keyid",
+        "expected": TEST_KEY_THUMBPRINT, "actual": got, "pass": got == TEST_KEY_THUMBPRINT,
+    })
+
+    # request signature vector (E.2.1)
+    priv = key_from_jwk(RFC9421_ED25519_TEST_KEY)
+    component_ids = [
+        ("@authority", []),
+        ("signature-agent", [("key", VEC_LABEL)]),
+    ]
+    base = request_signature_base(
+        authority=VEC_AUTHORITY,
+        signature_agent_member=sf_string(VEC_SIGNATURE_AGENT_URL),
+        component_ids=component_ids,
+        created=VEC_CREATED, keyid=TEST_KEY_THUMBPRINT,
+        expires=VEC_EXPIRES, nonce=VEC_NONCE,
+    )
+    expected_base = (
+        '"@authority": example.com\n'
+        f'"signature-agent";key="{VEC_LABEL}": "{VEC_SIGNATURE_AGENT_URL}"\n'
+        f'"@signature-params": ("@authority" "signature-agent";key="{VEC_LABEL}")'
+        f";created={VEC_CREATED};keyid=\"{TEST_KEY_THUMBPRINT}\";alg=\"ed25519\""
+        f";expires={VEC_EXPIRES};nonce=\"{VEC_NONCE}\";tag=\"web-bot-auth\""
+    )
+    out["checks"].append({
+        "name": "draft E.2.1 signature base reconstruction",
+        "pass": base == expected_base,
+        "base": base,
+    })
+    sig = sign_base(priv, base)
+    sig_b64 = base64.b64encode(sig).decode()
+    out["checks"].append({
+        "name": "draft E.2.1 Ed25519 signature value",
+        "expected": VEC_EXPECTED_SIGNATURE, "actual": sig_b64,
+        "pass": sig_b64 == VEC_EXPECTED_SIGNATURE,
+    })
+    # verify round-trip with the public key
+    pub = key_from_jwk({"kty": "OKP", "crv": "Ed25519", "x": RFC9421_ED25519_TEST_KEY["x"]})
+    out["checks"].append({
+        "name": "draft E.2.1 signature verifies under public x",
+        "pass": verify_base(pub, base, sig),
+    })
+
+    # signed directory response vector (E.2.3) — reproduced from the draft's
+    # printed base VERBATIM. The draft prints "content-digest" as an unquoted
+    # sf-token there, which its own E.2.1 style and RFC 9421 §2.3 (String
+    # values) contradict; the vector is still self-consistent, so we sign the
+    # literal printed bytes and record the inconsistency as a finding.
+    got_digest = content_digest(DIR_VEC_BODY)
+    out["checks"].append({
+        "name": "draft E.2.3 Content-Digest over exact directory bytes",
+        "expected": DIR_VEC_DIGEST, "actual": got_digest,
+        "pass": got_digest == DIR_VEC_DIGEST,
+    })
+    dir_vec_base = (
+        f'"@authority";req: {DIR_VEC_AUTHORITY}\n'
+        f'"content-digest": {DIR_VEC_DIGEST}\n'
+        f'"@signature-params": ("@authority";req "content-digest")'
+        f";created={VEC_CREATED};expires={VEC_EXPIRES}"
+        f';keyid="{TEST_KEY_THUMBPRINT}";tag="{DIR_VEC_TAG}"'
+    )
+    out["checks"].append({
+        "name": "draft E.2.3 base reproduced verbatim (token serialization as printed)",
+        "base": dir_vec_base,
+        "pass": True,
+        "note": "draft prints content-digest unquoted — see _component_id docstring",
+    })
+    dir_sig = base64.b64encode(sign_base(priv, dir_vec_base)).decode()
+    out["checks"].append({
+        "name": "draft E.2.3 signed directory response signature",
+        "expected": DIR_VEC_EXPECTED_SIGNATURE, "actual": dir_sig,
+        "pass": dir_sig == DIR_VEC_EXPECTED_SIGNATURE,
+    })
+    # normative (all-string) serialization of the same proof must also verify:
+    dir_norm_base = directory_signature_base(
+        authority=DIR_VEC_AUTHORITY, content_digest=DIR_VEC_DIGEST,
+        created=VEC_CREATED, expires=VEC_EXPIRES, keyid=TEST_KEY_THUMBPRINT,
+    )
+    norm_sig = sign_base(priv, dir_norm_base)
+    out["checks"].append({
+        "name": "same proof under normative all-string serialization verifies",
+        "pass": verify_base(pub, dir_norm_base, norm_sig),
+    })
+    out["pass"] = all(c["pass"] for c in out["checks"])
+    return out
+
+
+def stage_keygen() -> dict[str, Any]:
+    priv, jwk = generate_keypair()
+    tp = jwk_thumbprint(jwk)
+    ok = tp == jwk["kid"]
+    return {
+        "stage": "keygen", "network": False, "pass": ok,
+        "jwk": {k: jwk[k] for k in ("kty", "crv", "kid", "x", "use")},
+        "thumbprint_matches_kid": ok,
+        "note": "fresh keypair generated at probe time; private material is never persisted",
+    }
+
+
+def stage_directory() -> dict[str, Any]:
+    now = int(time.time())
+    priv, jwk = generate_keypair()
+    body = build_directory_body(jwk, nbf=now - 60, exp=now + 86_400)
+    proof = sign_directory_response(
+        priv, directory_host="supremeai-browser.example", body=body,
+        created=now, expires=now + 300, keyid=jwk["kid"],
+    )
+    # loopback: verify the proof with our own public key
+    pub = priv.public_key()
+    sig_b64 = proof["Signature"].split("=:", 1)[1][:-1]  # strip ":" prefix and trailing ":"
+    ok = verify_base(pub, proof["_base"], base64.b64decode(sig_b64))
+    return {
+        "stage": "directory", "network": False, "pass": ok,
+        "media_type": DIRECTORY_MEDIA_TYPE,
+        "body_bytes": len(body),
+        "content_digest": proof["Content-Digest"],
+        "signature_input": proof["Signature-Input"],
+        "signature": proof["Signature"],
+        "possession_proof_verified": ok,
+        "note": "self-signed directory per draft Appendix B; host here is a placeholder — "
+                "a real deployment publishes this at https://<host>/.well-known/"
+                "http-message-signatures-directory",
+    }
+
+
+def stage_loopback() -> dict[str, Any]:
+    """Full sign -> verify cycle against our own directory (no network)."""
+    now = int(time.time())
+    priv, jwk = generate_keypair()
+    label = "sig1"
+    sa_url = "https://supremeai-browser.example/.well-known/http-message-signatures-directory"
+    nonce = generate_nonce()
+    created, expires = now, now + 300
+    component_ids = [
+        ("@authority", []),
+        ("@method", []),
+        ("@path", []),
+        ("signature-agent", [("key", label)]),
+    ]
+    base = request_signature_base(
+        authority="target.example",
+        signature_agent_member=sf_string(sa_url),
+        component_ids=component_ids,
+        created=created, keyid=jwk["kid"], expires=expires, nonce=nonce,
+    )
+    sig = sign_base(priv, base)
+    headers = {
+        "Signature-Agent": signature_agent_header(label, sa_url),
+        "Signature-Input": signature_input_header(label, component_ids, [
+            ("created", created), ("keyid", jwk["kid"]), ("alg", "ed25519"),
+            ("expires", expires), ("nonce", nonce), ("tag", "web-bot-auth"),
+        ]),
+        "Signature": signature_header(label, sig),
+    }
+    # verifier side: rebuild the base from the emitted headers only
+    verify_base_str = request_signature_base(
+        authority="target.example",
+        signature_agent_member=sf_string(sa_url),
+        component_ids=component_ids,
+        created=created, keyid=jwk["kid"], expires=expires, nonce=nonce,
+    )
+    verified = verify_base(priv.public_key(), verify_base_str, sig)
+    return {
+        "stage": "loopback", "network": False, "pass": verified,
+        "covered_components": [c for c, _ in component_ids],
+        "signature_agent": headers["Signature-Agent"],
+        "signature_input": headers["Signature-Input"],
+        "signature": headers["Signature"],
+        "verified": verified,
+        "note": "sign and verify both implemented in-probe; tamper any base byte and verify flips false",
+    }
+
+
+def _http_get(url: str, headers: dict[str, str] | None = None, timeout: float = 20.0):
+    req = urllib.request.Request(url, headers=headers or {}, method="GET")
+    with urllib.request.urlopen(req, timeout=timeout) as resp:
+        return resp.status, dict(resp.headers), resp.read()
+
+
+def stage_live() -> dict[str, Any]:
+    """Probe the Cloudflare Research verification endpoint with a signed request."""
+    out: dict[str, Any] = {"stage": "live", "network": True,
+                           "origin": DEMO_ORIGIN, "checks": []}
+    # 1. fetch the key directory
+    try:
+        status, hdrs, body = _http_get(
+            DEMO_ORIGIN + DIRECTORY_PATH,
+            headers={"Accept": DIRECTORY_MEDIA_TYPE,
+                     "User-Agent": "supremeai-browser-webbotauth-probe/0.1 (explorer-lane)"},
+        )
+        ct = hdrs.get("Content-Type", "")
+        dir_ok = status == 200 and DIRECTORY_MEDIA_TYPE in ct
+        out["checks"].append({
+            "name": "directory fetch (media type + status)",
+            "expected": f"200 + {DIRECTORY_MEDIA_TYPE}",
+            "actual": f"{status} + {ct}", "pass": dir_ok,
+        })
+        if dir_ok:
+            jwks = json.loads(body)
+            kids = [k.get("kid") for k in jwks.get("keys", [])]
+            out["checks"].append({
+                "name": "directory lists the RFC 9421 test key thumbprint",
+                "expected": TEST_KEY_THUMBPRINT, "actual": kids,
+                "pass": TEST_KEY_THUMBPRINT in kids,
+            })
+        else:
+            out["pass"] = False
+            out["error"] = f"directory fetch unexpected: {status} {ct}"
+            return out
+    except Exception as exc:
+        out["pass"] = False
+        out["error"] = f"directory fetch failed: {exc}"
+        return out
+
+    # 2. control request (unsigned)
+    try:
+        c_status, c_hdrs, c_body = _http_get(
+            DEMO_ORIGIN + "/",
+            headers={"User-Agent": "supremeai-browser-webbotauth-probe/0.1 (explorer-lane)"},
+        )
+        out["checks"].append({
+            "name": "control unsigned GET status", "actual": c_status, "pass": c_status == 200,
+        })
+    except Exception as exc:
+        c_status, c_hdrs, c_body = None, {}, b""
+        out["checks"].append({"name": "control unsigned GET", "error": str(exc), "pass": False})
+
+    # 3. signed request with the published test key — two interop modes:
+    #      rfc    : base covers the dictionary MEMBER value ("https://…") —
+    #               RFC 9421 §2.1.2, draft E.2.1, http-message-sig 0.3.0.
+    #      legacy : base covers the FULL Signature-Agent field value
+    #               (sig1="https://…") — http-message-sig 0.2.0 behaviour,
+    #               which is what the deployed research server runs.
+    #    The live stage records BOTH verdicts as an interop matrix.
+    now = int(time.time())
+    label = "sig1"
+    sa_url = DEMO_ORIGIN + DIRECTORY_PATH
+    authority = DEMO_ORIGIN.removeprefix("https://")
+    component_ids = [
+        ("@authority", []),
+        ("@method", []),
+        ("@path", []),
+        ("signature-agent", [("key", label)]),
+    ]
+    sa_field_value = f'{label}="{sa_url}"'  # dictionary form (draft §5.2.1)
+    sig_params = [
+        ("created", now), ("keyid", TEST_KEY_THUMBPRINT), ("alg", "ed25519"),
+        ("expires", now + 300), ("nonce", generate_nonce()), ("tag", "web-bot-auth"),
+    ]
+    priv = key_from_jwk(RFC9421_ED25519_TEST_KEY)
+
+    def attempt(mode: str) -> dict[str, Any]:
+        base_value = (
+            sa_field_value if mode == "legacy" else sf_string(sa_url)
+        )
+        base = request_signature_base(
+            authority=authority,
+            signature_agent_member=sf_string(sa_url),
+            component_ids=component_ids,
+            created=now, keyid=TEST_KEY_THUMBPRINT,
+            expires=now + 300, nonce=sig_params[4][1],
+            signature_agent_base_value=base_value,
+            method="GET", path="/v0/api/verify",
+        )
+        req_headers = {
+            "User-Agent": "supremeai-browser-webbotauth-probe/0.1 (explorer-lane)",
+            "Accept": "text/plain",
+            "Signature-Agent": sa_field_value,
+            "Signature-Input": signature_input_header(label, component_ids, sig_params),
+            "Signature": signature_header(label, sign_base(priv, base)),
+        }
+        s_status, s_hdrs, s_body = _http_get(DEMO_ORIGIN + "/v0/api/verify",
+                                             headers=req_headers)
+        text = s_body.decode("utf-8", "replace").strip()
+        return {"mode": mode, "status": s_status, "endpoint": "/v0/api/verify",
+                "verdict": text,
+                "pass": s_status == 200 and text == "valid",
+                "signature_base": base}
+
+    out["attempts"] = []
+    for mode in ("rfc", "legacy"):
+        try:
+            attempt_out = attempt(mode)
+        except Exception as exc:
+            attempt_out = {"mode": mode, "error": str(exc), "pass": False}
+        out["attempts"].append(attempt_out)
+        out["checks"].append({
+            "name": f"signed GET verdict ({mode} base for signature-agent component)",
+            "actual": attempt_out.get("verdict", attempt_out.get("error")),
+            "pass": attempt_out.get("pass", False),
+        })
+    verdicts = {a.get("mode"): a.get("verdict") for a in out["attempts"]}
+    out["verdict_body"] = verdicts.get("rfc")
+    out["verdict_legacy"] = verdicts.get("legacy")
+    out["note"] = (
+        "rfc mode covers the dictionary member value per RFC 9421 §2.1.2 and "
+        "draft E.2.1; legacy mode covers the full Signature-Agent field value "
+        "per the deployed http-message-sig 0.2.0 verifier. Version skew is a "
+        "real interop finding — see the evidence document."
+    )
+
+    # Live interop succeeds when at least one serialization mode verifies.
+    # (Both verdicts are always recorded — a split matrix is itself evidence.)
+    out["pass"] = all(c.get("pass", False) for c in out["checks"][:2]) and (
+        out["verdict_body"] == "valid" or out["verdict_legacy"] == "valid"
+    )
+    return out
+
+
+# ---------------------------------------------------------------------------
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("stage", nargs="?", default="all",
+                        choices=["selftest", "keygen", "directory", "loopback", "live", "all"])
+    parser.add_argument("--out", help="write evidence JSON to this file")
+    parser.add_argument("--skip-live", action="store_true",
+                        help="run everything except the network stage")
+    args = parser.parse_args(argv)
+
+    stages = {
+        "selftest": stage_selftest,
+        "keygen": stage_keygen,
+        "directory": stage_directory,
+        "loopback": stage_loopback,
+        "live": stage_live,
+    }
+    order = (["selftest", "keygen", "directory", "loopback"]
+             + ([] if args.skip_live else ["live"]))
+    if args.stage != "all":
+        order = [args.stage]
+
+    results = []
+    for name in order:
+        entry = stages[name]()
+        results.append(entry)
+        state = "PASS" if entry.get("pass") else "FAIL"
+        print(f"[{state}] {name}", file=sys.stderr)
+
+    report = {
+        "probe": "web-bot-auth explorer lane (browser/scripts/webbotauth/probe.py)",
+        "draft": "draft-ietf-webbotauth-httpsig-protocol-00",
+        "ran_at_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
+        "results": results,
+        "pass": all(r.get("pass", False) for r in results),
+    }
+    payload = json.dumps(report, indent=2, ensure_ascii=False)
+    if args.out:
+        with open(args.out, "w", encoding="utf-8") as fh:
+            fh.write(payload)
+    print(payload)
+    return 0 if report["pass"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
