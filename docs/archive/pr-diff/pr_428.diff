+
+    Bridge Work Orders follow the 3-tier evidence contract whose tier 1 is the
+    Reflection line ("Reflection: ..."). Fail-closed: an empty body -> False.
+    """
+    return bool(re.search(r"Reflection\s*:\s*\S", wo_body or "", re.IGNORECASE))
+
