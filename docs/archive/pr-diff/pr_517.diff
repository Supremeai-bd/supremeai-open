+        }),
+        forbidden_operations=(
+            "claiming without atomic lock",
+            "breaking scope",
+        ),
+        trigger=TriggerSpec(
+            event_type="event:task.claimed",
+            required_labels=("status:claimed",),
+        ),
+    ),
+    "ci-fixer": RoleContract(
+        role_id="ci-fixer",
+        name="CI Fixer (Runway Healer)",
+        name_bn="রানওয়ে হিলার",
