+
+class DeprecationGuarantees(unittest.TestCase):
+    def test_37_no_keyword_api_on_matrix_module(self):
+        self.assertFalse(hasattr(rtm, "classify_task_role"))
+        self.assertFalse(hasattr(rtm, "classify_from_text"))
