+        # Event type must match exactly too.
+        self.assertEqual(rtm.dispatch(
+            rtm.DispatchSignal("event:task.claimedX")).reason, "UNKNOWN_EVENT")
+
+    def test_39_self_test_entrypoint_green(self):
