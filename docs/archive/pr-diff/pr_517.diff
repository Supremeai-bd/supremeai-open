+            "architectural rewrites (আর্কিটেকচারাল রিরাইট নিষিদ্ধ)",
+        ),
+        weapons=frozenset({
+            "replace_file_content",
+            "multi_replace_file_content",
+            "write_to_file",
+            "test_runner",
+            "git_branch_create",
