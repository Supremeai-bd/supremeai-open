-
-        if self._redis is None or self._redis.closed:
-            headers = {"Authorization": f"Bearer {self.config.UPSTASH_REDIS_TOKEN}"}
-            self._redis = aiohttp.ClientSession(
-                base_url=self.config.UPSTASH_REDIS_URL,
