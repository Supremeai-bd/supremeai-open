-            applied_at=datetime.now(),
-            success=True,
-            before_metrics={"score": 0.8},
-            after_metrics={"score": 0.88},
-            actual_improvement=action.expected_improvement,
-            side_effects=[],
-            should_keep=True,
-        )
-
-    def get_optimization_status(self) -> dict[str, Any]:
