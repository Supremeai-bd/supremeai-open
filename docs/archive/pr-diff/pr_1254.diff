-            ("always", "never"),
-            ("all", "no"),
-            ("everyone", "no one"),
-            ("is", "isn't"),
-            ("does", "doesn't"),
-            ("can", "cannot"),
-        ]
-
-        s1, s2 = sent1.lower(), sent2.lower()
-
-        for pos, neg in contradiction_pairs:
-            if (pos in s1 and neg in s2) or (neg in s1 and pos in s2):
-                return True
-
-        return False
