-    @with_error_bus("submit_task")
-    async def submit_task(
-        self,
-        func: Callable,
-        *args,
-        task_name: str | None = None,
-        priority: TaskPriority = TaskPriority.NORMAL,
-        max_retries: int = 3,
-        timeout: int = 300,
