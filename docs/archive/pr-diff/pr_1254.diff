-
-        if not sanitized:
-            raise ValueError(f"Identifier '{identifier}' contains no valid characters")
-
-        if sanitized != identifier:
-            logger.warning(
-                f"Identifier sanitized: '{identifier}' → '{sanitized}'. Invalid characters removed."
