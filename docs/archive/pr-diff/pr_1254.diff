-                m_table = re.search(
-                    r"CREATE\s+TABLE\s+(?:IF\s+NOT\s+EXISTS\s+)?([A-Za-z0-9_]+)",
-                    line,
-                    re.I,
-                )
-                if m_table:
-                    tname = m_table.group(1).lower()
-                    clean_tname = re.sub(r"^(?:legit|fake|mock|dummy)_", "", tname)
-                    return f"{clean_tname or tname}_schema.sql"
-
-        return None
