-        """
-        বাংলা মন্তব্য: Memory bound enforcement।
-        Oldest completed/failed tasks evict করা হয় — memory leak prevent।
-        """
-        while len(self._results) >= self._MAX_TRACKED_TASKS:
-            # বাংলা মন্তব্য: FIFO — সবচেয়ে পুরানো টাস্ক বাদ যাবে
