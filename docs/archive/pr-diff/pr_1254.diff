-                    predictions.append(
-                        Prediction(
-                            state, prob, f"Markov Chain prediction with {prob:.2f} probability"
-                        )
-                    )
-
-            if not predictions:
-                predictions.append(
-                    Prediction(f"next_page:{current_key}", 0.8, "Probable next page visit")
-                )
-        return predictions
-
-    async def schedule_prefetch(
