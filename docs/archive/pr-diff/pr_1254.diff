-            score += 0.2
-            signals.append("high-impact keyword")
-        if failure_rate > 0:
-            signals.append("recent failures")
-        digest = hashlib.sha256(normalized.encode()).digest()
-        noise = (random.Random(digest).random() * 2 - 1) * self.noise_budget
-        score = max(0.0, min(1.0, score + noise))
