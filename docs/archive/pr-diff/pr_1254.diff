-                score += idf_val * (numerator / denominator)
-
-            scores[idx] = score
-
-        # Rank results
-        ranked_indices = sorted(range(len(scores)), key=lambda i: scores[i], reverse=True)
-        results = []
-        for i in ranked_indices[:top_k]:
