-    def detect(self, text: str) -> list[dict[str, Any]]:
-        """Detect PII in text."""
-        findings: list[dict[str, Any]] = []
-        for name, pattern in self.compiled.items():
-            for match in pattern.finditer(text):
-                findings.append(
-                    {
-                        "type": name,
-                        "value": match.group(0),
-                        "start": match.start(),
-                        "end": match.end(),
-                    }
-                )
-        return findings
