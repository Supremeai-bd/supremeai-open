-        },
-        "phone_bd": {
-            "regex": r"(?:\+?88)?01[3-9]\d{8}",
-            "mask": "[PHONE_REDACTED]",
-        },
-        "nid_bd": {
-            "regex": r"\d{10,17}",
-            "mask": "[NID_REDACTED]",
-        },
-        "credit_card": {
-            "regex": r"(?:\d{4}[- ]?){3}\d{4}",
-            "mask": "[CARD_REDACTED]",
-        },
-        "ip_address": {
-            "regex": r"\b(?:\d{1,3}\.){3}\d{1,3}\b",
-            "mask": "[IP_REDACTED]",
