-            lambda: deque(maxlen=self.max_events_per_user)
-        )
-
-        # O(1) lookup profiles
-        self.user_profiles: dict[str, dict[str, Any]] = defaultdict(
-            lambda: {
-                "ip_addresses": defaultdict(int),
-                "actions": defaultdict(int),
-                "last_seen": 0.0,
-                "first_seen": time.time(),
-                "total_events": 0,
