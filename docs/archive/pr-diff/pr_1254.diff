-        )
-        return None
-
-    cfg = ACTION_PATTERNS.get(action, {})
-    return PromptAction(
-        action_type=action,
-        target_module=cfg.get("target"),
-        payload={
-            "original_prompt": prompt,
-            "gatekeeper": "llm",
-            "target_hint": data.get("target_hint"),
-        },
