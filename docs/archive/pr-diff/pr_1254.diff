-
-            entry = self.metrics[skill_name]
-            total_runs = entry["success_count"] + entry["failure_count"]
-
-        if total_runs < min_runs:
-            return False
-
-        score = self.calculate_fitness(skill_name)
-        if score >= threshold:
-            return False
-
-        logger.warning(
