-            RemediationAction.THROTTLE_TRAFFIC: 0.3,
-            RemediationAction.ACTIVATE_BACKUP: 2.5,
-        }
-
-        total_multiplier = sum(time_multipliers.get(action, 1.0) for action in actions)
