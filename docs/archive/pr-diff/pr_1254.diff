-DEFAULT_SENSITIVE_ENV_PATTERNS: tuple[str, ...] = (
-    "SUPREMEAI_*",
-    "DATABASE_URL*",
-    "*SECRET*",
-    "*PASSWORD*",
-    "*TOKEN*",
-    "*KEY*",
-    "JWT_*",
-    "INFISICAL_*",
-    "REDIS_*",
-    "RENDER_*",
