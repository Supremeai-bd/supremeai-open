-            if not allowed:
-                raise HTTPException(
-                    status_code=status.HTTP_429_TOO_MANY_REQUESTS,
-                    detail={"error": "Rate limit exceeded", "retry_after": int(meta["reset"])},
-                )
-
-            response = await func(request, *args, **kwargs)
-            return response
-
-        return wrapped_func
-
-    return decorator
