-    if not isinstance(text, str):
-        return text
-    # Remove HTML/Markdown comments (e.g., <!-- comment -->)
-    text = re.sub(r"<!--.*?-->", "", text, flags=re.DOTALL)
-    # Collapse 3 or more newlines into 2 newlines
-    text = re.sub(r"\n{3,}", "\n\n", text)
