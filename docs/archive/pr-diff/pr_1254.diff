-    CORRUPTED = "corrupted"
-    EXPIRED = "expired"
-    RESTORED = "restored"
-
-
-@dataclass
-class SystemBackup:
-    backup_id: str
-    created_at: datetime
-    expires_at: datetime
-    size_bytes: int
-    checksum: str
-    status: BackupStatus
