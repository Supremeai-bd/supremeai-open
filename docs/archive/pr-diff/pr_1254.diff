-            return path
-
-        except (nx.NetworkXNoPath, nx.NodeNotFound) as e:
-            logger.warning(f"No semantic path found between {start_skill} and {end_skill}: {e}")
-            return []
-
-    def get_fallback(self, skill_id: str) -> str | None:
-        return self.fallbacks.get(skill_id)
