-                    stderr=stderr_text,
-                    duration_ms=duration_ms,
-                    timed_out=timed_out,
-                    resource_exceeded=False,
-                    provider_metadata={
-                        "provider": self.provider_name,
-                        "trusted_boundary": self.is_trusted_boundary,
-                    },
-                )
-
-            except Exception as exc:
