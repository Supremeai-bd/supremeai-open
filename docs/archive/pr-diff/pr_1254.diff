-        time_multipliers = {
-            RemediationAction.RESTART_SERVICE: 1.0,
-            RemediationAction.SCALE_UP: 1.5,
-            RemediationAction.FAILOVER: 2.0,
-            RemediationAction.ROLLBACK_CONFIG: 3.0,
