-            title=title,
-            message=message,
-            metadata=metadata,
-        )
-
-        with self._lock:
-            self._alerts.append(alert)
-            self._counters[f"alerts_{severity.value}"] += 1
-
-        # Log based on severity
-        log_method = {
-            AlertSeverity.INFO: logger.info,
-            AlertSeverity.WARNING: logger.warning,
-            AlertSeverity.CRITICAL: logger.error,
