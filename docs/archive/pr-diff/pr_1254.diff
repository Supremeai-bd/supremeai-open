-        # Weighted penalty score
-        penalty = (
-            (norm_latency * self.latency_weight)
-            + (norm_cost * self.cost_weight)
-            + (norm_quality_inv * self.quality_weight)
-        )
-        priority_score = max(0.01, 1.0 - penalty)
