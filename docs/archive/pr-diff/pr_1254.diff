-            chromo = Chromosome(
-                chromosome_id=f"chromo_init_{i}",
-                genes=[
-                    Gene(
-                        gene_id=f"gene_weight_{i}",
-                        gene_type="weight",
-                        value=round(random.uniform(0.8, 0.98), 3),
-                        fitness=0.85,
-                        age=0,
-                        mutation_rate=0.1,
-                    )
-                ],
-                overall_fitness=0.85 + (i * 0.02),
