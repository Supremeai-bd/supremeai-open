-class ServiceRegistry:
-    """
-    বাংলা মন্তব্য: Factory pattern with async initialization.
-    Instance নয়, factory register করুন। async def create() classmethod দিয়ে async initialization করুন।
-    """
-
-    def __init__(self) -> None:
