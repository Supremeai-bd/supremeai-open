-        while len(_window_events) > _WINDOW_MAX_EVENTS:
-            _window_events.popleft()
-        while _window_events and now - _window_events[0][0] > _WINDOW_RETENTION_SECONDS:
-            _window_events.popleft()
-        _lifetime_requests += 1
-        if is_error:
-            _lifetime_errors += 1
