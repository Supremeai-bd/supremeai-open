-
-
-class HealthStatus(StrEnum):
-    HEALTHY = "healthy"
-    DEGRADED = "degraded"
-    UNHEALTHY = "unhealthy"
-
-
-@dataclass
-class HealthCheck:
-    """Individual health check registration."""
-
-    name: str
-    check_fn: Callable[[], bool] | Callable[[], Awaitable[bool]]
-    critical: bool = True
-    timeout_ms: int = 5000
-
-
-@dataclass
-class HealthResult:
-    """Result of a single health check."""
-
-    name: str
-    status: HealthStatus
-    latency_ms: float
-    error: str | None = None
