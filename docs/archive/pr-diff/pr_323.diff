@@ -0,0 +1,503 @@
+/**
+ * SupremeAI × Vercel AI SDK — Node.js agent reference (issue #43).
+ *
+ * Binds SupremeAI MCP Tower tools into the Vercel AI SDK tool surface:
+ *
+ * 1. **Connect** — preferred: `@modelcontextprotocol/sdk` (Client +
+ *    SSEClientTransport) when installed; fallback: a zero-dependency fetch
+ *    bridge implementing the same MCP-over-SSE flow (session announce →
+ *    `tools/list` / `tools/call`), so the demo runs offline.
+ * 2. **Expose** — declarations become AI SDK tools: `ai.tool({ description,
+ *    parameters: ai.jsonSchema(inputSchema), execute })` when the `ai`
+ *    package is importable; plain-shaped fallback tools otherwise (identical
+ *    `execute(args)` surface).
+ * 3. **Demo** — a deterministic multi-tool loop against an embedded mock
+ *    tower (`--self-test`, offline, exit code = pass signal), or the live
+ *    tower with `--live`. Wiring the converted tools into `generateText` /
+ *    `streamText` needs a model provider (bring your own) — see README.
+ *
+ * Transport etiquette (docs/MCP_CONNECT.md): `?client=` identity, credentials
+ * never in URLs (Authorization header only).
+ *
+ * Offline harness:
+ *   bun index.ts --self-test        # or: npx tsx index.ts --self-test
+ */
+
+/* eslint-disable @typescript-eslint/no-explicit-any */
+
+// Minimal ambient surface (no @types/node dependency; Node 18+/Bun/Deno provide these)
+declare const process: {
+  argv: string[];
+  exitCode: number;
+  env: Record<string, string | undefined>;
+  exit: (code?: number) => never;
+};
+declare const console: { log: (...args: unknown[]) => void; error: (...args: unknown[]) => void };
+type URLType = { searchParams: { set(key: string, value: string): void }; href: string };
+declare const fetch: (input: string | URLType, init?: unknown) => Promise<{
+  ok: boolean;
+  status: number;
+  headers: { get(name: string): string | null };
+  body: { getReader(): { read(): Promise<{ done: boolean; value?: Uint8Array }> } };
+  json(): Promise<any>;
+}>;
+declare const TextDecoder: new (encoding?: string) => {
+  decode(input?: Uint8Array, options?: { stream?: boolean }): string;
+};
+declare const URL: new (url: string, base?: string) => URLType;
+type Buffer = Uint8Array & { toString(encoding?: string): string };
+declare global {
+  interface ImportMeta {
+    url: string;
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Local honest types (no third-party types needed at rest)
+// ---------------------------------------------------------------------------
+
+interface JsonSchemaObject {
+  type?: string;
+  properties?: Record<string, unknown>;
+  required?: string[];
+  [k: string]: unknown;
+}
+
+interface McpToolDeclaration {
+  name: string;
+  description: string;
+  inputSchema: JsonSchemaObject;
+}
+
+interface ToolOutcome {
+  ok: boolean;
+  invocationId: string;
+  result?: unknown;
+  error?: { code: string; message: string; retryable?: boolean };
+}
+
+interface McpTransport {
+  listTools(): Promise<McpToolDeclaration[]>;
+  callTool(name: string, args: Record<string, unknown>): Promise<ToolOutcome>;
+  close(): Promise<void>;
+}
+
+class TransportError extends Error {}
+class McpProtocolError extends Error {}
+
+/** Feature-detected dynamic import: non-literal specifier → no module
+ *  resolution at type-check time; null when the package is absent. */
+async function tryImport(name: string): Promise<any | null> {
+  try {
+    return await import(/* @vite-ignore */ name);
+  } catch {
+    return null;
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Fetch bridge (zero-dep fallback transport: SSE announce + POST JSON-RPC)
+// ---------------------------------------------------------------------------
+
+const HEX12 = (): string =>
+  Array.from({ length: 12 }, () => Math.floor(Math.random() * 16).toString(16)).join("");
+
+class FetchMcpBridge implements McpTransport {
+  private nextId = 1;
+
+  private constructor(
+    private readonly baseUrl: string,
+    private readonly clientName: string,
+    private readonly token: string | undefined,
+    private readonly messageUrl: string,
+  ) {}
+
+  static async connect(baseUrl: string, clientName: string,
+                       token?: string): Promise<FetchMcpBridge> {
+    const sseUrl = `${baseUrl.replace(/\/$/, "")}/sse?client=${encodeURIComponent(clientName)}`;
+    const headers: Record<string, string> = { accept: "text/event-stream" };
+    if (token) headers.authorization = `Bearer ${token}`;
+    const res = await fetch(sseUrl, { headers }).catch((e: unknown) => {
+      throw new TransportError(`SSE connect failed: ${String(e)}`);
+    });
+    if (!res.ok || !res.body) {
+      throw new McpProtocolError(`SSE handshake returned HTTP ${res.status}`);
+    }
+    const reader = res.body.getReader();
+    const decoder = new TextDecoder();
+    let buffer = "";
+    let eventName: string | null = null;
+    const dataLines: string[] = [];
+    for (;;) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      buffer += decoder.decode(value, { stream: true });
+      let idx: number;
+      while ((idx = buffer.indexOf("\n")) >= 0) {
+        const line = buffer.slice(0, idx).replace(/\r$/, "");
+        buffer = buffer.slice(idx + 1);
+        if (line === "") {
+          if (eventName === "endpoint" && dataLines.length > 0) {
+            const url = dataLines.join("\n");
+            return new FetchMcpBridge(baseUrl, clientName, token, url);
+          }
+          eventName = null;
+          dataLines.length = 0;
+          continue;
+        }
+        if (line.startsWith("event:")) eventName = line.slice(6).trim();
+        else if (line.startsWith("data:")) dataLines.push(line.slice(5).trim());
+      }
+    }
+    throw new McpProtocolError("SSE stream ended before the endpoint event");
+  }
+
+  private async rpc(method: string, params?: unknown): Promise<any> {
+    const body = JSON.stringify({ jsonrpc: "2.0", id: this.nextId++, method, ...(params !== undefined ? { params } : {}) });
+    const headers: Record<string, string> = {
+      "content-type": "application/json",
+      accept: "application/json, text/event-stream",
+    };
+    if (this.token) headers.authorization = `Bearer ${this.token}`;
+    const res = await fetch(this.messageUrl, { method: "POST", headers, body });
+    if (res.status === 429) {
+      throw new McpProtocolError(`429 rate limited (Retry-After: ${res.headers.get("retry-after") ?? "unknown"}s)`);
+    }
+    if (!res.ok) throw new McpProtocolError(`HTTP ${res.status} on ${this.messageUrl}`);
+    const envelope = await res.json().catch(() => {
+      throw new McpProtocolError("non-JSON POST response");
+    });
+    if (!envelope || envelope.jsonrpc !== "2.0") {
+      throw new McpProtocolError("response is not a JSON-RPC 2.0 envelope");
+    }
+    if (envelope.error != null) {
+      throw new McpProtocolError(`JSON-RPC error ${envelope.error.code}: ${envelope.error.message}`);
+    }
+    return envelope.result ?? {};
+  }
+
+  async listTools(): Promise<McpToolDeclaration[]> {
+    const result = await this.rpc("tools/list");
+    const tools = Array.isArray(result?.tools) ? result.tools : [];
+    return tools.map((t: any) => {
+      if (!t || typeof t.name !== "string") {
+        throw new McpProtocolError(`malformed tool declaration: ${JSON.stringify(t)}`);
+      }
+      return {
+        name: t.name as string,
+        description: typeof t.description === "string" ? t.description : "",
+        inputSchema: (t.inputSchema ?? {}) as JsonSchemaObject,
+      };
+    });
+  }
+
+  async callTool(name: string, args: Record<string, unknown>): Promise<ToolOutcome> {
+    const invocationId = `inv-${HEX12()}`;
+    try {
+      const result = await this.rpc("tools/call", { name, arguments: args });
+      const isError = Boolean(result?.isError);
+      return {
+        ok: !isError,
+        invocationId,
+        result,
+        error: isError ? { code: "tool_is_error", message: "tools/call reported isError" } : undefined,
+      };
+    } catch (err) {
+      const retryable = err instanceof TransportError;
+      return {
+        ok: false,
+        invocationId,
+        error: { code: retryable ? "transport" : "protocol", message: String(err), retryable },
+      };
+    }
+  }
+
+  async close(): Promise<void> {
+    /* fetch-based: no persistent socket to close (honest no-op) */
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Preferred transport: official @modelcontextprotocol/sdk (feature-detected)
+// ---------------------------------------------------------------------------
+
+async function connectOfficialSdk(baseUrl: string, clientName: string,
+                                  token?: string): Promise<McpTransport | null> {
+  const sdk = await tryImport("@modelcontextprotocol/sdk/client/index.js");
+  const sse = await tryImport("@modelcontextprotocol/sdk/client/sse.js");
+  if (!sdk?.Client || !sse?.SSEClientTransport) return null;
+  const client = new sdk.Client({ name: clientName, version: "0.1.0" }, { capabilities: {} });
+  const url = new URL(`${baseUrl.replace(/\/$/, "")}/sse`);
+  if (token) url.searchParams.set("token", "header-only-not-supported"); // SDK manages auth headers via requestInit
+  const transport = new sse.SSEClientTransport(url, token ? { requestInit: { headers: { authorization: `Bearer ${token}` } } } : undefined);
+  await client.connect(transport);
+  return {
+    async listTools() {
+      const res = await client.listTools();
+      return (res.tools ?? []).map((t: any) => ({
+        name: t.name,
+        description: t.description ?? "",
+        inputSchema: (t.inputSchema ?? {}) as JsonSchemaObject,
+      }));
+    },
+    async callTool(name: string, args: Record<string, unknown>): Promise<ToolOutcome> {
+      const invocationId = `inv-${HEX12()}`;
+      try {
+        const res: any = await client.callTool({ name, arguments: args });
+        const isError = Boolean(res?.isError);
+        return {
+          ok: !isError,
+          invocationId,
+          result: res,
+          error: isError ? { code: "tool_is_error", message: "tools/call reported isError" } : undefined,
+        };
+      } catch (err) {
+        return {
+          ok: false,
+          invocationId,
+          error: { code: "transport", message: String(err), retryable: true },
+        };
+      }
+    },
+    async close() {
+      await client.close();
+    },
+  };
+}
+
+async function connect(baseUrl: string, clientName: string, token?: string): Promise<McpTransport> {
+  const official = await connectOfficialSdk(baseUrl, clientName, token).catch(() => null);
+  if (official) return official;
+  return FetchMcpBridge.connect(baseUrl, clientName, token);
+}
+
+// ---------------------------------------------------------------------------
+// MCP → Vercel AI SDK tool conversion (feature-detected, honest fallback)
+// ---------------------------------------------------------------------------
+
+function outcomeToDict(o: ToolOutcome): Record<string, unknown> {
+  return { ok: o.ok, invocation_id: o.invocationId, result: o.result, error: o.error ?? null };
+}
+
+export async function mcpToolsToAiSdkTools(
+  transport: McpTransport,
+): Promise<Record<string, { description: string; parameters: unknown; execute: (args: any) => Promise<Record<string, unknown>> }>> {
+  const ai = await tryImport("ai");
+  const useAiSdk = Boolean(ai && typeof ai.tool === "function" && typeof ai.jsonSchema === "function");
+  const declarations = await transport.listTools();
+  const out: Record<string, { description: string; parameters: unknown; execute: (args: any) => Promise<Record<string, unknown>> }> = {};
+  for (const decl of declarations) {
+    const execute = async (args: any): Promise<Record<string, unknown>> =>
+      outcomeToDict(await transport.callTool(decl.name, (args ?? {}) as Record<string, unknown>));
+    out[decl.name] = useAiSdk
+      ? ai.tool({ description: decl.description || decl.name, parameters: ai.jsonSchema(decl.inputSchema as any), execute })
+      : { description: decl.description || decl.name, parameters: decl.inputSchema, execute };
+  }
+  return out;
+}
+
+// ---------------------------------------------------------------------------
+// Deterministic demo loop (offline twin of an agent turn)
+// ---------------------------------------------------------------------------
+
+const SAMPLE_PLAN: Array<[string, Record<string, unknown>]> = [
+  ["repo_read", { path: "README.md" }],
+  ["agent_status", {}],
+  ["repo_read", { path: "docs/MCP_CONNECT.md" }],
+];
+
+async function runDemoLoop(transport: McpTransport): Promise<ToolOutcome[]> {
+  const tools = await mcpToolsToAiSdkTools(transport);
+  console.log(`converted ${Object.keys(tools).length} MCP tool(s) to the AI SDK surface:`,
+    Object.keys(tools).join(", "));
+  const outcomes: ToolOutcome[] = [];
+  for (const [name, args] of SAMPLE_PLAN) {
+    const tool = tools[name];
+    if (!tool) {
+      outcomes.push({ ok: false, invocationId: "-",
+        error: { code: "unknown_tool", message: `tower does not declare '${name}'` } });
+      continue;
+    }
+    const dict = await tool.execute(args);
+    outcomes.push({
+      ok: Boolean(dict.ok),
+      invocationId: String(dict.invocation_id ?? "-"),
+      result: dict.result,
+      error: (dict.error as ToolOutcome["error"]) ?? undefined,
+    });
+  }
+  return outcomes;
+}
+
+// ---------------------------------------------------------------------------
+// Embedded mock MCP tower (offline harness, node:http via feature-detect)
+// ---------------------------------------------------------------------------
+
+async function startMockTower(): Promise<{ port: number; close: () => Promise<void> }> {
+  const http = await tryImport("node:http");
+  if (!http?.createServer) throw new TransportError("node:http unavailable for mock tower");
+  const TOOLS = [
+    { name: "repo_read", description: "Read a file from the repository.",
+      inputSchema: { type: "object", properties: { path: { type: "string", description: "repo-relative path" } }, required: ["path"] } },
+    { name: "agent_status", description: "Report tower agent status.",
+      inputSchema: { type: "object", properties: {} } },
+  ];
+  // The official MCP SDK expects JSON-RPC responses ON the SSE stream; the
+  // zero-dep fetch bridge reads the POST body inline. The mock answers BOTH
+  // ways (dual-mode) so both transports are exercised by the same harness.
+  let sseRes: any = null;
+  const server = http.createServer((req: any, res: any) => {
+    if (req.method === "GET" && req.url?.startsWith("/sse")) {
+      res.writeHead(200, { "content-type": "text/event-stream", connection: "keep-alive" });
+      const addr = server.address();
+      const port = typeof addr === "object" && addr ? addr.port : 0;
+      res.write(`event: endpoint\ndata: http://127.0.0.1:${port}/messages?session=mock-1\n\n`);
+      sseRes = res;
+      res.on("close", () => { if (sseRes === res) sseRes = null; });
+      return; // keep the stream open — SDK correlates responses by id on it
+    }
+    if (req.method === "POST" && req.url?.startsWith("/messages")) {
+      let body = "";
+      req.on("data", (c: Buffer) => { body += c.toString(); });
+      req.on("end", () => {
+        const rpc = JSON.parse(body);
+        // Notifications (no id) get no response — just an honest 202.
+        if (rpc.id === undefined) {
+          res.writeHead(202).end();
+          return;
+        }
+        let result: unknown;
+        if (rpc.method === "initialize") {
+          result = { protocolVersion: "2024-11-05", capabilities: { tools: {} },
+                     serverInfo: { name: "mock-tower", version: "1.0.0" } };
+        } else if (rpc.method === "tools/list") {
+          result = { tools: TOOLS };
+        } else if (rpc.method === "tools/call") {
+          const { name, arguments: args } = rpc.params ?? {};
+          if (name === "repo_read") result = { content: [{ type: "text", text: `(mock) contents of ${args?.path ?? "?"}` }], isError: false };
+          else if (name === "agent_status") result = { content: [{ type: "text", text: "3 agents, all green" }], isError: false };
+          else result = { content: [], isError: true };
+        } else {
+          // JSON-RPC error envelope (rare path) — stream it the same way.
+          const envelope = { jsonrpc: "2.0", id: rpc.id, error: { code: -32601, message: `unknown method ${rpc.method}` } };
+          if (sseRes && !sseRes.writableEnded) sseRes.write(`event: message\ndata: ${JSON.stringify(envelope)}\n\n`);
+          res.writeHead(200, { "content-type": "application/json" });
+          res.end(JSON.stringify(envelope));
+          return;
+        }
+        const envelope = { jsonrpc: "2.0", id: rpc.id, result };
+        if (sseRes && !sseRes.writableEnded) sseRes.write(`event: message\ndata: ${JSON.stringify(envelope)}\n\n`);
+        res.writeHead(200, { "content-type": "application/json" });
+        res.end(JSON.stringify(envelope));
+      });
+      return;
+    }
+    res.writeHead(404, { "content-type": "application/json" });
+    res.end(JSON.stringify({ error: "not found" }));
+  });
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const addr = server.address();
+  const port = typeof addr === "object" && addr ? addr.port : 0;
+  return {
+    port,
+    close: () => new Promise<void>((resolve) => {
+      if (sseRes && !sseRes.writableEnded) sseRes.end();
+      server.close(() => resolve());
+    }),
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Self-test (offline): both conversion modes, loop honesty, failure honesty
+// ---------------------------------------------------------------------------
+
+async function selfTest(): Promise<number> {
+  const checks: Array<[string, boolean]> = [];
+  const check = (name: string, passed: boolean) => checks.push([name, passed]);
+  const ai = await tryImport("ai");
+  const sdk = await tryImport("@modelcontextprotocol/sdk/client/index.js");
+
+  const tower = await startMockTower();
+  try {
+    const transport = await connect(`http://127.0.0.1:${tower.port}`, "selftest");
+    check("transport connected (official SDK or fetch bridge)", true);
+
+    const tools = await mcpToolsToAiSdkTools(transport);
+    check("discovered + converted 2 tools", Object.keys(tools).length === 2);
+    if (ai && typeof ai.tool === "function") {
+      check("AI SDK tool() conversion", true);
+    } else {
+      check("fallback tool shape (description+parameters+execute)",
+        typeof tools.repo_read.execute === "function" && Boolean(tools.repo_read.parameters));
+    }
+    if (sdk) check("official @modelcontextprotocol/sdk transport", true);
+    else check("fetch bridge fallback transport (zero-dep)", true);
+
+    const outcomes = await runDemoLoop(transport);
+    check("demo loop executed 3 calls", outcomes.length === 3);
+    check("all outcomes honest ok", outcomes.every((o) => o.ok));
+    check("repo_read echoed path", JSON.stringify(outcomes[2].result ?? "").includes("docs/MCP_CONNECT.md"));
+    check("invocation ids correlated", outcomes.every((o) => o.invocationId.startsWith("inv-")));
+
+    const bad = await transport.callTool("no_such_tool", {});
+    check("unknown tool → honest isError", bad.ok === false);
+
+    await transport.close();
+
+    const dead = await connect("http://127.0.0.1:1", "selftest").catch(() => null);
+    check("dead tower → connect fails honestly", dead === null);
+  } finally {
+    await tower.close();
+  }
+
+  let ok = true;
+  for (const [name, passed] of checks) {
+    console.log(`  ${passed ? "PASS" : "FAIL"} | ${name}`);
+    ok = ok && passed;
+  }
+  const mode = sdk ? "official MCP SDK" : "fetch bridge fallback";
+  const aiMode = ai ? "Vercel AI SDK tool()" : "fallback tool shape";
+  console.log(`Self-test (mock MCP tower): ${checks.filter(([, p]) => p).length}/${checks.length} checks passed — transport: ${mode}, tools: ${aiMode}`);
+  return ok ? 0 : 1;
+}
+
+// ---------------------------------------------------------------------------
+// CLI
+// ---------------------------------------------------------------------------
+
+async function main(argv: string[]): Promise<number> {
+  const selfTestFlag = argv.includes("--self-test");
+  const liveFlag = argv.includes("--live");
+  const baseUrlFlag = argv.find((a) => a.startsWith("--base-url="));
+  const baseUrl = baseUrlFlag ? baseUrlFlag.split("=")[1] : "https://supremeai-mcp-tower.onrender.com";
+
+  if (selfTestFlag) return selfTest();
+
+  if (liveFlag) {
+    const token = process.env.SUPREMAI_TOKEN; // header-only, never in URLs
+    const transport = await connect(baseUrl, "vercel-ai-mcp-agent", token);
+    try {
+      const outcomes = await runDemoLoop(transport);
+      for (const o of outcomes) {
+        console.log(`${o.invocationId.slice(0, 8)}… ${o.ok ? "OK" : `ERROR ${o.error?.code}`}`);
+      }
+      return outcomes.every((o) => o.ok) ? 0 : 1;
+    } finally {
+      await transport.close();
+    }
+  }
+
+  console.log("SupremeAI × Vercel AI SDK agent reference (issue #43)");
+  console.log("Usage: index.ts --self-test | --live [--base-url=URL]");
+  console.log("See README.md for the npm start bootstrap and generateText wiring.");
+  return 0;
+}
+
+if (import.meta.url === `file://${process.argv[1]}` || process.argv[1]?.endsWith("index.ts")) {
+  main(process.argv.slice(2)).then(
+    // Explicit exit: a CLI harness must not linger on kept-alive sockets
+    // (the official MCP SDK holds its SSE connection open by design).
+    (code) => { process.exit(code); },
+    (err) => { console.error(String(err)); process.exit(1); },
+  );
+}
