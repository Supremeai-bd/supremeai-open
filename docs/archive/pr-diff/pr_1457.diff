+# Graphify AST sync — nightly extraction + self-test (template lane, .github is protected)
+# Source-of-truth change for Supremeai-bd/supremeai (monorepo): add as
+# .github/workflows/graphify-ast-sync.yml. Companion to #1329 (codebase_graph_query
+# currently reports status not_indexed because graph.json is never generated).
+
+name: Graphify AST Sync
+
+on:
+  schedule:
+    # Nightly, offset from the core PyErrorFix 02:00Z cron
+    - cron: "30 3 * * *"
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+jobs:
+  ast-sync:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@v5
+
+      - name: Set up Python
+        uses: actions/setup-python@v6
+        with:
+          python-version: "3.12"
+
+      - name: Install graphify CLI
+        # If graphify is served from an internal index, pin the same source the
+        # control-plane deploy uses (see infrastructure/mcp-control-plane docs).
+        run: pip install graphify
+
+      - name: Self-test (built into the script)
+        run: python scripts/ci/sync_graph_to_memory.py --self-test
+
+      - name: Extract AST graphs (studio, gateway, core)
+        run: |
+          set -e
+          for d in studio gateway core; do
+            python scripts/ci/sync_graph_to_memory.py --domain "$d" --force-extract
+          done
+
+      - name: Commit graph artifacts so the deployed tower finds graph.json
+        run: |
+          git config user.name "graphify-bot"
+          git config user.email "actions@users.noreply.github.com"
+          git add .cache/graphify
+          if git diff --cached --quiet; then
+            echo "No graph changes"
+          else
+            git commit -m "chore(graphify): nightly AST graph sync [skip ci]"
+            git push
+          fi
+
+# Operator note: the tower's codebase_graph_query resolves graph.json relative to
+# its runtime checkout. If the deployed path differs from .cache/graphify/<domain>/graphify-out/graph.json,
+# set the path via the control-plane env (or copy the artifact into the deploy image
+# in infrastructure/mcp-control-plane render.yaml build step).
