+++ b/api-schemas/websocket-events.schema.json
@@ -0,0 +1,324 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://supremeai.ai/schemas/websocket-events.schema.json",
+  "title": "SupremeAI WebSocket Live Event Stream Frames",
+  "description": "Wire contract for streaming live agent execution over WebSocket: agent thoughts, tool invocations/results, lifecycle events, and heartbeat frames. Every frame is one JSON object on the wire. Frames are strictly ordered per connection by the monotonically increasing seq and carry an RFC 3339 timestamp. The 6 event types are a closed vocabulary; each event tag is pinned to exactly one payload shape via if/then discrimination, so a mismatched payload is structurally invalid. Heartbeat ping/pong frames share the same envelope under frame_type=heartbeat. Contract-first: the MCP Tower serves its transports today (see docs/MCP_CONNECT.md); this schema pins the live event stream format for agent execution. See issue #40.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["frame_type", "seq", "timestamp"],
+  "properties": {
+    "frame_type": {
+      "enum": ["event", "heartbeat"],
+      "description": "Frame discriminator: execution events vs heartbeat ping/pong keepalives."
+    },
+    "seq": {
+      "type": "integer",
+      "minimum": 0,
+      "description": "Monotonically increasing per-connection sequence number; receivers detect gaps and trigger resync on discontinuity."
+    },
+    "timestamp": {
+      "type": "string",
+      "format": "date-time",
+      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?([Zz]|[+-]\\d{2}:\\d{2})$",
+      "description": "RFC 3339 UTC instant at which the server emitted the frame (ordering authority). Explicit pattern: format is annotation-only in Draft 2020-12, so the pattern gives the ordering contract teeth in every validator."
+    },
+    "event": {
+      "enum": ["agent:started", "agent:thought", "tool:invoking", "tool:result", "agent:done", "agent:error"],
+      "description": "Closed vocabulary of the 6 execution event types."
+    },
+    "task_id": {
+      "type": "string",
+      "pattern": "^task-[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
+      "description": "Task whose execution this stream carries (present on event frames)."
+    },
+    "agent_id": {
+      "type": "string",
+      "pattern": "^agent-[a-zA-Z0-9_-]{1,64}$",
+      "description": "Emitting agent (present on event frames; mirrors heartbeat.schema.json identity)."
+    },
+    "payload": {
+      "description": "Event-tagged payload; shape pinned by the if/then arms below."
+    },
+    "heartbeat": {
+      "$ref": "#/$defs/HeartbeatBody"
+    }
+  },
+  "allOf": [
+    {
+      "description": "Event frames carry task_id, agent_id and a payload.",
+      "if": {
+        "type": "object",
+        "required": ["frame_type"],
+        "properties": { "frame_type": { "const": "event" } }
+      },
+      "then": {
+        "type": "object",
+        "required": ["event", "task_id", "agent_id", "payload"],
+        "properties": { "heartbeat": { "not": {} } }
+      }
+    },
+    {
+      "description": "agent:started pins the AgentStartedPayload.",
+      "if": {
+        "type": "object",
+        "required": ["event"],
+        "properties": { "event": { "const": "agent:started" } }
+      },
+      "then": {
+        "type": "object",
+        "required": ["payload"],
+        "properties": { "payload": { "$ref": "#/$defs/AgentStartedPayload" } }
+      }
+    },
+    {
+      "description": "agent:thought pins the AgentThoughtPayload.",
+      "if": {
+        "type": "object",
+        "required": ["event"],
+        "properties": { "event": { "const": "agent:thought" } }
+      },
+      "then": {
+        "type": "object",
+        "required": ["payload"],
+        "properties": { "payload": { "$ref": "#/$defs/AgentThoughtPayload" } }
+      }
+    },
+    {
+      "description": "tool:invoking pins the ToolInvokingPayload.",
+      "if": {
+        "type": "object",
+        "required": ["event"],
+        "properties": { "event": { "const": "tool:invoking" } }
+      },
+      "then": {
+        "type": "object",
+        "required": ["payload"],
+        "properties": { "payload": { "$ref": "#/$defs/ToolInvokingPayload" } }
+      }
+    },
+    {
+      "description": "tool:result pins the ToolResultPayload.",
+      "if": {
+        "type": "object",
+        "required": ["event"],
+        "properties": { "event": { "const": "tool:result" } }
+      },
+      "then": {
+        "type": "object",
+        "required": ["payload"],
+        "properties": { "payload": { "$ref": "#/$defs/ToolResultPayload" } }
+      }
+    },
+    {
+      "description": "agent:done pins the AgentDonePayload.",
+      "if": {
+        "type": "object",
+        "required": ["event"],
+        "properties": { "event": { "const": "agent:done" } }
+      },
+      "then": {
+        "type": "object",
+        "required": ["payload"],
+        "properties": { "payload": { "$ref": "#/$defs/AgentDonePayload" } }
+      }
+    },
+    {
+      "description": "agent:error pins the AgentErrorPayload.",
+      "if": {
+        "type": "object",
+        "required": ["event"],
+        "properties": { "event": { "const": "agent:error" } }
+      },
+      "then": {
+        "type": "object",
+        "required": ["payload"],
+        "properties": { "payload": { "$ref": "#/$defs/AgentErrorPayload" } }
+      }
+    },
+    {
+      "description": "Heartbeat frames carry the heartbeat body.",
+      "if": {
+        "type": "object",
+        "required": ["frame_type"],
+        "properties": { "frame_type": { "const": "heartbeat" } }
+      },
+      "then": {
+        "type": "object",
+        "required": ["heartbeat"],
+        "properties": { "event": { "not": {} } }
+      }
+    }
+  ],
+  "$defs": {
+    "HeartbeatBody": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "Keepalive ping/pong. Client sends kind=ping; server MUST answer kind=pong echoing the ping seq. A missed pong within the timeout closes the connection and triggers reconnection with backoff.",
+      "required": ["kind"],
+      "properties": {
+        "kind": {
+          "enum": ["ping", "pong"],
+          "description": "Ping initiates the probe; pong echoes it."
+        },
+        "interval_seconds": {
+          "type": "integer",
+          "minimum": 5,
+          "maximum": 300,
+          "description": "Negotiated keepalive cadence (advisory on ping, binding on pong)."
+        },
+        "timeout_seconds": {
+          "type": "integer",
+          "minimum": 5,
+          "maximum": 600,
+          "description": "Max wait for the pong before the connection is considered dead."
+        }
+      }
+    },
+    "AgentStartedPayload": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "Emitted once when the agent begins working a task.",
+      "required": ["goal"],
+      "properties": {
+        "goal": {
+          "type": "string",
+          "minLength": 1,
+          "description": "Objective the agent is starting on."
+        },
+        "mode": {
+          "type": "string",
+          "pattern": "^[a-z][a-z0-9-]{0,63}$",
+          "description": "Execution mode tag (e.g. implement, audit, observe)."
+        },
+        "attempt": {
+          "type": "integer",
+          "minimum": 1,
+          "description": "1-based attempt number for this task."
+        }
+      }
+    },
+    "AgentThoughtPayload": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "Streaming thought/plan narration. Content is truncated by emitters at max_length; clients must not rely on completeness.",
+      "required": ["content"],
+      "properties": {
+        "content": {
+          "type": "string",
+          "minLength": 1,
+          "maxLength": 8192,
+          "description": "Thought text (server-side truncated)."
+        },
+        "step": {
+          "type": "integer",
+          "minimum": 1,
+          "description": "Reasoning step counter within the task."
+        },
+        "truncated": {
+          "type": "boolean",
+          "description": "True when content was cut by the emitter's cap."
+        }
+      }
+    },
+    "ToolInvokingPayload": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "Emitted immediately before a tool call is dispatched.",
+      "required": ["tool"],
+      "properties": {
+        "tool": {
+          "type": "string",
+          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
+          "description": "Tool identifier being invoked."
+        },
+        "arguments_digest": {
+          "type": "string",
+          "maxLength": 512,
+          "description": "Arguments summary or hash for correlation; never full secrets."
+        },
+        "invocation_id": {
+          "type": "string",
+          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{4,63}$",
+          "description": "Correlates the matching tool:result frame."
+        }
+      }
+    },
+    "ToolResultPayload": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "Emitted when a tool call completes.",
+      "required": ["tool", "status"],
+      "properties": {
+        "tool": {
+          "type": "string",
+          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
+          "description": "Tool identifier that produced the result."
+        },
+        "status": {
+          "enum": ["ok", "error"],
+          "description": "Outcome of the invocation."
+        },
+        "invocation_id": {
+          "type": "string",
+          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{4,63}$",
+          "description": "Echo of the tool:invoking correlation id."
+        },
+        "duration_ms": {
+          "type": "integer",
+          "minimum": 0,
+          "description": "Round-trip duration of the tool call."
+        },
+        "summary": {
+          "type": "string",
+          "maxLength": 2048,
+          "description": "Human-readable result summary (truncated; never raw secrets)."
+        }
+      }
+    },
+    "AgentDonePayload": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "Terminal success frame; stream ends after agent:done.",
+      "required": [],
+      "properties": {
+        "summary": {
+          "type": "string",
+          "maxLength": 4096,
+          "description": "Outcome summary."
+        },
+        "artifacts": {
+          "type": "array",
+          "uniqueItems": true,
+          "items": {
+            "type": "string",
+            "minLength": 1
+          },
+          "description": "Repository paths or identifiers produced by the task."
+        }
+      }
+    },
+    "AgentErrorPayload": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "Terminal failure frame; stream ends after agent:error.",
+      "required": ["error_code", "message", "retryable"],
+      "properties": {
+        "error_code": {
+          "type": "string",
+          "pattern": "^[a-z][a-z0-9_]{2,63}$",
+          "description": "Stable snake_case machine-readable error code."
+        },
+        "message": {
+          "type": "string",
+          "minLength": 1,
+          "maxLength": 4096,
+          "description": "Honest human-readable failure description."
+        },
+        "retryable": {
+          "type": "boolean",
+          "description": "Whether the task may be safely re-dispatched."
+        }
+      }
+    }
+  }
+}
