@@ -0,0 +1,131 @@
+"""Dual manifest schema: SKILL.md frontmatter + cursor plugin.json.
+
+Normalizes both ecosystem formats into one CapabilityDescriptor so the
+registry, loader, and CLI treat every capability identically.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from dataclasses import dataclass, field
+from typing import Any, Dict, List, Optional
+
+FRONTMATTER_RE = re.compile(r"\A---\s*\n(.*?)\n---\s*\n?", re.S)
+NAME_RE = re.compile(r"\A[a-z0-9][a-z0-9-]*\Z")
+
+
+class ManifestError(ValueError):
+    """Raised when a manifest violates the schema contract."""
+
+
+@dataclass
+class CapabilityDescriptor:
+    """Normalized capability metadata (stage-1/2 payload: no body)."""
+
+    name: str
+    version: str
+    description: str
+    triggers: List[str] = field(default_factory=list)
+    entry: Optional[str] = None
+    source_format: str = "skill-md"  # or "cursor-plugin"
+    source_path: Optional[str] = None
+
+    def validate(self) -> None:
+        if not NAME_RE.match(self.name):
+            raise ManifestError(f"invalid skill name: {self.name!r}")
+        if not self.version:
+            raise ManifestError(f"skill {self.name}: missing version")
+        if not self.description:
+            raise ManifestError(f"skill {self.name}: missing description")
+
+    def summary(self) -> Dict[str, Any]:
+        """Lightweight boot-index payload (progressive disclosure, stage 1)."""
+        return {
+            "name": self.name,
+            "version": self.version,
+            "description": self.description,
+            "triggers": list(self.triggers),
+            "source_format": self.source_format,
+        }
+
+
+def _parse_scalar(value: str) -> Any:
+    value = value.strip()
+    if value.startswith("[") and value.endswith("]"):
+        inner = value[1:-1].strip()
+        if not inner:
+            return []
+        return [item.strip().strip("'\"") for item in inner.split(",")]
+    if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
+        return value[1:-1]
+    return value
+
+
+def parse_frontmatter(text: str) -> Dict[str, Any]:
+    """Minimal YAML frontmatter reader: scalars, inline lists, comments."""
+    match = FRONTMATTER_RE.match(text)
+    if not match:
+        raise ManifestError("SKILL.md must open with a --- frontmatter block")
+    data: Dict[str, Any] = {}
+    for raw_line in match.group(1).splitlines():
+        line = raw_line.split("#", 1)[0].rstrip()
+        if not line.strip():
+            continue
+        if ":" not in line:
+            raise ManifestError(f"malformed frontmatter line: {raw_line!r}")
+        key, _, rest = line.partition(":")
+        data[key.strip()] = _parse_scalar(rest)
+    return data
+
+
+def parse_skill_md(text: str, source_path: Optional[str] = None) -> tuple:
+    """Return (descriptor, instructions_body) from SKILL.md content."""
+    data = parse_frontmatter(text)
+    match = FRONTMATTER_RE.match(text)
+    body = text[match.end():].strip()
+    for required in ("name", "version", "description"):
+        if required not in data:
+            raise ManifestError(f"SKILL.md frontmatter missing {required!r}")
+    descriptor = CapabilityDescriptor(
+        name=str(data["name"]),
+        version=str(data["version"]),
+        description=str(data["description"]),
+        triggers=[str(t) for t in data.get("triggers", [])] if isinstance(data.get("triggers"), list) else [],
+        entry=str(data["entry"]) if data.get("entry") else None,
+        source_format="skill-md",
+        source_path=source_path,
+    )
+    descriptor.validate()
+    return descriptor, body
+
+
+def parse_cursor_plugin(json_text: str, source_path: Optional[str] = None) -> tuple:
+    """Normalize a cursor/plugins plugin.json into (descriptor, notes)."""
+    try:
+        data = json.loads(json_text)
+    except json.JSONDecodeError as exc:
+        raise ManifestError(f"plugin.json is not valid JSON: {exc}") from exc
+    if not isinstance(data, dict):
+        raise ManifestError("plugin.json root must be an object")
+    for required in ("name", "description"):
+        if required not in data:
+            raise ManifestError(f"plugin.json missing {required!r}")
+    commands = data.get("commands")
+    triggers: List[str] = []
+    if isinstance(commands, dict):
+        triggers = [str(key) for key in commands]
+    elif isinstance(commands, list):
+        triggers = [str(item.get("name")) for item in commands if isinstance(item, dict) and item.get("name")]
+    descriptor = CapabilityDescriptor(
+        name=str(data["name"]).lower().replace("_", "-"),
+        version=str(data.get("version", "0.0.0")),
+        description=str(data["description"]),
+        triggers=triggers,
+        entry=str(data.get("entry")) if data.get("entry") else None,
+        source_format="cursor-plugin",
+        source_path=source_path,
+    )
+    descriptor.validate()
+    notes = str(data.get("instructions", "")).strip()
+    return descriptor, notes
diff --git a/skills/registry/package_manager.py b/skills/registry/package_manager.py
new file mode 100644
index 00000000..fc81a05d
--- /dev/null
+++ b/skills/registry/package_manager.py
@@ -0,0 +1,148 @@
+"""skills.sh-compatible CLI and importer engine.
+
+Verbs: install (local dir, git url, or index name), list, remove, pack.
+Registry sources resolve exclusively through registry/index.json — no
+credentials, no hardcoded endpoints.
+"""
+
+from __future__ import annotations
+
+import argparse
+import shutil
+import subprocess
+import sys
+import tarfile
+import tempfile
+from pathlib import Path
+from typing import List, Optional
+
+from .manifest_schema import ManifestError, parse_skill_md
+from .progressive_loader import ProgressiveLoader
+
+INDEX_FILENAME = "index.json"
+
+
+class PackageManagerError(RuntimeError):
+    """Raised when an install/remove/pack operation cannot proceed."""
+
+
+class PackageManager:
+    def __init__(self, target_root: Path, index_path: Optional[Path] = None) -> None:
+        self.target_root = Path(target_root)
+        self.index_path = Path(index_path) if index_path else self.target_root / INDEX_FILENAME
+
+    # ---- verbs -------------------------------------------------------
+    def install(self, source: str) -> Path:
+        """Install a skill from a local dir, a git url, or an index name."""
+        staged = self._stage_source(source)
+        try:
+            if not (staged / "SKILL.md").is_file():
+                raise PackageManagerError(f"not a skill directory (no SKILL.md): {source}")
+            descriptor, _ = parse_skill_md(
+                (staged / "SKILL.md").read_text(encoding="utf-8"),
+                source_path=str(staged / "SKILL.md"),
+            )
+            destination = self.target_root / descriptor.name
+            if destination.exists():
+                raise PackageManagerError(f"skill already installed: {descriptor.name}")
+            shutil.copytree(staged, destination)
+            return destination
+        finally:
+            shutil.rmtree(staged, ignore_errors=True)
+
+    def list_installed(self) -> List[str]:
+        if not self.target_root.is_dir():
+            return []
+        names = []
+        for skill_md in sorted(self.target_root.glob("*/SKILL.md")):
+            names.append(skill_md.parent.name)
+        return names
+
+    def remove(self, name: str) -> Path:
+        destination = self.target_root / name
+        if not destination.is_dir():
+            raise PackageManagerError(f"skill not installed: {name}")
+        shutil.rmtree(destination)
+        return destination
+
+    def pack(self, skill_dir: Path, output: Optional[Path] = None) -> Path:
+        """Build a distributable .skill tar.gz from a skill directory."""
+        skill_dir = Path(skill_dir)
+        skill_md = skill_dir / "SKILL.md"
+        if not skill_md.is_file():
+            raise PackageManagerError(f"not a skill directory (no SKILL.md): {skill_dir}")
+        name = skill_dir.name
+        output = output or (skill_dir.parent / f"{name}.skill")
+        with tarfile.open(output, "w:gz") as archive:
+            for member in sorted(skill_dir.rglob("*")):
+                archive.add(member, arcname=str(member.relative_to(skill_dir.parent)))
+        return output
+
+    # ---- staging -----------------------------------------------------
+    def _stage_source(self, source: str) -> Path:
+        staging = Path(tempfile.mkdtemp(prefix="skill-install-"))
+        candidate = Path(source)
+        if candidate.is_dir():
+            shutil.copytree(candidate, staging / "skill")
+            return staging / "skill"
+        git_source = self._resolve_index(source) or source
+        result = subprocess.run(
+            ["git", "clone", "--depth", "1", git_source, str(staging / "skill")],
+            capture_output=True,
+            text=True,
+            timeout=120,
+        )
+        if result.returncode != 0:
+            shutil.rmtree(staging, ignore_errors=True)
+            raise PackageManagerError(f"git clone failed for {source!r}: {result.stderr.strip()[:200]}")
+        return staging / "skill"
+
+    def _resolve_index(self, name: str) -> Optional[str]:
+        if not self.index_path.is_file():
+            return None
+        skills = ProgressiveLoader.read_index(self.index_path)
+        entry = skills.get(name)
+        if entry is None:
+            return None
+        if entry.get("ref"):
+            return f"{entry['git']}@{entry['ref']}"
+        return str(entry["git"])
+
+
+def build_cli() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(prog="supremeai-skill", description="SupremeAI skill package manager")
+    parser.add_argument("--root", default=".", help="skill installation root")
+    parser.add_argument("--index", default=None, help="path to registry index.json")
+    verbs = parser.add_subparsers(dest="verb", required=True)
+    install = verbs.add_parser("install")
+    install.add_argument("source")
+    verbs.add_parser("list")
+    remove = verbs.add_parser("remove")
+    remove.add_argument("name")
+    pack = verbs.add_parser("pack")
+    pack.add_argument("directory")
+    pack.add_argument("--out", default=None)
+    return parser
+
+
+def main(argv: Optional[List[str]] = None) -> int:
+    args = build_cli().parse_args(argv)
+    manager = PackageManager(Path(args.root), Path(args.index) if args.index else None)
+    try:
+        if args.verb == "install":
+            print(f"installed: {manager.install(args.source)}")
+        elif args.verb == "list":
+            for name in manager.list_installed():
+                print(name)
+        elif args.verb == "remove":
+            print(f"removed: {manager.remove(args.name)}")
+        elif args.verb == "pack":
+            print(f"packed: {manager.pack(Path(args.directory), Path(args.out) if args.out else None)}")
+    except (PackageManagerError, ManifestError) as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/skills/registry/progressive_loader.py b/skills/registry/progressive_loader.py
new file mode 100644
index 00000000..ec76f714
--- /dev/null
+++ b/skills/registry/progressive_loader.py
@@ -0,0 +1,96 @@
+"""Three-stage progressive disclosure loader.
+
+Stage 1 (boot):  discover() — walk roots, read frontmatter/manifests only.
+Stage 2 (index): summaries() — cheap metadata payloads for agent context.
+Stage 3 (dispatch): load() — read full instructions for exactly one skill.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Dict, List, Optional
+
+from .manifest_schema import (
+    CapabilityDescriptor,
+    ManifestError,
+    parse_cursor_plugin,
+    parse_skill_md,
+)
+
+SKILL_MD = "SKILL.md"
+CURSOR_MANIFEST = "plugin.json"
+
+
+class ProgressiveLoader:
+    """Filesystem-backed capability registry with context-diet semantics."""
+
+    def __init__(self, roots: List[Path]) -> None:
+        self.roots = [Path(root) for root in roots]
+        self._index: Dict[str, CapabilityDescriptor] = {}
+        self._bodies: Dict[str, str] = {}
+
+    def discover(self) -> Dict[str, CapabilityDescriptor]:
+        """Stage 1: index every skill under the roots (metadata only)."""
+        self._index = {}
+        self._bodies = {}
+        for root in self.roots:
+            if not root.is_dir():
+                continue
+            for skill_md in sorted(root.rglob(SKILL_MD)):
+                descriptor, body = parse_skill_md(
+                    skill_md.read_text(encoding="utf-8"), source_path=str(skill_md)
+                )
+                self._adopt(descriptor, body)
+            for plugin_json in sorted(root.rglob(CURSOR_MANIFEST)):
+                if plugin_json.parent.name != ".cursor-plugin":
+                    continue
+                descriptor, notes = parse_cursor_plugin(
+                    plugin_json.read_text(encoding="utf-8"), source_path=str(plugin_json)
+                )
+                self._adopt(descriptor, notes)
+        return dict(self._index)
+
+    def _adopt(self, descriptor: CapabilityDescriptor, body: str) -> None:
+        if descriptor.name in self._index:
+            raise ManifestError(f"duplicate capability name: {descriptor.name}")
+        self._index[descriptor.name] = descriptor
+        self._bodies[descriptor.name] = body
+
+    def summaries(self) -> List[Dict[str, object]]:
+        """Stage 2: lightweight summaries; safe for boot-time context."""
+        return [descriptor.summary() for descriptor in self._index.values()]
+
+    def load(self, name: str) -> Dict[str, object]:
+        """Stage 3: full instructions + entry for exactly one capability."""
+        if name not in self._index:
+            raise KeyError(f"capability not indexed: {name}")
+        descriptor = self._index[name]
+        return {
+            "descriptor": descriptor.summary(),
+            "entry": descriptor.entry,
+            "instructions": self._bodies[name],
+        }
+
+    def match(self, task_text: str) -> Optional[CapabilityDescriptor]:
+        """Resolve a dispatched task to a capability via trigger keywords."""
+        lowered = task_text.lower()
+        best: Optional[CapabilityDescriptor] = None
+        best_score = 0
+        for descriptor in self._index.values():
+            score = sum(1 for trigger in descriptor.triggers if trigger.lower() in lowered)
+            if score > best_score:
+                best, best_score = descriptor, score
+        return best
+
+    @staticmethod
+    def read_index(path: Path) -> Dict[str, Dict[str, str]]:
+        """Validate and return registry/index.json content (git sources)."""
+        raw = json.loads(Path(path).read_text(encoding="utf-8"))
+        skills = raw.get("skills", {})
+        if not isinstance(skills, dict):
+            raise ManifestError("index.json skills must be an object")
+        for name, spec in skills.items():
+            if not isinstance(spec, dict) or "git" not in spec:
+                raise ManifestError(f"index entry {name!r} missing git source")
+        return skills
