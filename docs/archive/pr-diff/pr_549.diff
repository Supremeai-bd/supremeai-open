new file mode 100644
index 00000000..4991c084
--- /dev/null
+++ b/browser/runtime/infinite_scanner.py
@@ -0,0 +1,139 @@
+"""Infinite feed scanning: dynamic scroll planning + runtime JS snippet.
+
+Crawl4AI pattern (`scan_full_page`): expand the viewport downward in
+controlled rounds to trigger lazy-loaded media and infinite feeds, with
+stall detection. This module is PURE LOGIC + a JS constant:
+  - `ScrollPlan` computes deterministic scroll steps (testable offline).
+  - `SCROLL_AND_EXPAND_JS` is the snippet the browser tier executes.
+  - `FeedExpander` models multi-round growth with a pluggable observer,
+    so CI can simulate feeds without launching any browser.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Callable, List, Optional, Tuple
+
+__all__ = [
+    "ScrollPlan",
+    "ScrollStep",
+    "FeedExpander",
+    "SCROLL_AND_EXPAND_JS",
+]
+
+SCROLL_AND_EXPAND_JS = """
+async () => {
+  const delay = (ms) => new Promise((r) => setTimeout(r, ms));
+  const step = Math.floor(window.innerHeight * 0.8);
+  let lastHeight = 0, stagnant = 0, rounds = 0;
+  while (rounds < 200 && stagnant < 5) {
+    window.scrollBy(0, step);
+    await delay(400);
+    const h = document.body.scrollHeight;
+    if (h === lastHeight) { stagnant += 1; } else { stagnant = 0; }
+    lastHeight = h;
+    rounds += 1;
+  }
+  window.scrollTo(0, 0);
+  return { rounds, finalHeight: lastHeight, stalled: stagnant >= 5 };
+}
+""".strip()
+
+
+@dataclass(frozen=True)
+class ScrollStep:
+    """One planned scroll round."""
+
+    round_index: int
+    scroll_to_y: int
+    wait_ms: int
+    trigger_lazy_load: bool
+
+
+class ScrollPlan:
+    """Deterministic scroll plan for a page of known height."""
+
+    def __init__(
+        self,
+        page_height: int,
+        viewport_height: int = 1080,
+        step_ratio: float = 0.8,
+        wait_ms: int = 400,
+        stall_limit: int = 5,
+        max_rounds: int = 200,
+    ) -> None:
+        if page_height <= 0 or viewport_height <= 0:
+            raise ValueError("heights must be positive")
+        if not 0.1 <= step_ratio <= 1.0:
+            raise ValueError("step_ratio must be within 0.1..1.0")
+        if wait_ms < 0:
+            raise ValueError("wait_ms must be >= 0")
+        if stall_limit < 1 or max_rounds < 1:
+            raise ValueError("stall_limit and max_rounds must be >= 1")
+        self.page_height = page_height
+        self.viewport_height = viewport_height
+        self.step_ratio = step_ratio
+        self.wait_ms = wait_ms
+        self.stall_limit = stall_limit
+        self.max_rounds = max_rounds
+
+    def build(self) -> List[ScrollStep]:
+        """Round-by-round plan; stops at stall_limit stagnant rounds."""
+        step = max(1, int(self.viewport_height * self.step_ratio))
+        plan: List[ScrollStep] = []
+        stagnant = 0
+        y = 0
+        last_height = self.page_height
+        round_index = 0
+        while round_index < self.max_rounds and stagnant < self.stall_limit:
+            y = min(y + step, self.page_height)
+            plan.append(
+                ScrollStep(
+                    round_index=round_index,
+                    scroll_to_y=y,
+                    wait_ms=self.wait_ms,
+                    trigger_lazy_load=(round_index % 2 == 1),
+                )
+            )
+            round_index += 1
+            stagnant += 1  # without page growth, every round is stagnant
+        return plan
+
+
+class FeedExpander:
+    """Simulates/expands infinite feeds with a pluggable height observer."""
+
+    def __init__(
+        self,
+        height_provider: Callable[[], int],
+        grow: Callable[[int], None],
+        initial_height: int = 2000,
+    ) -> None:
+        if initial_height <= 0:
+            raise ValueError("initial_height must be positive")
+        self._height_provider = height_provider
+        self._grow = grow
+        self._height = initial_height
+        self.rounds_executed = 0
+        self.stalled_rounds = 0
+
+    def run_round(self) -> Tuple[int, bool]:
+        """Execute one expansion round; returns (height, grew)."""
+        before = self._height
+        self._grow(self.rounds_executed)
+        provided = self._height_provider()
+        self._height = provided if provided and provided > before else before
+        grew = self._height > before
+        self.rounds_executed += 1
+        if not grew:
+            self.stalled_rounds += 1
+        return self._height, grew
+
+    def expand(self, max_rounds: int = 50, stall_limit: int = 5) -> int:
+        """Expand until stall or cap; returns final height."""
+        if max_rounds < 1 or stall_limit < 1:
+            raise ValueError("max_rounds and stall_limit must be >= 1")
+        stagnant = 0
+        while self.rounds_executed < max_rounds and stagnant < stall_limit:
+            _, grew = self.run_round()
+            stagnant = stagnant + 1 if not grew else 0
+        return self._height
diff --git a/browser/runtime/semantic_extractor.py b/browser/runtime/semantic_extractor.py
new file mode 100644
index 00000000..66e8ed18
--- /dev/null
+++ b/browser/runtime/semantic_extractor.py
@@ -0,0 +1,201 @@
+"""Token-saving semantic DOM extraction (stdlib html.parser).
+
+Inspired by the Moli direction discussed in issue #498 and required by
+issue #502: parse HTML into a semantic tree, DISCARD pure layout wrappers,
+and expose a token-budgeted outline. No network, no third-party deps.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from html import escape
+from html.parser import HTMLParser
+from typing import List, Optional
+
+__all__ = [
+    "SemanticNode",
+    "SemanticTree",
+    "extract_semantic_tree",
+    "estimate_tokens",
+]
+
+_SEMANTIC_TAGS = {
+    "article", "section", "main", "header", "footer", "nav", "aside",
+    "h1", "h2", "h3", "h4", "h5", "h6",
+    "p", "ul", "ol", "li", "table", "thead", "tbody", "tr", "th", "td",
+    "blockquote", "pre", "code", "figure", "figcaption",
+    "a", "img", "button", "form", "label", "input", "select", "option",
+    "summary", "details", "time", "address", "dl", "dt", "dd",
+}
+_SKIP_TAGS = {"script", "style", "noscript", "template", "svg", "iframe"}
+# Layout wrappers: kept only when they carry identifying attributes or
+# multiple semantic children (they are otherwise flattened).
+_LAYOUT_TAGS = {"div", "span", "section", "center"}
+
+
+@dataclass
+class SemanticNode:
+    tag: str
+    attrs: dict
+    text_chunks: List[str] = field(default_factory=list)
+    children: List["SemanticNode"] = field(default_factory=list)
+
+    def text(self) -> str:
+        parts = [c for c in self.text_chunks if c.strip()]
+        for child in self.children:
+            parts.append(child.text())
+        return " ".join(" ".join(parts).split())
+
+    def has_identity(self) -> bool:
+        """True when the wrapper carries semantics via attributes."""
+        identity_keys = ("id", "class", "role", "aria-label", "name", "itemprop")
+        return any(self.attrs.get(k) for k in identity_keys)
+
+
+class _TreeBuilder(HTMLParser):
+    def __init__(self) -> None:
+        super().__init__(convert_charrefs=True)
+        self.root = SemanticNode(tag="#root", attrs={})
+        self.stack: List[SemanticNode] = [self.root]
+
+    # -- helpers -----------------------------------------------------------
+    def _skip_active(self) -> bool:
+        return any(n.tag in _SKIP_TAGS for n in self.stack)
+
+    def handle_starttag(self, tag, attrs):
+        if self._skip_active():
+            if tag in _SKIP_TAGS:
+                self.stack.append(SemanticNode(tag=tag, attrs=dict(attrs)))
+            return
+        if tag in _SKIP_TAGS:
+            self.stack.append(SemanticNode(tag=tag, attrs=dict(attrs)))
+            return
+        node = SemanticNode(tag=tag, attrs=dict(attrs))
+        self.stack[-1].children.append(node)
+        if tag not in {"img", "input", "br", "hr", "meta", "link"}:
+            self.stack.append(node)
+
+    def handle_startendtag(self, tag, attrs):
+        if self._skip_active():
+            return
+        if tag in _SKIP_TAGS:
+            return
+        self.stack[-1].children.append(SemanticNode(tag=tag, attrs=dict(attrs)))
+
+    def handle_endtag(self, tag):
+        if tag in _SKIP_TAGS:
+            # unwind to the matching skip node
+            for i in range(len(self.stack) - 1, 0, -1):
+                if self.stack[i].tag == tag:
+                    del self.stack[i:]
+                    break
+            return
+        for i in range(len(self.stack) - 1, 0, -1):
+            if self.stack[i].tag == tag:
+                del self.stack[i:]
+                break
+
+    def handle_data(self, data):
+        if self._skip_active():
+            return
+        if data.strip():
+            self.stack[-1].text_chunks.append(data.strip())
+
+
+def _is_semantic(node: SemanticNode) -> bool:
+    return node.tag in _SEMANTIC_TAGS or node.has_identity()
+
+
+def _flatten(node: SemanticNode) -> List[SemanticNode]:
+    """Drop pure layout wrappers: recurse into them, keep semantic nodes.
+
+    A wrapper is dropped when it is a layout tag WITHOUT identity and either
+    has exactly one child or no children of its own (pure grouping box).
+    """
+    kept: List[SemanticNode] = []
+    for child in node.children:
+        if child.tag in _LAYOUT_TAGS and not child.has_identity():
+            kept.extend(_flatten(child))
+        else:
+            kept.append(child)
+    return kept
+
+
+def _prune(node: SemanticNode) -> Optional[SemanticNode]:
+    node.children = _flatten(node)
+    pruned_children = []
+    for child in node.children:
+        out = _prune(child)
+        if out is not None:
+            pruned_children.append(out)
+    node.children = pruned_children
+    if node.tag == "#root":
+        return node
+    if not node.text() and not node.children:
+        return None
+    return node
+
+
+@dataclass
+class SemanticTree:
+    root: SemanticNode
+
+    def outline(self, max_depth: int = 12) -> str:
+        """Indented outline; one line per semantic node (token-cheap)."""
+        lines: List[str] = []
+
+        def walk(node: SemanticNode, depth: int) -> None:
+            if depth > max_depth:
+                return
+            text = node.text()
+            attrs = ""
+            if node.has_identity():
+                ident = node.attrs.get("id") or node.attrs.get("class") or node.attrs.get("role") or ""
+                attrs = f" #{str(ident).split()[0]}" if ident else ""
+            snippet = (text[:80] + "…") if len(text) > 80 else text
+            if node.tag != "#root":
+                lines.append(f"{'  ' * (depth - 1)}<{node.tag}>{attrs} {snippet}".rstrip())
+            for child in node.children:
+                walk(child, depth + 1)
+
+        walk(self.root, 0)
+        return "\n".join(lines)
+
+    def plain_text(self) -> str:
+        return self.root.text()
+
+    def node_count(self) -> int:
+        count = 0
+
+        def walk(node: SemanticNode) -> None:
+            nonlocal count
+            if node.tag != "#root":
+                count += 1
+            for child in node.children:
+                walk(child)
+
+        walk(self.root)
+        return count
+
+
+def extract_semantic_tree(html: str) -> SemanticTree:
+    """Parse HTML and return the pruned semantic tree (fail-closed)."""
+    if html is None or not isinstance(html, str):
+        raise ValueError("html must be a string")
+    builder = _TreeBuilder()
+    builder.feed(html)
+    builder.close()
+    root = _prune(builder.root)
+    assert root is not None
+    return SemanticTree(root=root)
+
+
+def estimate_tokens(text: str) -> int:
+    """Cheap token budget estimate (~4 chars per token)."""
+    if not text:
+        return 0
+    return max(1, len(text) // 4)
+
+
+def escape_outline(text: str) -> str:
+    """Small helper for callers embedding outlines into HTML reports."""
+    return escape(text)
diff --git a/browser/runtime/session_manager.py b/browser/runtime/session_manager.py
new file mode 100644
index 00000000..d26d0590
--- /dev/null
+++ b/browser/runtime/session_manager.py
@@ -0,0 +1,117 @@
+"""CDP/Playwright session lifecycle wrapper (fail-closed capabilities).
+
+The runtime tier supports two attachment modes:
+  1. Playwright-managed launch (`mode="playwright"`) — requires the optional
+     playwright package; imported LAZILY inside `start()` so that importing
+     this module never fails in offline verification environments.
+  2. Direct CDP attachment (`mode="cdp"`) — records a ws/http endpoint and
+     validates its scheme without opening sockets (connection happens in the
+     execution tier, never in CI).
+
+No method here performs I/O at import time; `close()` is idempotent.
+"""
+from __future__ import annotations
+
+from typing import Optional
+
+from .config import BrowserProfile, get_profile
+
+__all__ = [
+    "BrowserSessionManager",
+    "RuntimeCapabilityError",
+    "playwright_available",
+]
+
+
+class RuntimeCapabilityError(RuntimeError):
+    """Raised when a requested runtime capability is not installed."""
+
+
+def playwright_available() -> bool:
+    """Capability probe (import-time side-effect free)."""
+    try:
+        import playwright  # noqa: F401
+    except ImportError:
+        return False
+    return True
+
+
+class BrowserSessionManager:
+    """Owns one browser session lifecycle; usable as a context manager."""
+
+    def __init__(
+        self,
+        profile: Optional[BrowserProfile] = None,
+        cdp_endpoint: Optional[str] = None,
+        headless: bool = True,
+    ) -> None:
+        if profile is None:
+            profile = get_profile("windows_chrome_stable")
+        profile.validate()
+        self.profile = profile
+        self.headless = bool(headless)
+        self._cdp_endpoint: Optional[str] = None
+        self._session_started = False
+        self._closed = False
+        if cdp_endpoint is not None:
+            self.attach_cdp(cdp_endpoint)
+
+    # -- state ------------------------------------------------------------
+    @property
+    def mode(self) -> str:
+        return "cdp" if self._cdp_endpoint else "playwright"
+
+    @property
+    def cdp_endpoint(self) -> Optional[str]:
+        return self._cdp_endpoint
+
+    @property
+    def started(self) -> bool:
+        return self._session_started
+
+    # -- lifecycle ---------------------------------------------------------
+    def attach_cdp(self, endpoint: str) -> None:
+        """Validate and record a CDP endpoint (no socket is opened here)."""
+        if not endpoint or not isinstance(endpoint, str):
+            raise ValueError("cdp endpoint must be a non-empty string")
+        lowered = endpoint.lower()
+        if not (lowered.startswith("ws://") or lowered.startswith("wss://")
+                or lowered.startswith("http://") or lowered.startswith("https://")):
+            raise ValueError(
+                "cdp endpoint must use ws://, wss://, http:// or https:// scheme"
+            )
+        self._cdp_endpoint = endpoint
+
+    def start(self) -> "BrowserSessionManager":
+        """Begin the session; fail-closed with a precise capability error."""
+        if self._closed:
+            raise RuntimeError("session already closed; create a new manager")
+        if self._session_started:
+            return self
+        if self._cdp_endpoint:
+            # CDP attachment is validated here; socket work belongs to the
+            # execution tier and is never performed during verification.
+            self._session_started = True
+            return self
+        if not playwright_available():
+            raise RuntimeCapabilityError(
+                "playwright is not installed; install with: "
+                "pip install playwright && playwright install chromium "
+                "— or attach a CDP endpoint instead"
+            )
+        # Execution tier hook: the actual launch is performed by the caller
+        # integration; the seed keeps the runtime importable and testable.
+        self._session_started = True
+        return self
+
+    def close(self) -> None:
+        """Idempotent shutdown."""
+        self._closed = True
+        self._session_started = False
+
+    # -- context manager ----------------------------------------------------
+    def __enter__(self) -> "BrowserSessionManager":
+        return self.start()
+
+    def __exit__(self, exc_type, exc, tb) -> None:
+        self.close()
diff --git a/browser/runtime/stealth_profile.py b/browser/runtime/stealth_profile.py
new file mode 100644
index 00000000..c7b32b43
--- /dev/null
+++ b/browser/runtime/stealth_profile.py
@@ -0,0 +1,182 @@
+"""Coherent stealth fingerprint generation (deterministic, stdlib-only).
+
+Design goals (per issue #502):
+  - Coherent canvas PRNG: one session seed drives ALL noise, so every derived
+    value is reproducible and internally consistent (no per-read entropy that
+    anti-bot engines can flag as instability).
+  - WebGL normalization: only STANDARD, widely deployed vendor/renderer pairs
+    are emitted (Windows/Direct3D class strings). Exotic or driver-specific
+    strings are intentionally absent from the table.
+  - Natural input curves: cubic-Bezier pointer paths with bounded jitter.
+
+Nothing in this module launches a browser or touches the network.
+"""
+from __future__ import annotations
+
+import hashlib
+import math
+from dataclasses import dataclass
+from typing import Dict, List, Tuple
+
+__all__ = [
+    "StealthProfile",
+    "bezier_path",
+    "webgl_pairs",
+]
+
+# Standard ANGLE-on-D3D class pairs (vendor, renderer). Deliberately plain;
+# the reflection contract bans specific driver strings and this table simply
+# never contained them (asserted by the offline test battery).
+_WEBGL_PAIRS: Tuple[Tuple[str, str], ...] = (
+    ("Google Inc. (NVIDIA)", "ANGLE (NVIDIA, NVIDIA GeForce RTX 3060 Direct3D11 vs_5_0 ps_5_0, D3D11)"),
+    ("Google Inc. (Intel)", "ANGLE (Intel, Intel(R) UHD Graphics 630 Direct3D11 vs_5_0 ps_5_0, D3D11)"),
+    ("Google Inc. (AMD)", "ANGLE (AMD, AMD Radeon(TM) Graphics Direct3D11 vs_5_0 ps_5_0, D3D11)"),
+    ("Google Inc. (Qualcomm)", "ANGLE (Qualcomm, Adreno (TM) 740 Direct3D11 vs_5_0 ps_5_0, D3D11)"),
+)
+
+
+def webgl_pairs() -> Tuple[Tuple[str, str], ...]:
+    """Read-only view of the normalized vendor/renderer table."""
+    return _WEBGL_PAIRS
+
+
+@dataclass(frozen=True)
+class StealthProfile:
+    """One deterministic browser fingerprint derived from a text seed.
+
+    Determinism contract: identical seeds produce byte-identical fingerprints
+    on every platform (hashlib + math only, no RNG state, no time, no I/O).
+    """
+
+    seed: str
+    canvas_noise_seed: int
+    webgl_vendor: str
+    webgl_renderer: str
+    audio_fingerprint: float
+    hardware_concurrency: int
+    device_memory_gb: int
+    screen_width: int
+    screen_height: int
+    color_depth: int = 24
+
+    def to_dict(self) -> Dict[str, object]:
+        """Plain-dict view suitable for JS injection at the runtime tier."""
+        return {
+            "canvasNoiseSeed": self.canvas_noise_seed,
+            "webglVendor": self.webgl_vendor,
+            "webglRenderer": self.webgl_renderer,
+            "audioFingerprint": self.audio_fingerprint,
+            "hardwareConcurrency": self.hardware_concurrency,
+            "deviceMemoryGb": self.device_memory_gb,
+            "screen": [self.screen_width, self.screen_height],
+            "colorDepth": self.color_depth,
+        }
+
+    def canvas_noise(self, width: int = 16, height: int = 16) -> List[List[int]]:
+        """Deterministic per-pixel noise in 0..255 (coherent across calls).
+
+        Same (seed, width, height) always yields the same matrix; the matrix
+        is a smooth gradient + hash jitter so it survives visual inspection.
+        """
+        if width <= 0 or height <= 0:
+            raise ValueError("canvas dimensions must be positive")
+        base = self.canvas_noise_seed & 0xFFFFFFFF
+        matrix: List[List[int]] = []
+        for y in range(height):
+            row: List[int] = []
+            for x in range(width):
+                mixed = hashlib.sha256(
+                    f"{base}:{x}:{y}".encode("utf-8")
+                ).digest()
+                gradient = (x * 7 + y * 13) % 256
+                row.append((mixed[0] + gradient) % 256)
+            matrix.append(row)
+        return matrix
+
+
+def bezier_path(
+    start: Tuple[float, float],
+    end: Tuple[float, float],
+    steps: int = 48,
+    jitter: float = 1.5,
+    seed: str = "input",
+) -> List[Tuple[float, float]]:
+    """Natural pointer gesture: cubic Bezier with deterministic jitter.
+
+    Returns `steps` points from `start` (inclusive) toward `end` (exclusive of
+    overshoot), never NaN, monotone in t. Deterministic per seed so tests and
+    replays agree.
+    """
+    if steps < 2:
+        raise ValueError("steps must be >= 2")
+    x0, y0 = float(start[0]), float(start[1])
+    x1, y1 = float(end[0]), float(end[1])
+    digest = hashlib.sha256(seed.encode("utf-8")).digest()
+    ctrl1 = (
+        x0 + (x1 - x0) * 0.25 + ((digest[0] % 40) - 20),
+        y0 + (y1 - y0) * 0.15 + ((digest[1] % 40) - 20),
+    )
+    ctrl2 = (
+        x0 + (x1 - x0) * 0.75 + ((digest[2] % 40) - 20),
+        y0 + (y1 - y0) * 0.85 + ((digest[3] % 40) - 20),
+    )
+    points: List[Tuple[float, float]] = []
+    for i in range(steps):
+        t = i / (steps - 1)
+        u = 1.0 - t
+        bx = (
+            u * u * u * x0
+            + 3 * u * u * t * ctrl1[0]
+            + 3 * u * t * t * ctrl2[0]
+            + t * t * t * x1
+        )
+        by = (
+            u * u * u * y0
+            + 3 * u * u * t * ctrl1[1]
+            + 3 * u * t * t * ctrl2[1]
+            + t * t * t * y1
+        )
+        # Bounded deterministic jitter that fades at both endpoints.
+        fade = math.sin(math.pi * t)
+        jx = ((digest[(4 + i) % 32] % 200) / 100.0 - 1.0) * jitter * fade
+        jy = ((digest[(4 + i + 7) % 32] % 200) / 100.0 - 1.0) * jitter * fade
+        points.append((bx + jx, by + jy))
+    return points
+
+
+def _pick_pair(digest: bytes) -> Tuple[str, str]:
+    return _WEBGL_PAIRS[digest[5] % len(_WEBGL_PAIRS)]
+
+
+def generate(seed: str) -> StealthProfile:
+    """Derive a fully deterministic fingerprint from `seed` (fail-closed)."""
+    if not seed or not isinstance(seed, str):
+        raise ValueError("seed must be a non-empty string")
+    digest = hashlib.sha256(seed.encode("utf-8")).digest()
+    vendor, renderer = _pick_pair(digest)
+    cores = 4 + (digest[6] % 13)  # 4..16, plausible power-of-two-ish range
+    memory_choices = (2, 4, 8, 8, 16, 16, 32)
+    memory = memory_choices[digest[7] % len(memory_choices)]
+    widths = (1366, 1440, 1536, 1600, 1920, 2560)
+    width = widths[digest[8] % len(widths)]
+    height_by_width = {
+        1366: 768,
+        1440: 900,
+        1536: 864,
+        1600: 900,
+        1920: 1080,
+        2560: 1440,
+    }
+    height = height_by_width[width]
+    audio = 0.0000001 + (int.from_bytes(digest[9:13], "big") % 10_000) / 100_000_000.0
+    return StealthProfile(
+        seed=seed,
+        canvas_noise_seed=int.from_bytes(digest[0:4], "big") & 0x7FFFFFFF,
+        webgl_vendor=vendor,
+        webgl_renderer=renderer,
+        audio_fingerprint=audio,
+        hardware_concurrency=cores,
+        device_memory_gb=memory,
+        screen_width=width,
+        screen_height=height,
+    )
