+# SupremeAI QA checklist — Customer journey (C-01..C-10)
+# Schema: docs/plans/features/qa_engine_auto_checking_implementation_plan.md (Part 1)
+# Routes verified against frontend/src/App.tsx + frontend/src/auth/routePolicies.ts.
+# Auth behavior grounded in frontend/src/components/core/AuthGuards.tsx:
+#   - ProtectedRoute: unauthenticated -> <Navigate to="/login" replace />
+#   - GuestRoute: authenticated visiting /login|/register -> <Navigate to="/workspace" replace />
+- id: C-01
+  area: auth
+  role: customer
+  name: Login form authenticates customer into workspace
+  description: >
+    Submitting valid customer credentials on /login authenticates the user
+    and lands them on /workspace (identity.ts resolveLandingPath).
+  route: /login
+  severity: P0
+  automated: true
+  action:
+    - navigate: /login
+    - fill: '[data-testid="email-input"] =<qa-customer-email>'
+    - fill: '[data-testid="password-input"] =<qa-customer-password>'
+    - click: '[data-testid="login-submit"]'
+  assert:
+    - url_matches: ^/workspace
+  manual_note: "Resolved (M0-G): Part-9 testids (email-input/password-input/login-submit) implemented on LoginPage; automation in qa/playwright/customer/.auth/auth.setup.ts. Env prerequisites: QA_CUSTOMER_EMAIL/QA_CUSTOMER_PASSWORD + QA_BASE_URL deployment with reachable auth backend."
+
+- id: C-02
+  area: auth
+  role: customer
+  name: Session survives a full page reload
+  description: >
+    An authenticated customer can reload /workspace and stays logged in —
+    the auth store rehydrates (status LOGGED_IN) instead of bouncing to /login.
+  route: /workspace
+  severity: P0
+  automated: true
+  action:
+    - navigate: /workspace
+    - reload: page
+  assert:
+    - url_matches: ^/workspace
+    - not_url_matches: ^/login$
+  manual_note: Requires the customer storage state produced by qa/playwright/customer/.auth/auth.setup.ts.
+
+- id: C-03
+  area: auth
+  role: customer
+  name: Authenticated user is bounced away from /login
+  description: >
+    A logged-in customer visiting /login is redirected to /workspace by
+    GuestRoute; the login form is never shown to an authenticated session.
+  route: /login
+  severity: P1
+  automated: true
+  action:
+    - navigate: /login
+  assert:
+    - url_matches: ^/workspace
+  manual_note: null
+
+- id: C-04
+  area: workspace
+  role: customer
+  name: Projects page loads for authenticated customer
+  description: >
+    /projects renders the projects workspace module for an authenticated
+    customer with HTTP 200 and no redirect to /login.
+  route: /projects
+  severity: P1
+  automated: true
+  action:
+    - navigate: /projects
+  assert:
+    - response_status: "200"
+    - url_matches: ^/projects$
+  manual_note: null
+
+- id: C-05
+  area: files
+  role: customer
+  name: File upload stores file in backend
+  description: >
+    Uploading a file from /files persists it (visible after reload) —
+    backend storage confirmed, not just optimistic UI state.
+  route: /files
+  severity: P1
+  automated: true
+  action:
+    - navigate: /files
+    - upload: 'input[type="file"] =qa-test.txt'
+    - click: '[data-testid="upload-submit"]'
+  assert:
+    - text_visible: qa-test.txt
+    - text_visible_after_reload: qa-test.txt
+  manual_note: "Still blocked (M0-G): /files (WorkspaceModulePage module='files') is a static page — no upload UI exists to instrument (upload-btn/file-input/upload-submit); needs the file-upload feature plus a reachable storage backend."
+
+- id: C-06
+  area: settings
+  role: customer
+  name: API keys page loads for authenticated customer
+  description: >
+    /settings/api-keys (SecretsPage) renders inside the workspace layout
+    with HTTP 200 for an authenticated customer.
+  route: /settings/api-keys
+  severity: P1
+  automated: true
+  action:
+    - navigate: /settings/api-keys
+  assert:
+    - response_status: "200"
+    - url_matches: ^/settings/api-keys$
+  manual_note: null
+
+- id: C-07
+  area: workspace
+  role: customer
+  name: AI Studio live workspace loads
+  description: >
+    /workspace/live (AIStudio inside WorkspaceLayout) loads for an
+    authenticated customer without crashing the shell.
+  route: /workspace/live
+  severity: P2
+  automated: true
+  action:
+    - navigate: /workspace/live
+  assert:
+    - response_status: "200"
+    - url_matches: ^/workspace/live$
+  manual_note: null
+
+- id: C-08
+  area: projects
+  role: customer
+  name: Created project persists after reload
+  description: >
+    Creating a project from /projects shows it in the list and it is still
+    present after a full reload (backend persistence, not local state only).
+  route: /projects
+  severity: P2
+  automated: true
+  action:
+    - navigate: /projects
+    - click: '[data-testid="create-project-btn"]'
+    - fill: '[data-testid="project-name-input"] =QA-Project-<run-id>'
+    - click: '[data-testid="create-project-submit"]'
+    - reload: page
+  assert:
+    - text_visible: QA-Project-<run-id>
+  manual_note: "Still blocked (M0-G): /projects (WorkspaceModulePage module='projects') is a static page — no create-project UI exists to instrument (create-project-btn/project-name-input/create-project-submit); needs the create-project feature."
+
+- id: C-09
+  area: billing
+  role: customer
+  name: Usage cost dashboard loads
+  description: >
+    /usage (CostDashboard inside WorkspaceLayout) loads for an authenticated
+    customer with HTTP 200.
+  route: /usage
+  severity: P2
+  automated: true
+  action:
+    - navigate: /usage
+  assert:
+    - response_status: "200"
+    - url_matches: ^/usage$
+  manual_note: null
+
+- id: C-10
+  area: auth
+  role: customer
+  name: Logout returns user to login
+  description: >
+    Triggering logout from the global header ends the session and navigates
+    the customer to /login; protected routes then bounce to login again.
