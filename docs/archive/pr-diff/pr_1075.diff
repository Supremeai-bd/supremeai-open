diff --git a/examples/vscode-agent-monitor/src/extension.ts b/examples/vscode-agent-monitor/src/extension.ts
new file mode 100644
index 00000000..e6a79a74
--- /dev/null
+++ b/examples/vscode-agent-monitor/src/extension.ts
@@ -0,0 +1,108 @@
+/**
+ * extension.ts — vscode glue (issue #333 AC1+AC2).
+ *
+ * The ONLY module importing 'vscode'. Everything testable lives in the pure
+ * modules (statusLogic, resilience, wsTransport). Wiring:
+ *   status bar item  <- statusBarView(monitor state)          (AC1)
+ *   output channel   <- outputLine(frame) via bounded buffer  (AC2)
+ *   reconnecting ws  <- injected WebSocket factory             (AC3)
+ *
+ * The WebSocket runtime is resolved honestly: global WebSocket if present,
+ * else the optional 'ws' package, else the monitor reports "unsupported"
+ * and stays idle — it never crashes the extension host.
+ */
+import * as vscode from "vscode";
+import { createRequire } from "node:module";
+import { ReconnectingTransport, type WsFactory, type WsLike } from "./wsTransport";
+import { BoundedOutputBuffer, ReconnectBackoff } from "./resilience";
+import { initialState, outputLine, statusBarView, type MonitorState } from "./statusLogic";
+
+function resolveWsFactory(): { factory: WsFactory; note: string } | null {
+  const g = globalThis as { WebSocket?: new (url: string) => WsLike };
+  if (typeof g.WebSocket === "function") {
+    const Ctor = g.WebSocket;
+    return { factory: (url) => new Ctor(url), note: "global WebSocket" };
+  }
+  try {
+    const nodeRequire = createRequire(__filename);
+    const Ws = nodeRequire("ws") as (new (url: string) => WsLike) | undefined;
+    if (typeof Ws === "function") {
+      return { factory: (url) => new Ws(url), note: "ws package" };
+    }
+  } catch {
+    // ws package absent - fall through to unsupported
+  }
+  return null;
+}
+
+export function activate(context: vscode.ExtensionContext): void {
+  const statusItem = vscode.window.createStatusBarItem(vscode.StatusBarAlignment.Right, 100);
+  const output = vscode.window.createOutputChannel("SupremeAI Agent Monitor");
+  const buffer = new BoundedOutputBuffer(2000);
+  const state: { monitor: MonitorState } = { monitor: initialState() };
+
+  const render = () => {
+    const view = statusBarView(state.monitor);
+    statusItem.text = view.text;
+    statusItem.tooltip = view.tooltip;
+    statusItem.backgroundColor =
+      view.status === "error"
+        ? new vscode.ThemeColor("statusBarItem.errorBackground")
+        : undefined;
+  };
+  render();
+
+  const cfg = vscode.workspace.getConfiguration("supremeaiAgentMonitor");
+  const towerUrl = String(cfg.get("towerUrl") ?? "ws://127.0.0.1:8765");
+  const taskFilter = String(cfg.get("taskFilter") ?? "");
+
+  let transport: ReconnectingTransport | null = null;
+
+  const connectCmd = vscode.commands.registerCommand("supremeaiAgentMonitor.connect", () => {
+    if (transport) {
+      output.appendLine("already running");
+      return;
+    }
+    const resolved = resolveWsFactory();
+    if (resolved === null) {
+      vscode.window.showWarningMessage(
+        "SupremeAI Agent Monitor: no WebSocket runtime available (need global WebSocket or the ws package).",
+      );
+      return;
+    }
+    output.appendLine(`connecting to ${towerUrl} via ${resolved.note}`);
+    transport = new ReconnectingTransport(towerUrl, resolved.factory, {
+      onFrame: (frame, monitor) => {
+        state.monitor = monitor;
+        render();
+        if (taskFilter === "" || frame.task_id === taskFilter || frame.frame_type === "heartbeat") {
+          buffer.push(outputLine(frame));
+          for (const line of buffer.drain()) output.appendLine(line);
+        }
+      },
+      onOutput: (line) => output.appendLine(line),
+      onStatusNote: (note) => output.appendLine(`[transport] ${note}`),
+      onResync: (reason) => {
+        output.appendLine(`[resync] ${reason} - reconnecting for a fresh seq space`);
+      },
+    }, new ReconnectBackoff());
+    transport.start();
+  });
+
+  const disconnectCmd = vscode.commands.registerCommand("supremeaiAgentMonitor.disconnect", () => {
+    if (transport) {
+      transport.dispose();
+      transport = null;
+      state.monitor = initialState();
+      render();
+      output.appendLine("disconnected");
+    }
+  });
+
+  context.subscriptions.push(statusItem, output, connectCmd, disconnectCmd);
+  statusItem.show();
+}
+
+export function deactivate(): void {
+  // transport disposal is owned by the connect command's closure
+}
diff --git a/examples/vscode-agent-monitor/src/resilience.ts b/examples/vscode-agent-monitor/src/resilience.ts
new file mode 100644
index 00000000..c0629411
--- /dev/null
+++ b/examples/vscode-agent-monitor/src/resilience.ts
@@ -0,0 +1,71 @@
+/**
+ * resilience.ts — reconnect backoff + bounded output buffer (issue #333 AC3).
+ *
+ * Backoff: exponential with full jitter, capped; resets after a stable
+ * connection. Buffer: bounded line buffer that drops OLDEST lines with an
+ * explicit truncation marker — a flooded stream can stall a stream, it can
+ * never freeze the IDE (AC3).
+ */
+
+/** Backoff schedule: full jitter over exponential windows. */
+export class ReconnectBackoff {
+  private attempt = 0;
+  constructor(
+    private readonly baseMs = 1000,
+    private readonly capMs = 60_000,
+    private readonly rng: () => number = Math.random,
+  ) {
+    if (baseMs <= 0 || capMs < baseMs) {
+      throw new Error("backoff: require 0 < baseMs <= capMs (fail-closed)");
+    }
+  }
+
+  /** Next delay in ms; deterministic given the injected rng. */
+  next(): number {
+    const exp = Math.min(this.capMs, this.baseMs * Math.pow(2, this.attempt));
+    this.attempt += 1;
+    const jitter = Math.floor(this.rng() * exp * 0.5);
+    return Math.min(this.capMs, exp - jitter);
+  }
+
+  /** A stable connection resets the schedule (spec etiquette). */
+  reset(): void {
+    this.attempt = 0;
+  }
+
+  get attempts(): number {
+    return this.attempt;
+  }
+}
+
+export const TRUNCATION_MARKER = "... earlier lines dropped (buffer cap)";
+
+/** Bounded output buffer: keeps the most recent maxLines, marks truncation. */
+export class BoundedOutputBuffer {
+  private lines: string[] = [];
+  private truncated = false;
+  constructor(private readonly maxLines = 2000) {
+    if (!Number.isInteger(maxLines) || maxLines < 10) {
+      throw new Error("buffer: maxLines must be an integer >= 10 (fail-closed)");
+    }
+  }
+
+  push(line: string): void {
+    if (this.lines.length >= this.maxLines) {
+      this.lines.shift();
+      this.truncated = true;
+    }
+    this.lines.push(line);
+  }
+
+  drain(): string[] {
+    const out = this.truncated ? [TRUNCATION_MARKER, ...this.lines] : [...this.lines];
+    this.lines = [];
+    this.truncated = false;
+    return out;
+  }
+
+  get size(): number {
+    return this.lines.length;
+  }
+}
diff --git a/examples/vscode-agent-monitor/src/statusLogic.ts b/examples/vscode-agent-monitor/src/statusLogic.ts
new file mode 100644
index 00000000..09fa43a6
--- /dev/null
+++ b/examples/vscode-agent-monitor/src/statusLogic.ts
@@ -0,0 +1,219 @@
+/**
+ * statusLogic.ts — PURE status-bar state machine (issue #333 AC1).
+ *
+ * Consumes validated websocket-events frames (WEBSOCKET_SPEC.md section 1)
+ * and derives the agent status: idle | busy | error. Zero vscode imports —
+ * fully unit-testable offline; the extension layer only renders the state.
+ *
+ * Frame validation is fail-closed per the spec's poka-yoke clause: a frame
+ * whose envelope fields are malformed is DROPPED (with a reason), never
+ * half-interpreted. Seq gaps trigger a RESYNC signal (spec: a receiver
+ * seeing a gap MUST resync rather than replay stale state).
+ */
+
+export type AgentStatus = "idle" | "busy" | "error";
+
+export interface StatusFrame {
+  frame_type: "event" | "heartbeat";
+  seq: number;
+  timestamp: string;
+  event?: string;
+  task_id?: string;
+  agent_id?: string;
+  payload?: unknown;
+  heartbeat?: { kind?: string; interval_seconds?: number; timeout_seconds?: number };
+}
+
+export const EVENT_NAMES = [
+  "agent:started",
+  "agent:thought",
+  "tool:invoking",
+  "tool:result",
+  "agent:done",
+  "agent:error",
+] as const;
+
+export type FrameVerdict =
+  | { kind: "accepted"; frame: StatusFrame }
+  | { kind: "dropped"; reason: string }
+  | { kind: "resync"; reason: string };
+
+const RFC3339_RE = /^\d{4}-\d{2}-\d{2}[Tt]\d{2}:\d{2}:\d{2}(\.\d+)?([Zz]|[+-]\d{2}:\d{2})$/;
+const TASK_ID_RE = /^task-[a-zA-Z0-9_-]{1,64}$/;
+
+/** Validate one raw frame against the WEBSOCKET_SPEC envelope contract. */
+export function validateFrame(raw: unknown, state: { lastSeq: number | null }): FrameVerdict {
+  if (raw === null || typeof raw !== "object" || Array.isArray(raw)) {
+    return { kind: "dropped", reason: "frame is not a JSON object" };
+  }
+  const f = raw as Record<string, unknown>;
+  if (f.frame_type !== "event" && f.frame_type !== "heartbeat") {
+    return { kind: "dropped", reason: `frame_type '${String(f.frame_type)}' not in enum` };
+  }
+  if (typeof f.seq !== "number" || !Number.isInteger(f.seq) || f.seq < 0) {
+    return { kind: "dropped", reason: "seq must be an integer >= 0" };
+  }
+  if (typeof f.timestamp !== "string" || !RFC3339_RE.test(f.timestamp)) {
+    return { kind: "dropped", reason: "timestamp must be RFC 3339 UTC" };
+  }
+  // Ordering: seq increases by 1 per connection (spec section 1). A gap is
+  // the client's resync signal — never replay stale state over it.
+  if (state.lastSeq !== null && f.seq > state.lastSeq + 1) {
+    return { kind: "resync", reason: `seq gap ${state.lastSeq} -> ${f.seq}` };
+  }
+  if (f.frame_type === "heartbeat") {
+    const hb = f.heartbeat;
+    if (hb === null || typeof hb !== "object" ||
+        (hb as { kind?: unknown }).kind !== "ping" && (hb as { kind?: unknown }).kind !== "pong") {
+      return { kind: "dropped", reason: "heartbeat frames carry a ping/pong body" };
+    }
+    return { kind: "accepted", frame: f as unknown as StatusFrame };
+  }
+  // event frame: event tag + payload pinning
+  const event = f.event;
+  if (typeof event !== "string" || !(EVENT_NAMES as readonly string[]).includes(event)) {
+    return { kind: "dropped", reason: `event '${String(event)}' not in the 6-value catalog` };
+  }
+  if (typeof f.task_id !== "string" || !TASK_ID_RE.test(f.task_id)) {
+    return { kind: "dropped", reason: "event frames carry a task-<id> task_id" };
+  }
+  if (f.payload !== undefined && (f.payload === null || typeof f.payload !== "object" || Array.isArray(f.payload))) {
+    return { kind: "dropped", reason: "payload must be an object when present" };
+  }
+  const p = (f.payload ?? {}) as Record<string, unknown>;
+  switch (event) {
+    case "agent:started":
+      if (typeof p.goal !== "string" || p.goal.length === 0) {
+        return { kind: "dropped", reason: "agent:started requires payload.goal" };
+      }
+      break;
+    case "agent:thought":
+      if (typeof p.content !== "string") {
+        return { kind: "dropped", reason: "agent:thought requires payload.content" };
+      }
+      break;
+    case "tool:invoking":
+      if (typeof p.tool !== "string") {
+        return { kind: "dropped", reason: "tool:invoking requires payload.tool" };
+      }
+      break;
+    case "tool:result":
+      if (typeof p.tool !== "string" || (p.status !== "ok" && p.status !== "error")) {
+        return { kind: "dropped", reason: "tool:result requires payload.tool + status ok|error" };
+      }
+      break;
+    case "agent:error":
+      if (typeof p.error_code !== "string" || typeof p.message !== "string" || typeof p.retryable !== "boolean") {
+        return { kind: "dropped", reason: "agent:error requires error_code + message + retryable" };
+      }
+      break;
+    // agent:done has only optional fields
+  }
+  return { kind: "accepted", frame: f as unknown as StatusFrame };
+}
+
+export interface StatusBarView {
+  status: AgentStatus;
+  text: string; // includes the icon glyph prefix (no emoji, editor-safe)
+  tooltip: string;
+}
+
+/**
+ * Derive the status-bar view from the running state.
+ * AC1: idle, busy, error — with honest last-event context in the tooltip.
+ */
+export function statusBarView(state: MonitorState): StatusBarView {
+  switch (state.status) {
+    case "busy":
+      return {
+        status: "busy",
+        text: `$(sync~spin) SupremeAI: busy`,
+        tooltip: `Task ${state.currentTask ?? "?"} — last event ${state.lastEvent ?? "-"} (seq ${state.lastSeq ?? "-"})`,
+      };
+    case "error":
+      return {
+        status: "error",
+        text: `$(error) SupremeAI: error`,
+        tooltip: `Last failure: ${state.errorSummary ?? "agent:error"} (seq ${state.lastSeq ?? "-"})`,
+      };
+    default:
+      return {
+        status: "idle",
+        text: `$(circle-slash) SupremeAI: idle`,
+        tooltip: "No active agent task.",
+      };
+  }
+}
+
+export interface MonitorState {
+  status: AgentStatus;
+  currentTask: string | null;
+  lastEvent: string | null;
+  lastSeq: number | null;
+  errorSummary: string | null;
+}
+
+export function initialState(): MonitorState {
+  return { status: "idle", currentTask: null, lastEvent: null, lastSeq: null, errorSummary: null };
+}
+
+/**
+ * Reduce one ACCEPTED event frame into the monitor state.
+ * Terminal frames end a task (done -> idle, error -> error sticky until the
+ * next agent:started).
+ */
+export function reduceEvent(state: MonitorState, frame: StatusFrame): MonitorState {
+  if (frame.frame_type === "heartbeat") {
+    return { ...state, lastSeq: frame.seq };
+  }
+  const next: MonitorState = {
+    ...state,
+    lastSeq: frame.seq,
+    lastEvent: frame.event ?? null,
+  };
+  switch (frame.event) {
+    case "agent:started":
+      return { ...next, status: "busy", currentTask: frame.task_id ?? null, errorSummary: null };
+    case "agent:thought":
+    case "tool:invoking":
+    case "tool:result":
+      return next; // busy persists (started required first per lifecycle)
+    case "agent:done":
+      return { ...next, status: "idle", currentTask: null };
+    case "agent:error": {
+      const p = (frame.payload ?? {}) as { error_code?: string; message?: string };
+      return {
+        ...next,
+        status: "error",
+        errorSummary: `${p.error_code ?? "error"}: ${(p.message ?? "").slice(0, 120)}`,
+      };
+    }
+    default:
+      return next;
+  }
+}
+
+/** Render one accepted frame as an OutputChannel line (AC2). */
+export function outputLine(frame: StatusFrame): string {
+  const t = frame.timestamp;
+  if (frame.frame_type === "heartbeat") {
+    return `${t} heartbeat ${frame.heartbeat?.kind ?? "ping"}`;
+  }
+  const p = (frame.payload ?? {}) as Record<string, unknown>;
+  switch (frame.event) {
+    case "agent:started":
+      return `${t} START  ${frame.task_id} goal: ${String(p.goal).slice(0, 80)}`;
+    case "agent:thought":
+      return `${t} THINK  ${String(p.content).slice(0, 200)}${p.truncated ? " (truncated)" : ""}`;
+    case "tool:invoking":
+      return `${t} CALL   ${String(p.tool)}${p.invocation_id ? ` inv=${String(p.invocation_id)}` : ""}`;
+    case "tool:result":
+      return `${t} RESULT ${String(p.tool)} status=${String(p.status)}${p.duration_ms ? ` (${String(p.duration_ms)}ms)` : ""}`;
+    case "agent:done":
+      return `${t} DONE   ${frame.task_id}`;
+    case "agent:error":
+      return `${t} ERROR  ${String(p.error_code)}: ${String(p.message).slice(0, 160)}`;
+    default:
+      return `${t} event  ${String(frame.event)}`;
+  }
+}
diff --git a/examples/vscode-agent-monitor/src/wsTransport.ts b/examples/vscode-agent-monitor/src/wsTransport.ts
new file mode 100644
index 00000000..ffb34535
--- /dev/null
+++ b/examples/vscode-agent-monitor/src/wsTransport.ts
@@ -0,0 +1,158 @@
+/**
+ * wsTransport.ts — reconnecting WebSocket transport (issue #333 AC3).
+ *
+ * The vscode WebSocket factory is INJECTED (extension layer may wire the
+ * 'ws' package or a global); tests inject a fake. Contract:
+ *  - callbacks only — the transport never throws synchronously into the
+ *    extension host (an unhandled throw here would freeze the window);
+ *  - every incoming message goes through validateFrame (fail-closed);
+ *  - seq-gap verdicts surface as onResync and the transport reconnects;
+ *  - server close / error -> backoff reconnect (unless dispose()d).
+ */
+
+import { ReconnectBackoff } from "./resilience";
+import { validateFrame, type StatusFrame, type MonitorState } from "./statusLogic";
+
+export interface WsLike {
+  close(): void;
+  send(data: string): void;
+  onmessage: ((ev: { data: unknown }) => void) | null;
+  onerror: ((err: unknown) => void) | null;
+  onclose: (() => void) | null;
+  onopen: (() => void) | null;
+}
+
+export type WsFactory = (url: string) => WsLike;
+
+export interface TransportHandlers {
+  onFrame: (frame: StatusFrame, state: MonitorState) => void;
+  onOutput: (line: string) => void;
+  onStatusNote: (note: string) => void;
+  onResync: (reason: string) => void;
+}
+
+export class ReconnectingTransport {
+  private disposed = false;
+  private ws: WsLike | null = null;
+  private backoff: ReconnectBackoff;
+  private monitor: MonitorState;
+  private reconnectTimer: ReturnType<typeof setTimeout> | null = null;
+  private lastSeq: number | null = null;
+
+  constructor(
+    private readonly url: string,
+    private readonly wsFactory: WsFactory,
+    private readonly handlers: TransportHandlers,
+    backoff?: ReconnectBackoff,
+  ) {
+    this.backoff = backoff ?? new ReconnectBackoff();
+    this.monitor = { status: "idle", currentTask: null, lastEvent: null, lastSeq: null, errorSummary: null };
+  }
+
+  get state(): MonitorState {
+    return this.monitor;
+  }
+
+  get isConnected(): boolean {
+    return this.ws !== null && this.reconnectTimer === null;
+  }
+
+  start(): void {
+    if (this.disposed) return;
+    this.open();
+  }
+
+  dispose(): void {
+    this.disposed = true;
+    if (this.reconnectTimer !== null) {
+      clearTimeout(this.reconnectTimer);
+      this.reconnectTimer = null;
+    }
+    if (this.ws) {
+      const ws = this.ws;
+      this.ws = null;
+      try { ws.onclose = null; ws.close(); } catch { /* best-effort dispose */ }
+    }
+  }
+
+  private open(): void {
+    if (this.disposed) return;
+    let ws: WsLike;
+    try {
+      ws = this.wsFactory(this.url);
+    } catch (err) {
+      this.handlers.onStatusNote(`websocket factory failed: ${String(err)}`);
+      this.scheduleReconnect();
+      return;
+    }
+    this.ws = ws;
+    ws.onopen = () => {
+      this.backoff.reset();
+      this.handlers.onStatusNote(`connected: ${this.url}`);
+    };
+    ws.onmessage = (ev) => this.ingest(ev.data);
+    ws.onerror = (err) => {
+      this.handlers.onStatusNote(`websocket error: ${String(err)}`);
+    };
+    ws.onclose = () => {
+      this.ws = null;
+      if (!this.disposed) {
+        this.handlers.onStatusNote("connection closed - reconnecting with backoff");
+        this.scheduleReconnect();
+      }
+    };
+  }
+
+  /** Feed one raw message through the fail-closed frame validator. */
+  ingest(raw: unknown): void {
+    let parsed = raw;
+    if (typeof raw === "string" || (raw && typeof (raw as { byteLength?: unknown }).byteLength === "number")) {
+      try {
+        parsed = JSON.parse(String(raw));
+      } catch {
+        this.handlers.onStatusNote("frame dropped: message is not valid JSON");
+        return;
+      }
+    }
+    const verdict = validateFrame(parsed, { lastSeq: this.lastSeq });
+    if (verdict.kind === "dropped") {
+      this.handlers.onStatusNote(`frame dropped: ${verdict.reason}`);
+      return;
+    }
+    if (verdict.kind === "resync") {
+      this.lastSeq = null;
+      this.handlers.onResync(verdict.reason);
+      // Spec: a receiver seeing a gap MUST resync. Reconnect (fresh seq
+      // space) rather than replaying stale state.
+      if (this.ws) {
+        const ws = this.ws;
+        this.ws = null;
+        try { ws.onclose = null; ws.close(); } catch { /* closing for resync */ }
+      }
+      this.scheduleReconnect();
+      return;
+    }
+    this.lastSeq = verdict.frame.seq;
+    this.monitor = reduceSafe(this.monitor, verdict.frame);
+    this.handlers.onFrame(verdict.frame, this.monitor);
+  }
+
+  private scheduleReconnect(): void {
+    if (this.disposed || this.reconnectTimer !== null) return;
+    const delay = this.backoff.next();
+    this.handlers.onStatusNote(`reconnect in ${delay}ms (attempt ${this.backoff.attempts})`);
+    this.reconnectTimer = setTimeout(() => {
+      this.reconnectTimer = null;
+      this.open();
+    }, delay);
+  }
+}
+
+import { reduceEvent } from "./statusLogic";
+function reduceSafe(state: MonitorState, frame: StatusFrame): MonitorState {
+  try {
+    return reduceEvent(state, frame);
+  } catch {
+    return state; // reducer must never break the pump (AC3)
+  }
+}
diff --git a/examples/vscode-agent-monitor/tsconfig.json b/examples/vscode-agent-monitor/tsconfig.json
new file mode 100644
index 00000000..c3a4bcd6
--- /dev/null
+++ b/examples/vscode-agent-monitor/tsconfig.json
