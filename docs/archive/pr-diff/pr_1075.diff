index 00000000..8e05b1d2
--- /dev/null
+++ b/examples/command-dispatch-reference/src/dispatch.mjs
@@ -0,0 +1,257 @@
+/**
+ * dispatch.mjs — omnichannel remote task injection handlers (issue #331).
+ *
+ * Zero-dependency reference implementation of:
+ *   - webhook task ingestion  (POST body -> instruction envelope -> dispatch)
+ *   - Telegram task ingestion (update -> /task command -> envelope candidate)
+ *   - envelope validation against the REAL landed schema
+ *     (api-schemas/instruction-envelope.schema.json, the deterministic
+ *     5-section envelope, issue #30)
+ *   - RBAC authorization against the REAL landed policy semantics
+ *     (api-schemas/permissions.schema.json, issue #28) with the
+ *     constitutional fail-closed defaults: anything not explicitly granted
+ *     does not exist (defaults.unknown_action = deny).
+ *
+ * Acceptance criterion 3 (fail-closed): unverified sources, malformed JSON,
+ * schema-invalid envelopes, unauthorized roles/chats and unknown actions are
+ * ALL rejected with structured errors — nothing is partially processed.
+ *
+ * Stateless (AGENTS.md §2): createDispatcher() closes over injected config;
+ * no module-level mutable state, no network calls (transport is the caller's).
+ */
+
+import { makeValidator } from "./schema_lite.mjs";
+
+const SPECIALIST_ROLES = new Set([
+  "coder", "auditor", "ci-fixer", "security-breaker", "browser-qa", "planner", "watcher",
+]);
+
+// 4-tier RBAC (permissions.schema.json RoleTier): the 7 specialist roles are
+// operational renderings of the tier-2 "agent" rung.
+const SPECIALIST_ROLE_TIER = 2;
+
+/** Timing-weak but dependency-free secret comparison over equal-length hashes. */
+function secretMatches(provided, expected) {
+  if (typeof provided !== "string" || typeof expected !== "string") return false;
+  if (provided.length !== expected.length) return false;
+  let diff = 0;
+  for (let i = 0; i < provided.length; i += 1) diff |= provided.charCodeAt(i) ^ expected.charCodeAt(i);
+  return diff === 0;
+}
+
+function deny(status, code, reason, extra = {}) {
+  return { status, ok: false, accepted: false, error: { code, reason, ...extra } };
+}
+
+/**
+ * Build the dispatcher. All configuration injected; nothing global.
+ *
+ * @param {object} opts
+ * @param {object} opts.envelopeSchema  parsed instruction-envelope schema
+ * @param {object} opts.permissionsPolicy parsed permissions policy (role_tiers,
+ *        permission_scopes, defaults with unknown_action=deny)
+ * @param {string} opts.webhookSecret  shared secret for the webhook route
+ * @param {number[]} opts.authorizedChatIds  Telegram chats allowed to inject
+ */
+export function createDispatcher(opts) {
+  const {
+    envelopeSchema, permissionsPolicy, webhookSecret, authorizedChatIds,
+  } = opts ?? {};
+  if (!envelopeSchema) throw new TypeError("envelopeSchema is required (fail-closed)");
+  if (!permissionsPolicy) throw new TypeError("permissionsPolicy is required (fail-closed)");
+  if (typeof webhookSecret !== "string" || webhookSecret.length < 8) {
+    throw new TypeError("webhookSecret must be a string of length >= 8 (fail-closed)");
+  }
+  if (!Array.isArray(authorizedChatIds) || authorizedChatIds.length === 0) {
+    throw new TypeError("authorizedChatIds must be a non-empty array (fail-closed: default-deny)");
+  }
+  const validateEnvelope = makeValidator(envelopeSchema);
+  const policy = permissionsPolicy;
+  if (policy?.defaults?.unknown_action !== "deny") {
+    throw new TypeError("policy.defaults.unknown_action must be 'deny' (constitutional fail-closed)");
+  }
+
+  /** RBAC: deny-by-default (acceptance criterion 3).
+   *
+   * Order (all fail-closed): unknown scope/action -> deny; specialist roles
+   * are pinned to their agent_sub_roles allowed-scope list -> deny when the
+   * scope is not granted to that sub-role; tier check against min_role_tier;
+   * MFA demand when the scope requires it (defaults.unverified_mfa=deny).
+   */
+  function authorize(actorRole, scopeId, action, { mfaToken = null } = {}) {
+    const scope = (policy.permission_scopes || []).find((s) => s.scope_id === scopeId);
+    if (!scope) return { allowed: false, reason: `unknown scope '${scopeId}' — deny by default` };
+    if (!scope.actions.includes(action)) {
+      return { allowed: false, reason: `action '${action}' not granted on '${scopeId}' — deny by default` };
+    }
+    const subRole = (policy.agent_sub_roles || []).find((s) => s.sub_role === actorRole);
+    if (SPECIALIST_ROLES.has(actorRole)) {
+      if (!subRole) {
+        return { allowed: false, reason: `role '${actorRole}' has no agent_sub_roles grant — deny by default` };
+      }
+      if (!(subRole.allowed_permission_scope_ids || []).includes(scopeId)) {
+        return {
+          allowed: false,
+          reason: `sub-role '${actorRole}' is not granted scope '${scopeId}' — deny by default`,
+        };
+      }
+    }
+    let tier;
+    if (subRole) {
+      tier = SPECIALIST_ROLE_TIER; // sub-roles are operational renderings of the agent rung
+    } else {
+      const rung = (policy.role_tiers || []).find((r) => r.name === actorRole);
+      tier = rung ? rung.tier : 0;
+    }
+    if (tier < scope.min_role_tier) {
+      return { allowed: false, reason: `role '${actorRole}' (tier ${tier}) below min_role_tier ${scope.min_role_tier}` };
+    }
+    if (scope.requires_mfa && !mfaToken) {
+      return { allowed: false, reason: `scope '${scopeId}' requires MFA — no token presented (defaults.unverified_mfa=deny)` };
+    }
+    return { allowed: true, reason: `granted via '${scopeId}' (${subRole ? `sub-role ${actorRole}, ` : ""}tier ${tier})` };
+  }
+
+  /** Shared envelope gate: validate + authorize, fully structured rejections. */
+  function ingestEnvelope(rawBody, actorRole, { mfaToken = null, source = "webhook" } = {}) {
+    let payload;
+    try {
+      payload = JSON.parse(rawBody);
+    } catch (exc) {
+      return deny(422, "MALFORMED_JSON", `body is not valid JSON: ${exc.message}`, { source });
+    }
+    const errors = validateEnvelope(payload);
+    if (errors.length > 0) {
+      return deny(422, "ENVELOPE_INVALID",
+        `payload violates api-schemas/instruction-envelope.schema.json (${errors.length} error(s))`,
+        { source, errors: errors.slice(0, 10) });
+    }
+    const verdict = authorize(actorRole, "remote-task-injection", "inject", { mfaToken });
+    if (!verdict.allowed) {
+      return deny(403, "UNAUTHORIZED", verdict.reason, { source });
+    }
+    return {
+      status: 202,
+      ok: true,
+      accepted: true,
+      task_id: payload.target.task_id,
+      issue: payload.target.issue,
+      role: payload.section_1_role_contract.role,
+      source,
+    };
+  }
+
+  /** Webhook route (acceptance criterion 1): secret -> JSON -> schema -> RBAC. */
+  function handleWebhook({ body, headers }) {
+    const provided = headers?.["x-supreme-signature"];
+    if (!secretMatches(provided, webhookSecret)) {
+      return deny(403, "UNVERIFIED_SOURCE",
+        "missing or invalid x-supreme-signature header — unverified triggers fail closed",
+        { source: "webhook" });
+    }
+    return ingestEnvelope(body, "agent", { source: "webhook" });
+  }
+
+  /** Telegram route: authorized chat -> command parse -> envelope -> RBAC. */
+  function handleTelegramUpdate(update) {
+    const message = update?.message;
+    const chatId = message?.chat?.id;
+    if (!authorizedChatIds.includes(chatId)) {
+      return deny(403, "UNAUTHORIZED_CHAT",
+        `chat ${chatId ?? "(none)"} is not authorized — unverified triggers fail closed`,
+        { source: "telegram" });
+    }
+    const text = typeof message?.text === "string" ? message.text.trim() : "";
+    if (!text.startsWith("/task")) {
+      return deny(422, "NOT_A_TASK_COMMAND", "only /task commands are accepted", { source: "telegram" });
+    }
+    // Deterministic /task command grammar: /task <issue> <objective...>
+    const rest = text.slice("/task".length).trim();
+    const [issue, ...objectiveParts] = rest.split(/\s+/);
+    if (!/^[1-9][0-9]{0,7}$/.test(issue ?? "") || objectiveParts.length === 0) {
+      return deny(422, "MALFORMED_COMMAND",
+        "usage: /task <issue> <objective> — deterministic grammar, nothing guessed",
+        { source: "telegram" });
+    }
+    const objective = objectiveParts.join(" ");
+    // Envelope built to the landed contract's EXACT shapes (issue #30):
+    // section_2 requires objective + 3 non-empty lists; section_3 requires
+    // >=1 citable policy + admin_gate; section_4 requires the pinned
+    // contract_version + exactly 3 named tiers; section_5 requires the
+    // closes_reference line + template carrying it.
+    const envelope = {
+      schema_version: "1.0",
+      envelope_format: "instruction-envelope-v1",
+      target: {
+        task_id: `task-${issue}`,
+        issue,
+        repository: "Supremeai-bd/supremeai",
+        task_type: "IMPLEMENT",
+        group: "agent-orchestration",
+        priority: "P2",
+      },
+      section_1_role_contract: {
+        role: "coder",
+        role_description: "Implementation specialist dispatched from Telegram",
+        operating_constraints: [
+          "Autonomous execution inside declared scope only; no confirmation prompts.",
+          `Objective from Telegram chat ${chatId}: ${objective}`,
+        ],
+        stop_conditions: ["Security boundary hit", "Out of declared scope"],
+      },
+      section_2_task_scope: {
+        objective,
+        touching_files: ["scripts/agents/"],
+        forbidden_paths: [".env*", "secrets/**", "credentials/**", "vault/**"],
+        acceptance_criteria: [`Objective satisfied: ${objective}`, "Zero unhandled crashes"],
+      },
+      section_3_governing_rules: {
+        policies: [
+          {
+            id: "smallest-safe-change",
+            statement:
+              "Implement the smallest safe change strictly inside the declared Touching Files.",
+            source: "AGENT_RULES.md U1",
+          },
+        ],
+        admin_gate: { required: false, status: "NOT_REQUIRED" },
+      },
+      section_4_verification: {
+        contract_version: "agent-loop-contract/1",
+        tiers: [
+          {
+            tier: 1,
+            name: "reflection_check",
+            command: "git diff --stat",
+            expectation: "Diff limited to the declared Touching Files.",
+          },
+          {
+            tier: 2,
+            name: "boot_smoke_test",
+            command: "python -c 'import scripts.agents.continuous_agent_loop'",
+            expectation: "Loop module imports cleanly from the repository root.",
+          },
+          {
+            tier: 3,
+            name: "test_suite",
+            command: "python -m pytest tests/ -q",
+            expectation: "Full offline test suite passes.",
+          },
+        ],
+        required_evidence: ["verification tier output", "diff check"],
+      },
+      section_5_submission: {
+        pathway: "bridge_submit_patch",
+        base_branch: "main",
+        branch_convention: "^(feat|fix|docs|chore|test|refactor|perf|bridge|contributor)/<slug>",
+        pr_title_prefix: "feat(open):",
+        issue_reference_required: true,
+        closes_reference: `Closes #${issue}`,
+        pr_body_template: `## Summary\nTelegram-dispatched task for issue #${issue}: ${objective}.\n\nCloses #${issue}\n`,
+      },
+    };
+    return ingestEnvelope(JSON.stringify(envelope), "coder", { source: "telegram" });
+  }
+
+  return { handleWebhook, handleTelegramUpdate, ingestEnvelope, authorize };
+}
diff --git a/examples/command-dispatch-reference/src/schema_lite.mjs b/examples/command-dispatch-reference/src/schema_lite.mjs
new file mode 100644
index 00000000..94dc4753
--- /dev/null
+++ b/examples/command-dispatch-reference/src/schema_lite.mjs
@@ -0,0 +1,203 @@
+/**
+ * schema_lite.mjs — minimal Draft-2020-12 subset validator (zero-dependency).
+ *
+ * Supports EXACTLY the keyword set used by the landed public contracts this
+ * reference validates against (api-schemas/instruction-envelope.schema.json,
+ * api-schemas/permissions.schema.json):
+ *   $defs/$ref (local), type, enum, const, pattern, minLength/maxLength,
+ *   minimum/maximum (+exclusive), items, minItems/maxItems, uniqueItems,
+ *   properties, required, additionalProperties:false, allOf, if/then.
+ *
+ * `format` is annotation-only in Draft 2020-12 (verified against the repo's
+ * validate_schemas.py semantics) — matched but not enforced.
+ *
+ * SSOT doctrine: the SCHEMA files are the contract; this validator is a
+ * stdlib-only executor for them. Any keyword outside the supported set makes
+ * the validator FAIL CLOSED (unknown keyword -> schema rejected), so a schema
+ * drift can never silently weaken validation.
+ */
+
+const SUPPORTED_KEYWORDS = new Set([
+  "$defs", "$id", "$schema", "$ref", "title", "description", "format",
+  "type", "enum", "const", "pattern", "minLength", "maxLength",
+  "minimum", "maximum", "exclusiveMinimum", "exclusiveMaximum",
+  "items", "minItems", "maxItems", "uniqueItems", "contains",
+  "properties", "required", "additionalProperties",
+  "allOf", "if", "then",
+]);
+
+const TYPES = new Set(["object", "array", "string", "number", "integer",
+  "boolean", "null"]);
+
+/** Validate a schema document itself — unknown keywords fail closed. */
+export function checkSchema(schema, root = schema, path = "") {
+  if (Array.isArray(schema)) {
+    schema.forEach((item, i) => checkSchema(item, root, `${path}/${i}`));
+    return;
+  }
+  if (schema === null || typeof schema !== "object" || Array.isArray(schema)) {
+    if (typeof schema === "boolean") return; // true/false schemas are legal
+    throw new Error(`schema_lite: schema node must be an object at ${path}`);
+  }
+  for (const key of Object.keys(schema)) {
+    if (!SUPPORTED_KEYWORDS.has(key)) {
+      throw new Error(`schema_lite: unsupported keyword '${key}' at ${path} (fail-closed)`);
+    }
+  }
+  if (schema.$ref !== undefined) {
+    if (typeof schema.$ref !== "string" || !schema.$ref.startsWith("#/$defs/")) {
+      throw new Error(`schema_lite: only local #/$defs/ refs supported at ${path}`);
+    }
+    return;
+  }
+  if (schema.type !== undefined) {
+    const types = Array.isArray(schema.type) ? schema.type : [schema.type];
+    for (const t of types) {
+      if (!TYPES.has(t)) throw new Error(`schema_lite: unknown type '${t}' at ${path}`);
+    }
+  }
+  for (const key of ["properties", "$defs"]) {
+    const node = schema[key];
+    if (node !== undefined) {
+      for (const name of Object.keys(node)) checkSchema(node[name], root, `${path}/${key}/${name}`);
+    }
+  }
+  for (const key of ["items", "if", "then", "additionalProperties"]) {
+    if (schema[key] !== undefined && typeof schema[key] === "object") {
+      checkSchema(schema[key], root, `${path}/${key}`);
+    }
+  }
+  if (schema.allOf !== undefined) checkSchema(schema.allOf, root, `${path}/allOf`);
+}
+
+function resolveRef(ref, root) {
+  const segs = ref.replace(/^#\//, "").split("/");
+  let node = root;
+  for (const seg of segs) {
+    node = node?.[seg];
+    if (node === undefined) throw new Error(`schema_lite: unresolvable $ref ${ref}`);
+  }
+  return node;
+}
+
+function typeOf(value) {
+  if (value === null) return "null";
+  if (Array.isArray(value)) return "array";
+  if (Number.isInteger(value)) return "integer";
+  return typeof value;
+}
+
+function typeMatches(value, expected) {
+  const actual = typeOf(value);
+  if (Array.isArray(expected)) return expected.some((t) => typeMatches(value, t));
+  if (expected === "number") return actual === "number" || actual === "integer";
+  return actual === expected;
+}
+
+function deepEqual(a, b) {
+  return JSON.stringify(a) === JSON.stringify(b);
+}
+
+/**
+ * Validate `value` against `schema` (with $root for $ref resolution).
+ * @returns {string[]} errors — empty list = valid
+ */
+export function validate(value, schema, root = null, path = "") {
+  const errors = [];
+  const r = root || schema;
+
+  if (schema === true) return errors;
+  if (schema === false) {
+    errors.push(`${path || "/"}: schema false admits nothing`);
+    return errors;
+  }
+
+  if (schema.$ref !== undefined) {
+    return validate(value, resolveRef(schema.$ref, r), r, path);
+  }
+
+  if (schema.type !== undefined && !typeMatches(value, schema.type)) {
+    errors.push(`${path || "/"}: expected type ${JSON.stringify(schema.type)}, got ${typeOf(value)}`);
+    return errors; // type mismatch makes deeper checks noise
+  }
+  if (schema.const !== undefined && !deepEqual(value, schema.const)) {
+    errors.push(`${path || "/"}: const mismatch (expected ${JSON.stringify(schema.const)})`);
+  }
+  if (schema.enum !== undefined && !schema.enum.some((v) => deepEqual(v, value))) {
+    errors.push(`${path || "/"}: value not in enum [${schema.enum.map((v) => JSON.stringify(v)).join(", ")}]`);
+  }
+  if (typeof value === "string") {
+    if (schema.pattern !== undefined && !new RegExp(schema.pattern).test(value)) {
+      errors.push(`${path || "/"}: string does not match pattern ${schema.pattern}`);
+    }
+    if (schema.minLength !== undefined && value.length < schema.minLength) {
+      errors.push(`${path || "/"}: minLength ${schema.minLength} violated`);
+    }
+    if (schema.maxLength !== undefined && value.length > schema.maxLength) {
+      errors.push(`${path || "/"}: maxLength ${schema.maxLength} violated`);
+    }
+  }
+  if (typeof value === "number") {
+    if (schema.minimum !== undefined && value < schema.minimum) errors.push(`${path || "/"}: minimum violated`);
+    if (schema.maximum !== undefined && value > schema.maximum) errors.push(`${path || "/"}: maximum violated`);
+    if (schema.exclusiveMinimum !== undefined && value <= schema.exclusiveMinimum) {
+      errors.push(`${path || "/"}: exclusiveMinimum violated`);
+    }
+    if (schema.exclusiveMaximum !== undefined && value >= schema.exclusiveMaximum) {
+      errors.push(`${path || "/"}: exclusiveMaximum violated`);
+    }
+  }
+  if (Array.isArray(value)) {
+    if (schema.minItems !== undefined && value.length < schema.minItems) {
+      errors.push(`${path || "/"}: minItems ${schema.minItems} violated`);
+    }
+    if (schema.maxItems !== undefined && value.length > schema.maxItems) {
+      errors.push(`${path || "/"}: maxItems ${schema.maxItems} violated`);
+    }
+    if (schema.uniqueItems) {
+      const seen = new Set(value.map((v) => JSON.stringify(v)));
+      if (seen.size !== value.length) errors.push(`${path || "/"}: uniqueItems violated`);
+    }
+    if (schema.items !== undefined) {
+      value.forEach((item, i) => errors.push(...validate(item, schema.items, r, `${path}/${i}`)));
+    }
+    if (schema.contains !== undefined) {
+      const anyMatch = value.some((item) => validate(item, schema.contains, r, path).length === 0);
+      if (!anyMatch) errors.push(`${path || "/"}: no item matches the 'contains' schema`);
+    }
+  }
+  if (value !== null && typeof value === "object" && !Array.isArray(value)) {
+    const props = schema.properties || {};
+    for (const name of schema.required || []) {
+      if (!(name in value)) errors.push(`${path || "/"}: missing required property '${name}'`);
+    }
+    if (schema.additionalProperties === false) {
+      for (const name of Object.keys(value)) {
+        if (!(name in props)) {
+          errors.push(`${path || "/"}: additional property not allowed: '${name}'`);
+        }
+      }
+    }
+    for (const name of Object.keys(props)) {
+      if (name in value) {
+        errors.push(...validate(value[name], props[name], r, `${path}/${name}`));
+      }
+    }
+  }
+  if (schema.allOf !== undefined) {
+    for (const sub of schema.allOf) errors.push(...validate(value, sub, r, path));
+  }
+  if (schema.if !== undefined) {
+    const matches = validate(value, schema.if, r, path).length === 0;
+    if (matches && schema.then !== undefined) {
+      errors.push(...validate(value, schema.then, r, path));
+    }
+  }
+  return errors;
+}
+
+/** Convenience: check the schema once, then validate a payload. */
+export function makeValidator(schema) {
+  checkSchema(schema);
+  return (payload) => validate(payload, schema, schema, "");
+}
diff --git a/examples/curl-tests/run_e2e_smoke.ps1 b/examples/curl-tests/run_e2e_smoke.ps1
new file mode 100644
index 00000000..0ed3394c
--- /dev/null
+++ b/examples/curl-tests/run_e2e_smoke.ps1
@@ -0,0 +1,132 @@
+# ============================================================================
+# SupremeAI Gateway — E2E smoke: 10 real-world calls (5 non-stream + 5 SSE)
+# Issue #403 · PowerShell mirror of run_e2e_smoke.sh (same subcommands, same
+# output contract, same exit codes — repo house style, WO #251 pattern).
+#
+# Usage:
+#   pwsh -File run_e2e_smoke.ps1                # full matrix (default)
+#   pwsh -File run_e2e_smoke.ps1 -NonStream     # only 5 non-streaming calls
+#   pwsh -File run_e2e_smoke.ps1 -Stream        # only 5 SSE streaming calls
+#
+# Environment overrides (identical to the sh mirror):
+#   GATEWAY_URL           default: https://supremeai-api.onrender.com
+#   SUPREMEAI_API_KEY     required — monolith key-plane key (vault/env only)
+#   MODELS                space-separated model rotation, default: "auto"
+#   MAX_TOKENS            default: 32
+#   CURL_TIMEOUT          default: 30 (seconds per request)
+#
+# Exit codes: 0 = all requested calls passed; 1 = at least one failed
+# (fail-closed — a skipped check does not exist).
+# ============================================================================
+[CmdletBinding()]
+param(
+    [switch]$NonStream,
+    [switch]$Stream
+)
+
+$ErrorActionPreference = 'Stop'
+
+$GatewayUrl = ($env:GATEWAY_URL ?? 'https://supremeai-api.onrender.com').TrimEnd('/')
+$ApiKey     = $env:SUPREMEAI_API_KEY
+$Models     = @($env:MODELS ?? 'auto')
+$MaxTokens  = [int]($env:MAX_TOKENS ?? '32')
+$TimeoutS   = [int]($env:CURL_TIMEOUT ?? '30')
+$Prompt     = 'Reply with exactly: SUPREME-E2E-OK'
+
+$script:Failures = 0
+$script:Passed   = 0
+
+function Fail([string]$Label, [string]$Reason) {
+    $script:Failures++
+    Write-Output "FAIL ${Label}: $Reason"
+}
+
+function Pass([string]$Label, [string]$Detail) {
+    $script:Passed++
+    Write-Output "PASS ${Label}: $Detail"
+}
+
+if (-not $ApiKey) {
+    Write-Output 'FAIL setup: SUPREMEAI_API_KEY is not set — key-plane key required (docs/CONSUMERS.md). No live calls attempted.'
+    exit 1
+}
+
+function Invoke-NonStreamCall([string]$Label, [string]$Model) {
+    $payload = @{ model = $Model; stream = $false; max_tokens = $MaxTokens
+                  messages = @(@{ role = 'user'; content = $Prompt }) } | ConvertTo-Json -Depth 5
+    $sw = [System.Diagnostics.Stopwatch]::StartNew()
+    try {
+        $resp = Invoke-WebRequest -Uri "$GatewayUrl/v1/chat/completions" -Method Post `
+            -Headers @{ 'X-SupremeAI-Key' = $ApiKey; 'Content-Type' = 'application/json' } `
+            -Body $payload -TimeoutSec $TimeoutS -UseBasicParsing
+    } catch {
+        $code = try { [int]$_.Exception.Response.StatusCode } catch { 'transport' }
+        Fail $Label "honest error — HTTP $code : $($_.Exception.Message.Split("`n")[0])"
+        return
+    }
+    $sw.Stop()
+    $obj = $resp.Content | ConvertFrom-Json
+    $content = $obj.choices[0].message.content
+    if (-not $content) { Fail $Label 'empty choices[0].message.content — contract violation'; return }
+    if (-not $obj.PSObject.Properties['usage']) { Fail $Label 'usage object missing — Honest Ledger contract violation'; return }
+    Pass $Label "model=$Model non-stream 200, content+usage present, $([math]::Round($sw.Elapsed.TotalSeconds,3))s"
+}
+
+function Invoke-StreamCall([string]$Label, [string]$Model) {
+    $payload = @{ model = $Model; stream = $true; max_tokens = $MaxTokens
+                  messages = @(@{ role = 'user'; content = $Prompt }) } | ConvertTo-Json -Depth 5
+    $client = [System.Net.Http.HttpClient]::new()
+    $client.Timeout = [TimeSpan]::FromSeconds($TimeoutS)
+    try {
+        $req = [System.Net.Http.HttpRequestMessage]::new([System.Net.Http.HttpMethod]::Post, "$GatewayUrl/v1/chat/completions")
+        $req.Headers.Add('X-SupremeAI-Key', $ApiKey)
+        $req.Content = [System.Net.Http.StringContent]::new($payload, [Text.Encoding]::UTF8, 'application/json')
+        $sw = [System.Diagnostics.Stopwatch]::StartNew()
+        $resp = $client.SendAsync($req, [System.Net.Http.HttpCompletionOption]::ResponseHeadersRead).GetAwaiter().GetResult()
+        if ([int]$resp.StatusCode -ne 200) {
+            $errBody = $resp.Content.ReadAsStringAsync().GetAwaiter().GetResult()
+            Fail $Label "honest error — HTTP $([int]$resp.StatusCode): $($errBody.Substring(0, [Math]::Min(200, $errBody.Length)))"
+            return
+        }
+        $stream = $resp.Content.ReadAsStreamAsync().GetAwaiter().GetResult()
+        $reader = [System.IO.StreamReader]::new($stream)
+        $ttft = $null; $frames = [System.Collections.Generic.List[string]]::new()
+        while ($null -ne ($line = $reader.ReadLine())) {
+            if ($line -like 'data:*') {
+                if ($null -eq $ttft) { $ttft = $sw.Elapsed.TotalSeconds }
+                $frames.Add(($line -replace '^data:\s*', '').TrimEnd("`r"))
+            }
+        }
+        if ($frames.Count -eq 0) { Fail $Label 'no SSE data: frames — streaming contract violation'; return }
+        $terminal = $frames[$frames.Count - 1]
+        if ($terminal -ne '[DONE]') {
+            Fail $Label "stream ended without exact 'data: [DONE]' terminal frame (mid-stream drop is an honest failure): last='$terminal'"
+            return
+        }
+        $bad = 0
+        foreach ($f in ($frames | Select-Object -SkipLast 1)) {
+            $obj = $null
+            try { $obj = $f | ConvertFrom-Json } catch { $bad++; continue }
+            if (-not $obj.choices[0].delta) { $bad++ }
+        }
+        if ($bad -gt 0) { Fail $Label "$bad SSE frame(s) missing choices[0].delta — frame contract violation"; return }
+        Pass $Label "model=$Model SSE 200, frames valid, terminal [DONE] exact, TTFT=$([math]::Round($ttft,3))s"
+    } catch {
+        Fail $Label "transport error: $($_.Exception.Message.Split("`n")[0])"
+    } finally {
+        $client.Dispose()
+    }
+}
+
+Write-Output "SupremeAI E2E smoke — gateway=$GatewayUrl models=[$($Models -join ' ')] subset=$(if ($Stream) {'stream'} elseif ($NonStream) {'nonstream'} else {'all'})"
+
+for ($i = 0; $i -lt 5; $i++) {
+    $m = $Models[$i % $Models.Count]
+    if (-not $Stream)  { Invoke-NonStreamCall "ns$($i + 1)" $m }
+    if (-not $NonStream) { Invoke-StreamCall "st$($i + 1)" $m }
+}
+
+$total = $script:Passed + $script:Failures
+Write-Output "RESULT: $($script:Passed)/$total calls passed (fail-closed — failures listed above are honest)"
+if ($script:Failures -gt 0) { exit 1 }
+exit 0
diff --git a/examples/curl-tests/run_e2e_smoke.sh b/examples/curl-tests/run_e2e_smoke.sh
new file mode 100644
index 00000000..181f50b9
--- /dev/null
+++ b/examples/curl-tests/run_e2e_smoke.sh
@@ -0,0 +1,176 @@
+#!/bin/sh
+# ============================================================================
+# SupremeAI Gateway — E2E smoke: 10 real-world calls (5 non-stream + 5 SSE)
+# Issue #403 · POSIX sh + curl + jq. Windows mirror: run_e2e_smoke.ps1
+# (same subcommands, same output contract, same exit codes).
+#
+# Usage:
+#   sh run_e2e_smoke.sh                # full matrix: 5 non-stream + 5 stream
+#   sh run_e2e_smoke.sh all            # explicit full matrix
+#   sh run_e2e_smoke.sh nonstream      # only the 5 non-streaming calls
+#   sh run_e2e_smoke.sh stream         # only the 5 SSE streaming calls
+#   sh run_e2e_smoke.sh help           # this help
+#
+# Environment overrides:
+#   GATEWAY_URL           default: https://supremeai-api.onrender.com
+#                         (repo client contract, examples/gateway_client.py)
+#   SUPREMEAI_API_KEY     required — monolith key-plane-issued key (vault/env;
+#                         never hardcode, SECRETS_MODEL.md)
+#   MODELS                space-separated model rotation, default: "auto"
+#                         (live list: GET /v1/models)
+#   MAX_TOKENS            default: 32 (budget cap — runaway-cost guard)
+#   CURL_TIMEOUT          default: 30 (seconds per request)
+#
+# Contract checks per the issue #403 acceptance:
+#   - non-stream: HTTP 200, choices[0].message.content non-empty, usage object
+#   - stream: valid `data:` frames, terminal frame EXACT `data: [DONE]`,
+#     TTFT recorded per call (curl time_starttransfer)
+#   - mid-stream provider failure = honest FAIL line + non-zero exit
+#     (never a silent corrupted drop)
+#
+# Exit codes: 0 = 10/10 (or N/N for the requested subset) passed; 1 = at
+# least one call failed (fail-closed — a skipped check does not exist).
+# ============================================================================
+set -u
+
+GATEWAY_URL="${GATEWAY_URL:-https://supremeai-api.onrender.com}"
+GATEWAY_URL="${GATEWAY_URL%/}"
+MODELS="${MODELS:-auto}"
+MAX_TOKENS="${MAX_TOKENS:-32}"
+CURL_TIMEOUT="${CURL_TIMEOUT:-30}"
+PROMPT="Reply with exactly: SUPREME-E2E-OK"
+
+failures=0
+passed=0
+STATE_DIR=$(mktemp -d)
+trap 'rm -rf "$STATE_DIR"' EXIT INT TERM
+
+fail() { # $1 = label, $2 = reason, $3 = optional model context (honest ledger)
+  failures=$((failures + 1))
+  if [ $# -ge 3 ]; then
+    printf 'FAIL %s (model=%s): %s\n' "$1" "$3" "$2"
+  else
+    printf 'FAIL %s: %s\n' "$1" "$2"
+  fi
+}
+
+ok() { # $1 = label, $2 = detail
+  passed=$((passed + 1))
+  printf 'PASS %s: %s\n' "$1" "$2"
+}
+
+require_env() {
+  if [ -z "${SUPREMEAI_API_KEY:-}" ]; then
+    printf 'FAIL setup: SUPREMEAI_API_KEY is not set — key-plane key required (docs/CONSUMERS.md). No live calls attempted.\n'
+    exit 1
+  fi
+  if ! command -v jq >/dev/null 2>&1; then
+    printf 'FAIL setup: jq is required for SSE/JSON frame validation (fail-closed; install jq).\n'
+    exit 1
+  fi
+}
+
+model_at() { # $1 = 0-based index → rotated model from $MODELS (POSIX; no set--, no arrays)
+  count=$(printf '%s' "$MODELS" | wc -w)
+  pos=$(( $1 % count + 1 ))
+  printf '%s' "$MODELS" | tr -s ' \t' '  ' | cut -d' ' -f"$pos"
+}
+
+nonstream_call() { # $1 = label, $2 = model
+  body_file="$STATE_DIR/body_$1.json"
+  meta=$(curl -sS -m "$CURL_TIMEOUT" -o "$body_file" \
+    -H "X-SupremeAI-Key: $SUPREMEAI_API_KEY" -H 'Content-Type: application/json' \
+    -w '%{http_code} %{time_total}' \
+    -d "{\"model\":\"$2\",\"messages\":[{\"role\":\"user\",\"content\":\"$PROMPT\"}],\"stream\":false,\"max_tokens\":$MAX_TOKENS}" \
+    "$GATEWAY_URL/v1/chat/completions" 2>"$STATE_DIR/curl_err_$1") || {
+      fail "$1" "curl transport error: $(cat "$STATE_DIR/curl_err_$1")" "$2"; return 1; }
+  status=$(printf '%s' "$meta" | cut -d' ' -f1)
+  latency=$(printf '%s' "$meta" | cut -d' ' -f2)
+  if [ "$status" != "200" ]; then
+    fail "$1" "honest error — HTTP $status (gateway must return sanitized ledger): $(head -c 200 "$body_file")" "$2"
+    return 1
+  fi
+  content=$(jq -r '.choices[0].message.content // empty' "$body_file" 2>/dev/null)
+  usage=$(jq -r 'has("usage")' "$body_file" 2>/dev/null)
+  if [ -z "$content" ]; then
+    fail "$1" "empty choices[0].message.content — contract violation" "$2"
+    return 1
+  fi
+  if [ "$usage" != "true" ]; then
+    fail "$1" "usage object missing — Honest Ledger contract violation" "$2"
+    return 1
+  fi
+  ok "$1" "model=$2 non-stream 200, content+usage present, ${latency}s"
+}
+
+stream_call() { # $1 = label, $2 = model
+  body_file="$STATE_DIR/sse_$1.txt"
+  meta=$(curl -sS -N -m "$CURL_TIMEOUT" -o "$body_file" \
+    -H "X-SupremeAI-Key: $SUPREMEAI_API_KEY" -H 'Content-Type: application/json' \
+    -w '%{http_code} %{time_starttransfer}' \
+    -d "{\"model\":\"$2\",\"messages\":[{\"role\":\"user\",\"content\":\"$PROMPT\"}],\"stream\":true,\"max_tokens\":$MAX_TOKENS}" \
+    "$GATEWAY_URL/v1/chat/completions" 2>"$STATE_DIR/curl_err_$1") || {
+      fail "$1" "curl transport error: $(cat "$STATE_DIR/curl_err_$1")" "$2"; return 1; }
+  status=$(printf '%s' "$meta" | cut -d' ' -f1)
+  ttft=$(printf '%s' "$meta" | cut -d' ' -f2)
+  if [ "$status" != "200" ]; then
+    fail "$1" "honest error — HTTP $status: $(head -c 200 "$body_file")" "$2"
+    return 1
+  fi
+  # SSE frame validation: every frame must be `data: ...`; terminal EXACT [DONE]
+  if ! grep -q '^data:' "$body_file"; then
+    fail "$1" "no SSE data: frames — streaming contract violation" "$2"
+    return 1
+  fi
+  terminal=$(grep '^data:' "$body_file" | tail -n 1 | sed 's/^data:[[:space:]]*//' | tr -d '\r')
+  if [ "$terminal" != "[DONE]" ]; then
+    fail "$1" "stream ended without exact 'data: [DONE]' terminal frame (mid-stream drop is an honest failure): last='$terminal'" "$2"
+    return 1
+  fi
+  # every non-terminal frame must parse as JSON with a delta chunk
+  frames_file="$STATE_DIR/frames_$1.txt"
+  grep '^data:' "$body_file" | sed 's/^data:[[:space:]]*//' | tr -d '\r' > "$frames_file"
+  bad_frames=0
+  while IFS= read -r frame; do
+    [ "$frame" = "[DONE]" ] && continue
+    printf '%s' "$frame" | jq -e '.choices[0].delta != null' >/dev/null 2>&1 || bad_frames=$((bad_frames + 1))
+  done < "$frames_file"
+  if [ "$bad_frames" != "0" ]; then
+    fail "$1" "$bad_frames SSE frame(s) missing choices[0].delta or unparseable — frame contract violation" "$2"
+    return 1
+  fi
+  ok "$1" "model=$2 SSE 200, frames valid, terminal [DONE] exact, TTFT=${ttft}s"
+}
+
+run_matrix() { # $1 = "nonstream" | "stream" | "all"
+  i=0
+  while [ $i -lt 5 ]; do
+    i=$((i + 1))
+    m=$(model_at $((i - 1)))
+    if [ "$1" != "stream" ]; then nonstream_call "ns$i" "$m" || true; fi
+    if [ "$1" != "nonstream" ]; then stream_call "st$i" "$m" || true; fi
+  done
+}
+
+main() {
+  sub="${1:-all}"
+  case "$sub" in
+    help|-h)
+      sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'
+      exit 0
+      ;;
+    all|nonstream|stream) ;;
+    *)
+      printf 'unknown subcommand: %s (use: all | nonstream | stream | help)\n' "$sub"
+      exit 1
+      ;;
+  esac
+  require_env
+  printf 'SupremeAI E2E smoke — gateway=%s models=[%s] subset=%s\n' "$GATEWAY_URL" "$MODELS" "$sub"
+  run_matrix "$sub"
+  total=$((passed + failures))
+  printf 'RESULT: %s/%s calls passed (fail-closed — failures listed above are honest)\n' "$passed" "$total"
+  [ "$failures" -eq 0 ]
+}
+
+main "$@"
