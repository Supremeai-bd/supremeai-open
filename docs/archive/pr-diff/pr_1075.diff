diff --git a/examples/skills-installer-reference/src/installer.mjs b/examples/skills-installer-reference/src/installer.mjs
new file mode 100644
index 00000000..ed7c8836
--- /dev/null
+++ b/examples/skills-installer-reference/src/installer.mjs
@@ -0,0 +1,181 @@
+// installer.mjs — dynamic MCP installer: connect, initialize, execute (issue #332 AC2+AC3).
+//
+// Transports (MCP standards, docs/MCP_CONNECT.md etiquette):
+//   - streamable-http: JSON-RPC over POST {base}{entry.path}; session rides
+//     the mcp-session-id response header.
+//   - sse: GET {base}/sse, parse the endpoint frame (event:/data: lines),
+//     then JSON-RPC over the announced endpoint.
+//
+// EXECUTION BOUNDARY (AC3, fail closed): every execute() call re-validates
+// the lease BEFORE any network activity. A denied call produces a structured
+// {denied:true,...} envelope and NEVER touches the wire — nothing is
+// partially executed, no scope escalation can slip a request through.
+
+export class InstallerError extends Error {
+  constructor(code, message, { status, retryable } = {}) {
+    super(`${code}: ${message}`);
+    this.name = "InstallerError";
+    this.code = code;
+    this.status = status;
+    this.retryable = retryable ?? false;
+  }
+}
+
+const MCP_ACCEPT = "application/json, text/event-stream";
+
+/** Minimal SSE frame parser per docs/MCP_CONNECT.md section 3. */
+export function parseSseFrames(text) {
+  const frames = [];
+  for (const block of text.split("\n\n")) {
+    let event = null;
+    const data = [];
+    for (const line of block.split("\n")) {
+      if (line.startsWith("event:")) event = line.slice(6).trim();
+      else if (line.startsWith("data:")) data.push(line.slice(5).replace(/^ /, ""));
+    }
+    if (data.length > 0 || event !== null) {
+      frames.push({ event, data: data.join("\n") });
+    }
+  }
+  return frames;
+}
+
+export class McpInstaller {
+  constructor({ baseUrl, clientName = "skills-installer-reference", fetchImpl = globalThis.fetch }) {
+    if (typeof baseUrl !== "string" || !/^https?:\/\//.test(baseUrl)) {
+      throw new InstallerError("bad_base_url", "baseUrl must be an http(s) URL");
+    }
+    if (typeof fetchImpl !== "function") {
+      throw new InstallerError("no_fetch", "fetch is unavailable in this runtime");
+    }
+    this.baseUrl = baseUrl.replace(/\/+$/, "");
+    this.clientName = clientName;
+    this.#fetch = fetchImpl;
+    this.sessionId = null;
+    this.rpcId = 1;
+  }
+
+  #fetch;
+
+  #url(path) {
+    return `${this.baseUrl}${path}${path.includes("?") ? "&" : "?"}client=${encodeURIComponent(this.clientName)}`;
+  }
+
+  async #postJson(path, payload, { sessionId = this.sessionId } = {}) {
+    const headers = { "Content-Type": "application/json", Accept: MCP_ACCEPT };
+    if (sessionId) headers["mcp-session-id"] = sessionId;
+    let resp;
+    try {
+      resp = await this.#fetch(this.#url(path), {
+        method: "POST",
+        headers,
+        body: JSON.stringify(payload),
+      });
+    } catch (err) {
+      throw new InstallerError("transport_error", String(err && err.message ? err.message : err), { retryable: true });
+    }
+    if (resp.status === 429) {
+      throw new InstallerError("rate_limited",
+        `429 (Retry-After: ${resp.headers.get("Retry-After") ?? "unknown"}s)`,
+        { status: 429, retryable: true });
+    }
+    if (resp.status === 403) {
+      throw new InstallerError("forbidden", "403 default-deny RBAC", { status: 403 });
+    }
+    if (!resp.ok) {
+      throw new InstallerError("http_error", `HTTP ${resp.status}`, { status: resp.status });
+    }
+    const newSession = resp.headers.get("mcp-session-id");
+    if (newSession) this.sessionId = newSession;
+    const text = await resp.text();
+    // SSE-framed JSON-RPC responses are legal under streamable MCP; unwrap.
+    if (text.startsWith("event:") || text.startsWith("data:")) {
+      const frames = parseSseFrames(text).filter((f) => f.data.startsWith("{"));
+      if (frames.length === 0) throw new InstallerError("bad_frame", "no JSON frame in SSE response");
+      return JSON.parse(frames[frames.length - 1].data);
+    }
+    return JSON.parse(text);
+  }
+
+  /**
+   * Initialize over the chosen transport (AC2). Returns the server tool list.
+   */
+  async initialize({ transport, path }) {
+    if (transport === "streamable-http") {
+      const init = await this.#postJson(path, {
+        jsonrpc: "2.0", id: this.rpcId++, method: "initialize",
+        params: { protocolVersion: "2025-03-26", capabilities: {},
+                  clientInfo: { name: this.clientName, version: "1.0.0" } },
+      });
+      if (init.error) throw new InstallerError("rpc_error", init.error.message ?? "initialize failed");
+      await this.#postJson(path, { jsonrpc: "2.0", method: "notifications/initialized" }).catch(() => {});
+      const list = await this.#postJson(path, { jsonrpc: "2.0", id: this.rpcId++, method: "tools/list" });
+      return { transport, tools: list.result?.tools ?? [] };
+    }
+    if (transport === "sse") {
+      // Open the SSE leg, read the endpoint frame, then JSON-RPC on it.
+      let resp;
+      try {
+        resp = await this.#fetch(this.#url("/sse"), { headers: { Accept: "text/event-stream" } });
+      } catch (err) {
+        throw new InstallerError("transport_error", String(err && err.message ? err.message : err), { retryable: true });
+      }
+      if (!resp.ok) throw new InstallerError("http_error", `SSE HTTP ${resp.status}`, { status: resp.status });
+      const head = await resp.text();
+      const frames = parseSseFrames(head);
+      const endpointFrame = frames.find((f) => f.event === "endpoint" || (f.data || "").startsWith("/"));
+      if (!endpointFrame) throw new InstallerError("bad_frame", "no endpoint frame on SSE leg");
+      const endpoint = endpointFrame.data.trim();
+      const init = await this.#postJson(endpoint, {
+        jsonrpc: "2.0", id: this.rpcId++, method: "initialize",
+        params: { protocolVersion: "2025-03-26", capabilities: {},
+                  clientInfo: { name: this.clientName, version: "1.0.0" } },
+      }, { sessionId: null });
+      if (init.error) throw new InstallerError("rpc_error", init.error.message ?? "initialize failed");
+      await this.#postJson(endpoint, { jsonrpc: "2.0", method: "notifications/initialized" }).catch(() => {});
+      const list = await this.#postJson(endpoint, { jsonrpc: "2.0", id: this.rpcId++, method: "tools/list" });
+      return { transport, endpoint, tools: list.result?.tools ?? [] };
+    }
+    throw new InstallerError("bad_transport", `unsupported transport '${transport}'`);
+  }
+
+  /**
+   * Execute a leased tool (AC3). Lease is re-checked BEFORE the wire.
+   * @returns {{denied:false, result:object, invocation_id:string}}
+   *          | {denied:true, code, reason}
+   */
+  async execute(installedManifest, lease, checkFn, toolName, args) {
+    try {
+      checkFn(lease, toolName, installedManifest);
+    } catch (err) {
+      return { denied: true, code: err.code ?? "lease_invalid", reason: err.reason ?? String(err.message) };
+    }
+    const declared = installedManifest.tools.find((t) => t.name === toolName);
+    if (!declared) {
+      // Belt and braces: the lease check re-reads the manifest too.
+      return { denied: true, code: "unknown_tool", reason: `tool '${toolName}' not in manifest` };
+    }
+    const invocationId = `inv-${Math.random().toString(16).slice(2, 14)}`;
+    const endpoint = this.endpointOverride ?? (installedManifest.entry.transport === "streamable-http"
+      ? installedManifest.entry.path : this.sseEndpoint ?? installedManifest.entry.path);
+    try {
+      const resp = await this.#postJson(endpoint, {
+        jsonrpc: "2.0", id: this.rpcId++, method: "tools/call",
+        params: { name: toolName, arguments: args },
+      });
+      if (resp.error) {
+        return { denied: false, invocation_id: invocationId, status: "error",
+                 error: { code: "tool_failed", message: String(resp.error.message ?? "tool error"), retryable: false } };
+      }
+      if (resp.result && resp.result.isError) {
+        // MCP tool-level failure: honest error envelope, no fabricated success.
+        return { denied: false, invocation_id: invocationId, status: "error",
+                 error: { code: "tool_denied", message: String(resp.result.message ?? "tool reported isError"), retryable: false } };
+      }
+      return { denied: false, invocation_id: invocationId, status: "ok", result: resp.result };
+    } catch (err) {
+      return { denied: false, invocation_id: invocationId, status: "error",
+               error: { code: err.code ?? "transport_error", message: String(err.message), retryable: err.retryable ?? true } };
+    }
+  }
+}
diff --git a/examples/skills-installer-reference/src/lease.mjs b/examples/skills-installer-reference/src/lease.mjs
new file mode 100644
index 00000000..f0cb0730
--- /dev/null
+++ b/examples/skills-installer-reference/src/lease.mjs
@@ -0,0 +1,133 @@
+// lease.mjs — least-privilege capability leases (issue #332 AC3).
+//
+// Grants are checked against the permissions SSOT exactly like the landed
+// command-dispatch reference (deny-by-default chain):
+//   1. unknown tool            -> deny
+//   2. tool scope not in the
+//      agent sub-role pinning  -> deny
+//   3. scope min_role_tier
+//      above the agent tier    -> deny
+//   4. scope requires_mfa and
+//      MFA unverified          -> deny (defaults.unverified_mfa)
+//   5. unknown scope id        -> deny (defaults.unknown_action analog)
+// A grant is a frozen, EXPIRING capability token; execute() re-checks it at
+// call time (a lease outliving its TTL authorizes nothing).
+
+export class LeaseDenied extends Error {
+  constructor(code, reason) {
+    super(`${code}: ${reason}`);
+    this.name = "LeaseDenied";
+    this.code = code;
+    this.reason = reason;
+  }
+}
+
+const SCOPE_EXEC_ACTIONS = new Set(["execute", "read"]); // read scopes alone never authorize execution
+
+export class LeaseAuthority {
+  /**
+   * @param {object} policy permissions fixture (role_tiers, agent_sub_roles,
+   *                        permission_scopes, defaults)
+   * @param {() => number} [clock] wall-clock seconds (injectable for tests)
+   */
+  constructor(policy, clock = () => Date.now() / 1000) {
+    if (policy === null || typeof policy !== "object") {
+      throw new LeaseDenied("config_invalid", "permissions policy object required");
+    }
+    if (policy.defaults && policy.defaults.unverified_mfa !== "deny") {
+      // The deny-by-default posture is the whole point — refuse to run
+      // against a policy that softened it.
+      throw new LeaseDenied("config_invalid", "defaults.unverified_mfa must be 'deny' (fail-closed)");
+    }
+    this.#policy = policy;
+    this.#clock = clock;
+  }
+
+  #policy;
+  #clock;
+
+  #subRole(name) {
+    return (this.#policy.agent_sub_roles || []).find((s) => s.sub_role === name);
+  }
+
+  #scope(scopeId) {
+    return (this.#policy.permission_scopes || []).find((s) => s.scope_id === scopeId);
+  }
+
+  /**
+   * Grant a lease for one tool of one installed manifest.
+   * @returns {object} frozen lease {tool, granted_scopes, expires_at}
+   */
+  grant({ sub_role, role_tier, mfa_verified = false, manifest, tool_name, ttl_s = 300 }) {
+    const sub = this.#subRole(sub_role);
+    if (!sub) {
+      throw new LeaseDenied("unknown_sub_role", `sub_role '${sub_role}' is not in the policy`);
+    }
+    if (!Number.isInteger(role_tier) || role_tier < 1 || role_tier > 4) {
+      throw new LeaseDenied("bad_tier", "role_tier must be an integer 1..4");
+    }
+    const tool = (manifest.tools || []).find((t) => t.name === tool_name);
+    if (!tool) {
+      // Unknown tool = the #1 SSRF-style escalation attempt. Deny BEFORE any
+      // wire activity (fail closed).
+      throw new LeaseDenied("unknown_tool", `tool '${tool_name}' is not declared by skill '${manifest.name}'`);
+    }
+    const allowed = new Set(sub.allowed_permission_scope_ids || []);
+    for (const scopeId of tool.required_scopes) {
+      const scope = this.#scope(scopeId);
+      if (!scope) {
+        throw new LeaseDenied("unknown_scope", `scope '${scopeId}' not in policy`);
+      }
+      if (!allowed.has(scopeId)) {
+        throw new LeaseDenied("scope_not_pinned",
+          `sub_role '${sub_role}' does not pin scope '${scopeId}' (deny-by-default)`);
+      }
+      if (scope.min_role_tier > role_tier) {
+        throw new LeaseDenied("tier_too_low",
+          `scope '${scopeId}' requires tier >= ${scope.min_role_tier}, agent has ${role_tier}`);
+      }
+      if (scope.requires_mfa && !mfa_verified) {
+        throw new LeaseDenied("mfa_required", `scope '${scopeId}' requires verified MFA`);
+      }
+    }
+    if (!Number.isInteger(ttl_s) || ttl_s <= 0 || ttl_s > 3600) {
+      throw new LeaseDenied("bad_ttl", "ttl_s must be an integer in (0, 3600]");
+    }
+    return Object.freeze({
+      tool: tool_name,
+      skill: manifest.name,
+      granted_scopes: Object.freeze([...tool.required_scopes]),
+      expires_at: Math.floor(this.#clock()) + ttl_s,
+    });
+  }
+
+  /**
+   * Re-check a lease at EXECUTION time (AC3).
+   * @returns {{ok: true}} or throws LeaseDenied
+   */
+  check(lease, toolName, manifest) {
+    if (lease === null || typeof lease !== "object") {
+      throw new LeaseDenied("no_lease", "a granted lease is required before execution");
+    }
+    const now = Math.floor(this.#clock());
+    if (now >= lease.expires_at) {
+      throw new LeaseDenied("lease_expired", `lease expired at ${lease.expires_at} (now ${now})`);
+    }
+    if (lease.tool !== toolName) {
+      throw new LeaseDenied("tool_mismatch", `lease covers '${lease.tool}', not '${toolName}'`);
+    }
+    const tool = (manifest.tools || []).find((t) => t.name === toolName);
+    if (!tool) {
+      throw new LeaseDenied("unknown_tool", `tool '${toolName}' not in installed manifest`);
+    }
+    for (const scopeId of tool.required_scopes) {
+      if (!lease.granted_scopes.includes(scopeId)) {
+        throw new LeaseDenied("scope_escalation",
+          `tool now requires '${scopeId}' which the lease does not grant`);
+      }
+    }
+    return { ok: true };
+  }
+}
+
+export { SCOPE_EXEC_ACTIONS };
diff --git a/examples/skills-installer-reference/src/manifest.mjs b/examples/skills-installer-reference/src/manifest.mjs
new file mode 100644
index 00000000..656336bf
--- /dev/null
+++ b/examples/skills-installer-reference/src/manifest.mjs
@@ -0,0 +1,129 @@
+// manifest.mjs — skill package manifest validation (issue #332 AC1).
+//
+// Fail-closed: a manifest is either FULLY valid against this contract or it
+// is rejected wholesale. Unknown keys, unknown scope ids, host-bearing URLs,
+// and path traversal are all rejected at load time — a drifted manifest can
+// never reach the installer.
+//
+// Manifests carry NO hostnames: the entry is a tower-relative path and the
+// agent supplies the base URL at connect time (no SSRF-by-manifest).
+
+const MANIFEST_VERSION = "skill-manifest/1";
+const NAME_RE = /^[a-z][a-z0-9-]{2,31}$/;
+const VERSION_RE = /^\d+\.\d+\.\d+$/;
+const PATH_RE = /^\/[a-z0-9/_.-]*$/;
+const TOOL_RE = /^[a-z][a-z0-9_-]{1,63}$/;
+
+export class ManifestError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = "ManifestError";
+  }
+}
+
+function requireString(value, field, max) {
+  if (typeof value !== "string" || value.length === 0 || value.length > max) {
+    throw new ManifestError(`${field}: non-empty string <= ${max} chars required`);
+  }
+}
+
+/**
+ * Validate one skill manifest against the strict contract.
+ * @param {object} raw candidate manifest
+ * @param {Set<string>} knownScopeIds scope-id SSOT from the permissions policy
+ * @returns {object} frozen, validated manifest
+ */
+export function validateManifest(raw, knownScopeIds) {
+  if (raw === null || typeof raw !== "object" || Array.isArray(raw)) {
+    throw new ManifestError("manifest must be a JSON object");
+  }
+  const allowed = ["manifest_version", "name", "version", "description", "capabilities", "entry", "tools"];
+  for (const key of Object.keys(raw)) {
+    if (!allowed.includes(key)) {
+      throw new ManifestError(`unknown manifest key '${key}' (fail-closed)`);
+    }
+  }
+  if (raw.manifest_version !== MANIFEST_VERSION) {
+    throw new ManifestError(`manifest_version must be exactly '${MANIFEST_VERSION}'`);
+  }
+  requireString(raw.name, "name", 32);
+  if (!NAME_RE.test(raw.name)) throw new ManifestError("name: kebab-case, 3-32 chars, starts with a letter");
+  requireString(raw.version, "version", 16);
+  if (!VERSION_RE.test(raw.version)) throw new ManifestError("version: semver MAJOR.MINOR.PATCH required");
+  requireString(raw.description, "description", 280);
+
+  if (!Array.isArray(raw.capabilities) || raw.capabilities.length === 0) {
+    throw new ManifestError("capabilities: non-empty array required");
+  }
+  for (const cap of raw.capabilities) {
+    if (cap === null || typeof cap !== "object" || Array.isArray(cap)) {
+      throw new ManifestError("capabilities entries must be objects");
+    }
+    for (const key of Object.keys(cap)) {
+      if (!["scope_id", "actions"].includes(key)) {
+        throw new ManifestError(`unknown capability key '${key}'`);
+      }
+    }
+    if (!knownScopeIds.has(cap.scope_id)) {
+      throw new ManifestError(`capability scope_id '${cap.scope_id}' is not in the permissions SSOT (fail-closed)`);
+    }
+    if (!Array.isArray(cap.actions) || cap.actions.length === 0 ||
+        !cap.actions.every((a) => a === "read" || a === "execute")) {
+      throw new ManifestError(`capability '${cap.scope_id}': actions must be a non-empty subset of ['read','execute']`);
+    }
+  }
+
+  if (raw.entry === null || typeof raw.entry !== "object") {
+    throw new ManifestError("entry: object required");
+  }
+  for (const key of Object.keys(raw.entry)) {
+    if (!["transport", "path"].includes(key)) {
+      throw new ManifestError(`unknown entry key '${key}'`);
+    }
+  }
+  if (raw.entry.transport !== "sse" && raw.entry.transport !== "streamable-http") {
+    throw new ManifestError("entry.transport must be 'sse' or 'streamable-http' (MCP standards only)");
+  }
+  requireString(raw.entry.path, "entry.path", 128);
+  if (!PATH_RE.test(raw.entry.path) || raw.entry.path.includes("..")) {
+    throw new ManifestError("entry.path: tower-relative path only (no hosts, no scheme, no traversal)");
+  }
+
+  if (!Array.isArray(raw.tools) || raw.tools.length === 0) {
+    throw new ManifestError("tools: non-empty array required");
+  }
+  const seen = new Set();
+  for (const tool of raw.tools) {
+    if (tool === null || typeof tool !== "object" || Array.isArray(tool)) {
+      throw new ManifestError("tools entries must be objects");
+    }
+    for (const key of Object.keys(tool)) {
+      if (!["name", "description", "required_scopes"].includes(key)) {
+        throw new ManifestError(`unknown tool key '${key}'`);
+      }
+    }
+    requireString(tool.name, "tool.name", 64);
+    if (!TOOL_RE.test(tool.name)) throw new ManifestError(`tool name '${tool.name}' invalid`);
+    if (seen.has(tool.name)) throw new ManifestError(`duplicate tool name '${tool.name}'`);
+    seen.add(tool.name);
+    requireString(tool.description, `tool ${tool.name} description`, 280);
+    if (!Array.isArray(tool.required_scopes) || tool.required_scopes.length === 0) {
+      throw new ManifestError(`tool ${tool.name}: required_scopes non-empty array required`);
+    }
+    for (const sid of tool.required_scopes) {
+      if (!knownScopeIds.has(sid)) {
+        throw new ManifestError(`tool ${tool.name}: required scope '${sid}' not in permissions SSOT (fail-closed)`);
+      }
+    }
+  }
+
+  return Object.freeze({
+    manifest_version: raw.manifest_version,
+    name: raw.name,
+    version: raw.version,
+    description: raw.description,
+    capabilities: Object.freeze(raw.capabilities.map((c) => Object.freeze({ ...c }))),
+    entry: Object.freeze({ ...raw.entry }),
+    tools: Object.freeze(raw.tools.map((t) => Object.freeze({ ...t, required_scopes: Object.freeze([...t.required_scopes]) }))),
+  });
+}
diff --git a/examples/skills-installer-reference/src/mock_tower.mjs b/examples/skills-installer-reference/src/mock_tower.mjs
new file mode 100644
index 00000000..3354c0b6
--- /dev/null
+++ b/examples/skills-installer-reference/src/mock_tower.mjs
@@ -0,0 +1,97 @@
+// mock_tower.mjs — offline MCP tower mock (issue #332 test harness).
+//
+// Surface:
+//   POST /mcp              initialize (issues mcp-session-id) / notifications / tools/list / tools/call
+//   GET  /sse              SSE leg: announces an endpoint frame
+//   POST /mcp-sse-session  the endpoint the SSE leg announces (same JSON-RPC surface)
+//   GET  /private          401 probe
+// Run directly for a smoke: node src/mock_tower.mjs
+import { createServer } from "node:http";
+
+const SESSIONS = new Map(); // sessionId -> {initialized: bool}
+
+function json(res, status, obj, headers = {}) {
+  const raw = JSON.stringify(obj);
+  res.writeHead(status, { "Content-Type": "application/json", ...headers });
+  res.end(raw);
+}
+
+function rpcHander(req, res, body) {
+  const rpc = JSON.parse(body);
+  const sid = req.headers["mcp-session-id"];
+  if (rpc.method === "initialize") {
+    const newSid = `sess-${Math.random().toString(16).slice(2, 10)}`;
+    SESSIONS.set(newSid, { initialized: false });
+    json(res, 200, {
+      jsonrpc: "2.0", id: rpc.id,
+      result: { protocolVersion: "2025-03-26", capabilities: { tools: {} },
+                serverInfo: { name: "mock-skills-tower", version: "1.0.0" } },
+    }, { "mcp-session-id": newSid });
+    return;
+  }
+  if (rpc.method === "notifications/initialized") {
+    if (sid && SESSIONS.has(sid)) SESSIONS.get(sid).initialized = true;
+    res.writeHead(202).end();
+    return;
+  }
+  if (!sid || !SESSIONS.has(sid)) {
+    json(res, 200, { jsonrpc: "2.0", id: rpc.id ?? null,
+                     error: { code: -32001, message: "unknown session - initialize first" } });
+    return;
+  }
+  if (rpc.method === "tools/list") {
+    json(res, 200, { jsonrpc: "2.0", id: rpc.id, result: {
+      tools: [{ name: "repo_read", description: "read a repo path" },
+              { name: "repo_write", description: "write a repo path" }],
+    } });
+    return;
+  }
+  if (rpc.method === "tools/call") {
+    const name = rpc.params?.name ?? "";
+    if (name === "repo_write") {
+      // The mock enforces its own server-side boundary too: writes are denied.
+      json(res, 200, { jsonrpc: "2.0", id: rpc.id,
+                       result: { content: [], isError: true, message: "server-side deny: repo_write" } });
+      return;
+    }
+    json(res, 200, { jsonrpc: "2.0", id: rpc.id,
+                     result: { content: [{ type: "text", text: `echo:${name}` }],
+                              tool: name, echo: rpc.params?.arguments ?? {} } });
+    return;
+  }
+  json(res, 200, { jsonrpc: "2.0", id: rpc.id ?? null,
+                   error: { code: -32601, message: `unknown method ${rpc.method}` } });
+}
+
+export function startMockTower(port = 0) {
+  const server = createServer((req, res) => {
+    let body = "";
+    req.on("data", (c) => { body += c; });
+    req.on("end", () => {
+      if (req.method === "POST" && (req.url.startsWith("/mcp") || req.url.startsWith("/mcp-sse-session"))) {
+        try { rpcHander(req, res, body); } catch {
+          json(res, 200, { jsonrpc: "2.0", id: null, error: { code: -32700, message: "parse error" } });
+        }
+      } else if (req.method === "GET" && req.url.startsWith("/sse")) {
+        res.writeHead(200, { "Content-Type": "text/event-stream" });
+        res.write("event: endpoint\ndata: /mcp-sse-session\n\n");
+        res.end();
+      } else if (req.url.startsWith("/private")) {
+        json(res, 401, { error: "unauthorized" });
+      } else {
+        json(res, 404, { error: "not found" });
+      }
+    });
+  });
+  return new Promise((resolve) => server.listen(port, "127.0.0.1", () => resolve({
+    server,
+    baseUrl: `http://127.0.0.1:${server.address().port}`,
+  })));
+}
+
+if (process.argv[1] && process.argv[1].endsWith("mock_tower.mjs")) {
+  const { server, baseUrl } = await startMockTower(0);
+  console.log(`mock skills tower on ${baseUrl} (ctrl-c to stop)`);
+  const stop = () => server.close(() => process.exit(0));
+  process.on("SIGINT", stop);
+}
diff --git a/examples/skills-installer-reference/src/registry.mjs b/examples/skills-installer-reference/src/registry.mjs
new file mode 100644
index 00000000..47b6d9d8
--- /dev/null
+++ b/examples/skills-installer-reference/src/registry.mjs
@@ -0,0 +1,105 @@
+// registry.mjs — capability registry (issue #332 AC1).
+//
+// Loads a marketplace of skill manifests FAIL-CLOSED: every manifest is
+// validated at construction (manifest.mjs contract); one invalid manifest
+// rejects the WHOLE load — a poisoned marketplace entry can never be half-
+// installed. Discovery and install are pure functions over the frozen index.
+
+import { validateManifest } from "./manifest.mjs";
+
+export class RegistryError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = "RegistryError";
+  }
+}
+
+export class CapabilityRegistry {
+  /**
+   * @param {object} permissionsPolicy parsed permissions fixture (needs permission_scopes)
+   * @param {object[]} rawManifests marketplace manifests
+   */
+  constructor(permissionsPolicy, rawManifests) {
+    if (permissionsPolicy === null || typeof permissionsPolicy !== "object") {
+      throw new RegistryError("permissions policy object required (fail-closed)");
+    }
+    const scopes = permissionsPolicy.permission_scopes;
+    if (!Array.isArray(scopes) || scopes.length === 0) {
+      throw new RegistryError("permissions policy must carry a non-empty permission_scopes list");
+    }
+    this.#scopeIds = new Set(scopes.map((s) => s.scope_id).filter(Boolean));
+    if (this.#scopeIds.size !== scopes.length) {
+      throw new RegistryError("duplicate scope_id in permissions policy (fail-closed)");
+    }
+    if (!Array.isArray(rawManifests) || rawManifests.length === 0) {
+      throw new RegistryError("marketplace manifests must be a non-empty array");
+    }
+    const index = new Map();
+    for (const raw of rawManifests) {
+      let manifest;
+      try {
+        manifest = validateManifest(raw, this.#scopeIds);
+      } catch (err) {
+        // Uniform fail-closed surface: a poisoned marketplace entry rejects
+        // the WHOLE load, with the underlying reason preserved.
+        throw new RegistryError(`manifest load rejected: ${err.message}`);
+      }
+      if (index.has(manifest.name)) {
+        throw new RegistryError(`duplicate skill name '${manifest.name}' in marketplace`);
+      }
+      index.set(manifest.name, manifest);
+    }
+    this.#index = index;
+  }
+
+  #scopeIds;
+  #index;
+
+  /** All installed skill names (deterministic order). */
+  listNames() {
+    return [...this.#index.keys()].sort();
+  }
+
+  /**
+   * Discovery (AC1): skills whose tools require the queried scope.
+   * @param {{scope_id?: string, action?: "read"|"execute"}} query
+   */
+  discover(query = {}) {
+    if (query.scope_id !== undefined && !this.#scopeIds.has(query.scope_id)) {
+      // Unknown scope in a DISCOVERY QUERY is a caller bug — honest empty
+      // result would hide it; the fail-closed posture reports it.
+      throw new RegistryError(`query.scope_id '${query.scope_id}' is not in the permissions SSOT`);
+    }
+    const results = [];
+    for (const manifest of this.#index.values()) {
+      const matched = manifest.tools.filter((tool) => {
+        const scopeOk = query.scope_id === undefined || tool.required_scopes.includes(query.scope_id);
+        const cap = manifest.capabilities.find((c) => c.scope_id === query.scope_id);
+        const actionOk = query.action === undefined || (cap && cap.actions.includes(query.action));
+        return scopeOk && actionOk;
+      });
+      if (matched.length > 0) {
+        results.push(Object.freeze({
+          name: manifest.name,
+          version: manifest.version,
+          description: manifest.description,
+          entry: manifest.entry,
+          matching_tools: matched.map((t) => t.name),
+        }));
+      }
+    }
+    return results.sort((a, b) => (a.name < b.name ? -1 : 1));
+  }
+
+  /**
+   * Install (AC1): return the validated manifest as an immutable handle.
+   * Installation is pure validation + freeze — nothing executes here.
+   */
+  install(name) {
+    const manifest = this.#index.get(name);
+    if (manifest === undefined) {
+      throw new RegistryError(`skill '${name}' not found in registry (fail-closed)`);
+    }
+    return manifest;
+  }
+}
