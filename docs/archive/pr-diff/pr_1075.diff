+# SupremeAI QA checklist — Admin journey (A-01..A-10)
+# Schema: docs/plans/features/qa_engine_auto_checking_implementation_plan.md (Part 1)
+# Routes verified against frontend/src/App.tsx: /admin/* is the ONLY admin route
+# (ProtectedRoute -> RoleGuard(requiredRole=admin) -> AdminShell). Step-up
+# (Firebase -> OTP/TOTP -> RBAC) is enforced inside AdminShell
+# (frontend/src/pages/admin/AdminShell.tsx, adminStore otpRequired/totpSetupRequired).
+# Admin API endpoints grounded in backend/api/routes/admin_v1.py (prefix /api/v1,
+# dependencies=[Depends(require_admin_token), Depends(admin_rate_limit)]).
+- id: A-01
+  area: auth
+  role: admin
+  name: Unauthenticated /admin access is denied
+  description: >
+    Visiting /admin without a session never shows the console: ProtectedRoute
+    redirects to /login before RoleGuard/AdminShell mount.
+  route: /admin
+  severity: P0
+  automated: true
+  action:
+    - navigate: /admin
+  assert:
+    - url_matches: ^/login$
+  manual_note: null
+
+- id: A-02
+  area: stepup
+  role: admin
+  name: Step-up OTP/TOTP challenge gates the console
+  description: >
+    After Firebase login, an admin without a step-up session sees the
+    AdminShell OTP/TOTP challenge (adminStore otpRequired) and cannot reach
+    console data until the OTP/TOTP verify succeeds.
+  route: /admin
+  severity: P0
+  automated: true
+  action:
+    - navigate: /login
+    - fill: '[data-testid="email-input"] =<qa-admin-email>'
+    - fill: '[data-testid="password-input"] =<qa-admin-password>'
+    - click: '[data-testid="login-submit"]'
+    - navigate: /admin
+    - fill: '[data-testid="admin-email-input"] =<qa-admin-email>'
+    - fill: '[data-testid="admin-password-input"] =<qa-admin-password>'
+    - click: '[data-testid="admin-login-submit"]'
+    - assert: '[data-testid="otp-input"]'
+  assert:
+    - selector_visible: '[data-testid="otp-input"]'
+    - no_network_request: /api/v1/admin/stats
+  manual_note: "Resolved (M0-G): Part-9 testids on LoginPage + AdminGate (admin-email-input/admin-password-input/admin-login-submit/otp-input/otp-submit) implemented; spec drives the real two-stage flow. Env prerequisites: QA_ADMIN_EMAIL/QA_ADMIN_PASSWORD + live backend answering otp_required for the dedicated QA admin."
+
+- id: A-03
+  area: auth
+  role: admin
+  name: Step-up admin reaches the console
+  description: >
+    With a completed step-up session (storage state from the admin setup
+    project), /admin stays on the console: no redirect to /login, shell renders.
+  route: /admin
+  severity: P1
+  automated: true
+  action:
+    - navigate: /admin
+  assert:
+    - url_matches: ^/admin
+    - not_url_matches: ^/login$
+  manual_note: Requires the admin storage state produced by qa/playwright/admin/.auth/auth.setup.ts.
+
+- id: A-04
+  area: rbac
+  role: admin
+  name: Admin API rejects unauthenticated requests
+  description: >
+    GET /api/v1/admin/stats (backend/api/routes/admin_v1.py, require_admin_token)
+    returns 401/403 without credentials — console data is never public.
+  route: /admin
+  severity: P1
+  automated: true
+  action:
+    - request_get: /api/v1/admin/stats
+  assert:
+    - status_in: '401,403'
+  manual_note: null
+
+- id: A-05
+  area: rbac
+  role: admin
+  name: Admin API rejects authenticated non-admin token
+  description: >
+    A valid customer JWT presented to /api/v1/admin/* is rejected with 403 —
+    backend RBAC re-checks role on every admin call even with a valid login.
+  route: /admin
+  severity: P1
+  automated: true
+  action:
+    - request_get_with_customer_token: /api/v1/admin/stats
+  assert:
+    - status_in: '403'
+  manual_note: Requires extracting a customer JWT from the auth storage state; token transport (Bearer header vs cookie) not yet verified — pending Part 9 fixture work.
+
+- id: A-06
+  area: console
+  role: admin
+  name: Overview sub-tab renders without shell crash
+  description: >
+    The admin console overview sub-tab (AdminConsole default "overview")
+    renders its KPI/health data without crashing the admin shell.
+  route: /admin
+  severity: P2
+  automated: true
+  action:
+    - navigate: /admin
+    - assert: admin-shell
+  assert:
+    - selector_visible: admin-shell
+  manual_note: "Resolved (M0-G): admin-shell (AdminAuthenticated) + admin-kpi (overview Dashboard KPI cards) testids implemented; requires the stepped-up admin storage state from setup-admin (QA_ADMIN_* + live backend)."
+
+- id: A-07
+  area: console
+  role: admin
+  name: Sub-tab navigation switches panels
+  description: >
+    Switching admin sub-tabs (overview -> users -> audit-logs) updates the
+    panel content without a full page reload or error boundary.
+  route: /admin
+  severity: P2
+  automated: true
+  action:
+    - navigate: /admin
+    - click: '[data-testid="admin-tenants-rbac-tab"]'
+  assert:
+    - selector_visible: '[data-testid="user-list"]'
+  manual_note: "Resolved (M0-G): nav action buttons carry data-testid='admin-<actionId>-tab'; the users panel is the registry's Tenants/RBAC sub-tab (UserManager), whose registry list carries user-list. Requires admin storage state from setup-admin."
+
+- id: A-08
+  area: rbac
+  role: admin
+  name: Role changes take effect across RBAC matrix
+  description: >
+    Changing a user's role from the console is reflected in backend RBAC
+    decisions (new role granted/denied on next request) — verified against
+    the RBAC matrix, not just the UI state.
+  route: /admin
+  severity: P1
+  automated: false
+  action:
+    - navigate: /admin
+    - open: user-management-panel
+    - change_role: selected-user
+  assert:
+    - rbac_decision_matches_new_role: "true"
+  manual_note: Human-executed RBAC drill with a dedicated non-admin test account; UI state alone cannot prove backend enforcement.
+
+- id: A-09
+  area: stepup
+  role: admin
+  name: TOTP recovery flow restores admin access
+  description: >
+    Using a recovery code on the TOTP recovery path (adminStore recoverTotp)
+    restores step-up access and invalidates the used code.
+  route: /admin
+  severity: P2
+  automated: false
+  action:
+    - navigate: /admin
+    - use_recovery_code: pre-provisioned-code
+  assert:
+    - step_up_succeeds: "true"
+    - code_single_use: "true"
+  manual_note: Requires pre-provisioned recovery codes in a dedicated QA admin account; drill executed before each release.
+
+- id: A-10
+  area: console
+  role: admin
+  name: Admin console copy and visual hierarchy review
+  description: >
+    Admin console panels read clearly (labels, error copy, Bangla/English
+    mix) and visual hierarchy matches the design intent — human judgment.
+  route: /admin
+  severity: P3
+  automated: false
+  action:
+    - navigate: /admin
+    - review: each-sub-tab
+  assert:
+    - human_signoff_recorded: "true"
+  manual_note: Subjective quality per plan Part 10 — machines cannot judge copy naturalness or visual hierarchy.
