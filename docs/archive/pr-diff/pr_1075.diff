new file mode 100644
index 00000000..abc83d63
--- /dev/null
+++ b/examples/vscode-agent-monitor/package.json
@@ -0,0 +1,53 @@
+{
+  "name": "supremeai-vscode-agent-monitor",
+  "displayName": "SupremeAI Agent Monitor",
+  "description": "Live agent execution monitor: status bar indicator and streaming event output (issue #333 reference).",
+  "version": "0.1.0",
+  "publisher": "supremeai",
