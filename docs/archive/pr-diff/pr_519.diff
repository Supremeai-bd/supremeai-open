+class CliSmoke(unittest.TestCase):
+    def test_27_extractor_cli_json(self):
+        import json
+        import tempfile
+        with tempfile.NamedTemporaryFile("w", suffix=".py", delete=False) as fh:
+            fh.write(fingerprint_source())
+            path = fh.name
+        try:
+            out = subprocess.run(
+                [sys.executable, str(AGENTS / "scout_extractor.py"),
+                 "--extract", path, "evidence_fingerprint", "--json"],
+                capture_output=True, text=True, timeout=60)
+        finally:
+            Path(path).unlink(missing_ok=True)
+        self.assertEqual(out.returncode, 0, out.stderr)
+        payload = json.loads(out.stdout)
+        self.assertEqual(payload["lines"], 35)
+        self.assertTrue(payload["budget_ok"])
+
+    def test_28_guard_cli_exit_semantics(self):
+        clean = subprocess.run(
+            [sys.executable, str(CI / "vendored_tree_guard.py"),
+             "--files-json", '[{"path": "src/ok.py", "bytes": 100}]'],
+            capture_output=True, text=True, timeout=60)
+        self.assertEqual(clean.returncode, 0)
+        dirty = subprocess.run(
+            [sys.executable, str(CI / "vendored_tree_guard.py"),
+             "--files-json", '[{"path": "vendor/x.py", "bytes": 10}]'],
+            capture_output=True, text=True, timeout=60)
+        self.assertEqual(dirty.returncode, 2)
