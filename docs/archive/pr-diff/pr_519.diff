+        (lambda: _check_budget(ExtractedSlice(
+            "python", "tiny", "x", 1, 1, ())), ExtractionError),
+    ):
+        try:
+            breaker()
+            raise SystemExit(f"extractor gate failed open: {exc}")
+        except exc:  # type: ignore[misc]
+            pass
+
+    # TS brace balancing.
+    ts_source = "\n".join(
+        ["import { Node } from './dom';", "",
+         "export function semanticFilter(nodes: Node[]): Node[] {",
+         "  const out: Node[] = [];"]
+        + [f"  if (!nodes[{i}]) throw new Error('unknown node');"
