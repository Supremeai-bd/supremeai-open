@@ -0,0 +1,53 @@
+name: ci
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+
+permissions:
+  contents: read
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+
+      - name: Install dependencies
+        run: |
+          python -m pip install --upgrade pip
+          pip install ruff pytest pytest-asyncio pydantic
+
+      - name: Lint with ruff
+        run: |
+          ruff check .
+
+      - name: Run pytest
+        run: |
+          pytest -v
+
+      - name: Secret scan (fail-closed)
+        run: |
+          set -euo pipefail
+          HIT=0
+          check() {
+            if grep -rInE "$1" --exclude-dir=.git . 2>/dev/null; then
+              echo "::error::secret-pattern hit: $2"; HIT=1
+            fi
+          }
+          check 'sk-[A-Za-z0-9]{20,}' 'OpenAI-style sk- key'
+          check 'gh[pousr]_[A-Za-z0-9]{36,}' 'GitHub token'
+          check 'AKIA[0-9A-Z]{16}' 'AWS access key'
+          check 'AIza[0-9A-Za-z_-]{35}' 'Google API key'
+          if [ "$HIT" -eq 1 ]; then
+            echo "Security violation: secret detected in repository"
+            exit 1
+          fi
+          echo "Secret scan clean"
