+  const d4 = svc.decide(normalizedGithub(failurePayload({ workflow_run: { id: 1, name: "CI", conclusion: "success", run_attempt: 1 } })));
+  check("rejects conclusion=success", !d4.accept && d4.reason.includes("conclusion not watched"));
