+          { name: "lint", conclusion: "success", html_url: "https://github.com/x/job/2", steps: [] },
+          { name: "deploy", conclusion: null, html_url: "https://github.com/x/job/3", steps: [] },
+        ],
+      }),
+      { status: 200, headers: { "content-type": "application/json" } },
