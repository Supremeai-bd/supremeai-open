+// ── 7. defaultFetchJobs — enrichment extraction (stubbed fetch) ────────────────
+section("defaultFetchJobs: failed-job/step extraction (stubbed fetch)");
+{
+  const origFetch = globalThis.fetch;
+  globalThis.fetch = (async () =>
