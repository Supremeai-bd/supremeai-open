+        )
+        out = Path(td)
+        train = out / "train.jsonl"
+        val = out / "val.jsonl"
+        all_rows_path = out / "all.jsonl"
+        assert train.exists() and val.exists() and all_rows_path.exists()
+
+        all_rows = [
