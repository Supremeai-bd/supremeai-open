+# --- poetry runtime plane (#2101, radar R49) -------------------------------
+
+POETRY_SKIP_KEYS = frozenset({"python"})
+_LOCAL_VCS_KEYS = ("path", "git", "url", "file")
+_EXACT_VERSION_RE = re.compile(r"^v?\d+(?:\.\d+)*(?:(?:[ab]|rc|\.dev)\d+)?$")
+_OPEN_SPEC_RE = re.compile(r"^(?:>=|<=|!=|>|<)\s*v?\d")
