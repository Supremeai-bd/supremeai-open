-                embeddings=[embedding],
-                payloads=[{
-                    "content": content,
-                    "user_id": user_id,
-                    "session_id": session_id,
-                    "importance": importance,
-                }],
-                ids=[f"{user_id}:{session_id}:{hash(content) & 0xFFFFFF}"],
