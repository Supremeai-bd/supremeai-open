-
-class AutoRAGInjector:
-    """Retrieves top-K relevant memories and prepends them to the system prompt."""
-
-    MEMORY_PREFIX = "\n\n--- 🧠 Past Context (Auto-Recalled) ---\n"
-    TOP_K = 5
