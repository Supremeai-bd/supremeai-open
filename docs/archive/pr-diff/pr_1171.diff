+  extends?: string;
+  implements?: string[];
+}
+
+export interface DependencyGraph {
+  nodes: DependencyNode[];
+  edges: DependencyEdge[];
+}
+
+export interface DependencyNode {
+  id: string;
+  label: string;
+  type: 'file' | 'function' | 'class' | 'module';
