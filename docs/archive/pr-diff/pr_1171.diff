+  --sa-ink: #f1f5f2;
+  --sa-ink-muted: #9aa9a2;
+  --sa-border: #2b3a34;
+  --sa-primary: #62d7b2;
+  --sa-primary-soft: #173c32;
+  --sa-action: #7ea8ff;
+  --sa-action-soft: #1c2e52;
+  --sa-success: #62d7b2;
+  --sa-warning: #f3c969;
+  --sa-danger: #f38b8b;
+  --sa-shadow-sm: 0 1px 2px rgb(0 0 0 / 0.18);
+  --sa-shadow-md: 0 16px 36px rgb(0 0 0 / 0.24);
+}
+
+/* Prefer the calm product canvas for the default shell. Existing specialty
+   themes can still opt into their own surfaces through more specific rules. */
+body {
+  background: var(--sa-canvas);
+  color: var(--sa-ink);
+  font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
+  transition: background-color 160ms ease, color 160ms ease;
+}
+
+.sa-surface {
+  background: var(--sa-surface);
