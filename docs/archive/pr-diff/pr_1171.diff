+/* ═══════════════════════════════════════════════════════
+   ELEGANT DASHBOARD SYSTEM (Aurora Sky + Glass Cards)
+   বাংলা মন্তব্য: ড্যাশবোর্ড/অ্যাডমিন কনসোলের জন্য শান্ত অ্যানিমেটেড
+   পিসফুল-স্কাই অরোরা ব্যাকগ্রাউন্ড ও গ্লাসমরফিজম কার্ড।
+   সব টোকেন-ভিত্তিক — নতুন হার্ডকোডেড রঙ নেই, থিম-অ্যাওয়ার।
+   ═══════════════════════════════════════════════════════ */
+
+/* ── Peaceful Aurora/স্কাই ব্যাকগ্রাউন্ড (লাইট) ── */
+.dashboard-aurora {
+  position: relative;
+  isolation: isolate;
+  overflow: hidden;
+  background:
+    radial-gradient(1200px 800px at 8% -12%, rgba(147, 197, 253, 0.18), transparent 60%),
+    radial-gradient(1000px 750px at 108% 8%, rgba(216, 180, 254, 0.16), transparent 55%),
+    radial-gradient(900px 720px at 50% 125%, rgba(125, 211, 252, 0.14), transparent 60%),
+    var(--background, #f8fafc);
+  background-attachment: fixed;
+  background-size: cover;
+  transition: background 0.5s ease;
+}
+
+.dark .dashboard-aurora {
+  background:
+    radial-gradient(1100px 780px at 12% -14%, rgba(0, 243, 255, 0.10), transparent 60%),
+    radial-gradient(950px 720px at 112% 12%, rgba(188, 19, 254, 0.12), transparent 55%),
+    radial-gradient(1050px 820px at 52% 128%, rgba(99, 102, 241, 0.12), transparent 60%),
+    var(--background, #0a0e1a);
+  background-attachment: fixed;
+  background-size: cover;
+}
+
+/* ভাসমান "স্কাই" অরব — ধীর, GPU-ফ্রেন্ডলি ট্রান্সফর্ম অ্যানিমেশন */
+.dashboard-aurora::before,
+.dashboard-aurora::after {
+  content: "";
+  position: absolute;
+  z-index: -1;
+  border-radius: 50%;
+  filter: blur(90px);
+  pointer-events: none;
+  opacity: 0.55;
+  will-change: transform;
+}
+
+.dashboard-aurora::before {
+  width: 55vw;
+  height: 55vw;
+  left: -14vw;
+  top: -16vw;
+  background: radial-gradient(circle, rgba(129, 140, 248, 0.5), transparent 68%);
+  animation: aurora-drift-a 30s ease-in-out infinite;
+}
+
+.dashboard-aurora::after {
+  width: 48vw;
+  height: 48vw;
+  right: -12vw;
+  bottom: -14vw;
+  background: radial-gradient(circle, rgba(34, 211, 238, 0.45), transparent 68%);
+  animation: aurora-drift-b 36s ease-in-out infinite;
+}
+
+.dark .dashboard-aurora::before {
