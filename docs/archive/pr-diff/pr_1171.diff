+  const fetchFixes = async () => {
+    setLoading(true);
+    try {
+      // Issue #2522: raw fetch -> apiClient.get — token ক্লায়েন্ট নিজেই বসায়।
+      const data = await apiClient.get<{ fixes?: unknown[] }>('/api/admin/fixes?tenant_id=supremeai-a');
+      setFixes(data.fixes || []);
