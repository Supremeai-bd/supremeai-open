+  errorMessage: string;
+  errorCode?: string;
+  filePath: string;
+  lineNumber: number;
+  columnNumber?: number;
+  stackTrace?: string;
+  codeSnippet?: string;
+  severity: 'error' | 'warning' | 'info';
+  timestamp: string;
+}
+
+export interface SuggestionFeedback {
+  suggestionId: string;
