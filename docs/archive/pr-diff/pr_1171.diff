+  --sa-action-soft: #e5eeff;
+  --sa-success: #16805b;
+  --sa-warning: #b7791f;
+  --sa-danger: #c24141;
+  --sa-radius: 12px;
+  --sa-radius-sm: 8px;
+  --sa-shadow-sm: 0 1px 2px rgb(17 22 21 / 0.05);
