+
+/* ═══════════════════════════════════════════════════════
+   THEME 1: SUPREMEAI 2.0 (Inherently Dark)
+   ═══════════════════════════════════════════════════════ */
+:root, .dark {
+  --background: #06070B; /* Ink */
+  --foreground: #F8FAFC; /* Text */
+  --neon-blue: #00F3FF; /* Admin Primary */
+  --neon-purple: #A855F7; /* User Primary */
+  --cyber-gray: #64748B; /* Muted */
+  --success: #22C55E;
+  --danger: #F43F5E;
+  --warning: #F59E0B;
+  --info: #38BDF8;
+  --card-bg: #0B0F17; /* Surface */
+  --card-border: rgba(255, 255, 255, 0.08); /* Border */
+  --sidebar-bg: #0B0F17;
+  --tabbar-bg: #111722; /* Raised */
+  --border-color: rgba(255, 255, 255, 0.08);
+  --card-text: #94A3B8; /* Secondary */
+  --card-title-text: #F8FAFC; /* Text */
+  --alert-bg: rgba(255, 255, 255, 0.02);
+  --input-bg: #06070B; /* Ink */
+  --input-border: rgba(255, 255, 255, 0.08);
+  --panel-bg: #0B0F17; /* Surface */
+
+  /* CommandCenter Semantic Variables */
+  --bg-main: #06070B;
+  --text-main: #F8FAFC;
+  --text-secondary: #94A3B8;
+  --bg-panel: #0B0F17;
+  --bg-cell: #111722;
+  --border-accent: rgba(255, 255, 255, 0.08);
+  --accent-primary: #00F3FF;
+  --accent-secondary: #22D3EE;
+  --node-bg: #0B0F17;
+  --node-text: #F8FAFC;
+  --node-border: rgba(255, 255, 255, 0.08);
+  --chat-bg: #0B0F17;
+  --chat-input-bg: #06070B;
+  --waveform-bg: #111722;
+}
+
+/* ═══════════════════════════════════════════════════════
+   SURFACES (70% Minimal, 20% Glass)
+   ═══════════════════════════════════════════════════════ */
+.surface-0 {
+  background-color: var(--bg-main, #06070B);
+}
+
+.surface-1 {
+  background-color: var(--card-bg, #0B0F17);
+  border: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
+}
+
+.surface-2 {
+  background-color: var(--tabbar-bg, rgba(11, 15, 23, 0.7));
