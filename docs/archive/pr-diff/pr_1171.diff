+/* ═══════════════════════════════════════════════════════════════════════════
+   SUPREMEAI CALM COMMAND CENTER FOUNDATION
+   Lightweight operational identity: quiet telemetry, clear hierarchy, no glow.
+   ═══════════════════════════════════════════════════════════════════════════ */
+:root {
+  --sa-canvas: #f6f7f4;
+  --sa-surface: #ffffff;
+  --sa-surface-muted: #eef1ee;
