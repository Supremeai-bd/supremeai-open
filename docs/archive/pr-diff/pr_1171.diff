+import { chatService, getAethelResponse, sendMessageStream } from './chatService';
+import { apiClient, getAuthHeaders } from './apiClient';
+
+describe('chatService', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    global.fetch = vi.fn();
