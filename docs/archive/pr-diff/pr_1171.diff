+import React from 'react';
+import { Activity, AlertTriangle, ArrowUpRight, CheckCircle2, CircleDashed, GitMerge, HeartPulse, LifeBuoy, ServerCog, ShieldCheck, Sparkles, Terminal, Zap } from 'lucide-react';
+import { useMetrics, useThreatScan, useCIReports, useDashboardEvents } from '../../hooks/useDashboardData';
+
+type HealthRecord = { status?: string; latency?: string | number; region?: string; [key: string]: unknown };
+
+interface AdminCommandCenterProps {
+  healthMap?: Record<string, HealthRecord>;
+  setAdminSubTab?: (tab: string) => void;
+  handleTriggerDeploy?: () => void;
+  actionStatus?: string;
+}
+
+const statusTone = (status: string | undefined) => {
+  const normalized = (status || 'unknown').toLowerCase();
+  if (['healthy', 'operational', 'online', 'ok', 'ready'].includes(normalized)) return { label: status || 'Healthy', dot: 'bg-emerald-400', text: 'text-emerald-300', bar: 'bg-emerald-400' };
+  if (['degraded', 'warning', 'partial'].includes(normalized)) return { label: status || 'Degraded', dot: 'bg-amber-400', text: 'text-amber-300', bar: 'bg-amber-400' };
+  if (['down', 'offline', 'error', 'critical'].includes(normalized)) return { label: status || 'Offline', dot: 'bg-rose-400', text: 'text-rose-300', bar: 'bg-rose-400' };
+  return { label: status || 'Unknown', dot: 'bg-slate-500', text: 'text-slate-400', bar: 'bg-slate-500' };
+};
+
+function MetricCard({ label, value, detail, icon: Icon, tone = 'cyan' }: { label: string; value: React.ReactNode; detail: string; icon: React.ElementType; tone?: 'cyan' | 'emerald' | 'amber' | 'rose' }) {
+  const tones = { cyan: 'text-cyan-300 bg-cyan-400/10 border-cyan-400/20', emerald: 'text-emerald-300 bg-emerald-400/10 border-emerald-400/20', amber: 'text-amber-300 bg-amber-400/10 border-amber-400/20', rose: 'text-rose-300 bg-rose-400/10 border-rose-400/20' };
+  return <article className="rounded-2xl border border-[var(--sa-border)] bg-[var(--sa-surface)] p-5 shadow-[0_18px_50px_rgba(0,0,0,0.12)]"><div className="flex items-start justify-between gap-3"><div><p className="sa-eyebrow">{label}</p><p className="mt-3 text-3xl font-semibold tracking-tight text-[var(--sa-ink)]">{value}</p><p className="mt-2 text-xs text-[var(--sa-ink-muted)]">{detail}</p></div><div className={`rounded-xl border p-2.5 ${tones[tone]}`}><Icon size={18} /></div></div></article>;
+}
+
+export default function AdminCommandCenter({ healthMap = {}, setAdminSubTab, handleTriggerDeploy, actionStatus }: AdminCommandCenterProps) {
+  const { data: metrics } = useMetrics();
+  const { data: threats } = useThreatScan();
+  const { data: ciReports } = useCIReports();
+  const { data: events } = useDashboardEvents(6);
+  const findings = threats?.findings || [];
+  const activeIncidents = findings.filter((item) => item.severity === 'high' || item.severity === 'critical');
+  const runningDeployments = ciReports?.filter((item) => item.status === 'running') || [];
+  const serviceEntries = Object.entries(healthMap);
+  const healthyServices = serviceEntries.filter(([, service]) => ['healthy', 'operational', 'online', 'ok', 'ready'].includes((service.status || '').toLowerCase())).length;
+  const rps = metrics?.requests_per_second;
+  const latency = metrics?.latency_p95_ms;
+  const cpu = metrics?.cpu_percent ?? metrics?.cpu_usage_percent;
+  const open = (tab: string) => setAdminSubTab?.(tab);
+
+  return <div className="min-h-full bg-[var(--sa-canvas)] px-5 py-7 sm:px-8 lg:px-10"><div className="mx-auto max-w-[1500px] space-y-7"><header className="flex flex-col justify-between gap-5 lg:flex-row lg:items-end"><div><div className="mb-3 flex items-center gap-2 text-xs font-medium uppercase tracking-[0.18em] text-cyan-300"><Sparkles size={14} /> SupremeAI operations</div><h1 className="text-3xl font-semibold tracking-tight text-[var(--sa-ink)] sm:text-4xl">Command Center</h1><p className="mt-2 max-w-2xl text-sm leading-6 text-[var(--sa-ink-muted)]">One calm surface for platform health, incidents, delivery, and the next safe operator action.</p></div><div className="flex flex-wrap items-center gap-3"><span className="inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-2 text-xs font-medium text-emerald-300"><span className="size-2 rounded-full bg-emerald-400 shadow-[0_0_12px_rgba(52,211,153,0.8)]" />Admin context protected</span>{handleTriggerDeploy && <button type="button" onClick={handleTriggerDeploy} className="inline-flex items-center gap-2 rounded-xl border border-cyan-400/25 bg-cyan-400/10 px-3 py-2 text-xs font-semibold text-cyan-200 transition hover:bg-cyan-400/20"><GitMerge size={15} /> Deploy</button>}</div></header>{actionStatus && <div role="status" className="rounded-xl border border-cyan-400/20 bg-cyan-400/10 px-4 py-3 text-xs text-cyan-200">{actionStatus}</div>}<section className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="Platform summary"><MetricCard label="Platform signal" value={metrics ? 'Live' : 'Pending'} detail={metrics ? 'Telemetry is reporting' : 'Waiting for telemetry'} icon={HeartPulse} tone={metrics ? 'emerald' : 'amber'} /><MetricCard label="p95 latency" value={latency != null ? `${latency} ms` : '—'} detail="From the current metrics snapshot" icon={Zap} tone="cyan" /><MetricCard label="Open incidents" value={activeIncidents.length} detail={activeIncidents.length ? 'Review required' : 'No high-severity findings'} icon={activeIncidents.length ? AlertTriangle : CheckCircle2} tone={activeIncidents.length ? 'rose' : 'emerald'} /><MetricCard label="Running deploys" value={runningDeployments.length} detail="CI/CD runs currently active" icon={GitMerge} tone="amber" /></section><section className="grid gap-5 xl:grid-cols-[1.35fr_0.65fr]"><div className="space-y-5"><article className="rounded-2xl border border-[var(--sa-border)] bg-[var(--sa-surface)] p-5 sm:p-6"><div className="flex flex-wrap items-start justify-between gap-4"><div><p className="sa-eyebrow">Operational posture</p><h2 className="mt-2 text-lg font-semibold text-[var(--sa-ink)]">What needs attention now?</h2></div><span className="text-xs text-[var(--sa-ink-muted)]">Auto-refreshed by platform hooks</span></div><div className="mt-5 grid gap-3 sm:grid-cols-3"><PostureItem label="Services" value={serviceEntries.length ? `${healthyServices}/${serviceEntries.length} healthy` : 'No snapshot'} tone={serviceEntries.length && healthyServices === serviceEntries.length ? 'good' : 'neutral'} /><PostureItem label="Compute" value={cpu != null ? `${cpu}% CPU` : 'Awaiting data'} tone={cpu != null && cpu > 80 ? 'warn' : 'good'} /><PostureItem label="Traffic" value={rps != null ? `${rps} req/s` : 'Awaiting data'} tone="neutral" /></div></article><article className="rounded-2xl border border-[var(--sa-border)] bg-[var(--sa-surface)] p-5 sm:p-6"><div className="flex items-center justify-between gap-4"><div><p className="sa-eyebrow">Service health</p><h2 className="mt-2 text-lg font-semibold text-[var(--sa-ink)]">Federation status</h2></div><button type="button" onClick={() => open('service-explorer')} className="inline-flex items-center gap-1 text-xs font-semibold text-cyan-300 hover:text-cyan-200">Open explorer <ArrowUpRight size={14} /></button></div><div className="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">{serviceEntries.length ? serviceEntries.map(([name, service]) => { const tone = statusTone(service.status); return <div key={name} className="rounded-xl border border-[var(--sa-border)] bg-black/10 p-4"><div className="flex items-center justify-between gap-3"><span className="truncate text-sm font-medium capitalize text-[var(--sa-ink)]">{name.replace(/[-_]/g, ' ')}</span><span className={`inline-flex items-center gap-1.5 text-[11px] ${tone.text}`}><span className={`size-1.5 rounded-full ${tone.dot}`} />{tone.label}</span></div><div className="mt-4 h-1.5 overflow-hidden rounded-full bg-white/5"><div className={`h-full rounded-full ${tone.bar}`} style={{ width: tone.label === 'Healthy' || tone.label === 'Operational' ? '100%' : tone.label === 'Degraded' ? '58%' : '24%' }} /></div><p className="mt-3 text-[11px] text-[var(--sa-ink-muted)]">{service.region || 'Region unavailable'}{service.latency != null ? ` · ${service.latency} latency` : ''}</p></div>; }) : <EmptyState icon={CircleDashed} title="No health snapshot yet" body="Open Service Explorer after the next health poll completes." />}</div></article></div><aside className="space-y-5"><article className="rounded-2xl border border-[var(--sa-border)] bg-[var(--sa-surface)] p-5 sm:p-6"><div className="flex items-center gap-3"><div className="rounded-xl border border-indigo-400/20 bg-indigo-400/10 p-2 text-indigo-300"><LifeBuoy size={18} /></div><div><p className="sa-eyebrow">Operator shortcuts</p><h2 className="mt-1 text-lg font-semibold text-[var(--sa-ink)]">Move safely</h2></div></div><div className="mt-5 grid gap-2">{[['incidents', 'Review incidents', AlertTriangle], ['audit', 'Inspect audit trail', ShieldCheck], ['deployments', 'Review deployments', GitMerge], ['configuration', 'Open configuration', ServerCog], ['interactive-chat', 'Ask the admin copilot', Terminal]].map(([tab, label, Icon]) => <button key={tab as string} type="button" onClick={() => open(tab as string)} className="group flex items-center justify-between rounded-xl border border-[var(--sa-border)] bg-black/10 px-3 py-3 text-left text-sm text-[var(--sa-ink)] transition hover:border-cyan-400/30 hover:bg-cyan-400/5"><span className="flex items-center gap-3"><Icon size={16} className="text-[var(--sa-ink-muted)] group-hover:text-cyan-300" />{label as string}</span><ArrowUpRight size={14} className="text-[var(--sa-ink-muted)] group-hover:text-cyan-300" /></button>)}</div></article><article className="rounded-2xl border border-[var(--sa-border)] bg-[var(--sa-surface)] p-5 sm:p-6"><div className="flex items-center justify-between"><div><p className="sa-eyebrow">Recent activity</p><h2 className="mt-1 text-lg font-semibold text-[var(--sa-ink)]">What changed</h2></div><Activity size={18} className="text-cyan-300" /></div><div className="mt-5 space-y-3">{events?.length ? events.map((event, index) => <div key={`${event.timestamp}-${index}`} className="flex gap-3 border-b border-[var(--sa-border)] pb-3 last:border-0 last:pb-0"><div className="mt-1 size-2 shrink-0 rounded-full bg-cyan-300" /><div className="min-w-0"><p className="text-sm text-[var(--sa-ink)]">{event.message || event.source || 'Platform event'}</p><p className="mt-1 text-[11px] text-[var(--sa-ink-muted)]">{new Date(event.timestamp).toLocaleString()}</p></div></div>) : <EmptyState icon={Activity} title="No recent events" body="The activity stream is quiet." />}</div></article></aside></section>{activeIncidents.length > 0 && <section className="rounded-2xl border border-rose-400/25 bg-rose-400/5 p-5"><div className="flex items-start gap-3"><AlertTriangle className="mt-0.5 shrink-0 text-rose-300" size={18} /><div><h2 className="font-semibold text-rose-200">High-severity findings require review</h2><p className="mt-1 text-sm text-rose-100/70">The dashboard is showing the live threat feed. Use Incidents or Security for remediation; no destructive action is taken from this overview.</p><button type="button" onClick={() => open('incidents')} className="mt-3 inline-flex items-center gap-2 rounded-lg border border-rose-300/20 px-3 py-2 text-xs font-semibold text-rose-200 hover:bg-rose-400/10">Review now <ArrowUpRight size={14} /></button></div></div></section>}</div></div>;
+}
+
+function PostureItem({ label, value, tone }: { label: string; value: string; tone: 'good' | 'warn' | 'neutral' }) {
+  const styles = { good: 'border-emerald-400/20 bg-emerald-400/5', warn: 'border-amber-400/20 bg-amber-400/5', neutral: 'border-[var(--sa-border)] bg-black/10' };
+  return <div className={`rounded-xl border p-4 ${styles[tone]}`}><p className="text-xs text-[var(--sa-ink-muted)]">{label}</p><p className="mt-2 text-sm font-semibold text-[var(--sa-ink)]">{value}</p></div>;
+}
+
+function EmptyState({ icon: Icon, title, body }: { icon: React.ElementType; title: string; body: string }) {
+  return <div className="rounded-xl border border-dashed border-[var(--sa-border)] p-5 text-center sm:col-span-2 xl:col-span-3"><Icon size={18} className="mx-auto text-[var(--sa-ink-muted)]" /><p className="mt-3 text-sm font-medium text-[var(--sa-ink)]">{title}</p><p className="mt-1 text-xs text-[var(--sa-ink-muted)]">{body}</p></div>;
+}
