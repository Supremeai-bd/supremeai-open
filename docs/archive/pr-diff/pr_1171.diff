+}
+
+// ---------- CodeFlow: Analysis ----------
+export interface CodeFlowAnalysis {
+  repositoryId: string;
+  repositoryUrl?: string;
+  files: CodeFlowFile[];
+  dependencies: DependencyGraph;
+  patterns: PatternDetection[];
+  securityIssues: SecurityIssue[];
