+      setError(err.message);
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  useEffect(() => {
+    const loadFixes = async () => {
+      await fetchFixes();
+    };
+
+    loadFixes();
+  }, []);
+
+  return (
+    <div className="min-h-screen bg-slate-950 text-slate-300 p-8">
