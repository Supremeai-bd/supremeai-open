+.sa-operational-pulse[data-state="degraded"] { color: var(--sa-warning); }
+.sa-operational-pulse[data-state="unavailable"] { color: var(--sa-danger); }
+
+/* Keep feedback meaningful and inexpensive; never animate for users who opt out. */
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    animation-duration: 0.01ms !important;
