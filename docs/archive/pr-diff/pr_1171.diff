+  it('logs a warning when the probe throws', async () => {
+    const consoleSpy = vi.spyOn(console, 'warn').mockImplementation(() => {});
+    mockGet.mockRejectedValue(new Error('network down'));
+
+    startAntiSleepHeartbeat();
