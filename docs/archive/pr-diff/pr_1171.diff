+.sa-operational-pulse {
+  align-items: center;
+  color: var(--sa-success);
+  display: inline-flex;
+  gap: 0.45rem;
+  font-size: 0.8125rem;
+  font-weight: 600;
+}
+
+.sa-operational-pulse::before {
+  background: currentColor;
+  border-radius: 999px;
+  box-shadow: 0 0 0 3px color-mix(in srgb, currentColor 14%, transparent);
+  content: '';
+  height: 0.45rem;
+  width: 0.45rem;
