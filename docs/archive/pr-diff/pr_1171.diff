diff --git a/studio/public/dashboard-preview/index.css b/studio/public/dashboard-preview/index.css
new file mode 100644
index 000000000..bb8171aa8
--- /dev/null
+++ b/studio/public/dashboard-preview/index.css
@@ -0,0 +1,516 @@
+/*
+  SupremeAI Studio — Dashboard Preview styles (issue #337).
+  Token-driven dark & light glassmorphism.
+  Every token mirrors api-schemas/dashboard.schema.json $defs.DesignTokens 1:1.
+
+  Normative guidelines:
+  contrast >= 4.5:1 body text · 44px interactive targets · :focus-visible rings
+  · prefers-reduced-motion kills non-essential animation · mobile-first grid.
+*/
+
+:root,
+html[data-theme="dark"] {
+  /* color tokens ($defs.DesignTokens.color) - Dark Mode */
+  --bg-base: #0a0f0d;
+  --surface-glass: rgba(22, 32, 27, 0.58);
+  --surface-border: rgba(148, 233, 194, 0.14);
+  --surface-hover: rgba(45, 212, 191, 0.08);
+  --text-primary: #eef7f2;
+  --text-secondary: #9db8ab;
+  --text-dim: #648074;
+  --accent: #10b981;
+  --accent-soft: #2dd4bf;
+  --success: #34d399;
+  --warning: #f59e0b;
+  --danger: #f87171;
+  --terminal-bg: rgba(10, 15, 13, 0.85);
+
+  /* typography tokens */
+  --font-sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
+  --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  --size-display: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem);
+  --size-title: clamp(1.05rem, 0.95rem + 0.5vw, 1.3rem);
+  --size-body: 0.95rem;
+  --size-caption: 0.78rem;
+
+  /* radius tokens */
+  --radius-sm: 8px;
+  --radius-md: 14px;
+  --radius-lg: 22px;
+
+  /* motion tokens */
+  --duration-fast: 140ms;
+  --duration-base: 320ms;
+  --easing: cubic-bezier(0.22, 1, 0.36, 1);
+}
+
+html[data-theme="light"] {
+  /* color tokens - Light Mode (Frosted Glass, high contrast >= 4.5:1) */
+  --bg-base: #f3f6f4;
+  --surface-glass: rgba(255, 255, 255, 0.78);
+  --surface-border: rgba(16, 185, 129, 0.20);
+  --surface-hover: rgba(16, 185, 129, 0.06);
+  --text-primary: #0f1d16;
+  --text-secondary: #3b5247;
+  --text-dim: #627c70;
+  --accent: #059669;
+  --accent-soft: #0d9488;
+  --success: #059669;
+  --warning: #d97706;
+  --danger: #dc2626;
+  --terminal-bg: rgba(240, 246, 243, 0.92);
+}
+
+* { box-sizing: border-box; }
+
+body {
+  margin: 0;
+  min-height: 100vh;
+  display: flex;
+  flex-direction: column;
+  background:
+    radial-gradient(1100px 500px at 85% -10%, rgba(45, 212, 191, 0.12), transparent 60%),
+    radial-gradient(900px 480px at -10% 110%, rgba(16, 185, 129, 0.10), transparent 55%),
+    var(--bg-base);
+  color: var(--text-primary);
+  font-family: var(--font-sans);
+  font-size: var(--size-body);
+  line-height: 1.55;
+  transition: background-color var(--duration-base) var(--easing), color var(--duration-base) var(--easing);
+  -webkit-font-smoothing: antialiased;
+}
+
+/* Accessibility */
+.skip-link {
+  position: absolute;
+  left: -9999px;
+  top: 0;
+  padding: 12px 18px;
+  border-radius: 0 0 var(--radius-sm) 0;
+  background: var(--accent);
+  color: #052e21;
+  font-weight: 700;
+  z-index: 100;
+}
+.skip-link:focus { left: 0; }
+
+:focus-visible {
+  outline: 2px solid var(--accent-soft);
+  outline-offset: 2px;
+  border-radius: var(--radius-sm);
+}
+
+/* Header Topbar */
+.topbar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  flex-wrap: wrap;
+  padding: 16px clamp(16px, 4vw, 40px);
+  border-bottom: 1px solid var(--surface-border);
+  background: var(--surface-glass);
+  backdrop-filter: blur(16px);
+  -webkit-backdrop-filter: blur(16px);
+  position: sticky;
+  top: 0;
+  z-index: 50;
+}
+
+.brand {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+.brand-mark {
+  font-size: 1.8rem;
+  color: var(--accent);
+  filter: drop-shadow(0 0 10px rgba(16, 185, 129, 0.45));
+}
+.brand-name {
+  margin: 0;
+  font-size: 1.15rem;
+  font-weight: 700;
+  letter-spacing: -0.01em;
+}
+.brand-name span {
+  color: var(--accent-soft);
+  font-weight: 400;
+}
+.brand-sub {
+  margin: 2px 0 0;
+  font-size: var(--size-caption);
+  color: var(--text-dim);
+}
+
+/* Header Stats Bar */
+.header-stats {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  flex-wrap: wrap;
+}
+.stat-pill {
+  display: flex;
+  flex-direction: column;
+  padding: 6px 14px;
+  background: var(--surface-glass);
+  border: 1px solid var(--surface-border);
+  border-radius: var(--radius-sm);
+  min-width: 90px;
+}
+.stat-label {
+  font-size: 0.70rem;
+  color: var(--text-dim);
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+}
+.stat-value {
+  font-size: 1rem;
+  font-weight: 700;
+  color: var(--text-primary);
+}
+
+/* Controls */
+.topbar-controls {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+.control-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  min-height: 44px;
+  padding: 0 14px;
+  border-radius: var(--radius-sm);
+  border: 1px solid var(--surface-border);
+  background: var(--surface-glass);
+  color: var(--text-primary);
+  font-family: inherit;
+  font-size: var(--size-caption);
+  cursor: pointer;
+  transition: all var(--duration-fast) var(--easing);
+}
+.control-btn:hover {
+  background: var(--surface-hover);
+  border-color: var(--accent-soft);
+}
+.icon-btn {
+  min-width: 44px;
+  justify-content: center;
+  padding: 0;
+  font-size: 1.1rem;
+}
+
+.live-dot {
+  width: 9px;
+  height: 9px;
+  border-radius: 50%;
+  background: var(--accent);
+  box-shadow: 0 0 10px var(--accent);
+  animation: pulse 2s infinite var(--easing);
+}
+@keyframes pulse {
+  0%, 100% { opacity: 1; transform: scale(1); }
+  50% { opacity: 0.45; transform: scale(0.85); }
+}
+
+.pill {
+  font-family: var(--font-mono);
+  font-size: 0.72rem;
+  font-weight: 700;
+  letter-spacing: 0.06em;
+}
+.clock {
+  font-family: var(--font-mono);
+  font-size: var(--size-caption);
+  color: var(--text-secondary);
+  padding-left: 4px;
+}
+
+/* Filter Bar */
+.filters-bar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  flex-wrap: wrap;
+  padding: 12px clamp(16px, 4vw, 40px);
+  border-bottom: 1px solid var(--surface-border);
+  background: rgba(10, 15, 13, 0.25);
+}
+.filter-group {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  flex-wrap: wrap;
+}
+.filter {
+  min-height: 44px;
+  padding: 0 16px;
+  border-radius: 9999px;
+  border: 1px solid var(--surface-border);
+  background: var(--surface-glass);
+  color: var(--text-secondary);
+  font-family: inherit;
+  font-size: var(--size-caption);
+  font-weight: 500;
+  cursor: pointer;
+  transition: all var(--duration-fast) var(--easing);
+}
+.filter:hover {
+  color: var(--text-primary);
+  border-color: var(--accent-soft);
+}
+.filter.is-active {
+  background: var(--accent);
+  color: #052e21;
+  border-color: var(--accent);
+  font-weight: 700;
+  box-shadow: 0 0 14px rgba(16, 185, 129, 0.35);
+}
+.stream-info {
+  font-size: var(--size-caption);
+  color: var(--text-dim);
+  font-family: var(--font-mono);
+}
+
+/* Layout */
+.layout {
+  flex: 1;
+  width: 100%;
+  max-width: 1440px;
+  margin: 0 auto;
+  padding: clamp(20px, 3vw, 36px) clamp(16px, 4vw, 40px);
+  display: flex;
+  flex-direction: column;
+  gap: 32px;
+}
+
+.section-header {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 16px;
+  flex-wrap: wrap;
+  margin-bottom: 16px;
+}
+.section-title {
+  margin: 0;
+  font-size: var(--size-title);
+  font-weight: 600;
+  letter-spacing: -0.01em;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+.section-tag {
+  font-size: var(--size-caption);
+  color: var(--text-dim);
+}
+.count {
+  font-size: var(--size-body);
+  font-weight: 400;
+  color: var(--text-dim);
+  font-family: var(--font-mono);
+}
+
+/* Grids */
+.grid {
+  display: grid;
+  gap: 16px;
+}
+.repos-grid {
+  grid-template-columns: 1fr;
+}
+@media (min-width: 640px) {
+  .repos-grid { grid-template-columns: repeat(2, 1fr); }
+  .agents-grid { grid-template-columns: repeat(2, 1fr); }
+}
+@media (min-width: 1024px) {
+  .repos-grid { grid-template-columns: repeat(3, 1fr); }
+  .agents-grid { grid-template-columns: repeat(3, 1fr); }
+}
+@media (min-width: 1280px) {
+  .repos-grid { grid-template-columns: repeat(4, 1fr); }
+}
+
+/* Cards */
+.card {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  padding: 18px;
+  background: var(--surface-glass);
+  border: 1px solid var(--surface-border);
+  border-radius: var(--radius-md);
+  backdrop-filter: blur(12px);
+  -webkit-backdrop-filter: blur(12px);
+  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
+  transition: transform var(--duration-fast) var(--easing), border-color var(--duration-fast) var(--easing);
+}
+.card:hover {
+  transform: translateY(-2px);
+  border-color: var(--accent-soft);
+}
+
+.card-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  padding-bottom: 8px;
+  border-bottom: 1px solid var(--surface-border);
+}
+.card-title {
+  margin: 0;
+  font-size: 0.98rem;
+  font-weight: 600;
+  color: var(--text-primary);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.card-line {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  font-size: 0.85rem;
+  color: var(--text-secondary);
+}
+
+/* Badges */
+.badge {
+  display: inline-flex;
+  align-items: center;
+  padding: 3px 8px;
+  border-radius: var(--radius-sm);
+  font-size: 0.70rem;
+  font-family: var(--font-mono);
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+}
+.badge.healthy, .badge.passing, .badge.done {
+  background: rgba(52, 211, 153, 0.16);
+  color: var(--success);
+  border: 1px solid rgba(52, 211, 153, 0.32);
+}
+.badge.working, .badge.running {
+  background: rgba(45, 212, 191, 0.16);
+  color: var(--accent-soft);
+  border: 1px solid rgba(45, 212, 191, 0.32);
+}
+.badge.waiting, .badge.degraded {
+  background: rgba(245, 158, 11, 0.16);
+  color: var(--warning);
+  border: 1px solid rgba(245, 158, 11, 0.32);
+}
+.badge.blocked, .badge.failing, .badge.error, .badge.down {
+  background: rgba(248, 113, 113, 0.16);
+  color: var(--danger);
+  border: 1px solid rgba(248, 113, 113, 0.32);
+}
+.badge.unknown {
+  background: rgba(148, 163, 184, 0.16);
+  color: var(--text-dim);
+  border: 1px solid rgba(148, 163, 184, 0.25);
+}
+
+/* Progress bar */
+.progress {
+  width: 100%;
+  height: 6px;
+  background: rgba(148, 163, 184, 0.18);
+  border-radius: 9999px;
+  overflow: hidden;
+  margin-top: 4px;
+}
+.progress-bar {
+  height: 100%;
+  background: linear-gradient(90deg, var(--accent), var(--accent-soft));
+  border-radius: 9999px;
+  transition: width var(--duration-base) var(--easing);
+  box-shadow: 0 0 8px rgba(16, 185, 129, 0.5);
+}
+
+/* Terminal Log Panel */
+.terminal-panel {
+  background: var(--terminal-bg);
+  border: 1px solid var(--surface-border);
+  border-radius: var(--radius-md);
+  padding: 16px;
+  max-height: 240px;
+  overflow-y: auto;
+  box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.25);
+}
+.event-feed {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  font-size: 0.78rem;
+  line-height: 1.45;
+}
+.event-line {
+  display: flex;
+  align-items: baseline;
+  gap: 12px;
+  color: var(--text-secondary);
+}
+.event-time { color: var(--text-dim); }
+.event-tag {
+  font-weight: 700;
+  color: var(--accent-soft);
+}
+.event-msg { color: var(--text-primary); }
+
+.btn-dim {
+  background: transparent;
+  border: 1px solid var(--surface-border);
+  color: var(--text-secondary);
+  font-size: 0.75rem;
+  padding: 6px 12px;
+  border-radius: var(--radius-sm);
+  cursor: pointer;
+  min-height: 32px;
+}
+.btn-dim:hover { color: var(--text-primary); border-color: var(--accent); }
+
+/* Error Banner */
+.error-banner {
+  padding: 14px 18px;
+  border-radius: var(--radius-sm);
+  background: rgba(248, 113, 113, 0.16);
+  border: 1px solid var(--danger);
+  color: var(--danger);
+  font-weight: 600;
+}
+
+/* Footer */
+.footer {
+  padding: 24px clamp(16px, 4vw, 40px);
+  border-top: 1px solid var(--surface-border);
+  text-align: center;
+  color: var(--text-secondary);
+  font-size: var(--size-caption);
+  background: var(--surface-glass);
+}
+.footer p { margin: 4px 0; }
+.footer-dim { color: var(--text-dim); }
+.footer a { color: var(--accent-soft); text-decoration: none; }
+.footer a:hover { text-decoration: underline; }
+
+.mono { font-family: var(--font-mono); }
+
+/* Reduced Motion Override */
+@media (prefers-reduced-motion: reduce) {
+  *, ::before, ::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+  .live-dot { animation: none; }
+}
