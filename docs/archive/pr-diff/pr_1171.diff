+      Authorization: 'Bearer x',
+    });
+  });
+
+  it('sendMessage posts to the task execute endpoint', async () => {
+    (apiClient.post as unknown as ReturnType<typeof vi.fn>).mockResolvedValue({
+      response: 'hi',
