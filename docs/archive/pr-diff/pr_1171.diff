+import { describe, it, expect, vi } from 'vitest';
+import { renderHook, act } from '@testing-library/react';
+
+const fakeService = {
+  sendChatMessage: vi.fn().mockResolvedValue({ response: 'resp-text' }),
+  getSessionId: vi.fn().mockReturnValue('sid'),
