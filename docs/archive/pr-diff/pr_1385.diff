+name: Guardian Verdict Executor
+
+# bridge-20261027-guardian-verdict-executor (#1331)
+# The PR Guardian evaluates verdicts but nothing enacted them: CLOSE_PR verdicts
+# on PRs #326/#328 sat open for days with zero follow-up, and FIX_REGRESSION_THEN_MERGE
+# on #324 spawned no remediation work order. This scheduled lane closes that
+# evaluate->enact gap. Tier-2 only — Tier-3 verdicts always route to HITL
+# approvals per the existing policy engine.
+#
+# NOTE (bridge protected-path policy): .github/ changes route to ADMIN REVIEW —
+# this workflow is intentionally submitted through the bridge for gated landing.
+
+on:
+  schedule:
+    - cron: "0 */2 * * *" # every 2 hours
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  pull-requests: write
+  issues: write
+
+jobs:
+  enact-verdicts:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Guard against concurrent executor runs
+        uses: actions/github-script@v7
+        id: lease
+        with:
+          script: |
+            const { data: runs } = await github.rest.actions.listWorkflowRuns({
+              owner: context.repo.owner,
+              repo: context.repo.repo,
+              workflow_id: 'verdict-executor.yml',
+              status: 'in_progress',
+            });
+            if (runs.total_count > 1) {
+              core.notice('Another executor run holds the lease — exiting.');
+              core.setOutput('held', 'true');
+            } else {
+              core.setOutput('held', 'false');
+            }
+
+      - name: Enact pending Guardian verdicts
+        if: steps.lease.outputs.held != 'true'
+        uses: actions/github-script@v7
+        with:
+          script: |
+            const VERDICT_LABEL = 'guardian:verdict-pending';
+            const { data: prs } = await github.rest.pulls.list({
+              owner: context.repo.owner, repo: context.repo.repo, state: 'open', per_page: 100,
+            });
+            for (const pr of prs) {
+              const { data: comments } = await github.rest.issues.listComments({
+                owner: context.repo.owner, repo: context.repo.repo,
+                issue_number: pr.number, per_page: 50,
+              });
+              const verdict = comments
+                .filter(c => c.user.login.includes('guardian') && /verdict[:\s]+(CLOSE_PR|MERGE_PR|FIX_REGRESSION_THEN_MERGE|ESCALATE_TO_ADMIN)/i.test(c.body))
+                .pop();
+              if (!verdict) continue;
+              const m = verdict.body.match(/verdict[:\s]+(CLOSE_PR|MERGE_PR|FIX_REGRESSION_THEN_MERGE|ESCALATE_TO_ADMIN)/i);
+              const action = m[1].toUpperCase();
+
+              if (action === 'CLOSE_PR') {
+                await github.rest.issues.createComment({
+                  owner: context.repo.owner, repo: context.repo.repo, issue_number: pr.number,
+                  body: `🤖 Verdict executor: enacting Guardian verdict ${action} (auto-lane, Tier-2).`,
+                });
+                await github.rest.pulls.update({
+                  owner: context.repo.owner, repo: context.repo.repo,
+                  pull_number: pr.number, state: 'closed',
+                });
+                core.notice(`Closed PR #${pr.number} per CLOSE_PR verdict`);
+              } else if (action === 'FIX_REGRESSION_THEN_MERGE') {
+                const existing = await github.rest.issues.listForRepo({
+                  owner: context.repo.owner, repo: context.repo.repo,
+                  state: 'open', labels: 'handoff:coder', per_page: 100,
+                });
+                const slug = `regression-fix-pr-${pr.number}`;
+                if (!existing.data.some(i => i.title.includes(slug))) {
+                  await github.rest.issues.create({
+                    owner: context.repo.owner, repo: context.repo.repo,
+                    title: `fix(bridge): ${slug} — remediate regression flagged by Guardian`,
+                    body: `PR #${pr.number} received verdict FIX_REGRESSION_THEN_MERGE.\n\nRemediate the flagged regressions, then re-request Guardian evaluation.\n\nVerdict source comment: ${verdict.html_url}`,
+                    labels: ['handoff:coder', 'area:guardian'],
+                  });
+                  core.notice(`Spawned remediation work order for PR #${pr.number}`);
+                }
+              } else if (action === 'ESCALATE_TO_ADMIN') {
+                core.notice(`PR #${pr.number} stays with HITL admin approval (Tier-3) — no auto-action`);
+              } else if (action === 'MERGE_PR') {
+                core.notice(`MERGE_PR enactments intentionally require the human merge gate — skipping`);
+              }
+            }
+
+      - name: Notify Telegram lane
+        if: steps.lease.outputs.held != 'true'
+        run: |
+          if [ -n "${{ secrets.TELEGRAM_ALERTS_BOT_TOKEN }}" ] && [ -n "${{ secrets.TELEGRAM_ALERTS_CHAT_ID }}" ]; then
+            curl -sf -X POST "https://api.telegram.org/bot${{ secrets.TELEGRAM_ALERTS_BOT_TOKEN }}/sendMessage" \
+              -d chat_id="${{ secrets.TELEGRAM_ALERTS_CHAT_ID }}" \
+              -d text="🤖 Guardian verdict executor ran at $(date -u +%FT%TZ) — see workflow summary." > /dev/null || \
+              echo "::warning::Telegram notification failed (non-fatal)"
+          else
+            echo "::notice::Telegram secrets not configured — skipping notification"
+          fi
