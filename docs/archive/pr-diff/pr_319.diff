+"""SupremeAI async Python SDK — zero-dependency client core (issue #33).
+
+Lightweight asyncio client for the SupremeAI MCP Tower:
+- SSE streaming (`stream_sse` async generator, frame parser per docs/MCP_CONNECT.md §3)
+- Tool calling (`invoke_tool` with invocation_id correlation, JSON-RPC per MCP contract)
+- Health probe
+- Type-annotated dataclasses (frozen+slots; Pydantic-free by design — zero deps)
+- Honest error classes: 401 → SdkAuthError, 403 → SdkForbidden,
+  404 → SdkNotFound, 429 → SdkRateLimited (Retry-After carried)
+
+Transport etiquette (docs/MCP_CONNECT.md): `?client=` identity, credentials
+never in URLs, Retry-After honored, terminal frames end streams.
+
+Mock-MCP-server test harness (embedded, offline):
+    python client.py --self-test
+Spins a local stdlib mock MCP server in a thread and exercises the async
+client end-to-end (health, tool call, SSE frames, all four error statuses).
+Exit code 0 = harness passed. (A pytest test_*.py file would sit outside the
+Touching Files boundary; this harness is the boundary-respecting equivalent.)
+"""
+from __future__ import annotations
+
+import argparse
+import asyncio
+import json
+import sys
+import threading
+import time
+import uuid
+from dataclasses import dataclass, field
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from typing import AsyncIterator, Iterator
+
+DEFAULT_BASE_URL = "https://supremeai-mcp-tower.onrender.com"
+DEFAULT_CLIENT_NAME = "sdk-py-client"
+MCP_ACCEPT = "application/json, text/event-stream"
+
+
+# ---------------------------------------------------------------------------
+# Error taxonomy (honest failures; status codes carried)
+# ---------------------------------------------------------------------------
+
+class SdkError(RuntimeError):
+    """সব SDK-ত্রুটির মূল — status_code বহন করে।"""
+
+    def __init__(self, message: str, status_code: int | None = None):
+        super().__init__(message)
+        self.status_code = status_code
+
+
+class SdkAuthError(SdkError):
+    """401 — credential অবৈধ/বাতিল। retry অর্থহীন।"""
+
+
+class SdkForbidden(SdkError):
+    """403 — default-deny RBAC: role যথেষ্ট নয়।"""
+
+
+class SdkNotFound(SdkError):
+    """404 — রুট/সেশন নেই; fresh initialize দিন।"""
+
+
+class SdkRateLimited(SdkError):
+    """429 — per-IP সীমা; Retry-After সম্মান করুন।"""
+
+    def __init__(self, message: str, retry_after_s: float | None = None):
+        super().__init__(message, 429)
+        self.retry_after_s = retry_after_s
+
+
+# ---------------------------------------------------------------------------
+# Typed contracts (dataclasses, frozen+slots; task-router / websocket aligned)
+# ---------------------------------------------------------------------------
+
+@dataclass(frozen=True, slots=True)
+class TaskDispatchRequest:
+    task_id: str
+    issue: str
+    objective: str
+    touching_files: tuple[str, ...]
+    tier: str | None = None            # fast_light | coding_reasoning | complex_architecture
+    priority: str | None = None        # P0..P3
+    metadata: dict[str, str | int | bool] = field(default_factory=dict)
+
+
+@dataclass(frozen=True, slots=True)
+class TaskDispatchResult:
+    task_id: str
+    tier: str
+    route: tuple[dict, ...]            # [{provider, model}, ...] primary first
+    accepted: bool
+    reason: str | None = None
+
+
+@dataclass(frozen=True, slots=True)
+class ToolInvocation:
+    tool: str
+    arguments: dict
+    invocation_id: str = ""            # auto-filled when empty
+
+
+@dataclass(frozen=True, slots=True)
+class ToolResult:
+    tool: str
+    invocation_id: str
+    status: str                        # ok | error
+    result: object | None = None
+    error: dict | None = None
+    duration_ms: int | None = None
+
+
+@dataclass(frozen=True, slots=True)
+class StatusFrame:
+    frame_type: str                    # event | heartbeat
+    seq: int
+    timestamp: str
+    event: str | None = None
+    task_id: str | None = None
+    agent_id: str | None = None
+    payload: object | None = None
+    heartbeat: dict | None = None
+
+
+# ---------------------------------------------------------------------------
+# Async HTTP core (raw asyncio streams — zero third-party dependencies)
+# ---------------------------------------------------------------------------
+
+async def _read_response(reader: asyncio.StreamReader) -> tuple[int, dict[str, str], bytes]:
+    status_line = (await reader.readline()).decode("latin-1").strip()
+    parts = status_line.split(" ", 2)
+    status = int(parts[1]) if len(parts) > 1 else 0
+    headers: dict[str, str] = {}
+    while True:
+        line = (await reader.readline()).decode("latin-1")
+        if line in ("\r\n", "\n", ""):
+            break
+        key, _, value = line.partition(":")
+        headers[key.strip().lower()] = value.strip()
+    body = b""
+    if "content-length" in headers:
+        body = await reader.readexactly(int(headers["content-length"]))
+    elif headers.get("transfer-encoding", "").lower() == "chunked":
+        while True:
+            size_line = (await reader.readline()).strip()
+            size = int(size_line.split(b";")[0], 16)
+            if size == 0:
+                await reader.readline()
+                break
+            body += await reader.readexactly(size)
+            await reader.readline()
+    return status, headers, body
+
+
+async def _request(method: str, url: str, *, body: bytes | None = None,
+                   headers: dict[str, str] | None = None,
+                   timeout: float = 30.0) -> tuple[int, dict[str, str], bytes]:
+    """One honest HTTP/1.1 round-trip over asyncio streams (keep-alive off)."""
+    assert url.startswith("http://") or url.startswith("https://")
+    rest = url.split("://", 1)[1]
+    host_port, _, path = rest.partition("/")
+    host, _, port_s = host_port.partition(":")
+    port = int(port_s) if port_s else (443 if url.startswith("https") else 80)
+    if url.startswith("https"):
+        import ssl
+        opener = asyncio.open_connection(host, port, ssl=ssl.create_default_context())
+    else:
+        opener = asyncio.open_connection(host, port)
+    reader, writer = await asyncio.wait_for(opener, timeout=timeout)
+    try:
+        req_headers = {
+            "Host": host_port,
+            "Accept": MCP_ACCEPT,
+            "Connection": "close",
+        }
+        if body is not None:
+            req_headers["Content-Type"] = "application/json"
+            req_headers["Content-Length"] = str(len(body))
+        for k, v in (headers or {}).items():
+            req_headers[k] = v
+        head = f"{method} /{path} HTTP/1.1\r\n" + "".join(
+            f"{k}: {v}\r\n" for k, v in req_headers.items()
+        ) + "\r\n"
+        writer.write(head.encode("latin-1") + (body or b""))
+        await writer.drain()
+        status, resp_headers, resp_body = await asyncio.wait_for(
+            _read_response(reader), timeout=timeout
+        )
+        return status, resp_headers, resp_body
+    finally:
+        writer.close()
+        try:
+            await writer.wait_closed()
+        except Exception:
+            pass
+
+
+def _raise_for_status(status: int, headers: dict[str, str], body: bytes) -> None:
+    detail = body.decode(errors="replace")[:300]
+    if status == 401:
+        raise SdkAuthError(f"401 invalid/expired credential — {detail}", 401)
+    if status == 403:
+        raise SdkForbidden(f"403 default-deny RBAC — {detail}", 403)
+    if status == 404:
+        raise SdkNotFound(f"404 route/session not found — {detail}", 404)
+    if status == 429:
+        ra = headers.get("retry-after")
+        raise SdkRateLimited(
+            f"429 rate limited (Retry-After: {ra or 'unknown'}s) — {detail}",
+            float(ra) if ra and ra.replace('.', '', 1).isdigit() else None,
+        )
+    if status >= 400:
+        raise SdkError(f"HTTP {status} — {detail}", status)
+
+
+# ---------------------------------------------------------------------------
+# Client
+# ---------------------------------------------------------------------------
+
+class SupremeAIClient:
+    """Async zero-dependency client for the SupremeAI MCP Tower."""
+
+    def __init__(self, base_url: str = DEFAULT_BASE_URL,
+                 client_name: str = DEFAULT_CLIENT_NAME,
+                 api_key: str | None = None):
+        self.base_url = base_url.rstrip("/")
+        self.client_name = client_name
+        self._api_key = api_key
+        self._next_id = 1
+
+    def _url(self, path: str) -> str:
+        return f"{self.base_url}{path}?client={self.client_name}"
+
+    def _auth_headers(self, extra: dict[str, str] | None = None) -> dict[str, str]:
+        h = dict(extra or {})
+        if self._api_key:
+            h["Authorization"] = f"Bearer {self._api_key}"
+        return h
+
+    async def health(self) -> dict:
+        """GET /health — public, credential-free smoke probe."""
+        status, headers, body = await _request("GET", f"{self.base_url}/health")
+        _raise_for_status(status, headers, body)
+        return json.loads(body)
+
+    async def dispatch_task(self, req: TaskDispatchRequest) -> TaskDispatchResult:
+        """Dispatch a task; router classifies and returns the model chain."""
+        payload = {
+            "task_id": req.task_id,
+            "issue": req.issue,
+            "objective": req.objective,
+            "touching_files": list(req.touching_files),
+        }
+        if req.tier:
+            payload["tier"] = req.tier
+        if req.priority:
+            payload["priority"] = req.priority
+        status, headers, body = await _request(
+            "POST", self._url("/tasks/dispatch"),
+            body=json.dumps(payload).encode(),
+            headers=self._auth_headers(),
+        )
+        _raise_for_status(status, headers, body)
+        d = json.loads(body)
+        return TaskDispatchResult(
+            task_id=d["task_id"],
+            tier=d["tier"],
+            route=tuple(d.get("route", ())),
+            accepted=d.get("accepted", True),
+            reason=d.get("reason"),
+        )
+
+    async def invoke_tool(self, inv: ToolInvocation) -> ToolResult:
+        """Invoke a Tower tool (JSON-RPC tools/call) with correlation id."""
+        invocation_id = inv.invocation_id or f"inv-{uuid.uuid4().hex[:12]}"
+        started = time.monotonic()
+        payload = {
+            "jsonrpc": "2.0",
+            "id": self._next_id,
+            "method": "tools/call",
+            "params": {"name": inv.tool, "arguments": inv.arguments},
+        }
+        self._next_id += 1
+        try:
+            status, headers, body = await _request(
+                "POST", self._url("/mcp"),
+                body=json.dumps(payload).encode(),
+                headers=self._auth_headers(),
+            )
+            _raise_for_status(status, headers, body)
+            envelope = json.loads(body)
+            # JSON-RPC 2.0 unwrap: consumers get the inner result, not the plumbing.
+            if isinstance(envelope, dict) and "jsonrpc" in envelope:
+                if envelope.get("error") is not None:
+                    rpc_err = envelope["error"]
+                    return ToolResult(
+                        tool=inv.tool,
+                        invocation_id=invocation_id,
+                        status="error",
+                        error={"code": "tool_failed",
+                               "message": str(rpc_err.get("message", rpc_err)),
+                               "retryable": False},
+                        duration_ms=int((time.monotonic() - started) * 1000),
+                    )
+                result = envelope.get("result")
+            else:
+                result = envelope
+            return ToolResult(
+                tool=inv.tool,
+                invocation_id=invocation_id,
+                status="ok",
+                result=result,
+                duration_ms=int((time.monotonic() - started) * 1000),
+            )
+        except SdkError as exc:
+            code = {401: "auth_failure", 403: "forbidden", 404: "not_found",
+                    429: "rate_limited"}.get(exc.status_code or 0, "tool_failed")
+            return ToolResult(
+                tool=inv.tool,
+                invocation_id=invocation_id,
+                status="error",
+                error={"code": code, "message": str(exc),
+                       "retryable": (exc.status_code in (429, 503))},
+                duration_ms=int((time.monotonic() - started) * 1000),
+            )
+        except OSError as exc:
+            # Transport-level failure (DNS/refused/reset): honest retryable envelope.
+            return ToolResult(
+                tool=inv.tool,
+                invocation_id=invocation_id,
+                status="error",
+                error={"code": "transport_error", "message": str(exc),
+                       "retryable": True},
+                duration_ms=int((time.monotonic() - started) * 1000),
+            )
+
+    async def stream_sse(self, task_id: str) -> AsyncIterator[StatusFrame]:
+        """Yield StatusFrames from /sse (text/event-stream).
+
+        Frames carry the websocket-events envelope; terminal frames
+        (agent:done / agent:error) end the stream. Server close ends it too.
+        """
+        stream_url = self._url("/sse")
+        rest = stream_url.split("://", 1)[1]
+        host_port, _, path = rest.partition("/")
+        host, _, port_s = host_port.partition(":")
+        secure = stream_url.startswith("https")
+        port = int(port_s) if port_s else (443 if secure else 80)
+        if secure:
+            import ssl
+            reader, writer = await asyncio.open_connection(
+                host, port, ssl=ssl.create_default_context())
+        else:
+            reader, writer = await asyncio.open_connection(host, port)
+        try:
+            head = (
+                f"GET /{path} HTTP/1.1\r\n"
+                f"Host: {host_port}\r\n"
+                "Accept: text/event-stream\r\n"
+                "Connection: close\r\n"
+                + (f"Authorization: Bearer {self._api_key}\r\n" if self._api_key else "")
+                + "\r\n"
+            )
+            writer.write(head.encode("latin-1"))
+            await writer.drain()
+            # status + headers
+            status_line = (await reader.readline()).decode("latin-1")
+            status = int(status_line.split(" ")[1])
+            while True:
+                line = (await reader.readline()).decode("latin-1")
+                if line in ("\r\n", "\n", ""):
+                    break
+            if status != 200:
+                _raise_for_status(status, {}, b"(stream rejected)")
+            event_name: str | None = None
+            data_lines: list[str] = []
+            while True:
+                raw = await reader.readline()
+                if not raw:
+                    break  # server closed
+                text = raw.decode("utf-8", errors="replace").rstrip("\r\n")
+                if text == "":
+                    if data_lines:
+                        frame = json.loads("\n".join(data_lines))
+                        yield StatusFrame(
+                            frame_type=frame.get("frame_type", "event"),
+                            seq=frame.get("seq", 0),
+                            timestamp=frame.get("timestamp", ""),
+                            event=frame.get("event") or event_name,  # SSE event: fallback
+                            task_id=frame.get("task_id"),
+                            agent_id=frame.get("agent_id"),
+                            payload=frame.get("payload"),
+                            heartbeat=frame.get("heartbeat"),
+                        )
+                        if frame.get("event") in ("agent:done", "agent:error"):
+                            return
+                    event_name, data_lines = None, []
+                elif text.startswith("event:"):
+                    event_name = text.split(":", 1)[1].strip()
+                elif text.startswith("data:"):
+                    data_lines.append(text.split(":", 1)[1].lstrip())
+        finally:
+            writer.close()
+            try:
+                await writer.wait_closed()
+            except Exception:
+                pass
+
+
+# ---------------------------------------------------------------------------
+# Mock MCP server + embedded test harness (offline, stdlib-only)
+# ---------------------------------------------------------------------------
+
+class _MockMcpHandler(BaseHTTPRequestHandler):
+    """Minimal mock of the Tower surface for harness runs (localhost only)."""
+
+    server_version = "MockTower/1.0"
+
+    def log_message(self, *args):  # silence request logging
+        pass
+
+    def _send_json(self, status: int, payload: dict, headers: dict | None = None):
+        raw = json.dumps(payload).encode()
+        self.send_response(status)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(raw)))
+        for k, v in (headers or {}).items():
+            self.send_header(k, v)
+        self.end_headers()
+        self.wfile.write(raw)
+
+    def do_GET(self):
+        if self.path.startswith("/health"):
+            self._send_json(200, {"status": "ok", "mock": True})
+        elif self.path.startswith("/sse"):
+            self.send_response(200)
+            self.send_header("Content-Type", "text/event-stream")
+            self.send_header("Connection", "close")
+            self.end_headers()
+            frames = [
+                {"frame_type": "event", "seq": 1, "timestamp": "2026-02-14T09:30:00Z",
+                 "event": "agent:started", "task_id": "task-33", "agent_id": "agent-1",
+                 "payload": {"goal": "harness"}},
+                {"frame_type": "heartbeat", "seq": 2, "timestamp": "2026-02-14T09:30:05Z",
+                 "heartbeat": {"kind": "ping", "interval_seconds": 30}},
+                {"frame_type": "event", "seq": 3, "timestamp": "2026-02-14T09:30:10Z",
+                 "event": "agent:done", "task_id": "task-33", "agent_id": "agent-1",
+                 "payload": {"summary": "harness complete"}},
+            ]
+            for f in frames:
+                self.wfile.write(f"data: {json.dumps(f)}\n\n".encode())
+        elif self.path.startswith("/private"):
+            self._send_json(401, {"error": "unauthorized"})
+        elif self.path.startswith("/gated"):
+            self._send_json(403, {"error": "forbidden"})
+        elif self.path.startswith("/gone"):
+            self._send_json(404, {"error": "not found"})
+        else:
+            self._send_json(429, {"error": "rate limit exceeded"},
+                            {"Retry-After": "2"})
+        self.close_connection = True
+
+    def do_POST(self):
+        length = int(self.headers.get("Content-Length", "0"))
+        body = self.rfile.read(length)
+        if self.path.startswith("/tasks/dispatch"):
+            req = json.loads(body)
+            self._send_json(200, {
+                "task_id": req["task_id"],
+                "tier": "coding_reasoning",
+                "route": [{"provider": "anthropic", "model": "claude-sonnet-4-5"}],
+                "accepted": True,
+            })
+        elif self.path.startswith("/mcp"):
+            req = json.loads(body)
+            if req["params"]["name"] == "boom":
+                self._send_json(200, {
+                    "jsonrpc": "2.0", "id": req.get("id"),
+                    "error": {"code": -32601, "message": "unknown tool: boom"},
+                })
+            else:
+                self._send_json(200, {
+                    "jsonrpc": "2.0", "id": req.get("id"),
+                    "result": {"tool": req["params"]["name"],
+                               "echo": req["params"]["arguments"]},
+                })
+        else:
+            self._send_json(404, {"error": "not found"})
+        self.close_connection = True
+
+
+def _parse_sse_frames(data: bytes) -> Iterator[dict]:
+    """Offline unit parse of SSE bytes into data-frame dicts (harness helper)."""
+    for block in data.decode().split("\n\n"):
+        lines = [l for l in block.split("\n") if l.startswith("data:")]
+        if lines:
+            yield json.loads(lines[0][5:].lstrip())
+
+
+def _self_test() -> int:
+    """Mock-MCP end-to-end harness: health, dispatch, tool, SSE, 401/403/404/429."""
+    checks: list[tuple[str, bool]] = []
+
+    srv = ThreadingHTTPServer(("127.0.0.1", 0), _MockMcpHandler)
+    port = srv.server_address[1]
+    thread = threading.Thread(target=srv.serve_forever, daemon=True)
+    thread.start()
+
+    async def run():
+        client = SupremeAIClient(f"http://127.0.0.1:{port}", "harness-client")
+        health = await client.health()
+        checks.append(("health probe", health.get("status") == "ok"))
+
+        res = await client.dispatch_task(TaskDispatchRequest(
+            task_id="task-33", issue="33", objective="harness",
+            touching_files=("examples/sdk-client-py/client.py",),
+        ))
+        checks.append(("task dispatch round-trip",
+                       res.accepted and res.tier == "coding_reasoning" and res.route[0]["provider"] == "anthropic"))
+
+        tr = await client.invoke_tool(ToolInvocation(tool="repo_read", arguments={"path": "docs/"}))
+        checks.append(("tool call + echo", tr.status == "ok" and tr.result["echo"]["path"] == "docs/"))
+        checks.append(("invocation_id auto-filled", tr.invocation_id.startswith("inv-")))
+
+        frames = [f async for f in client.stream_sse("task-33")]
+        checks.append(("SSE 3 frames", len(frames) == 3))
+        checks.append(("SSE seq monotonic", [f.seq for f in frames] == [1, 2, 3]))
+        checks.append(("SSE terminal frame ends", frames[-1].event == "agent:done"))
+        checks.append(("SSE heartbeat frame typed", frames[1].heartbeat is not None
+                       and frames[1].heartbeat["kind"] == "ping"))
+
+        for name, path, exc_cls in (
+            ("401 → SdkAuthError", "/private", SdkAuthError),
+            ("403 → SdkForbidden", "/gated", SdkForbidden),
+            ("404 → SdkNotFound", "/gone", SdkNotFound),
+        ):
+            try:
+                st, hdrs, b = await _request("GET", f"http://127.0.0.1:{port}{path}")
+                _raise_for_status(st, hdrs, b)
+                checks.append((name, False))
+            except exc_cls:
+                checks.append((name, True))
+        try:
+            st, hdrs, b = await _request("GET", f"http://127.0.0.1:{port}/throttled")
+            _raise_for_status(st, hdrs, b)
+            checks.append(("429 → SdkRateLimited", False))
+        except SdkRateLimited as exc:
+            checks.append(("429 → SdkRateLimited", exc.retry_after_s == 2.0))
+
+        tr_boom = await client.invoke_tool(ToolInvocation(tool="boom", arguments={}))
+        checks.append(("JSON-RPC error → honest envelope",
+                       tr_boom.status == "error" and tr_boom.error["code"] == "tool_failed"
+                       and tr_boom.error["retryable"] is False))
+
+        # Transport-level honest envelope: bogus port → OSError → retryable error.
+        bad = SupremeAIClient("http://127.0.0.1:1", "harness-client")
+        tr_err = await bad.invoke_tool(ToolInvocation(tool="x", arguments={}))
+        checks.append(("transport error → retryable envelope",
+                       tr_err.status == "error"
+                       and tr_err.error["code"] == "transport_error"
+                       and tr_err.error["retryable"] is True))
+
+        # offline SSE parser unit check
+        parsed = list(_parse_sse_frames(b"data: {\"a\": 1}\n\ndata: {\"b\": 2}\n\n"))
+        checks.append(("SSE parser helper", len(parsed) == 2))
+
+    try:
+        asyncio.run(run())
+    finally:
+        srv.shutdown()
+        srv.server_close()
+
+    ok = True
+    for name, passed in checks:
+        print(f"  {'PASS' if passed else 'FAIL'} | {name}")
+        ok &= passed
+    print(f"Self-test (mock MCP harness): {sum(1 for _, p in checks if p)}/{len(checks)} checks passed")
+    return 0 if ok else 1
+
+
+def main(argv: list[str]) -> int:
+    parser = argparse.ArgumentParser(description="SupremeAI async Python SDK (issue #33)")
+    parser.add_argument("--self-test", action="store_true",
+                        help="run the embedded mock-MCP-server harness (offline)")
+    parser.add_argument("--health", action="store_true",
+                        help="probe GET /health on the configured Tower (network)")
+    parser.add_argument("--base-url", default=DEFAULT_BASE_URL)
+    parser.add_argument("--client-name", default=DEFAULT_CLIENT_NAME)
+    args = parser.parse_args(argv)
+
+    if args.self_test:
+        return _self_test()
+    if args.health:
+        client = SupremeAIClient(args.base_url, args.client_name)
+        print(json.dumps(asyncio.run(client.health()), indent=2))
+        return 0
+    print(__doc__.strip())
+    print("\nUsage: client.py --self-test | --health [--base-url URL] [--client-name NAME]")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
