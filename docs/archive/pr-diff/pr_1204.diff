+// JARVIS /status — instant local device + session status (no network).
+// Reports what Jarvis can actually see: connectivity, storage pressure,
+// local memory/todo counts and which relay targets are configured.
+
+import type { IntentContext, IntentResult } from '../registry';
+import { listMemory } from './memory';
+import { listTodos } from './todos';
+
+function bytesLabel(n: number): string {
+  if (n < 1024) return `${n} B`;
+  if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`;
+  return `${(n / (1024 * 1024)).toFixed(2)} MB`;
+}
+
+function storagePressure(): { used: number; label: string } {
+  let used = 0;
+  if (typeof localStorage !== 'undefined') {
+    try {
+      for (let i = 0; i < localStorage.length; i += 1) {
+        const k = localStorage.key(i);
+        if (!k) continue;
+        used += k.length + (localStorage.getItem(k)?.length ?? 0);
+      }
+    } catch {
+      /* private mode */
+    }
+  }
+  // 5 MB is the classic localStorage budget; report characters as bytes (UTF-16 worst case is 2x, close enough for a status line).
+  return { used, label: `${bytesLabel(used * 2)} / ~5 MB` };
+}
+
+function relayTargets(): string {
+  const env = (import.meta as unknown as { env?: Record<string, string> }).env || {};
+  const webhook = env.VITE_STEALTH_WEBHOOK_URL || env.VITE_WEBHOOK_URL || '';
+  const api = env.VITE_SUPREMEAI_API_URL || 'https://supremeai-api-ulw0.onrender.com';
+  return webhook ? `webhook + ${api}` : api;
+}
+
+export function renderStatus(_ctx?: IntentContext): IntentResult {
+  const memoryCount = listMemory().length;
+  const todos = listTodos();
+  const openTodos = todos.filter((t) => !t.done).length;
+  const storage = storagePressure();
+  const online = typeof navigator !== 'undefined' ? navigator.onLine : true;
+  const now = new Date();
+  const lines = [
+    `Jarvis status — ${now.toLocaleString()}`,
+    `  Network: ${online ? 'online' : 'OFFLINE (commands still work, AI relay needs a connection)'}`,
+    `  AI relay: ${relayTargets()}`,
+    `  Local memory: ${memoryCount} fact${memoryCount === 1 ? '' : 's'} stored (/recall to view)`,
+    `  Todos: ${openTodos} open / ${todos.length} total (/todo list)`,
+    `  Local storage: ${storage.label} used`,
+    '  All Jarvis commands run locally — zero AI quota used.',
+  ];
+  return { text: lines.join('\n'), via: 'jarvis:status' };
+}
+
+export const statusIntent = {
+  name: 'status',
+  usage: '/status',
+  description: 'Show local device, storage, memory and relay status',
+  permission: 'read' as const,
+  match: (raw: string): string | boolean | null => {
+    const msg = raw.trim().toLowerCase().replace(/\s+/g, ' ').replace(/[?.!]+$/, '');
+    if (msg === '/status' || msg === 'status' || msg === 'system status' || msg === 'health check' || msg === 'jarvis status') return true;
+    return null;
+  },
+  handle: (ctx: IntentContext): IntentResult => renderStatus(ctx),
+};
diff --git a/studio/src/lib/jarvis/handlers/todos.ts b/studio/src/lib/jarvis/handlers/todos.ts
new file mode 100644
index 00000000..059b9cf8
--- /dev/null
+++ b/studio/src/lib/jarvis/handlers/todos.ts
@@ -0,0 +1,203 @@
+// JARVIS todos + reminders — /todo, /remind (localStorage + Notification).
+// Owner request 2026-10-25: "Todos/reminders via local storage" (free).
+// Reminders use setTimeout while the tab is open — the honest free-tier
+// limitation is stated in the reply. A due-check export is provided so a
+// later cycle can wire it into app boot for catch-up notifications.
+
+import type { IntentContext, IntentResult } from '../registry';
+import { jarvisReadJson, jarvisWriteJson } from '../registry';
+
+const TODO_KEY = 'supremeai_jarvis_todos';
+const MAX_TODOS = 100;
+
+export interface TodoItem {
+  id: string;
+  text: string;
+  createdAt: string;
+  /** ISO due time for reminders; undefined for plain todos. */
+  dueAt?: string;
+  reminded?: boolean;
+  done: boolean;
+}
+
+export function listTodos(): TodoItem[] {
+  return jarvisReadJson<TodoItem[]>(TODO_KEY, []);
+}
+
+function saveTodos(items: TodoItem[]): void {
+  jarvisWriteJson(TODO_KEY, items.slice(0, MAX_TODOS));
+}
+
+export function addTodo(text: string, dueAt?: Date): TodoItem {
+  const item: TodoItem = {
+    id: `todo-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
+    text: text.trim(),
+    createdAt: new Date().toISOString(),
+    ...(dueAt ? { dueAt: dueAt.toISOString() } : {}),
+    done: false,
+  };
+  const all = listTodos();
+  all.unshift(item);
+  saveTodos(all);
+  return item;
+}
+
+export function completeTodo(idOrIndex: string): TodoItem | null {
+  const all = listTodos();
+  let target: TodoItem | undefined;
+  const asIndex = Number.parseInt(idOrIndex, 10);
+  if (Number.isFinite(asIndex) && String(asIndex) === idOrIndex.trim()) {
+    const open = all.filter((t) => !t.done);
+    target = open[asIndex - 1];
+  }
+  if (!target) target = all.find((t) => t.id === idOrIndex || t.text.toLowerCase() === idOrIndex.toLowerCase());
+  if (!target || target.done) return null;
+  target.done = true;
+  saveTodos(all);
+  return target;
+}
+
+export function clearDoneTodos(): number {
+  const all = listTodos();
+  const kept = all.filter((t) => !t.done);
+  const removed = all.length - kept.length;
+  if (removed > 0) saveTodos(kept);
+  return removed;
+}
+
+/** Fires due reminders; safe to call repeatedly (marks items reminded). */
+export function checkDueTodos(now: Date = new Date()): TodoItem[] {
+  const all = listTodos();
+  const fired: TodoItem[] = [];
+  let changed = false;
+  for (const t of all) {
+    if (t.done || t.reminded || !t.dueAt) continue;
+    if (new Date(t.dueAt).getTime() <= now.getTime()) {
+      t.reminded = true;
+      fired.push(t);
+      changed = true;
+      if (typeof Notification !== 'undefined' && Notification.permission === 'granted') {
+        try { new Notification('Jarvis reminder', { body: t.text }); } catch { /* best effort */ }
+      }
+    }
+  }
+  if (changed) saveTodos(all);
+  return fired;
+}
+
+/** Parses "in 10 minutes|hours|days" returns a Date, or null. */
+export function parseInDuration(text: string, now: Date = new Date()): Date | null {
+  const m = text.match(/\bin\s+(\d+)\s*(minutes?|mins?|m|hours?|hrs?|h|days?|d)\b/i);
+  if (!m) return null;
+  const amount = Number.parseInt(m[1], 10);
+  const unit = m[2].toLowerCase();
+  const ms = unit.startsWith('m') ? 60_000
+    : unit.startsWith('h') ? 3_600_000
+      : 86_400_000;
+  return new Date(now.getTime() + amount * ms);
+}
+
+function humanDelay(dueAt: Date, now: Date): string {
+  const secs = Math.max(1, Math.round((dueAt.getTime() - now.getTime()) / 1000));
+  if (secs < 120) return `${secs}s`;
+  if (secs < 7200) return `${Math.round(secs / 60)}min`;
+  if (secs < 172800) return `${Math.round(secs / 3600)}h`;
+  return `${Math.round(secs / 86400)}d`;
+}
+
+function handleTodo(ctx: IntentContext): IntentResult {
+  const arg = ctx.arg.trim();
+  if (!arg || arg === 'list') {
+    const open = listTodos().filter((t) => !t.done);
+    if (open.length === 0) return { text: 'No open todos. Add one with: /todo <text> or "todo buy milk".', via: 'jarvis:todos' };
+    const lines = [`Open todos (${open.length}):`];
+    open.forEach((t, i) => {
+      const due = t.dueAt ? ` — due in ${humanDelay(new Date(t.dueAt), ctx.now)}` : '';
+      lines.push(`  ${i + 1}. ${t.text}${due}`);
+    });
+    lines.push('Complete with: /todo done <number>.');
+    return { text: lines.join('\n'), via: 'jarvis:todos' };
+  }
+  const doneMatch = arg.match(/^done\s+(?:#)?(\d+)$/i);
+  if (doneMatch) {
+    const item = completeTodo(doneMatch[1]);
+    return item
+      ? { text: `Done: "${item.text}". ${listTodos().filter((t) => !t.done).length} open left.`, via: 'jarvis:todos' }
+      : { text: `Couldn't find open todo #${doneMatch[1]}. Check /todo list.`, via: 'jarvis:todos' };
+  }
+  if (arg.toLowerCase() === 'clear') {
+    const removed = clearDoneTodos();
+    return { text: `Cleared ${removed} completed todo${removed === 1 ? '' : 's'}.`, via: 'jarvis:todos' };
+  }
+  const stripped = arg.replace(/^add\s+/i, '');
+  const item = addTodo(stripped);
+  return { text: `Todo added: "${item.text}". /todo list to see it.`, via: 'jarvis:todos' };
+}
+
+async function handleRemind(ctx: IntentContext): Promise<IntentResult> {
+  const arg = ctx.arg.trim();
+  if (!arg) {
+    return { text: 'Usage: /remind me to <task> in 10 minutes|hours|days', via: 'jarvis:todos' };
+  }
+  // Two accepted shapes: "me to X in 10m" and "in 10m to X".
+  let task = '';
+  let due: Date | null = null;
+  const a = arg.match(/^me\s+(?:to\s+)?(.+?)\s+in\s+(\d+)\s*(minutes?|mins?|hours?|hrs?|days?)\s*$/i);
+  const b = arg.match(/^in\s+(\d+)\s*(minutes?|mins?|hours?|hrs?|days?)\s+(?:to\s+)?(.+)$/i);
+  if (a) {
+    task = a[1].trim();
+    due = parseInDuration(`in ${a[2]} ${a[3]}`, ctx.now);
+  } else if (b) {
+    task = b[3].trim();
+    due = parseInDuration(`in ${b[1]} ${b[2]}`, ctx.now);
+  } else {
+    task = arg.replace(/^me\s+(?:to\s+)?/i, '').trim();
+  }
+  if (!due) {
+    return { text: `I need a delay for that: "/remind me to ${task} in 10 minutes". Supported units: minutes, hours, days.`, via: 'jarvis:todos' };
+  }
+  // Request notification permission lazily (browser only, never blocks).
+  if (typeof Notification !== 'undefined' && Notification.permission === 'default') {
+    try { void Notification.requestPermission(); } catch { /* best effort */ }
+  }
+  const item = addTodo(task, due);
+  checkDueTodos(ctx.now); // fire anything already due
+  if (typeof setTimeout === 'function') {
+    const delay = Math.max(0, due.getTime() - ctx.now.getTime());
+    setTimeout(() => { checkDueTodos(); }, delay + 250);
+  }
+  return {
+    text: `Reminder set: "${item.text}" in ${humanDelay(due, ctx.now)}. I will fire a browser notification (keep this tab open — free-tier honesty).`,
+    via: 'jarvis:todos',
+  };
+}
+
+export const todoIntent = {
+  name: 'todo',
+  usage: '/todo <text> | /todo list | /todo done <n> | /todo clear',
+  description: 'Local todo list (free, offline)',
+  permission: 'write' as const,
+  match: (raw: string): string | boolean | null => {
+    const msg = raw.trim();
+    if (msg.toLowerCase().startsWith('/todo')) return msg.slice('/todo'.length).trim();
+    const m = msg.match(/^todos?\s+(?:add\s+)?(.+)$/i);
+    if (m) return m[1];
+    const m2 = msg.match(/^add\s+todos?\s+(.+)$/i);
+    return m2 ? m2[1] : null;
+  },
+  handle: handleTodo,
+};
+
+export const remindIntent = {
+  name: 'remind',
+  usage: '/remind me to <task> in <n> minutes|hours|days',
+  description: 'Set a local reminder (browser notification)',
+  permission: 'write' as const,
+  match: (raw: string): string | boolean | null => {
+    const msg = raw.trim();
+    if (msg.toLowerCase().startsWith('/remind')) return msg.slice('/remind'.length).trim();
+    const m = msg.match(/^remind\s+me\s+(.+)$/i);
+    return m ? m[1] : null;
+  },
+  handle: handleRemind,
+};
diff --git a/studio/src/lib/jarvis/index.ts b/studio/src/lib/jarvis/index.ts
new file mode 100644
index 00000000..b3da1033
--- /dev/null
+++ b/studio/src/lib/jarvis/index.ts
@@ -0,0 +1,36 @@
+// JARVIS assembly — registration order matters (first match wins).
+// help -> status -> memory (remember/recall/forget) -> todos (todo/remind)
+// -> search last (its bare-/search and github: alias must not shadow).
+//
+// Importing this module registers every intent exactly once. UnifiedChatPanel
+// imports tryHandleIntent from here; future surfaces (admin voice cockpit,
+// Telegram bridge) can reuse the same registry.
+
+import { registerIntent } from './registry';
+import { helpIntent } from './handlers/help';
+import { statusIntent } from './handlers/status';
+import { forgetIntent, recallIntent, rememberIntent } from './handlers/memory';
+import { remindIntent, todoIntent } from './handlers/todos';
+import { searchIntent } from './handlers/search';
+
+let registered = false;
+
+/** Idempotent — safe to import from multiple entry points. */
+export function ensureJarvisIntents(): void {
+  if (registered) return;
+  registered = true;
+  registerIntent(helpIntent);
+  registerIntent(statusIntent);
+  registerIntent(rememberIntent);
+  registerIntent(recallIntent);
+  registerIntent(forgetIntent);
+  registerIntent(todoIntent);
+  registerIntent(remindIntent);
+  registerIntent(searchIntent);
+}
+
+ensureJarvisIntents();
+
+export { jarvisRegistry, matchIntent, tryHandleIntent } from './registry';
+export { listMemory, rememberFact, recallMemory, forgetMemory, clearMemory } from './handlers/memory';
+export { listTodos, addTodo, completeTodo, clearDoneTodos, checkDueTodos, parseInDuration } from './handlers/todos';
diff --git a/studio/src/lib/jarvis/registry.ts b/studio/src/lib/jarvis/registry.ts
new file mode 100644
index 00000000..d71c09f8
--- /dev/null
+++ b/studio/src/lib/jarvis/registry.ts
@@ -0,0 +1,123 @@
+// ============================================================
+// SUPREMEAI JARVIS — Shared Intent Registry & Router (Phase A)
+// Zero-cost local command layer for the unified chat.
+// Owner request 2026-10-25: "Search + Help + Notify intents add korum
+// (free APIs)" + memory recall + todos — all resolving LOCALLY so chat
+// commands never burn relay/LLM quota.
+//
+// Design notes:
+// - Handlers live in ./handlers/* and self-register via registerIntent.
+// - index.ts owns registration order (help first, search last) so
+//   matchers never shadow each other.
+// - matchers are ANCHORED (^...) and conservative: a normal question
+//   like "help me write an essay" must fall through to the LLM.
+// - The admin voice cockpit (components/admin/jarvis) keeps its own
+//   persona; this registry is the shared hands layer both can use.
+// ============================================================
+
+export type IntentPermission = 'read' | 'write';
+
+export interface IntentContext {
+  /** Everything after the command token (trimmed). May be ''. */
+  arg: string;
+  /** The full original message, trimmed. */
+  raw: string;
+  now: Date;
+}
+
+export interface IntentResult {
+  text: string;
+  /** Shown as the bubble's via badge, e.g. 'jarvis:help'. */
+  via: string;
+}
+
+export interface JarvisIntent {
+  /** Registry id, e.g. 'help'. */
+  name: string;
+  /** Short usage string shown by /help, e.g. '/remember <fact>'. */
+  usage: string;
+  /** One-line description shown by /help. */
+  description: string;
+  /** 'write' intents mutate local state (memory/todos); 'read' ones do not. */
+  permission: IntentPermission;
+  /**
+   * Return null to pass, true for "matched, no argument",
+   * or a string for "matched, argument = ...".
+   */
+  match: (raw: string) => string | boolean | null;
+  handle: (ctx: IntentContext) => IntentResult | Promise<IntentResult>;
+}
+
+/** Live registry — populated at app start by index.ts. */
+export const jarvisRegistry: JarvisIntent[] = [];
+
+export function registerIntent(intent: JarvisIntent): void {
+  const existing = jarvisRegistry.findIndex((i) => i.name === intent.name);
+  if (existing >= 0) jarvisRegistry[existing] = intent;
+  else jarvisRegistry.push(intent);
+}
+
+export interface IntentMatch {
+  intent: JarvisIntent;
+  arg: string;
+}
+
+/** First registered match wins. Null when no intent claims the message. */
+export function matchIntent(raw: string): IntentMatch | null {
+  const msg = raw.trim();
+  if (!msg) return null;
+  for (const intent of jarvisRegistry) {
+    let hit: string | boolean | null = null;
+    try {
+      hit = intent.match(msg);
+    } catch {
+      hit = null;
+    }
+    if (hit === null || hit === false) continue;
+    return { intent, arg: typeof hit === 'string' ? hit.trim() : '' };
+  }
+  return null;
+}
+
+/**
+ * Router used by UnifiedChatPanel: resolves a local intent or returns
+ * null so the caller proceeds with the normal relay/LLM path. Handler
+ * failures are swallowed into a jarvis:error result (chat must never
+ * break because a local command misfired).
+ */
+export async function tryHandleIntent(raw: string): Promise<IntentResult | null> {
+  const match = matchIntent(raw);
+  if (!match) return null;
+  try {
+    return await match.intent.handle({ arg: match.arg, raw: raw.trim(), now: new Date() });
+  } catch (e) {
+    return {
+      text: `Jarvis command "/${match.intent.name}" failed: ${e instanceof Error ? e.message : String(e)}. The message was not sent to the model.`,
+      via: 'jarvis:error',
+    };
+  }
+}
+
+// ------------------------------------------------------------
+// localStorage helpers (guarded — SSR/jsdom/non-browser safe)
+// ------------------------------------------------------------
+
+export function jarvisReadJson<T>(key: string, fallback: T): T {
+  if (typeof localStorage === 'undefined') return fallback;
+  try {
+    const stored = localStorage.getItem(key);
+    if (!stored) return fallback;
+    return JSON.parse(stored) as T;
+  } catch {
+    return fallback;
+  }
+}
+
+export function jarvisWriteJson(key: string, value: unknown): void {
+  if (typeof localStorage === 'undefined') return;
+  try {
+    localStorage.setItem(key, JSON.stringify(value));
+  } catch {
+    /* quota/private-mode: memory commands degrade gracefully */
+  }
+}
