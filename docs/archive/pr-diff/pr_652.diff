+export function upstashSoftThreshold(): number {
+  const raw = Number(process.env.UPSTASH_PREEMPTIVE_ROTATION_THRESHOLD);
+  if (Number.isFinite(raw) && raw > 0) return raw;
+  return Math.floor(upstashCommandLimit() * 0.96);
+}
