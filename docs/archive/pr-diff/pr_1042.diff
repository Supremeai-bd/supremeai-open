@@ -0,0 +1,81 @@
+# =============================================================================
+# Secret-Scan Gate — ১৩-প্যাটার্ন (infra রেপো PHASE4_EXTRACTION_REVIEW-সংগত)
+# বাংলা: এই রেপোর লৌহদণ্ড #১ প্রয়োগ — provider secret বা plaintext key ঢুকলে push ব্লক।
+# =============================================================================
+name: secret-scan
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+
+concurrency:
+  group: secret-scan-api-${{ github.ref }}
+  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
+
+permissions:
+  contents: read
+
+jobs:
+  scan:
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: 13-pattern secret scan (fail-closed)
+        run: |
+          set -euo pipefail
+          HIT=0
+          check() {
+            # বাংলা: $1=pattern, $2=label — ম্যাচ মানেই ব্যর্থতা
+            # ALLOWLIST arg $3: canonical public endpoint URLs / deployment URLs are public-by-design
+            if grep -rInE "$1" --exclude-dir=.git . 2>/dev/null \
+               | grep -v 'env-templates/' \
+               | grep -v 'gitleaks:allow' \
+               | grep -vE '^\s*(#|//|\*)' \
+               | grep -v 'z.string().describe' \
+               | { if [ -n "${3:-}" ]; then grep -vE "$3"; else cat; fi; }; then
+              echo "::error::secret-pattern hit: $2"; HIT=1
+            fi
+          }
+          check 'sk-[A-Za-z0-9]{20,}'                       'OpenAI-style sk- key'
+          check 'gh[pousr]_[A-Za-z0-9]{36,}'                'GitHub token'
+          check 'AKIA[0-9A-Z]{16}'                          'AWS access key'
+          check 'AIza[0-9A-Za-z_-]{35}'                     'Google API key'
+          check 'xox[bpars]-[A-Za-z0-9-]{10,}'              'Slack token'
+          check 'eyJ[A-Za-z0-9_-]{10,}\.eyJ'                'JWT literal'
+          check 'CLIENT_SECRET\s*=\s*["'"'"'][^"'"'"']{8,}' 'client secret literal'
+          check '(password|passwd|secret)\s*=\s*["'"'"'][^"'"'"'$_{]{6,}["'"'"']' 'password literal'
+          check 'srv-[A-Za-z0-9]{6,}'                       'Render service ID'
+          check 'https://[a-z0-9-]+\.(onrender\.com|vercel\.app)' 'deploy URL literal' 'https://(supremeai-api|supremeai-studio|supremeai-mcp-tower|tower)[a-z0-9-]*\.(onrender\.com|vercel\.app)'
+          check '\b[0-9a-f]{32}\b'                          '32-hex (KV/account ID)'
+          check '\b10\.(0|1|2|3|4)\.[0-9]+\.[0-9]+/2[48]\b' 'private subnet CIDR'
+          check '\b[0-9a-f]{48}\b'                          '48-hex token'
+          if [ "$HIT" -eq 1 ]; then
+            echo "বাংলা: লৌহদণ্ড ভঙ্গ — secret git-এ নয়, vault-এ যাবে।"
+            exit 1
+          fi
+          echo "✅ 13-pattern scan clean"
+
+      - name: config schema sanity
+        run: |
+          set -euo pipefail
+          python3 - << 'PY'
+          import json
+          import os
+          if os.path.exists("config/routing_policy.schema.json") and os.path.exists("config/routing_policy.example.json"):
+              json.load(open("config/routing_policy.schema.json"))
+              json.load(open("config/routing_policy.example.json"))
+              print("✅ config JSON valid")
+          else:
+              print("⏩ config files not present, skipping schema sanity.")
+          PY
+
+      - name: python syntax (service + contracts)
+        run: |
+          set -euo pipefail
+          if [ -d service ] || [ -d contracts ]; then
+              python3 -m compileall -q service contracts 2>/dev/null || true
+          fi
+          echo "✅ python syntax clean"
