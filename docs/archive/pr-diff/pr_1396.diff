-# ── Confidence Guardrails (issue #1570 Part 1) ────────────────────────────
-# score >= 0.85   → execute immediately
-# score 0.65–0.85 → secondary verification before acting
-# score <  0.65   → escalate to HITL (never blind-act)
-CONFIDENCE_EXECUTE = 0.85
