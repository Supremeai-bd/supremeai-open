diff --git a/api-schemas/provider-registry.schema.json b/api-schemas/provider-registry.schema.json
new file mode 100644
index 00000000..ab540375
--- /dev/null
+++ b/api-schemas/provider-registry.schema.json
@@ -0,0 +1,195 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://supremeai.dev/schemas/provider-registry.schema.json",
+  "title": "SupremeAI Provider Registry",
+  "description": "Single source of truth (SSOT) for LLM provider capability, error-classification and failover-cascade contracts. One place to declare what a provider can do, how its failures normalize, and who takes over when it degrades. BN: LLM প্রোভাইডারের সক্ষমতা, ত্রুটি-শ্রেণিবিন্যাস ও ফেইলওভার চেইনের একক সত্য-উৎস।",
+  "type": "object",
+  "required": ["schema_version", "providers"],
+  "additionalProperties": false,
+  "properties": {
+    "schema_version": {
+      "type": "string",
+      "pattern": "^\\d+\\.\\d+$",
+      "description": "Registry contract version (semver-ish MAJOR.MINOR). MAJOR bumps require consumer-adapter review; MINOR bumps are additive-only."
+    },
+    "providers": {
+      "type": "array",
+      "minItems": 1,
+      "uniqueItems": true,
+      "description": "All declared providers. The id-space is pattern-open (not a closed enum) so new providers up to and beyond the 12-provider target extend the registry with zero schema changes and zero breaking changes to existing consumer adapters.",
+      "items": { "$ref": "#/$defs/provider" }
+    },
+    "failover_cascade": {
+      "type": "array",
+      "items": { "$ref": "#/$defs/providerId" },
+      "minItems": 1,
+      "uniqueItems": true,
+      "description": "Global default failover order: first entry is the primary route, later entries are successive fallbacks. Per-provider overrides live on the provider's failover object."
+    }
+  },
+  "$defs": {
+    "providerId": {
+      "type": "string",
+      "pattern": "^[a-z][a-z0-9-]*$",
+      "description": "Stable lowercase provider id, e.g. openai, anthropic, gemini, mistral, deepseek, groq, openrouter."
+    },
+    "errorCode": {
+      "type": "string",
+      "enum": [
+        "rate_limited",
+        "auth_failure",
+        "provider_unavailable",
+        "context_overflow",
+        "content_filter",
+        "timeout",
+        "quota_exhausted",
+        "upstream_error"
+      ],
+      "description": "Standardized failure classes every upstream error MUST normalize into. Consumers branch on this code only — never on raw upstream payloads."
+    },
+    "errorAction": {
+      "type": "string",
+      "enum": ["retry", "backoff_then_retry", "failover", "abort"],
+      "description": "The single prescribed consumer action for the mapped error class."
+    },
+    "provider": {
+      "type": "object",
+      "required": ["id", "display_name", "status", "auth", "capabilities", "errors", "failover"],
+      "additionalProperties": false,
+      "properties": {
+        "id": { "$ref": "#/$defs/providerId" },
+        "display_name": {
+          "type": "string",
+          "minLength": 1,
+          "description": "Human-facing provider name."
+        },
+        "status": {
+          "type": "string",
+          "enum": ["active", "planned", "deprecated"],
+          "description": "Lifecycle status. planned = declared but not yet integrated; deprecated = still routable but excluded from new failover cascades."
+        },
+        "base_url": {
+          "type": "string",
+          "pattern": "^https://",
+          "description": "HTTPS-only API base URL. No paths, no query strings, no credentials."
+        },
+        "auth": {
+          "type": "object",
+          "required": ["scheme", "env_var"],
+          "additionalProperties": false,
+          "description": "Credential POINTER only. The registry never carries secret VALUES — credentials resolve at runtime from the named environment variable (boundary-guard doctrine: name, never value).",
+          "properties": {
+            "scheme": {
+              "type": "string",
+              "enum": ["bearer", "api-key-header", "query-param"]
+            },
+            "header_name": {
+              "type": "string",
+              "pattern": "^[A-Za-z][A-Za-z0-9-]*$",
+              "description": "Required when scheme is api-key-header (e.g. X-SupremeAI-Key style inbound or provider-specific outbound headers)."
+            },
+            "env_var": {
+              "type": "string",
+              "pattern": "^[A-Z][A-Z0-9_]*$",
+              "description": "Name of the environment variable holding the credential. Never the credential itself."
+            }
+          },
+          "if": { "properties": { "scheme": { "const": "api-key-header" } } },
+          "then": { "required": ["scheme", "env_var", "header_name"] }
+        },
+        "capabilities": {
+          "type": "object",
+          "required": ["streaming", "tool_calling", "reasoning_tokens", "json_mode", "max_context_tokens", "rate_limits"],
+          "additionalProperties": false,
+          "properties": {
+            "streaming": { "type": "boolean", "description": "SSE/token streaming supported." },
+            "tool_calling": { "type": "boolean", "description": "Native function/tool invocation supported." },
+            "reasoning_tokens": { "type": "boolean", "description": "Extended-thinking/reasoning token accounting surfaced in usage." },
+            "json_mode": { "type": "boolean", "description": "Structured JSON output mode supported." },
+            "max_context_tokens": {
+              "type": "integer",
+              "minimum": 0,
+              "description": "Maximum context window in tokens."
+            },
+            "rate_limits": { "$ref": "#/$defs/rateLimits" }
+          }
+        },
+        "errors": {
+          "type": "object",
+          "required": ["mappings"],
+          "additionalProperties": false,
+          "properties": {
+            "mappings": {
+              "type": "array",
+              "minItems": 1,
+              "description": "Upstream-condition → standard-class normalization table. First matching entry wins; consumers MUST NOT interpret unmapped upstream shapes.",
+              "items": {
+                "type": "object",
+                "required": ["code", "upstream_status", "action"],
+                "additionalProperties": false,
+                "properties": {
+                  "code": { "$ref": "#/$defs/errorCode" },
+                  "upstream_status": {
+                    "type": "integer",
+                    "minimum": 400,
+                    "maximum": 599,
+                    "description": "HTTP status this mapping applies to."
+                  },
+                  "upstream_pattern": {
+                    "type": "string",
+                    "description": "Optional substring/shape discriminator for statuses that encode multiple failure classes (e.g. 429 with quota vs rate body)."
+                  },
+                  "action": { "$ref": "#/$defs/errorAction" }
+                }
+              }
+            }
+          }
+        },
+        "failover": {
+          "type": "object",
+          "required": ["priority", "fallback_ids", "retry_policy"],
+          "additionalProperties": false,
+          "properties": {
+            "priority": {
+              "type": "integer",
+              "minimum": 1,
+              "description": "1 = highest routing preference. Cascade builders sort on this, then on id for determinism."
+            },
+            "fallback_ids": {
+              "type": "array",
+              "items": { "$ref": "#/$defs/providerId" },
+              "uniqueItems": true,
+              "description": "This provider's ordered takeover list. Must not contain the provider's own id; cycle-free across the registry by convention."
+            },
+            "retry_policy": {
+              "type": "object",
+              "required": ["max_retries", "backoff_base_ms", "backoff_multiplier", "retry_on"],
+              "additionalProperties": false,
+              "properties": {
+                "max_retries": { "type": "integer", "minimum": 0, "maximum": 10 },
+                "backoff_base_ms": { "type": "integer", "minimum": 0 },
+                "backoff_multiplier": { "type": "number", "minimum": 1 },
+                "retry_on": {
+                  "type": "array",
+                  "items": { "$ref": "#/$defs/errorCode" },
+                  "uniqueItems": true,
+                  "description": "Standard classes eligible for in-place retry. Everything else either fails over or aborts."
+                }
+              }
+            }
+          }
+        }
+      }
+    },
+    "rateLimits": {
+      "type": "object",
+      "required": ["requests_per_minute", "tokens_per_minute", "concurrent_requests"],
+      "additionalProperties": false,
+      "properties": {
+        "requests_per_minute": { "type": "integer", "minimum": 0 },
+        "tokens_per_minute": { "type": "integer", "minimum": 0 },
+        "concurrent_requests": { "type": "integer", "minimum": 0 }
+      }
+    }
+  }
+}
