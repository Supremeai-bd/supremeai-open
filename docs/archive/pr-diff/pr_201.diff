+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://supremeai.ai/schemas/webhook-notification.schema.json",
+  "title": "Agent Notification Webhook Payload",
+  "description": "Standard payload dispatched by SupremeAI services to external webhook consumers (Telegram, Discord, Slack channels, or any HTTPS receiver) for agent-system notifications (#51). Declared events: pr.opened, pr.merged, ci.failure, deployment.completed. Transport contract: HTTP POST with Content-Type application/json. The raw request body is signed with HMAC-SHA256 and carried in the X-SupremeAI-Signature header as 'sha256=<hex digest>' — the identical value format the Control Tower already enforces for inbound webhooks (infrastructure/mcp-control-plane/src/lib/webhook_signature.ts, #69). Receivers MUST verify the signature over the RAW received bytes (never a re-serialized JSON copy) using a constant-time comparison, and MUST fail-closed on a missing secret, a missing or malformed header (anything not starting with 'sha256='), or a digest mismatch. Severity maps to consumer presentation color: info (neutral), success (green), warning (orange), error (red). Reference verifier: examples/webhook-verification/verify.py (zero-dependency).",
+  "type": "object",
+  "required": ["event", "service", "severity", "message", "link", "timestamp"],
+  "additionalProperties": false,
+  "properties": {
+    "event": {
+      "type": "string",
+      "enum": ["pr.opened", "pr.merged", "ci.failure", "deployment.completed"],
+      "description": "Notification event kind. v1 contract declares exactly four events; adding one is a schema version bump, not a silent extension."
+    },
+    "service": {
+      "type": "string",
+      "pattern": "^[a-z][a-z0-9-]{1,63}$",
+      "description": "Kebab-case identifier of the emitting SupremeAI service (e.g. supremeai-mcp-tower, supremeai-gateway). Enables consumers to route or filter by source."
+    },
+    "severity": {
+      "type": "string",
+      "enum": ["info", "success", "warning", "error"],
+      "description": "Presentation severity. Expected mapping for the declared events: pr.opened=info, pr.merged=success, ci.failure=error, deployment.completed=success."
+    },
+    "message": {
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 2000,
+      "description": "Human-readable one-line summary suitable for direct rendering as a Telegram message text, Discord embed description, or Slack text block."
+    },
+    "link": {
+      "type": "string",
+      "format": "uri",
+      "minLength": 1,
+      "maxLength": 2048,
+      "description": "Absolute HTTPS deep-link to the triggering artifact (pull request, CI run, or deployment environment). Consumers render it as the notification's action link."
+    },
+    "timestamp": {
+      "type": "string",
+      "format": "date-time",
+      "description": "RFC 3339 / ISO 8601 UTC timestamp at which the notification was emitted (e.g. 2026-10-15T23:07:00Z)."
+    }
+  },
+  "examples": [
+    {
+      "event": "ci.failure",
+      "service": "supremeai-mcp-tower",
+      "severity": "error",
+      "message": "tower-verify job failed on main at commit 3832c85 (typecheck: 2 errors)",
+      "link": "https://github.com/Supremeai-bd/supremeai-open/actions/runs/987654321",
+      "timestamp": "2026-10-15T23:07:00Z"
+    }
+  ]
+}
diff --git a/examples/webhook-verification/verify.py b/examples/webhook-verification/verify.py
new file mode 100644
index 00000000..cb37d69e
--- /dev/null
+++ b/examples/webhook-verification/verify.py
@@ -0,0 +1,125 @@
+"""SupremeAI Webhook Notification — zero-dependency verification example (#51).
+
+Contract: api-schemas/webhook-notification.schema.json
+
+বাংলা মন্তব্য (consumer-চুক্তি):
+- signature header সবসময় `X-SupremeAI-Signature`, value ফরম্যাট `sha256=<hex>`
+  (Control Tower-এর inbound যাচাইয়ের মতোই — src/lib/webhook_signature.ts, #69)
+- HMAC-SHA256 কঠোরভাবে RAW body bytes-এর উপর — কখনো re-serialized JSON কপিতে নয়
+- যাচাই fail-closed: secret/header অনুপস্থিত বা বিকৃত হলে সবসময় প্রত্যাখ্যান
+- তুলনা সবসময় constant-time (hmac.compare_digest)
+
+Self-test (run: python examples/webhook-verification/verify.py):
+  1. builds one sample payload per declared event (pr.opened, pr.merged,
+     ci.failure, deployment.completed) conforming to the schema;
+  2. signs each over the raw bytes and verifies the round trip;
+  3. asserts fail-closed rejection for: tampered body, wrong signature
+     prefix, missing header, missing secret, and header-for-different-body;
+  4. if `jsonschema` is installed, validates every sample payload against
+     the schema file (explicit SKIP note when unavailable — never a fake pass).
+Exit code 0 = all checks green; 1 = any failure (fail-loud).
+"""
+
+from __future__ import annotations
+
+import hashlib
+import hmac
+import json
+from pathlib import Path
+from typing import Any
+
+SIGNATURE_HEADER = "X-SupremeAI-Signature"
+SIGNATURE_PREFIX = "sha256="
+DECLARED_EVENTS = (
+    ("pr.opened", "info", "PR #193 opened: declare autonomy-loop integration contract"),
+    ("pr.merged", "success", "PR #192 merged via Merge Gate at commit 3832c85"),
+    ("ci.failure", "error", "tower-verify job failed on main (typecheck: 2 errors)"),
+    ("deployment.completed", "success", "mcp-tower deployed to production (revision 4177)"),
+)
+
+SCHEMA_PATH = Path(__file__).resolve().parents[2] / "api-schemas" / "webhook-notification.schema.json"
+
+
+def build_notification(event: str, message: str, link: str, service: str = "supremeai-mcp-tower", timestamp: str = "2026-10-15T23:07:00Z") -> dict[str, str]:
+    """Build a schema-conforming notification payload."""
+    severity_map = {
+        "pr.opened": "info",
+        "pr.merged": "success",
+        "ci.failure": "error",
+        "deployment.completed": "success",
+    }
+    if event not in severity_map:
+        raise ValueError(f"undeclared event: {event} (v1 contract allows only {sorted(severity_map)})")
+    return {
+        "event": event,
+        "service": service,
+        "severity": severity_map[event],
+        "message": message,
+        "link": link,
+        "timestamp": timestamp,
+    }
+
+
+def sign_payload(raw_body: bytes, secret: str) -> str:
+    """Return the exact header value for a raw body: 'sha256=<hex>'."""
+    digest = hmac.new(secret.encode("utf-8"), raw_body, hashlib.sha256).hexdigest()
+    return SIGNATURE_PREFIX + digest
+
+
+def verify_signature(raw_body: bytes, secret: str, header_value: str | None) -> bool:
+    """Fail-closed, constant-time verification over the RAW body bytes."""
+    if not secret or not header_value or not header_value.startswith(SIGNATURE_PREFIX):
+        return False
+    expected = sign_payload(raw_body, secret)
+    return hmac.compare_digest(header_value, expected)
+
+
+def _check(name: str, cond: bool) -> None:
+    if not cond:
+        print(f"FAIL: {name}")
+        raise SystemExit(1)
+    print(f"ok: {name}")
+
+
+def run_self_test(secret: str = "demo-webhook-signing-secret") -> None:
+    # 1+2. build + sign + verify round trip for every declared event
+    payloads: list[dict[str, Any]] = []
+    for event, _, message in DECLARED_EVENTS:
+        payload = build_notification(event=event, message=message, link="https://github.com/Supremeai-bd/supremeai-open/actions/runs/987654321")
+        raw = json.dumps(payload, separators=(",", ":"), sort_keys=True).encode("utf-8")
+        header_value = sign_payload(raw, secret)
+        _check(f"roundtrip verify ({event})", verify_signature(raw, secret, header_value))
+        payloads.append(payload)
+
+    # 3. fail-closed rejection matrix
+    raw0 = json.dumps(payloads[0], separators=(",", ":"), sort_keys=True).encode("utf-8")
+    good_header = sign_payload(raw0, secret)
+    tampered = json.dumps({**payloads[0], "message": "tampered"}, separators=(",", ":"), sort_keys=True).encode("utf-8")
+    _check("reject tampered body", not verify_signature(tampered, secret, good_header))
+    _check("reject wrong prefix", not verify_signature(raw0, secret, "md5=" + good_header[len(SIGNATURE_PREFIX):]))
+    _check("reject missing header", not verify_signature(raw0, secret, None))
+    _check("reject missing secret", not verify_signature(raw0, "", good_header))
+    _check("reject header of different body", not verify_signature(raw0, secret, sign_payload(tampered, secret)))
+
+    # 4. schema validation (real check when jsonschema is importable)
+    try:
+        import jsonschema
+    except ImportError:
+        print("SKIP: schema validation (jsonschema not installed — signature checks above still ran)")
+        return
+    schema = json.loads(SCHEMA_PATH.read_text(encoding="utf-8"))
+    validator = jsonschema.Draft202012Validator(schema)
+    for payload in payloads:
+        errors = sorted(validator.iter_errors(payload), key=lambda e: e.path)
+        _check(f"schema-valid payload ({payload['event']})", not errors)
+    try:
+        validator.validate({"event": "unknown.event", "service": "x", "severity": "info", "message": "m", "link": "https://a.b", "timestamp": "2026-10-15T23:07:00Z"})
+        _check("schema rejects undeclared event", False)
+    except jsonschema.ValidationError:
+        _check("schema rejects undeclared event", True)
+
+
+if __name__ == "__main__":
+    print("SupremeAI webhook notification verification example (#51)")
+    run_self_test()
+    print("webhook verification example: ALL CHECKS GREEN")
