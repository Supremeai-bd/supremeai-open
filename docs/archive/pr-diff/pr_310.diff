diff --git a/api-schemas/task-router.schema.json b/api-schemas/task-router.schema.json
new file mode 100644
index 00000000..7e574275
--- /dev/null
+++ b/api-schemas/task-router.schema.json
@@ -0,0 +1,268 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://supremeai.ai/schemas/task-router.schema.json",
+  "title": "SupremeAI Dynamic Task Router and Model-Chain Orchestrator",
+  "description": "Layer-1 routing contracts for dynamic AI task dispatch. Classifies tasks into three complexity tiers (fast/light, coding/reasoning, complex/architecture), maps each tier to an optimal primary provider model with an ordered fallback cascade, and encodes cost-aware token-budget routing rules. Provider identifiers reuse the providerId pattern SSOT'd in provider-registry.schema.json; the router never invents providers — unknown providers are rejected by validation and unknown tasks by the fail-closed default. See issue #27.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema_version",
+    "router_id",
+    "complexity_tiers",
+    "routing_table",
+    "budget_rules",
+    "defaults"
+  ],
+  "properties": {
+    "schema_version": {
+      "type": "string",
+      "pattern": "^\\d+\\.\\d+$",
+      "description": "Semantic version of this routing policy document (e.g. \"1.0\")."
+    },
+    "router_id": {
+      "type": "string",
+      "pattern": "^[a-z][a-z0-9-]{2,63}$",
+      "description": "Stable identifier of the router policy instance (e.g. \"federation-task-router\")."
+    },
+    "complexity_tiers": {
+      "type": "array",
+      "minItems": 3,
+      "maxItems": 3,
+      "uniqueItems": true,
+      "description": "Exactly the 3 complexity tiers, each present exactly once: allOf-of-contains clauses below pin ordinals 1..3 (monotonic capability, higher tier handles harder tasks).",
+      "items": {
+        "$ref": "#/$defs/ComplexityTier"
+      },
+      "allOf": [
+        {
+          "description": "Tier 1 (fast_light) must be present.",
+          "contains": {
+            "type": "object",
+            "required": ["tier"],
+            "properties": { "tier": { "const": 1 } }
+          }
+        },
+        {
+          "description": "Tier 2 (coding_reasoning) must be present.",
+          "contains": {
+            "type": "object",
+            "required": ["tier"],
+            "properties": { "tier": { "const": 2 } }
+          }
+        },
+        {
+          "description": "Tier 3 (complex_architecture) must be present.",
+          "contains": {
+            "type": "object",
+            "required": ["tier"],
+            "properties": { "tier": { "const": 3 } }
+          }
+        }
+      ]
+    },
+    "routing_table": {
+      "type": "array",
+      "minItems": 3,
+      "maxItems": 3,
+      "uniqueItems": true,
+      "description": "Exactly one route mapping per complexity tier: allOf-of-contains clauses pin tiers 1..3.",
+      "items": {
+        "$ref": "#/$defs/RouteMapping"
+      },
+      "allOf": [
+        {
+          "description": "A route for tier 1 must exist.",
+          "contains": {
+            "type": "object",
+            "required": ["tier"],
+            "properties": { "tier": { "const": 1 } }
+          }
+        },
+        {
+          "description": "A route for tier 2 must exist.",
+          "contains": {
+            "type": "object",
+            "required": ["tier"],
+            "properties": { "tier": { "const": 2 } }
+          }
+        },
+        {
+          "description": "A route for tier 3 must exist.",
+          "contains": {
+            "type": "object",
+            "required": ["tier"],
+            "properties": { "tier": { "const": 3 } }
+          }
+        }
+      ]
+    },
+    "budget_rules": {
+      "$ref": "#/$defs/CostBudgetRules"
+    },
+    "defaults": {
+      "$ref": "#/$defs/RouterDefaults"
+    }
+  },
+  "$defs": {
+    "ComplexityTier": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "One rung of the 3-tier task complexity ladder.",
+      "required": ["tier", "name", "description", "example_signals"],
+      "properties": {
+        "tier": {
+          "type": "integer",
+          "minimum": 1,
+          "maximum": 3,
+          "description": "Ordinal; higher tier implies harder tasks and stronger models."
+        },
+        "name": {
+          "enum": ["fast_light", "coding_reasoning", "complex_architecture"],
+          "description": "Canonical tier name; name and ordinal are pinned together by the router renderer."
+        },
+        "description": {
+          "type": "string",
+          "minLength": 1,
+          "description": "What class of work this tier serves."
+        },
+        "example_signals": {
+          "type": "array",
+          "minItems": 1,
+          "uniqueItems": true,
+          "items": {
+            "type": "string",
+            "minLength": 1
+          },
+          "description": "Observable task signals that classify a request into this tier (deterministic classification inputs)."
+        }
+      }
+    },
+    "RouteMapping": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "Tier → primary model + ordered fallback cascade (model-chain orchestration).",
+      "required": ["tier", "primary", "fallback_cascade"],
+      "properties": {
+        "tier": {
+          "type": "integer",
+          "minimum": 1,
+          "maximum": 3,
+          "description": "The complexity tier this route serves."
+        },
+        "primary": {
+          "$ref": "#/$defs/ModelEndpoint"
+        },
+        "fallback_cascade": {
+          "type": "array",
+          "minItems": 1,
+          "uniqueItems": true,
+          "items": {
+            "$ref": "#/$defs/ModelEndpoint"
+          },
+          "description": "Ordered model chain tried after the primary fails; first entry is tried first. Mirrors the failover_cascade semantics of provider-registry.schema.json at model granularity."
+        }
+      }
+    },
+    "ModelEndpoint": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "One routable model endpoint: provider identity plus concrete model name.",
+      "required": ["provider", "model"],
+      "properties": {
+        "provider": {
+          "enum": ["openai", "anthropic", "gemini", "groq", "openrouter", "mistral", "deepseek"],
+          "description": "Provider id — enum pinned to the currently registered provider ids in provider-registry.schema.json (pattern SSOT: ^[a-z][a-z0-9-]*$). Keep in sync when the registry grows; the router's unknown_provider=reject default gives this enum load-time teeth."
+        },
+        "model": {
+          "type": "string",
+          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,99}$",
+          "description": "Provider-specific model name, e.g. gpt-4o-mini, claude-sonnet-4-5, llama-3.3-70b-versatile, deepseek-chat."
+        },
+        "max_context_tokens": {
+          "type": "integer",
+          "minimum": 1024,
+          "description": "Context ceiling of this endpoint; router consults it against the task's estimated input size."
+        },
+        "cost_per_1k_tokens_usd": {
+          "type": "number",
+          "minimum": 0,
+          "description": "Blended per-1k-token cost used by the budget rules."
+        }
+      }
+    },
+    "CostBudgetRules": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "Cost-aware token budget routing rules, evaluated deterministically in listed order.",
+      "required": ["per_task_max_input_tokens", "per_task_max_output_tokens", "max_cost_per_task_usd", "budget_floor_usd", "rules"],
+      "properties": {
+        "per_task_max_input_tokens": {
+          "type": "integer",
+          "minimum": 1024,
+          "description": "Hard input ceiling per task; tasks above it are downgraded to the cascade or rejected per rules."
+        },
+        "per_task_max_output_tokens": {
+          "type": "integer",
+          "minimum": 256,
+          "description": "Hard output ceiling per task."
+        },
+        "max_cost_per_task_usd": {
+          "type": "number",
+          "exclusiveMinimum": 0,
+          "description": "Estimated total cost above which the reroute rule fires."
+        },
+        "budget_floor_usd": {
+          "type": "number",
+          "minimum": 0,
+          "description": "Remaining-budget threshold below which only cheaper-tier routing is permitted."
+        },
+        "rules": {
+          "type": "array",
+          "minItems": 1,
+          "uniqueItems": true,
+          "description": "Ordered when→then routing rules; first match wins.",
+          "items": {
+            "$ref": "#/$defs/BudgetRule"
+          }
+        }
+      }
+    },
+    "BudgetRule": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "One deterministic routing rule.",
+      "required": ["when", "then"],
+      "properties": {
+        "when": {
+          "enum": [
+            "context_exceeds_primary",
+            "estimated_cost_above_cap",
+            "budget_remaining_below_floor",
+            "latency_sla_missed"
+          ],
+          "description": "Trigger condition evaluated against the task estimate and live provider telemetry."
+        },
+        "then": {
+          "enum": ["fallback_cascade", "downgrade_tier", "cap_output_tokens", "queue_and_retry"],
+          "description": "Deterministic action taken on trigger."
+        }
+      }
+    },
+    "RouterDefaults": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "Fail-closed router defaults.",
+      "required": ["unclassifiable_task", "unknown_provider"],
+      "properties": {
+        "unclassifiable_task": {
+          "const": "reject",
+          "description": "Tasks that match no complexity tier are rejected, never guessed onto a route."
+        },
+        "unknown_provider": {
+          "const": "reject",
+          "description": "Routes referencing providers absent from the provider registry are rejected at load time."
+        }
+      }
+    }
+  }
+}
