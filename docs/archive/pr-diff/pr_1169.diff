-
-on:
-  workflow_run:
-    workflows: ["CI — Open Unified Pipeline"]
-    types: [completed]
-  pull_request:
-    types: [closed]
-    branches: [main]
-  workflow_dispatch:
-    inputs:
-      pr_number:
