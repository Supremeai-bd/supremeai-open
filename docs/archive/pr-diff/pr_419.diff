-  TIER3: "HITL_REQUIRED",
-};
-
-const TIER_RANK: Record<ChangeTier, number> = { TIER1: 1, TIER2: 2, TIER3: 3 };
-
-export interface TierClassification {
-  tier: ChangeTier;
-  authority: MergeAuthority;
-  /** The rule that determined the tier (null when nothing matched). */
