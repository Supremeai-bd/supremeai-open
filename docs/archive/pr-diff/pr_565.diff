+"""SupremeAI Gateway — unified provider gateway (issue #336).
+
+FastAPI/Starlette implementation of api-schemas/gateway.openapi.yaml:
+
+- ``GET /health`` + ``GET /healthz`` — credential-free probes (OpenAPI security: [])
+- ``GET /v1/models`` — enabled models from the routing policy (scope ``models``)
+- ``POST /v1/chat/completions`` — OpenAI-compatible completions (scope ``chat``);
+  ``stream: true`` relays Server-Sent Events with ``event:``/``data:`` framing
+  (docs/MCP_CONNECT.md §3) and the ``data: [DONE]`` terminal sentinel
+- Sliding-window rate limiting → standardized JSON error contract on
+  429/503 with ``X-RateLimit-*`` + ``Retry-After`` headers (AC2)
+- Provider failover via gateway/provider_chain.py — exhaustion → 502 with a
+  REDACTED transition ledger (zero silent fallback, provider names visible,
+  keys NEVER — OpenAPI §ChatCompletionResponse model description)
+
+Wire honesty: usage is echoed only when the provider reported it; ``model``
+names the endpoint that ACTUALLY served the request.
+
+App factory (``create_app``) keeps every dependency injectable — the pytest
+suite drives it fully offline via fastapi.testclient.
+"""
+from __future__ import annotations
+
+import json
+import time
+import uuid
+from collections.abc import AsyncIterator
+from typing import Any
+
+from fastapi import FastAPI, Request, Response
+from fastapi.responses import JSONResponse, StreamingResponse
+
+from .config import GatewayConfig
+from .provider_chain import (
+    AttemptFn,
+    AttemptResult,
+    ProviderChainExhausted,
+    execute_chain,
+)
+from .rate_limit import SlidingWindowLimiter
+
+GATEWAY_VERSION = "1.0.0"
+
+# --- standardized JSON error contract (AC2) --------------------------------
+
+
+def error_response(
+    status: int,
+    *,
+    err_type: str,
+    code: str,
+    message: str,
+    param: str | None = None,
+    headers: dict[str, str] | None = None,
+    extra: dict[str, Any] | None = None,
+) -> JSONResponse:
+    payload: dict[str, Any] = {
+        "error": {"message": message, "type": err_type, "param": param, "code": code}
+    }
+    if extra:
+        payload.update(extra)
+    return JSONResponse(status_code=status, content=payload, headers=headers or {})
+
+
+def _redact_ledger(ledger: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    """Keep provider/model/outcome/status; drop anything key-shaped."""
+    safe = {"index", "provider", "model", "outcome", "status", "latency_ms", "detail"}
+    return [{k: v for k, v in entry.items() if k in safe} for entry in ledger]
+
+
+# --- auth -------------------------------------------------------------------
+
+
+def authenticate(request: Request, config: GatewayConfig) -> JSONResponse | None:
+    """X-SupremeAI-Key → 401 (missing/unknown) or 403 (scope) — default-deny."""
+    key = request.headers.get("x-supremeai-key")
+    if not key:
+        return error_response(
+            401, err_type="authentication_error", code="missing_api_key",
+            message="Missing X-SupremeAI-Key header. One SUPREMEAI_API_KEY, provider-agnostic responses.",
+        )
+    record = config.api_keys.get(key)
+    if record is None:
+        return error_response(
+            401, err_type="authentication_error", code="invalid_api_key",
+            message="Unknown SUPREMEAI_API_KEY — credential invalid or revoked.",
+        )
+    request.state.key_record = record
+    return None
+
+
+def require_scope(request: Request, scope: str) -> JSONResponse | None:
+    record = getattr(request.state, "key_record", None)
+    if record is None or scope not in record.scopes:
+        return error_response(
+            403, err_type="permission_error", code="insufficient_scope",
+            message=f"Key lacks required scope '{scope}'.",
+        )
+    return None
+
+
+# --- rate limiting (AC2) ----------------------------------------------------
+
+
+def rate_limit_headers(response: "Response", limiter: SlidingWindowLimiter,
+                       decision) -> None:
+    response.headers["X-RateLimit-Limit"] = str(limiter.max_requests)
+    response.headers["X-RateLimit-Remaining"] = str(decision.remaining)
+    response.headers["X-RateLimit-Reset"] = str(decision.reset_epoch)
+
+
+async def check_rate_limit(
+    request: Request, limiter: SlidingWindowLimiter
+):
+    """Per-key sliding window (IP fallback); returns the full decision."""
+    key_id = request.headers.get("x-supremeai-key") or (
+        request.client.host if request.client else "anonymous"
+    )
+    return await limiter.check(key_id)
+
+
+def build_429(limiter: SlidingWindowLimiter, decision) -> JSONResponse:
+    """Standardized JSON error contract for a rejected request (AC2)."""
+    return error_response(
+        429, err_type="rate_limit_error", code="rate_limit_exceeded",
+        message=(
+            f"Rate limit exceeded: {limiter.max_requests} requests per "
+            f"{limiter.window_s}s window. Honor Retry-After; never hot-loop."
+        ),
+        headers={
+            "Retry-After": str(decision.retry_after_s or 1),
+            "X-RateLimit-Limit": str(limiter.max_requests),
+            "X-RateLimit-Remaining": "0",
+            "X-RateLimit-Reset": str(decision.reset_epoch),
+        },
+    )
+
+
+# --- SSE framing (AC1) ------------------------------------------------------
+
+SSE_CHUNK_EVENT = "chat.completion.chunk"
+SSE_ERROR_EVENT = "error"
+SSE_DONE_EVENT = "done"
+
+
+def sse_frame(event: str, data: str) -> str:
+    """One SSE frame per docs/MCP_CONNECT.md §3 (event:/data: lines, blank-line terminator)."""
+    return f"event: {event}\ndata: {data}\n\n"
+
+
+def openai_chunk(completion_id: str, created: int, model: str,
+                 delta: dict[str, Any] | None, finish_reason: str | None) -> str:
+    return json.dumps({
+        "id": completion_id,
+        "object": "chat.completion.chunk",
+        "created": created,
+        "model": model,
+        "choices": [{"index": 0, "delta": delta or {}, "finish_reason": finish_reason}],
+    })
+
+
+async def relay_stream(
+    chain,
+    payload: bytes,
+    completion_id: str,
+    stream_fn,
+) -> AsyncIterator[str]:
+    """Relay provider deltas as SSE; fail over ONLY before the first chunk.
+
+    Once chunks flow, a provider failure becomes an honest ``event: error``
+    frame (restarting mid-stream would duplicate output — silent-fabrication
+    is banned). Terminal frames are ``event: done`` + ``data: [DONE]``.
+    """
+    created = int(time.time())
+    served_by: str | None = None
+    for endpoint in chain:
+        opened = False
+        try:
+            async for event in stream_fn(endpoint, payload):
+                if event["type"] == "chunk":
+                    if not opened:
+                        opened = True
+                        served_by = f"{endpoint.provider}/{endpoint.model}"
+                    yield sse_frame(
+                        SSE_CHUNK_EVENT,
+                        openai_chunk(completion_id, created, served_by,
+                                     event.get("delta"), event.get("finish_reason")),
+                    )
+                elif event["type"] == "error":
+                    if not opened:
+                        # pre-first-chunk provider failure → failover, no wire noise
+                        break
+                    yield sse_frame(SSE_ERROR_EVENT, json.dumps({
+                        "error": {
+                            "message": str(event.get("message", "provider stream failed")),
+                            "type": "api_error",
+                            "param": None,
+                            "code": "provider_stream_error",
+                            "served_by": served_by,
+                        }
+                    }))
+                    return
+            if opened:
+                # clean provider EOF → terminal
+                yield sse_frame(SSE_DONE_EVENT, "[DONE]")
+                return
+            continue  # provider failed before any chunk → next endpoint
+        except Exception as exc:
+            if not opened:
+                continue  # pre-first-chunk failure → failover to next endpoint
+            yield sse_frame(SSE_ERROR_EVENT, json.dumps({
+                "error": {
+                    "message": f"provider stream interrupted: {exc}"[:300],
+                    "type": "api_error",
+                    "param": None,
+                    "code": "provider_stream_interrupted",
+                    "served_by": served_by,
+                }
+            }))
+            return
+    # exhausted before any chunk
+    yield sse_frame(SSE_ERROR_EVENT, json.dumps({
+        "error": {
+            "message": "all providers in the chain failed before streaming began",
+            "type": "api_error",
+            "param": None,
+            "code": "chain_exhausted",
+        }
+    }))
+    yield sse_frame(SSE_DONE_EVENT, "[DONE]")
+
+
+def parse_completion_response(result: AttemptResult) -> dict[str, Any]:
+    """Parse a provider completion body honestly (no fabricated usage)."""
+    try:
+        body = json.loads(result.body)
+    except (json.JSONDecodeError, UnicodeDecodeError):
+        raise ValueError("provider returned a non-JSON completion body") from None
+    choices = body.get("choices") or []
+    if not choices:
+        raise ValueError("provider completion body has no choices")
+    return body
+
+
+# --- app factory ------------------------------------------------------------
+
+
+def create_app(
+    config: GatewayConfig,
+    *,
+    limiter: SlidingWindowLimiter | None = None,
+    attempt_fn: AttemptFn | None = None,
+    stream_fn=None,
+) -> FastAPI:
+    """Build the gateway. Every collaborator is injectable for offline tests."""
+    limiter = limiter or SlidingWindowLimiter(
+        config.rate_limit_window_s, config.rate_limit_max_requests
+    )
+    app = FastAPI(title="SupremeAI API", version=GATEWAY_VERSION, docs_url=None, redoc_url=None)
+
+    # ---- health (no auth, OpenAPI security: []) ----
+    @app.get("/health")
+    @app.get("/healthz")
+    async def health() -> dict[str, Any]:
+        return {
+            "status": "ok",
+            "service": "supremeai-gateway",
+            "version": GATEWAY_VERSION,
+            "chains": sorted(config.chains),
+        }
+
+    # ---- /v1/models ----
+    @app.get("/v1/models")
+    async def list_models(request: Request) -> Response:
+        if (err := authenticate(request, config)) is not None:
+            return err
+        if (err := await gate(request, "models")) is not None:
+            return err
+        seen: dict[str, dict[str, str]] = {}
+        for chain in config.chains.values():
+            for endpoint in chain:
+                seen.setdefault(endpoint.model, {
+                    "id": endpoint.model,
+                    "object": "model",
+                    "owned_by": "supremeai",
+                })
+        return attach_rate_headers(request, JSONResponse(
+            {"object": "list", "data": sorted(seen.values(), key=lambda m: m["id"])}))
+
+    def attach_rate_headers(request: Request, response: Response) -> Response:
+        """Success responses carry the standardized X-RateLimit-* contract."""
+        decision = getattr(request.state, "rate_decision", None)
+        if decision is not None:
+            response.headers["X-RateLimit-Limit"] = str(limiter.max_requests)
+            response.headers["X-RateLimit-Remaining"] = str(decision.remaining)
+            response.headers["X-RateLimit-Reset"] = str(decision.reset_epoch)
+        return response
+
+    async def gate(request: Request, scope: str) -> JSONResponse | None:
+        """Shared per-request gate: rate limit first-class, scope pinned."""
+        decision = await check_rate_limit(request, limiter)
+        if not decision.allowed:
+            return build_429(limiter, decision)
+        request.state.rate_decision = decision  # per-request, no shared-state race
+        return require_scope(request, scope)
+
+    # ---- /v1/chat/completions ----
+    @app.post("/v1/chat/completions")
+    async def chat_completions(request: Request) -> Response:
+        if (err := authenticate(request, config)) is not None:
+            return err
+        if (err := await gate(request, "chat")) is not None:
+            return err
+
+        try:
+            body = await request.json()
+        except Exception:
+            return error_response(
+                400, err_type="invalid_request_error", code="malformed_json",
+                message="Request body is not valid JSON.",
+            )
+        messages = body.get("messages") if isinstance(body, dict) else None
+        if not isinstance(messages, list) or not messages:
+            return error_response(
+                400, err_type="invalid_request_error", code="missing_messages",
+                message="'messages' must be a non-empty array (OpenAPI ChatCompletionRequest).",
+            )
+        model = body.get("model", "auto")
+        wants_stream = bool(body.get("stream", False))
+
+        try:
+            chain = config.chain_for(model if isinstance(model, str) else "auto")
+        except Exception:
+            return error_response(
+                400, err_type="invalid_request_error", code="unknown_model",
+                message=f"No routing chain configured for model '{model}'.",
+            )
+
+        payload = json.dumps({"messages": messages, "stream": wants_stream}).encode()
+        completion_id = f"chatcmpl-{uuid.uuid4().hex[:24]}"
+
+        if wants_stream:
+            if stream_fn is None:
+                # Default stdlib transport relays the non-stream completion as
+                # a single chunk — honest, no fabricated deltas.
+                async def default_stream(endpoint, pl):
+                    res = await (attempt_fn or _noop_attempt)(endpoint, pl)
+                    if res.status >= 400:
+                        yield {"type": "error", "status": res.status,
+                               "message": f"provider HTTP {res.status}"}
+                        return
+                    try:
+                        parsed = parse_completion_response(res)
+                    except ValueError as exc:
+                        yield {"type": "error", "status": res.status, "message": str(exc)}
+                        return
+                    content = (parsed["choices"][0].get("message") or {}).get("content", "")
+                    yield {"type": "chunk", "delta": {"role": "assistant", "content": content},
+                           "finish_reason": None}
+                    yield {"type": "chunk", "delta": {}, "finish_reason": "stop"}
+                relay = default_stream
+            else:
+                relay = stream_fn
+            return StreamingResponse(
+                relay_stream(chain, payload, completion_id, relay),
+                media_type="text/event-stream",
+                headers={"Cache-Control": "no-cache", "Connection": "keep-alive",
+                         "X-Accel-Buffering": "no"},
+            )
+
+        result = await execute_chain(chain, payload, attempt_fn=attempt_fn)
+        served_model = f"{result.endpoint.provider}/{result.endpoint.model}"
+        try:
+            parsed = parse_completion_response(result)
+        except ValueError as exc:
+            return error_response(
+                502, err_type="api_error", code="provider_malformed_response",
+                message=str(exc),
+            )
+        usage = parsed.get("usage")  # honesty: echo ONLY if provider reported it
+        out: dict[str, Any] = {
+            "id": completion_id,
+            "object": "chat.completion",
+            "created": int(time.time()),
+            "model": served_model,
+            "choices": parsed["choices"],
+        }
+        if usage is not None:
+            out["usage"] = usage
+        return attach_rate_headers(request, JSONResponse(out))
+
+    # ---- provider exhaustion → 502 with redacted ledger ----
+    @app.exception_handler(ProviderChainExhausted)
+    async def chain_exhausted_handler(request: Request, exc: ProviderChainExhausted):
+        return error_response(
+            502, err_type="api_error", code="provider_chain_exhausted",
+            message=str(exc),
+            extra={"providers_tried": _redact_ledger(exc.ledger)},
+        )
+
+    return app
+
+
+async def _noop_attempt(endpoint, payload) -> AttemptResult:  # pragma: no cover
+    raise RuntimeError("no provider transport configured")
diff --git a/gateway/provider_chain.py b/gateway/provider_chain.py
new file mode 100644
index 00000000..8ca03fc1
--- /dev/null
+++ b/gateway/provider_chain.py
@@ -0,0 +1,180 @@
+"""SupremeAI Gateway — provider failover with an honest transition ledger (issue #336).
+
+Walks a config-ordered provider chain; every attempt is LEDGERED, and
+exhaustion raises :class:`ProviderChainExhausted` carrying the FULL ledger —
+zero silent fallback (doctrine shared with core/routing dynamic router, WO
+#349). Transport is injected (``attempt_fn``) so tests and the SSE layer run
+deterministically offline; the default transport is stdlib asyncio HTTP (same
+honest core as sdk/python — no third-party client dependency).
+"""
+from __future__ import annotations
+
+import asyncio
+import json
+import ssl
+import time
+from dataclasses import dataclass, field
+from typing import Any, Awaitable, Callable
+
+from .config import Endpoint
+
+# Provider outcomes that justify failing over to the next endpoint.
+FAILOVER_STATUS = frozenset({429, 500, 502, 503, 504})
+
+
+class ProviderChainExhausted(RuntimeError):
+    """Every endpoint in the chain failed — 502 upstream, ledger attached."""
+
+    def __init__(self, message: str, ledger: list[dict[str, Any]]):
+        super().__init__(message)
+        self.ledger = ledger
+
+
+@dataclass(frozen=True, slots=True)
+class AttemptResult:
+    """Outcome of one provider round-trip (success or honest failure)."""
+
+    endpoint: Endpoint
+    status: int
+    headers: dict[str, str]
+    body: bytes
+    latency_ms: int
+
+    @property
+    def retry_after_s(self) -> float | None:
+        ra = self.headers.get("retry-after")
+        if ra is None:
+            return None
+        try:
+            return float(ra)
+        except ValueError:
+            return None
+
+
+AttemptFn = Callable[[Endpoint, bytes], Awaitable[AttemptResult]]
+
+
+async def _default_attempt(endpoint: Endpoint, payload: bytes) -> AttemptResult:
+    """One honest HTTP/1.1 round-trip over stdlib asyncio streams.
+
+    Provider credentials are injected by the operator via
+    ``SUPREMEAI_PROVIDER_KEY_<PROVIDER>`` env vars — never logged, never in
+    URLs (MCP_CONNECT §5 etiquette applies provider-side too).
+    """
+    import os
+
+    api_base = os.environ.get(f"SUPREMEAI_PROVIDER_BASE_{endpoint.provider.upper()}")
+    api_key = os.environ.get(f"SUPREMEAI_PROVIDER_KEY_{endpoint.provider.upper()}")
+    if not api_base or not api_key:
+        raise RuntimeError(
+            f"provider {endpoint.provider} not configured (set SUPREMEAI_PROVIDER_BASE_/KEY_)"
+        )
+
+    url = api_base.rstrip("/") + "/v1/chat/completions"
+    rest = url.split("://", 1)[1]
+    host_port, _, path = rest.partition("/")
+    host, _, port_s = host_port.partition(":")
+    secure = url.startswith("https")
+    port = int(port_s) if port_s else (443 if secure else 80)
+    started = time.monotonic()
+    if secure:
+        opener = asyncio.open_connection(host, port, ssl=ssl.create_default_context())
+    else:
+        opener = asyncio.open_connection(host, port)
+    reader, writer = await asyncio.wait_for(opener, timeout=30.0)
+    try:
+        body = json.dumps({
+            "model": endpoint.model,
+            "messages": json.loads(payload).get("messages", []),
+            "stream": False,
+        }).encode()
+        head = (
+            f"POST /{path} HTTP/1.1\r\n"
+            f"Host: {host_port}\r\n"
+            "Content-Type: application/json\r\n"
+            f"Authorization: Bearer {api_key}\r\n"
+            f"Content-Length: {len(body)}\r\n"
+            "Connection: close\r\n\r\n"
+        )
+        writer.write(head.encode("latin-1") + body)
+        await writer.drain()
+        status_line = (await reader.readline()).decode("latin-1")
+        status = int(status_line.split(" ")[1]) if len(status_line.split(" ")) > 1 else 0
+        headers: dict[str, str] = {}
+        while True:
+            line = (await reader.readline()).decode("latin-1")
+            if line in ("\r\n", "\n", ""):
+                break
+            k, _, v = line.partition(":")
+            headers[k.strip().lower()] = v.strip()
+        resp_body = b""
+        if "content-length" in headers:
+            resp_body = await reader.readexactly(int(headers["content-length"]))
+        return AttemptResult(
+            endpoint=endpoint,
+            status=status,
+            headers=headers,
+            body=resp_body,
+            latency_ms=int((time.monotonic() - started) * 1000),
+        )
+    finally:
+        writer.close()
+        try:
+            await writer.wait_closed()
+        except Exception:
+            pass
+
+
+@dataclass(slots=True)
+class ChainLedger:
+    """Every transition is recorded; exhaustion carries the full ledger."""
+
+    entries: list[dict[str, Any]] = field(default_factory=list)
+
+    def record(self, **entry: Any) -> None:
+        self.entries.append(entry)
+
+
+async def execute_chain(
+    chain: tuple[Endpoint, ...],
+    payload: bytes,
+    *,
+    attempt_fn: AttemptFn | None = None,
+) -> AttemptResult:
+    """Try endpoints in order; fail over ONLY on retryable outcomes.
+
+    - 2xx → success, ledger records the win.
+    - 429/5xx from a provider → ledger + next endpoint (failover semantics).
+    - 401/403 from a provider → that endpoint is misconfigured; ledger +
+      failover (a different provider may be configured correctly).
+    - Exhaustion → ProviderChainExhausted with the FULL ledger (→ 502).
+    """
+    attempt = attempt_fn or _default_attempt
+    ledger = ChainLedger()
+    last: AttemptResult | None = None
+    for idx, endpoint in enumerate(chain):
+        try:
+            result = await attempt(endpoint, payload)
+        except Exception as exc:  # transport-level failure — honest ledger entry
+            ledger.record(
+                index=idx, provider=endpoint.provider, model=endpoint.model,
+                outcome="transport_error", detail=str(exc)[:200],
+            )
+            last = None
+            continue
+        ledger.record(
+            index=idx, provider=endpoint.provider, model=endpoint.model,
+            outcome="success" if result.status < 400 else "provider_error",
+            status=result.status, latency_ms=result.latency_ms,
+        )
+        if result.status < 400:
+            return result
+        last = result
+        if result.status not in FAILOVER_STATUS and result.status not in (401, 403):
+            # Non-retryable, non-auth provider error (e.g. 400 bad request
+            # shaped by the gateway itself): honest 4xx passthrough.
+            return result
+    raise ProviderChainExhausted(
+        "all providers in the chain failed — 502 upstream (zero silent fallback)",
+        ledger=ledger.entries,
+    )
