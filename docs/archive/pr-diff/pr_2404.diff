--- /dev/null
+++ b/infrastructure/mcp-control-plane/test_health_watchdog.ts
@@ -0,0 +1,190 @@
+/**
+ * #2665 watchdog increment guard — deploy-independent pin for the monitoring-lane
+ * remedies (#2710; #2673 remedy pt.2; follows the #2681 hollow-guard precedent).
+ *
+ * What it asserts:
+ *   1. COMPLETION STAMPING — HealthCache exposes markSweepCompleted() telemetry
+ *      (lastCompletedSweepMs + sweepCompletions) and HealthEngine.runFullSweep
+ *      stamps it on the SUCCESS path, after the durable history append.
+ *   2. /health STALENESS TELEMETRY — the /health response carries additive
+ *      lastCompletedSweepAt / sweepCompletions / stale keys (both the main and
+ *      the cold-start fallback branches), so consumers can distinguish
+ *      "all-clear" from "no data / data too old".
+ *   3. SWEEP-GAP ALARM (anti-false-clear) — a 60s watchdog interval alarms on
+ *      the RISING EDGE only (>10min without any completion, past boot grace)
+ *      and RE-ARMS when a fresh completion lands: a one-off manual sweep buys
+ *      exactly one silence window, never a permanent all-clear.
+ *   4. SEMANTIC TRUTH TABLE — deriveWatchdog() is imported and pinned as pure
+ *      data: null-completion / grace / fresh / boundary (exactly 10min is still
+ *      fresh — strictly-greater comparison) / stale-rearm.
+ *
+ * Static source scans follow the test_annotations_floor.ts /
+ * test_health_hollow_guard.ts precedent (deploy-independent; live-plane
+ * behavior is separately witnessed by hourly curl readings, e.g. #2665's
+ * evidence series and the cycle-42/43/44 receipts).
+ *
+ * Run: tsx test_health_watchdog.ts  (wired as `test:health-watchdog` in test:unit)
+ */
+import { readFileSync } from "node:fs";
+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+import { deriveWatchdog, SWEEP_STALE_AFTER_MS, WATCHDOG_BOOT_GRACE_MS } from "./src/health/watchdog.js";
+
+const ROOT = dirname(fileURLToPath(import.meta.url));
+const SERVER_SRC = join(ROOT, "src", "http_server.ts");
+const CACHE_SRC = join(ROOT, "src", "health", "snapshot.ts");
+const ENGINE_SRC = join(ROOT, "src", "health", "engine.ts");
+
+let failed = false;
+function check(name: string, ok: boolean, detail = "") {
+  if (ok) {
+    console.log(`[health-watchdog] ok — ${name}`);
+  } else {
+    failed = true;
+    console.error(`[health-watchdog] FAIL — ${name}${detail ? ` (${detail})` : ""}`);
+  }
+}
+
+/** Strip line comments and block comments so prose inside explanatory comments
+ *  can never satisfy or defeat a code-shape assertion (#2681 precedent). */
+function stripComments(s: string): string {
+  let out = "";
+  let i = 0;
+  while (i < s.length) {
+    if (s.startsWith("//", i)) {
+      while (i < s.length && s[i] !== "\n") i++;
+    } else if (s.startsWith("/*", i)) {
+      const close = s.indexOf("*/", i + 2);
+      i = close === -1 ? s.length : close + 2;
+    } else if (s.startsWith('"', i) || s.startsWith("'", i) || s.startsWith("`", i)) {
+      const q = s[i];
+      out += s[i++];
+      while (i < s.length && s[i] !== q) {
+        if (s[i] === "\\") out += s[i++];
+        out += s[i++] ?? "";
+      }
+      if (i < s.length) out += s[i++];
+    } else {
+      out += s[i++];
+    }
+  }
+  return out;
+}
+
+// ── 1. Completion stamping (snapshot.ts + engine.ts) ──────────────────────────
+const cacheSrc = stripComments(readFileSync(CACHE_SRC, "utf8"));
+check(
+  "HealthCache.markSweepCompleted stamps lastCompletedSweepMs",
+  /markSweepCompleted\([\s\S]{0,60}?\)\s*\{[\s\S]{0,200}?this\.lastCompletedSweepMs\s*=\s*atMs/.test(cacheSrc),
+);
+check(
+  "markSweepCompleted increments sweepCompletions",
+  /this\.sweepCompletions\s*\+=\s*1/.test(cacheSrc),
+);
+check(
+  "HealthCache exposes getLastCompletedSweepMs + getSweepCompletions",
+  cacheSrc.includes("getLastCompletedSweepMs(): number | null") && cacheSrc.includes("getSweepCompletions(): number"),
+);
+
+const engineSrc = stripComments(readFileSync(ENGINE_SRC, "utf8"));
+const stampIdx = engineSrc.indexOf("globalHealthCache.markSweepCompleted()");
+const histIdx = engineSrc.indexOf('provider: "__sweep__"');
+check(
+  "engine.runFullSweep stamps completion on the success path",
+  stampIdx !== -1,
+  "markSweepCompleted() call missing from engine.ts",
+);
+check(
+  "stamping happens AFTER the durable history append (telemetry never outruns persistence)",
+  stampIdx !== -1 && histIdx !== -1 && stampIdx > histIdx,
+);
+
+// ── 2. /health staleness telemetry (http_server.ts) ───────────────────────────
+const rawServer = readFileSync(SERVER_SRC, "utf8");
+const serverSrc = stripComments(rawServer);
+const hStart = rawServer.indexOf('url === "/health"');
+if (hStart === -1) {
+  check("/health handler present in src/http_server.ts", false, "route anchor not found");
+} else {
+  const hEnd = rawServer.indexOf("return;", hStart);
+  const region = stripComments(rawServer.slice(hStart, hEnd === -1 ? rawServer.length : hEnd));
+  check(
+    "/health response carries lastCompletedSweepAt",
+    region.includes("lastCompletedSweepAt:"),
+  );
+  check(
+    "/health response carries sweepCompletions",
+    region.includes("sweepCompletions:"),
+  );
+  check(
+    "/health response carries stale flag",
+    region.includes("stale:"),
+  );
+  const catchIdx = region.indexOf("} catch {");
+  const catchTail = catchIdx === -1 ? "" : region.slice(catchIdx);
+  check(
+    "cold-start fallback also reports stale:true + null telemetry",
+    catchTail.includes("stale: true") && catchTail.includes("lastCompletedSweepAt: null"),
+    "an unreadable cache is not all-clear evidence",
+  );
+}
+
+// ── 3. Sweep-gap alarm with rising edge + re-arm (anti-false-clear) ──────────
+const timerIdx = serverSrc.indexOf("healthWatchdogTimer");
+check(
+  "watchdog interval exists in http_server.ts",
+  timerIdx !== -1 && /const\s+healthWatchdogTimer\s*=\s*setInterval/.test(serverSrc),
+);
+const timerAnchor = serverSrc.indexOf("healthWatchdogTimer = setInterval");
+check(
+  "watchdog interval cadence is 60s",
+  timerAnchor !== -1 && /\},\s*60_000\)/.test(serverSrc.slice(timerAnchor, timerAnchor + 2500)),
+);
+check(
+  "rising-edge alarm: alarmDue && !healthWatchdogAlarmActive",
+  /view\.alarmDue\s*&&\s*!healthWatchdogAlarmActive/.test(serverSrc),
+);
+check(
+  "re-arm branch: fresh completion clears the alarm latch",
+  /!\s*view\.stale\s*\)?\s*\{[\s\S]{0,200}?healthWatchdogAlarmActive\s*=\s*false/.test(serverSrc),
+);
+const watchdogModuleSrc = stripComments(readFileSync(join(ROOT, "src", "health", "watchdog.ts"), "utf8"));
+check(
+  "alarm mirrors into durable history (__watchdog__ rows)",
+  /recordWatchdogAlarm\(/.test(serverSrc) && /__watchdog__/.test(watchdogModuleSrc),
+);
+check(
+  "watchdog timer is unref'd (Render spin-down must stay possible)",
+  /healthWatchdogTimer\.unref/.test(serverSrc),
+);
+
+// ── 4. Semantic truth table for deriveWatchdog (imported, not re-stated) ─────
+const T0 = 1_700_000_000_000;
+const MIN = 60_000;
+check("constants: SWEEP_STALE_AFTER_MS = 600_000 (10min)", SWEEP_STALE_AFTER_MS === 600_000);
+check("constants: WATCHDOG_BOOT_GRACE_MS = 600_000 (10min)", WATCHDOG_BOOT_GRACE_MS === 600_000);
+
+// never swept, inside boot grace -> stale, but alarm held back
+const a = deriveWatchdog(T0 + 1 * MIN, T0, null, 0);
+check("truth: never-swept within grace -> stale=true alarmDue=false", a.stale === true && a.alarmDue === false);
+// never swept, past grace -> alarm
+const b = deriveWatchdog(T0 + 11 * MIN, T0, null, 0);
+check("truth: never-swept past grace -> stale=true alarmDue=true", b.stale === true && b.alarmDue === true);
+// fresh completion 3min ago (e.g. one-off manual sweep) -> all-clear window
+const c = deriveWatchdog(T0 + 20 * MIN, T0, T0 + 17 * MIN, 1);
+check("truth: 3min-old completion -> stale=false alarmDue=false", c.stale === false && c.alarmDue === false);
+// boundary: EXACTLY 10min old is still fresh (strictly-greater comparison)
+const d = deriveWatchdog(T0 + 30 * MIN, T0, T0 + 20 * MIN, 2);
+check("truth: exactly-at-edge completion -> still fresh (strictly-greater)", d.stale === false);
+// 10.5min old -> stale again (manual window expired; alarm re-arms)
+const e = deriveWatchdog(T0 + 30 * MIN + 30_000, T0, T0 + 20 * MIN, 2);
+check("truth: past-edge completion -> stale=true alarmDue=true (re-arm)", e.stale === true && e.alarmDue === true);
+// ISO shaping
+check("truth: lastCompletedSweepAt is ISO or null", c.lastCompletedSweepAt !== null && !Number.isNaN(Date.parse(c.lastCompletedSweepAt as string)) && a.lastCompletedSweepAt === null);
+check("truth: bootedAt is ISO", !Number.isNaN(Date.parse(a.bootedAt)));
+check("truth: sweepCompletions passes through", c.sweepCompletions === 1 && e.sweepCompletions === 2);
+
+if (failed) {
+  process.exit(1);
+}
+console.log("[health-watchdog] PASS — sweep-completion telemetry + rising-edge gap alarm + anti-false-clear re-arm pinned (#2710)");
diff --git a/infrastructure/mcp-control-plane/test_marketplace_plugins.ts b/infrastructure/mcp-control-plane/test_marketplace_plugins.ts
new file mode 100644
index 000000000..8417d6d6d
--- /dev/null
+++ b/infrastructure/mcp-control-plane/test_marketplace_plugins.ts
@@ -0,0 +1,106 @@
+import assert from "node:assert/strict";
+import {
+  MARKETPLACE_PLUGINS,
+  clearMarketplaceConnections,
+  connectPlugin,
+  getMarketplacePlugin,
+  listMarketplaceConnections,
+  looksLikePlaintextSecret,
+} from "./src/registry/marketplace-plugins.js";
+import { clearRemoteServerRegistry, getRemoteServer } from "./src/registry/remote-mcp-servers.js";
+
+// ── #1523 Marketplace MVP — plugin catalog + zero-risk BYO connect ─────────
+
+clearRemoteServerRegistry();
+clearMarketplaceConnections();
+
+// 1. Catalog integrity: Phase-1 seed (5 providers), templates only.
+assert.equal(MARKETPLACE_PLUGINS.length, 5);
+const ids = MARKETPLACE_PLUGINS.map((p) => p.pluginId);
+assert.deepEqual(ids, ["github", "telegram", "web-search", "google-drive", "notion"]);
+for (const plugin of MARKETPLACE_PLUGINS) {
+  assert.equal(plugin.trustLevel, "untrusted", "every catalog entry lands untrusted");
+  assert.ok(plugin.description.length > 20, `${plugin.pluginId} needs a real description`);
+  for (const field of plugin.credentialFields) {
+    assert.equal(field.secret, true, "marketplace credential fields are always secret-class");
+    assert.equal(field.required, true, "phase-1 credential fields are required");
+    assert.ok(!looksLikePlaintextSecret(field.label), "labels must never look like live tokens");
+  }
+}
+// Hosted templates only where the vendor publishes an official endpoint.
+assert.equal(getMarketplacePlugin("github")?.endpointTemplate, "https://api.githubcopilot.com/mcp/");
+assert.equal(getMarketplacePlugin("notion")?.endpointTemplate, "https://mcp.notion.com/mcp");
+assert.equal(getMarketplacePlugin("telegram")?.endpointTemplate, null);
+assert.equal(getMarketplacePlugin("web-search")?.endpointTemplate, null);
+assert.equal(getMarketplacePlugin("google-drive")?.endpointTemplate, null);
+
+// 2. Plaintext-secret detector (defense in depth at the connect guard).
+assert.equal(looksLikePlaintextSecret("vault:github-token"), false);
+assert.equal(looksLikePlaintextSecret("ghp_abc123def"), true); // gitleaks:allow — detector fixture, not a real token
+assert.equal(looksLikePlaintextSecret("ghs_abc123def"), true); // gitleaks:allow — detector fixture
+assert.equal(looksLikePlaintextSecret("sk-proj-abcdef"), true);
+assert.equal(looksLikePlaintextSecret("xoxb-123-456"), true);
+
+// 3. Happy path: connect delegates to the SAME federation registry.
+const gh = connectPlugin({
+  pluginId: "github",
+  tenantId: "tenant-a",
+  credentialVaultRef: "vault:github-token",
+});
+assert.ok(gh.ok, "github connect should succeed");
+if (gh.ok) {
+  assert.equal(gh.connection.pluginId, "github");
+  assert.equal(gh.connection.tenantId, "tenant-a");
+  assert.equal(gh.connection.credentialVaultRef, "vault:github-token");
+  assert.equal(gh.connection.endpointUsed, "https://api.githubcopilot.com/mcp/");
+  assert.equal(gh.connection.status, "pending", "connections start pending, never active");
+  assert.ok(gh.nextStep.includes("client.discover_mcp_server"), "next step routes to descriptor pinning");
+  // The backing remote server IS the federation registry's record.
+  const remote = getRemoteServer(gh.connection.remoteServerId, "tenant-a");
+  assert.ok(remote, "connection must resolve through the governed registry");
+  assert.equal(remote?.name, "marketplace:github");
+  assert.equal(remote?.status, "pending");
+  assert.equal(remote?.trustLevel, "untrusted");
+  assert.equal(getRemoteServer(gh.connection.remoteServerId, "tenant-other"), undefined, "tenant-scoped reads");
+}
+
+// 4. Zero-plaintext guard: live-token-shaped refs are rejected outright.
+const plaintext = connectPlugin({ pluginId: "github", tenantId: "tenant-b", credentialVaultRef: "ghp_AbCdEf123456" }); // gitleaks:allow — detector fixture
+assert.deepEqual(plaintext, { ok: false, error: "credentialVaultRef looks like a live token value — store it in a vault and pass the reference instead." });
+const notVault = connectPlugin({ pluginId: "github", tenantId: "tenant-b", credentialVaultRef: "my-raw-token" });
+assert.ok(!notVault.ok && notVault.error.includes("vault reference"), "non-vault refs are rejected");
+const missing = connectPlugin({ pluginId: "github", tenantId: "tenant-b", credentialVaultRef: "" });
+assert.ok(!missing.ok && missing.error.includes("Missing credential field"), "missing ref is rejected");
+
+// 5. Self-hosted plugins require an explicit endpoint (zero default trust).
+const tgNoEndpoint = connectPlugin({ pluginId: "telegram", tenantId: "tenant-a", credentialVaultRef: "vault:bot-token" });
+assert.ok(!tgNoEndpoint.ok && tgNoEndpoint.error.includes("endpoint is required"), "template-less plugins demand an endpoint");
+const tg = connectPlugin({ pluginId: "telegram", tenantId: "tenant-a", credentialVaultRef: "vault:bot-token", endpoint: "https://tg-hub.example.com/mcp" });
+assert.ok(tg.ok, "telegram BYO endpoint connect succeeds");
+assert.ok(!tg.ok || tg.connection.endpointUsed === "https://tg-hub.example.com/mcp");
+const badUrl = connectPlugin({ pluginId: "telegram", tenantId: "tenant-a", credentialVaultRef: "vault:bot-token", endpoint: "not-a-url" });
+assert.ok(!badUrl.ok && badUrl.error.includes("not a valid URL"), "endpoint URL is validated");
+
+// 6. Unique per (tenant, plugin) — mirrors the SQL UNIQUE constraint.
+const dup = connectPlugin({ pluginId: "github", tenantId: "tenant-a", credentialVaultRef: "vault:github-token-2" });
+assert.ok(!dup.ok && dup.error.includes("already connected"), "duplicate connect is rejected");
+// Same plugin, different tenant: fine.
+const ghOther = connectPlugin({ pluginId: "github", tenantId: "tenant-b", credentialVaultRef: "vault:github-token" });
+assert.ok(ghOther.ok, "same plugin in another tenant is allowed");
+
+// 7. Unknown plugin fails closed.
+const unknown = connectPlugin({ pluginId: "nope", tenantId: "tenant-a", credentialVaultRef: "vault:x" });
+assert.ok(!unknown.ok && unknown.error.includes("Unknown marketplace plugin"));
+
+// 8. Ledger is tenant-scoped; "*" sees all.
+assert.equal(listMarketplaceConnections("tenant-a").length, 2);
+assert.equal(listMarketplaceConnections("tenant-b").length, 1);
+assert.equal(listMarketplaceConnections("*").length, 3);
+assert.ok(listMarketplaceConnections("tenant-a").every((c) => c.tenantId === "tenant-a"));
+
+// 9. Test hygiene: clear resets everything.
+clearMarketplaceConnections();
+clearRemoteServerRegistry();
+assert.equal(listMarketplaceConnections("*").length, 0);
+
+console.log("marketplace plugins tests passed");
diff --git a/infrastructure/mcp-control-plane/test_mcp_mutation_rate_limit.ts b/infrastructure/mcp-control-plane/test_mcp_mutation_rate_limit.ts
new file mode 100644
index 000000000..7f72a3983
--- /dev/null
+++ b/infrastructure/mcp-control-plane/test_mcp_mutation_rate_limit.ts
@@ -0,0 +1,176 @@
+/**
+ * #2363 — anonymous-mutation plane rate-limit regression battery (pure, offline).
+ * House style: tsx script, hard asserts, exit code = verdict.
+ *
+ * The audit (#2363 F-1, live-mapped 2026-10-29) proved 4 side-effect-capable
+ * tools (github_create_issue, memory_remember_fact, work_claim,
+ * bridge_submit_patch) reachable zero-credential with ZERO 429s observed
+ * across 27 dispatch cycles. The pre-existing per-(identity, tool) limit
+ * collapses every anonymous caller into the shared "default|anon" bucket —
+ * one abusive tenant exhausts it (a DoS against the other anonymous agents),
+ * and nothing bounds novel-content spam at writes/hour scale per IP.
+ *
+ * The fix: per-(caller IP, tool) HOURLY sliding window on exactly those 4
+ * mutation tools, enforced at the /mcp POST entry with 429 + Retry-After.
+ * Read plane untouched; malformed bodies fail open into the downstream
+ * RBAC/limits (availability over blocking — never silent).
+ */
+import {
+  MUTATION_TOOLS,
+  mutationRateBuckets,
+  consumeMutationRateLimit,
+  mutationToolGateError,
+  consumeSlidingWindow,
+  consumeSlidingWindowAt,
+} from "./src/lib/mcp_rate_limit.js";
+
+let failures = 0;
+function check(name: string, cond: boolean, detail?: string): void {
+  if (cond) {
+    console.log(`  ✓ ${name}`);
+  } else {
+    failures += 1;
+    console.error(`  ✗ ${name}${detail ? ` — ${detail}` : ""}`);
+  }
+}
+function section(title: string): void {
+  console.log(`\n=== ${title} ===`);
+}
+
+const HOUR = 3_600_000;
+const T0 = 1_770_000_000_000; // fixed epoch for deterministic replay
+
+function freshBuckets(): Map<string, number[]> {
+  const b = new Map<string, number[]>();
+  for (const [k, v] of mutationRateBuckets) b.set(k, [...v]);
+  mutationRateBuckets.clear();
+  return b;
+}
+
+function call(name: string): unknown {
+  return { jsonrpc: "2.0", id: 1, method: "tools/call", params: { name, arguments: {} } };
+}
+
+// ─── 1. Mutation surface declaration ────────────────────────────────────────
+section("1. MUTATION_TOOLS = exactly the 4 anonymous-reachable mutators (#2363 F-1 table)");
+check("github_create_issue declared (PROVEN side effect)", MUTATION_TOOLS.has("github_create_issue"));
+check("memory_remember_fact declared (PROVEN side effect)", MUTATION_TOOLS.has("memory_remember_fact"));
+check("work_claim declared (would-be side effect)", MUTATION_TOOLS.has("work_claim"));
+check("bridge_submit_patch declared (would-be side effect)", MUTATION_TOOLS.has("bridge_submit_patch"));
+check("exactly 4 tools — no scope creep", MUTATION_TOOLS.size === 4, `size=${MUTATION_TOOLS.size}`);
+
+// ─── 2. Sliding window mechanics (injectable clock) ─────────────────────────
+section("2. consumeSlidingWindowAt mechanics");
+{
+  const b = new Map<string, number[]>();
+  const r1 = consumeSlidingWindowAt(b, "k", 2, HOUR, T0);
+  const r2 = consumeSlidingWindowAt(b, "k", 2, HOUR, T0 + 1);
+  check("first two consumes allowed", r1.allowed && r2.allowed);
+  const r3 = consumeSlidingWindowAt(b, "k", 2, HOUR, T0 + 2);
+  check("third consume denied at max", !r3.allowed);
+  check("retryAfterMs > 0 on denial", r3.retryAfterMs > 0);
+  const r4 = consumeSlidingWindowAt(b, "k", 2, HOUR, T0 + HOUR + 1);
+  check("window slide re-allows", r4.allowed);
+  check("injectable clock equals wall-clock variant shape", (() => {
+    const w = new Map<string, number[]>();
+    consumeSlidingWindow(w, "k2", 1, 1000);
+    const probe = consumeSlidingWindowAt(w, "k2", 1, 1000, Date.now() + 5000);
+    return probe.allowed === true; // old stamp evicted by the later clock
+  })());
+}
+
+// ─── 3. Per-(IP, tool) hourly bucket ────────────────────────────────────────
+section("3. Per-(IP, tool) hourly bound");
+{
+  freshBuckets();
+  const ip = "203.0.113.7";
+  let last = { allowed: true, retryAfterMs: 0 };
+  let denies = 0;
+  for (let i = 0; i < 31; i++) {
+    last = consumeMutationRateLimit(ip, "github_create_issue", T0 + i);
+    if (!last.allowed) denies += 1;
+  }
+  check("30 writes/hour allowed", 31 - denies === 30, `allowed=${31 - denies}`);
+  check("31st write denied", denies === 1 && !last.allowed);
+  check("retryAfterMs ~ remaining window", last.retryAfterMs > 0 && last.retryAfterMs <= HOUR);
+  // slide past the window -> re-allowed
+  const later = consumeMutationRateLimit(ip, "github_create_issue", T0 + HOUR + 1);
+  check("hour slide re-allows", later.allowed);
+}
+
+// ─── 4. Isolation axes ──────────────────────────────────────────────────────
+section("4. Isolation: per-IP and per-tool");
+{
+  freshBuckets();
+  for (let i = 0; i < 30; i++) consumeMutationRateLimit("198.51.100.1", "work_claim", T0 + i);
+  check("exhausted IP still isolated from other IP", consumeMutationRateLimit("198.51.100.2", "work_claim", T0).allowed);
+  check("exhausted tool still isolated from other tool (same IP)", consumeMutationRateLimit("198.51.100.1", "memory_remember_fact", T0).allowed);
+}
+
+// ─── 5. Gate: allow path + boundary + Retry-After semantics ─────────────────
+section("5. mutationToolGateError — allow / deny / worst-reply");
+{
+  freshBuckets();
+  const ip = "192.0.2.9";
+  check("first mutation call passes", mutationToolGateError(call("github_create_issue"), ip, T0) === null);
+  for (let i = 1; i < 30; i++) mutationToolGateError(call("github_create_issue"), ip, T0 + i);
+  check("29 more calls pass (30 total)", true);
+  const denied = mutationToolGateError(call("github_create_issue"), ip, T0 + 100);
+  check("31st call denied with retryAfterMs", denied !== null && denied.retryAfterMs > 0);
+  check("denial names the tool", denied !== null && denied.tool === "github_create_issue");
+}
+
+// ─── 6. Read plane untouched ────────────────────────────────────────────────
+section("6. Read plane untouched");
+{
+  freshBuckets();
+  const ip = "192.0.2.77";
+  const readTools = ["status", "health_dashboard", "bridge_work", "github_read_file", "memory_search_nodes", "bridge_work_order"];
+  let allPass = true;
+  for (let i = 0; i < 500; i++) {
+    for (const t of readTools) {
+      if (mutationToolGateError(call(t), ip, T0 + i) !== null) allPass = false;
+    }
+  }
+  check("3000 read calls: zero denials", allPass);
+  check("non-tools/call methods pass", mutationToolGateError({ jsonrpc: "2.0", method: "tools/list", id: 2 }, ip, T0) === null);
+  check("initialize passes", mutationToolGateError({ jsonrpc: "2.0", method: "initialize", params: {} }, ip, T0) === null);
+}
+
+// ─── 7. Batch + malformed shapes (fail-open) ────────────────────────────────
+section("7. Batch arrays + fail-open on malformed bodies");
+{
+  freshBuckets();
+  const ip = "192.0.2.50";
+  check("batch [read, read] passes", mutationToolGateError([call("status"), call("bridge_work")], ip, T0) === null);
+  check("batch [read, mutation] consumes mutation bucket only", mutationToolGateError([call("status"), call("work_claim")], ip, T0) === null);
+  check("null body (no body) passes", mutationToolGateError(null, ip, T0) === null);
+  check("string body (unparseable upstream) passes", mutationToolGateError("garbage", ip, T0) === null);
+  check("malformed tools/call (params missing) passes", mutationToolGateError({ method: "tools/call" }, ip, T0) === null);
+  check("non-string tool name passes", mutationToolGateError({ method: "tools/call", params: { name: 42 } }, ip, T0) === null);
+  // exhaustive batch denial: worst (longest) retryAfterMs wins deterministically
+  for (let i = 0; i < 30; i++) consumeMutationRateLimit(ip, "bridge_submit_patch", T0);
+  const both = mutationToolGateError(
+    [call("github_create_issue"), call("bridge_submit_patch")], ip, T0,
+  );
+  check("batch denial reports a mutation tool with retryAfterMs", both !== null && both.retryAfterMs > 0);
+}
+
+// ─── 8. Openness doctrine intact ────────────────────────────────────────────
+section("8. Openness doctrine: bounded, not closed (#2082 standing doctrine)");
+{
+  freshBuckets();
+  const ip = "192.0.2.200";
+  // 30 writes/hour/tool is far above any legitimate agent cycle (audit: 40+ calls
+  // per cycle across ALL tools never hit the old 20/min shared bucket).
+  let ok = true;
+  for (let i = 0; i < 30; i++) {
+    if (!consumeMutationRateLimit(ip, "memory_remember_fact", T0 + i * 1000).allowed) ok = false;
+  }
+  check("legitimate single-agent cycle (30 writes) fully allowed", ok);
+  const beyond = consumeMutationRateLimit(ip, "memory_remember_fact", T0 + 31_000);
+  check("beyond the bound: denied with Retry-After (bounded != authenticated)", !beyond.allowed && beyond.retryAfterMs > 0);
+}
+
+console.log(`\n${failures === 0 ? "ALL CHECKS PASSED" : `${failures} CHECK(S) FAILED`}`);
+process.exit(failures === 0 ? 0 : 1);
diff --git a/infrastructure/mcp-control-plane/test_r66_target_echo.ts b/infrastructure/mcp-control-plane/test_r66_target_echo.ts
new file mode 100644
index 000000000..72342cf4e
--- /dev/null
+++ b/infrastructure/mcp-control-plane/test_r66_target_echo.ts
@@ -0,0 +1,95 @@
+/**
+ * R66 target-echo contract tests (#2447 option A): every github_* tool
+ * advertises outputSchema {targetRepo, targetUrl} and emits the resolved
+ * target in structuredContent, while the TextContent block stays byte-
+ * identical (R65 dual-emission discipline). Network-free battery:
+ *   1. describeTarget unit (parse /repos/<owner>/<repo>/, strip .git, fallback)
+ *   2. tools/list outputSchema advertisement (9 github tools; nullable pair
+ *      on the org-wide search surface)
+ *   3. error-path receipt: a context-less call stays isError text-only and
+ *      exempt from output validation
+ * Success-path structuredContent rides the same one-line helper the adapters
+ * already feed (describeTarget of the repoUrlFor value), so the unit test in
+ * (1) plus the deployed-tower observation close that half honestly.
+ */
+import assert from "node:assert/strict";
+import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
+import { InMemoryTransport } from "@modelcontextprotocol/sdk/inMemory.js";
+import { Client } from "@modelcontextprotocol/sdk/client/index.js";
+import { describeTarget, registerGitHubTools } from "./src/tools/github.tools.js";
+import { RequestContextStore } from "./src/policy/auth.context.js";
+
+// ─── 1. describeTarget unit ───────────────────────────────────────────────
+const parsed = describeTarget("https://api.github.com/repos/Supremeai-bd/supremeai");
+assert.equal(parsed.targetRepo, "Supremeai-bd/supremeai");
+assert.equal(parsed.targetUrl, "https://api.github.com/repos/Supremeai-bd/supremeai");
+const gitSuffix = describeTarget("https://api.github.com/repos/Supremeai-bd/supremeai-open.git");
+assert.equal(gitSuffix.targetRepo, "Supremeai-bd/supremeai-open");
+const query = describeTarget("https://api.github.com/repos/Supremeai-bd/x/issues?page=2");
+assert.equal(query.targetRepo, "Supremeai-bd/x");
+const fallback = describeTarget("https://api.github.com/orgs/Supremeai-bd");
+assert.equal(fallback.targetRepo, "https://api.github.com/orgs/Supremeai-bd");
+console.log("[1] describeTarget unit OK (parse, .git strip, query strip, fallback)");
+
+// ─── harness: bare McpServer + production-shape registerTool shim ─────────
+const server = new McpServer({ name: "r66-echo-test", version: "0.0.1" });
+const originalRegisterTool = (server as unknown as { registerTool: (n: string, c: unknown, cb: unknown) => unknown }).registerTool.bind(server);
+(server as unknown as { registerTool: unknown }).registerTool = (name: string, config: unknown, cb: unknown) => {
+  const sanitizedName = name.replace(/\./g, "_");
+  return originalRegisterTool(sanitizedName, config, cb);
+};
+await registerGitHubTools(server);
+
+const client = new Client({ name: "r66-echo-client", version: "0.0.1" });
+const [cT, sT] = InMemoryTransport.createLinkedPair();
+await server.connect(sT);
+await client.connect(cT);
+
+const anon = { authenticated: false } as never;
+await RequestContextStore.run(anon, async () => {
+  // ─── 2. tools/list outputSchema advertisement ───────────────────────────
+  const list = await client.listTools();
+  const tools = list.tools ?? [];
+  const github = tools.filter((t) => t.name.startsWith("github_"));
+  assert.equal(github.length, 9, `expected 9 github tools, got ${github.length}`);
+
+  type OS = { required?: string[]; properties?: Record<string, { type?: unknown }> };
+  const schemaOf = (wire: string): OS => {
+    const t = github.find((x) => x.name === wire);
+    assert.ok(t, `${wire} missing from tools/list`);
+    const os = (t as { outputSchema?: OS }).outputSchema;
+    assert.ok(os, `${wire} must advertise outputSchema (R66 option A)`);
+    return os as OS;
+  };
+
+  // Repo-targeted pair sample: required keys lock the echo from birth.
+  for (const wire of ["github_read_file", "github_list_prs", "github_workflow_runs", "github_create_issue"]) {
+    const os = schemaOf(wire);
+    for (const key of ["targetRepo", "targetUrl"]) {
+      assert.ok(os.required?.includes(key), `${wire}.outputSchema.required must include ${key}`);
+      assert.ok(os.properties?.[key], `${wire}.outputSchema.properties must include ${key}`);
+    }
+  }
