+++ b/command/dispatcher.py
@@ -0,0 +1,190 @@
+"""src/dispatcher.py — MCP Control Tower relay + minimal persistent kill-switch.
+
+dispatcher.TowerDispatcher
+- Speaks JSON-RPC 2.0 to the MCP Control Tower (`/mcp`) with explicit timeouts
+  on every call (guard doctrine: no IO without timeout).
+- fetch_status(): a READ-ONLY tools/call used by /status and /runway.
+- dispatch_issue(): relays an issue URL into the agent-loop intake lane.
+
+MiniRedis (kill-switch persistence)
+- A minimal RESP-protocol client supporting exactly SET (with EX ttl),
+  GET and DEL — enough for the persistent emergency kill-switch contract
+  without any third-party dependency.
+- Fail-closed: without REDIS_URL configured the kill-switch refuses to arm
+  (KillSwitchUnavailable) instead of pretending to persist.
+"""
+
+from __future__ import annotations
+
+import json
+import socket
+import urllib.error
+import urllib.request
+from typing import Any, Dict, List, Optional, Tuple
+from urllib.parse import urlparse
+
+MCP_PROTOCOL_VERSION = "2025-06-18"
+
+
+class DispatcherError(Exception):
+    """Raised when the Control Tower call fails or returns malformed data."""
+
+
+class TowerDispatcher:
+    def __init__(self, base_url: str, timeout_s: float = 30.0) -> None:
+        if not base_url or not base_url.startswith("https://"):
+            raise DispatcherError("tower base_url must be an https URL")
+        self.base_url = base_url.rstrip("/")
+        self.timeout_s = timeout_s
+
+    def _rpc(self, method: str, params: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
+        payload: Dict[str, Any] = {"jsonrpc": "2.0", "id": 1, "method": method}
+        if params is not None:
+            payload["params"] = params
+        req = urllib.request.Request(
+            self.base_url,
+            data=json.dumps(payload).encode("utf-8"),
+            headers={
+                "Content-Type": "application/json",
+                "Accept": "application/json, text/event-stream",
+                "MCP-Protocol-Version": MCP_PROTOCOL_VERSION,
+            },
+            method="POST",
+        )
+        try:
+            with urllib.request.urlopen(req, timeout=self.timeout_s) as resp:
+                body = resp.read().decode("utf-8")
+                if resp.status != 200:
+                    raise DispatcherError("tower HTTP %d" % resp.status)
+        except urllib.error.HTTPError as exc:
+            raise DispatcherError("tower HTTP %d" % exc.code) from exc
+        except urllib.error.URLError as exc:
+            raise DispatcherError("tower unreachable: %s" % exc.reason) from exc
+        try:
+            data = json.loads(body)
+        except ValueError as exc:
+            raise DispatcherError("tower returned malformed JSON") from exc
+        if data.get("error"):
+            raise DispatcherError("tower RPC error: %s" % data["error"])
+        return data.get("result", {})
+
+    def call_tool(self, name: str, arguments: Optional[Dict[str, Any]] = None) -> str:
+        result = self._rpc(
+            "tools/call", {"name": name, "arguments": arguments or {}}
+        )
+        chunks = [
+            c.get("text", "")
+            for c in result.get("content", [])
+            if isinstance(c, dict) and c.get("type") == "text"
+        ]
+        return "".join(chunks)
+
+    def fetch_status(self) -> str:
+        """Read-only runway snapshot: tower liveness + queued work orders."""
+        tools = self._rpc("tools/list")
+        names = sorted(t.get("name", "") for t in tools.get("tools", []))
+        try:
+            queue = self.call_tool(
+                "bridge_list_work_orders", {"label": "bridge:queued"}
+            )
+        except DispatcherError as exc:
+            queue = "(queue unavailable: %s)" % exc
+        lines = [
+            "🏰 Control Tower: reachable",
+            "🧰 tools: %d (%s)" % (len(names), ", ".join(names[:6]) + ("…" if len(names) > 6 else "")),
+            "🌉 queued work orders: %s" % (queue or "?"),
+        ]
+        return "\n".join(lines)
+
+    def dispatch_issue(self, issue_url: str) -> str:
+        """Relay a GitHub issue URL into the agent-loop intake lane."""
+        if not issue_url.startswith("https://github.com/") or "/issues/" not in issue_url:
+            raise DispatcherError("issue_url must be a github.com issue URL")
+        out = self.call_tool(
+            "bridge_dispatch_issue", {"issueUrl": issue_url}
+        )
+        return "🛰️ dispatch relayed: %s" % (out or issue_url)
+
+
+# ---------------------------------------------------------------------------
+# Minimal RESP (Redis) client — kill-switch persistence
+# ---------------------------------------------------------------------------
+
+CRLF = b"\r\n"
+
+
+def encode_resp(*args: bytes) -> bytes:
+    out = bytearray(b"*%d%s" % (len(args), CRLF))
+    for a in args:
+        out += b"$%d%s%s%s" % (len(a), CRLF, a, CRLF)
+    return bytes(out)
+
+
+def parse_resp_line(line: bytes) -> str:
+    return line.decode("utf-8", errors="replace").strip()
+
+
+class KillSwitchUnavailable(Exception):
+    """Raised when no REDIS_URL is configured (feature explicitly off)."""
+
+
+class MiniRedis:
+    """Tiny RESP client: SET key val EX ttl / GET / DEL only."""
+
+    def __init__(self, url: Optional[str], timeout_s: float = 5.0) -> None:
+        if not url:
+            raise KillSwitchUnavailable("REDIS_URL is not configured")
+        parsed = urlparse(url)
+        if parsed.scheme not in ("redis", "rediss") or not parsed.hostname:
+            raise KillSwitchUnavailable("REDIS_URL must be a redis:// URL")
+        self.host = parsed.hostname
+        self.port = parsed.port or 6379
+        self.timeout_s = timeout_s
+
+    def _command(self, *args: bytes) -> str:
+        with socket.create_connection((self.host, self.port), timeout=self.timeout_s) as sock:
+            sock.sendall(encode_resp(*args))
+            sock.settimeout(self.timeout_s)
+            data = sock.recv(4096)
+        if not data:
+            raise DispatcherError("empty response from redis")
+        return parse_resp_line(data.split(CRLF)[0])
+
+    def set_ex(self, key: str, value: str, ttl_s: int) -> str:
+        return self._command(b"SET", key.encode("utf-8"), value.encode("utf-8"),
+                             b"EX", str(int(ttl_s)).encode("utf-8"))
+
+    def get(self, key: str) -> Optional[str]:
+        raw = self._command(b"GET", key.encode("utf-8"))
+        if raw.startswith("$-1") or raw in ("(nil)", ""):
+            return None
+        return raw[1:] if raw.startswith("$") else raw
+
+    def delete(self, key: str) -> str:
+        return self._command(b"DEL", key.encode("utf-8"))
+
+
+KILL_SWITCH_KEY = "supremeai:command:kill_switch"
+
+
+class KillSwitch:
+    """Persistent emergency kill-switch backed by MiniRedis."""
+
+    def __init__(self, redis: Optional[MiniRedis], ttl_s: int = 86400) -> None:
+        if redis is None:
+            raise KillSwitchUnavailable(
+                "kill-switch requires REDIS_URL; refusing to fake persistence"
+            )
+        self.redis = redis
+        self.ttl_s = ttl_s
+
+    def arm(self, reason: str = "superadmin /stop") -> str:
+        reply = self.redis.set_ex(KILL_SWITCH_KEY, reason, self.ttl_s)
+        return "🛑 kill-switch ARMED (persistent %ss, redis: %s)" % (self.ttl_s, reply)
+
+    def armed(self) -> bool:
+        return self.redis.get(KILL_SWITCH_KEY) is not None
+
+    def clear(self) -> str:
+        self.redis.delete(KILL_SWITCH_KEY)
+        return "✅ kill-switch cleared"
diff --git a/command/telegram_bot.py b/command/telegram_bot.py
new file mode 100644
index 00000000..8bfeafef
--- /dev/null
+++ b/command/telegram_bot.py
@@ -0,0 +1,167 @@
+"""src/telegram_bot.py — async Telegram command handler with strict RBAC.
+
+Design notes (honesty + portability):
+- The COMMAND LAYER (RBAC, routing, payload shaping) is pure logic over
+  Telegram update dicts and is fully unit-testable offline.
+- The TRANSPORT layer (long-polling + send_message) is a thin stdlib adapter
+  used at runtime; tests inject fakes and never touch the network.
+- Every outbound HTTP call carries an explicit timeout (cross-platform guard
+  doctrine: no subprocess/IO call without a timeout).
+- RBAC is fail-closed: an update whose chat id is not the configured
+  superadmin receives a denial and triggers nothing.
+"""
+
+from __future__ import annotations
+
+import json
+import time
+import urllib.error
+import urllib.request
+from typing import Any, Callable, Dict, List, Optional
+
+from .config import CommandConfig
+
+HELP_TEXT = (
+    "SupremeAI Omnichannel Admin Control\n"
+    "Commands:\n"
+    "  /status              - Control Tower runway + active agent claims\n"
+    "  /runway              - runway summary (alias of /status)\n"
+    "  /dispatch <issue-url> - dispatch an agent loop intake for an issue\n"
+    "  /stop                - arm the persistent emergency kill-switch\n"
+    "  /help                - this text"
+)
+
+DENY_TEXT = "⛔ Unauthorized: this control channel accepts the Superadmin chat only."
+
+ISSUE_URL_PREFIX = "https://github.com/"
+VALID_COMMANDS = ("/status", "/runway", "/dispatch", "/stop", "/help", "/start")
+
+
+class TelegramUpdate:
+    """Minimal projection of a Telegram message update."""
+
+    def __init__(self, chat_id: str, text: str) -> None:
+        self.chat_id = str(chat_id or "").strip()
+        self.text = (text or "").strip()
+
+    @classmethod
+    def from_payload(cls, payload: Dict[str, Any]) -> "TelegramUpdate":
+        message = (payload or {}).get("message") or {}
+        chat = message.get("chat") or {}
+        return cls(chat_id=str(chat.get("id", "")), text=str(message.get("text", "")))
+
+
+class BotReply:
+    def __init__(self, text: str, allowed: bool = True, action: str = "reply") -> None:
+        self.text = text
+        self.allowed = allowed
+        self.action = action
+
+
+def _validate_issue_url(url: str) -> Optional[str]:
+    url = (url or "").strip()
+    if not url.startswith(ISSUE_URL_PREFIX) or "/issues/" not in url:
+        return None
+    tail = url.rsplit("/issues/", 1)[1]
+    number = tail.split("?")[0].split("#")[0].strip("/")
+    if not number.isdigit():
+        return None
+    return url
+
+
+class CommandRouter:
+    """Pure RBAC + routing layer. Dependencies are injected callables so every
+    branch is testable offline."""
+
+    def __init__(
+        self,
+        config: CommandConfig,
+        fetch_status: Callable[[], str],
+        dispatch_issue: Callable[[str], str],
+        arm_kill_switch: Callable[[], str],
+    ) -> None:
+        self.config = config
+        self._fetch_status = fetch_status
+        self._dispatch_issue = dispatch_issue
+        self._arm_kill_switch = arm_kill_switch
+
+    def route(self, update: TelegramUpdate) -> BotReply:
+        if not self.config.is_superadmin(update.chat_id):
+            return BotReply(DENY_TEXT, allowed=False, action="deny")
+        text = update.text.strip()
+        if not text.startswith("/"):
+            return BotReply(HELP_TEXT)
+        parts = text.split(maxsplit=1)
+        command = parts[0].lower()
+        argument = parts[1].strip() if len(parts) > 1 else ""
+        if command in ("/status", "/runway"):
+            return BotReply(self._fetch_status())
+        if command == "/dispatch":
+            issue_url = _validate_issue_url(argument)
+            if issue_url is None:
+                return BotReply(
+                    "⚠️ /dispatch requires a GitHub issue URL, e.g.\n"
+                    "/dispatch https://github.com/Supremeai-bd/supremeai-open/issues/505"
+                )
+            return BotReply(self._dispatch_issue(issue_url), action="dispatch")
+        if command == "/stop":
+            return BotReply(self._arm_kill_switch(), action="kill_switch")
+        if command in ("/help", "/start"):
+            return BotReply(HELP_TEXT)
+        return BotReply(HELP_TEXT)
+
+
+class StdlibTelegramTransport:
+    """Runtime transport: sendMessage + getUpdates long-polling (stdlib only)."""
+
+    def __init__(self, config: CommandConfig) -> None:
+        self.config = config
+
+    def send_message(self, chat_id: str, text: str) -> None:
+        payload = json.dumps(
+            {"chat_id": chat_id, "text": text}
+        ).encode("utf-8")
+        req = urllib.request.Request(
+            self.config.telegram_api_base + "/sendMessage",
+            data=payload,
+            headers={"Content-Type": "application/json"},
+            method="POST",
+        )
+        with urllib.request.urlopen(req, timeout=self.config.request_timeout_s) as resp:
+            if resp.status != 200:
+                raise RuntimeError("telegram sendMessage HTTP %d" % resp.status)
+
+    def poll_updates(self, router: CommandRouter, timeout_s: int = 25) -> None:  # pragma: no cover - runtime loop
+        offset = 0
+        url = self.config.telegram_api_base + "/getUpdates?timeout=%d" % max(1, timeout_s)
+        while True:
+            req = urllib.request.Request(
+                url + ("&offset=%d" % offset if offset else ""),
+                method="GET",
+            )
+            try:
+                with urllib.request.urlopen(
+                    req, timeout=timeout_s + self.config.request_timeout_s
+                ) as resp:
+                    data = json.loads(resp.read().decode("utf-8"))
+            except urllib.error.URLError:
+                time.sleep(3)
+                continue
+            for item in data.get("result", []):
+                offset = max(offset, int(item.get("update_id", 0)) + 1)
+                reply = router.route(TelegramUpdate.from_payload(item))
+                message = (item.get("message") or {}).get("chat", {}).get("id")
+                if message and reply.allowed:
+                    self.send_message(str(message), reply.text)
+                    if reply.action == "kill_switch":
+                        break  # emergency stop also ends the poll loop
+
+
+def default_router(config: CommandConfig, dispatcher: Any, kill_switch: Any) -> CommandRouter:
+    """Wire the router to the real dispatcher + kill-switch implementations."""
+    return CommandRouter(
+        config=config,
+        fetch_status=lambda: dispatcher.fetch_status(),
+        dispatch_issue=lambda issue_url: dispatcher.dispatch_issue(issue_url),
+        arm_kill_switch=lambda: kill_switch.arm(),
+    )
