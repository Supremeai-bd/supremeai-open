@@ -0,0 +1,68 @@
+# 🛡️ Open Guards (#63) — shift-left validation on FREE public runtime.
+# বাংলা: প্রাইভেট repo-র Actions minute হলো সীমিত সম্পদ (Free org = 2,000 min/month)।
+# branch-naming ও issue-reference ভালাইখোরা প্রাইভেট CI-তে গিয়ে ব্যর্থ হওয়ার আগেই
+# এই সস্তা public guard ধরে ফেলে — invalid contribution বাউন্ডারিতেই থামে।
+# Zero-checkout (event-context-only) → প্রতি রান ~৫ সেকেন্ড, public repo-র
+# Actions minute ফ্রি ও আনলিমিটেড।
+name: 🛡️ Open Guards (branch naming + issue reference)
+
+on:
+  pull_request:
+    types: [opened, edited, reopened, synchronize, ready_for_review]
+
+permissions:
+  contents: read
+  pull-requests: read
+
+concurrency:
+  group: open-guards-${{ github.event.pull_request.number }}
+  cancel-in-progress: true
+
+jobs:
+  branch-naming-guard:
+    name: "🌿 Branch Naming Guard"
+    runs-on: ubuntu-latest
+    timeout-minutes: 3
+    steps:
+      - name: Validate head branch name (event-context only, no checkout)
+        env:
+          HEAD_REF: ${{ github.event.pull_request.head.ref }}
+          HEAD_REPO: ${{ github.event.pull_request.head.repo.full_name }}
+        run: |
+          echo "head branch: '$HEAD_REF' (from $HEAD_REPO)"
+          # বট-জেনারেটেড ব্রাঞ্চ সবসময় অনুমোদিত (নিজেদের automation ভাঙবে না)
+          if [[ "$HEAD_REF" =~ ^(dependabot|github-actions|copilot|all-contributors|gh-readonly)/ ]] \
+             || [[ "$HEAD_REF" =~ ^(dependabot|github-actions|copilot)\[?[a-z_]* ]]; then
+            echo "✅ Automated/bot branch — allowed."; exit 0
+          fi
+          # কনস্টিটিউশনাল কনভেনশন: <type>/<slug> — #63 + AGENTS.md lane discipline
+          if [[ "$HEAD_REF" =~ ^(feat|fix|docs|chore|test|refactor|perf|bridge|group|contributor|hotfix|release|agent)/.+ ]]; then
+            echo "✅ Branch naming OK ('$HEAD_REF')."; exit 0
+          fi
+          echo "::error::Branch '$HEAD_REF' violates the naming convention."
+          echo "Allowed prefixes: feat/ fix/ docs/ chore/ test/ refactor/ perf/ bridge/ group/ contributor/ hotfix/ release/ agent/"
+          echo "(bot branches dependabot|github-actions|copilot/* are auto-allowed; admin escape hatch: 'guard-exempt' label)"
+          exit 1
+
+  issue-reference-guard:
+    name: "🔗 Issue Reference Guard"
+    runs-on: ubuntu-latest
+    timeout-minutes: 3
+    steps:
+      - name: Validate PR references an issue (event-context only, no checkout)
+        env:
+          PR_TITLE: ${{ github.event.pull_request.title }}
+          PR_BODY: ${{ github.event.pull_request.body }}
+          PR_LABELS: ${{ join(github.event.pull_request.labels.*.name, ' ') }}
+        run: |
+          # অ্যাডমিন escape hatch — বিরল no-issue পরিবর্তনের জন্য
+          if [[ "$PR_LABELS" == *"guard-exempt"* ]]; then
+            echo "✅ 'guard-exempt' label present — guard skipped."; exit 0
+          fi
+          if echo "$PR_TITLE $PR_BODY" | grep -qE '#[0-9]+'; then
+            echo "✅ Issue reference found in title/body."; exit 0
+          fi
+          echo "::error::PR must reference an issue number (e.g. 'Refs #63') in title or body."
+          echo "The Task Envelope's submission.issue_reference_required=true documents this contract (#63)."
+          echo "(Admin escape hatch: add the 'guard-exempt' label.)"
+          exit 1
