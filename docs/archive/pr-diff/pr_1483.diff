+      <section className="rounded-2xl bg-white/10 p-4 ring-1 ring-white/10">
+        <p className="mb-3 flex items-center gap-1.5 text-[11px] uppercase tracking-wider text-white/60">
+          <Sun size={12} /> Wallpaper theme
