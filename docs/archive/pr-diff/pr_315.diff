diff --git a/api-schemas/memory-search.schema.json b/api-schemas/memory-search.schema.json
new file mode 100644
index 00000000..434cd740
--- /dev/null
+++ b/api-schemas/memory-search.schema.json
@@ -0,0 +1,297 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://supremeai.ai/schemas/memory-search.schema.json",
+  "title": "SupremeAI Semantic Memory Retrieval Sidecar Contracts",
+  "description": "Layer-1 interface contracts for the semantic memory retrieval sidecar: vector memory search queries (query text, top_k, score threshold, namespace filter) and their responses (score, document id, payload, metadata). One contract document pairs the request with its response. Backend-neutral normal form (SearchHit) plus explicit adapter envelopes for Qdrant (points + similarity score) and ChromaDB (ids/documents/metadatas + distances) vector formats, so sidecar clients speak one contract regardless of the backing store. Fail-closed: unknown backends are rejected by the enum, adapter bodies are discriminator-pinned to the backend tag, similarity scores are bounded [0,1], and recorded instants carry an explicit RFC 3339 pattern (format is annotation-only in Draft 2020-12). See issue #36.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["schema_version", "request", "response"],
+  "properties": {
+    "schema_version": {
+      "type": "string",
+      "pattern": "^\\d+\\.\\d+$",
+      "description": "Semantic version of this contract document."
+    },
+    "request": {
+      "$ref": "#/$defs/MemorySearchRequest"
+    },
+    "response": {
+      "$ref": "#/$defs/MemorySearchResponse"
+    }
+  },
+  "$defs": {
+    "MemorySearchRequest": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "One semantic search request against the memory sidecar.",
+      "required": ["namespace", "backend", "query", "top_k", "embedding"],
+      "properties": {
+        "namespace": {
+          "type": "string",
+          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
+          "description": "Namespace filter scoping the search to one memory partition (e.g. agent-episodes, repo-docs)."
+        },
+        "backend": {
+          "enum": ["qdrant", "chromadb"],
+          "description": "Backing vector store; the adapter body keys off this tag. Unknown backends are structurally impossible (fail-closed)."
+        },
+        "query": {
+          "type": "string",
+          "minLength": 1,
+          "maxLength": 8192,
+          "description": "Natural-language search query text."
+        },
+        "top_k": {
+          "type": "integer",
+          "minimum": 1,
+          "maximum": 256,
+          "description": "Maximum number of hits to return."
+        },
+        "score_threshold": {
+          "type": "number",
+          "minimum": 0,
+          "maximum": 1,
+          "description": "Optional similarity floor; hits below it are dropped (fail-closed retrieval)."
+        },
+        "embedding": {
+          "$ref": "#/$defs/EmbeddingVector"
+        },
+        "with_payload": {
+          "type": "boolean",
+          "description": "Include stored payloads in hits."
+        },
+        "with_vectors": {
+          "type": "boolean",
+          "description": "Include raw vectors in hits; expensive — off by default."
+        }
+      }
+    },
+    "MemorySearchResponse": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "Backend-neutral normal form returned by the sidecar; raw backend body preserved alongside for debugging.",
+      "required": ["namespace", "backend", "model", "hits"],
+      "properties": {
+        "namespace": {
+          "type": "string",
+          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
+          "description": "Echo of the queried namespace."
+        },
+        "backend": {
+          "enum": ["qdrant", "chromadb"],
+          "description": "Echo of the queried backend — discriminator for adapter_body."
+        },
+        "model": {
+          "type": "string",
+          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,99}$",
+          "description": "Embedding model identity that produced the vectors (e.g. text-embedding-3-small)."
+        },
+        "hits": {
+          "type": "array",
+          "minItems": 1,
+          "maxItems": 256,
+          "uniqueItems": true,
+          "items": {
+            "$ref": "#/$defs/SearchHit"
+          },
+          "description": "Hits in descending similarity score order (ordering verified semantically per response)."
+        },
+        "adapter_body": {
+          "$ref": "#/$defs/AdapterBody"
+        }
+      },
+      "allOf": [
+        {
+          "description": "Qdrant responses carry a Qdrant-shaped adapter body.",
+          "if": {
+            "type": "object",
+            "required": ["backend"],
+            "properties": { "backend": { "const": "qdrant" } }
+          },
+          "then": {
+            "type": "object",
+            "properties": {
+              "adapter_body": {
+                "anyOf": [
+                  { "not": {} },
+                  { "$ref": "#/$defs/QdrantAdapterBody" }
+                ]
+              }
+            }
+          }
+        },
+        {
+          "description": "ChromaDB responses carry a ChromaDB-shaped adapter body.",
+          "if": {
+            "type": "object",
+            "required": ["backend"],
+            "properties": { "backend": { "const": "chromadb" } }
+          },
+          "then": {
+            "type": "object",
+            "properties": {
+              "adapter_body": {
+                "anyOf": [
+                  { "not": {} },
+                  { "$ref": "#/$defs/ChromaAdapterBody" }
+                ]
+              }
+            }
+          }
+        }
+      ]
+    },
+    "EmbeddingVector": {
+      "type": "array",
+      "minItems": 8,
+      "maxItems": 10000,
+      "items": {
+        "type": "number"
+      },
+      "description": "Embedding vector; dimensions must match the collection's model (dimension consistency is verified semantically per request/response pair)."
+    },
+    "SearchHit": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "One retrieved memory item in normal form.",
+      "required": ["document_id", "score", "payload"],
+      "properties": {
+        "document_id": {
+          "type": "string",
+          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
+          "description": "Stable id of the stored document/point."
+        },
+        "score": {
+          "type": "number",
+          "minimum": 0,
+          "maximum": 1,
+          "description": "Normalized similarity score in [0,1]; higher is more similar."
+        },
+        "payload": {
+          "type": "object",
+          "description": "Stored document payload (free-form JSON sidecar data)."
+        },
+        "metadata": {
+          "type": "object",
+          "description": "Sidecar-added metadata (source, timestamps, tags)."
+        },
+        "vector": {
+          "$ref": "#/$defs/EmbeddingVector"
+        },
+        "episode": {
+          "$ref": "#/$defs/EpisodeRef"
+        }
+      }
+    },
+    "EpisodeRef": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "Optional pointer binding the hit to a stored agent episode (episodic memory retrieval).",
+      "required": ["episode_id", "turn"],
+      "properties": {
+        "episode_id": {
+          "type": "string",
+          "pattern": "^ep-[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
+          "description": "Episode identifier (ep- prefix)."
+        },
+        "turn": {
+          "type": "integer",
+          "minimum": 0,
+          "description": "Turn index within the episode."
+        },
+        "recorded_at": {
+          "type": "string",
+          "format": "date-time",
+          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?([Zz]|[+-]\\d{2}:\\d{2})$",
+          "description": "RFC 3339 UTC instant the episode turn was recorded (explicit pattern: format is annotation-only in Draft 2020-12)."
+        }
+      }
+    },
+    "AdapterBody": {
+      "type": "object",
+      "description": "Raw backend response preserved for debugging; intentionally permissive here — the strict shape is pinned by the backend discriminator arms on MemorySearchResponse (Qdrant/Chroma bodies below).",
+      "required": [],
+      "properties": {}
+    },
+    "QdrantAdapterBody": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "Qdrant search response shape: points with id/score/payload/vector.",
+      "required": ["points"],
+      "properties": {
+        "points": {
+          "type": "array",
+          "minItems": 1,
+          "items": {
+            "type": "object",
+            "additionalProperties": false,
+            "required": ["id", "score"],
+            "properties": {
+              "id": {
+                "type": "string",
+                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
+                "description": "Qdrant point id."
+              },
+              "score": {
+                "type": "number",
+                "minimum": 0,
+                "maximum": 1,
+                "description": "Qdrant similarity score, normalized to [0,1]."
+              },
+              "payload": {
+                "type": "object",
+                "description": "Qdrant point payload."
+              },
+              "vector": {
+                "$ref": "#/$defs/EmbeddingVector"
+              }
+            }
+          }
+        }
+      }
+    },
+    "ChromaAdapterBody": {
+      "type": "object",
+      "additionalProperties": false,
+      "description": "ChromaDB query response shape: parallel arrays ids/documents/metadatas/distances.",
+      "required": ["ids", "documents", "metadatas", "distances"],
+      "properties": {
+        "ids": {
+          "type": "array",
+          "minItems": 1,
+          "uniqueItems": true,
+          "items": {
+            "type": "string",
+            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
+          },
+          "description": "Chroma id array."
+        },
+        "documents": {
+          "type": "array",
+          "minItems": 1,
+          "items": {
+            "type": "string"
+          },
+          "description": "Chroma document array (same order as ids)."
+        },
+        "metadatas": {
+          "type": "array",
+          "minItems": 1,
+          "items": {
+            "type": "object"
+          },
+          "description": "Chroma metadata array (same order as ids)."
+        },
+        "distances": {
+          "type": "array",
+          "minItems": 1,
+          "items": {
+            "type": "number",
+            "minimum": 0
+          },
+          "description": "Chroma distance array (same order as ids); lower is closer — sidecar normalizes to score = 1/(1+distance)."
+        }
+      }
+    }
+  }
+}
