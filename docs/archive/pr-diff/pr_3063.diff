+"""Evidence-plane visibility guard: docs/reports/ must never be gitignore-shadowed.
+
+Born-red guard for the #3047 item-19 root cause. The repo's runtime
+health-report ignore rule was a bare ``reports/`` pattern, which matches a
+directory named ``reports`` at ANY depth and therefore shadowed the tracked
+evidence plane ``docs/reports/``: plain ``git add`` refused new files there
+and ignore-respecting traversals (rg / scan tooling) saw none of the tree.
+
+The rule is now root-anchored (``/reports/``). These two probes pin both
+halves of that contract:
+
+1. a new untracked file under ``docs/reports/`` must NOT be ignored;
+2. runtime health-report outputs at the repo-root ``reports/`` directory
+   must STAY ignored.
+
+Both probes use ``git check-ignore`` on throwaway untracked files so the
+test is independent of any particular receipt file's lifetime. If a future
+change re-introduces a shadowing pattern, test (1) born-reds; if the rule
+is dropped entirely, test (2) born-reds.
+"""
+
+import pathlib
+import subprocess
+
+REPO = pathlib.Path(__file__).resolve().parents[1]
+PROBE_NAME = "__evidence_plane_visibility_probe__.tmp"
+
+
+def _check_ignore(relpath: str) -> "tuple[int, str]":
+    """Run `git check-ignore -v <relpath>`; return (exit_code, stdout)."""
+    r = subprocess.run(
+        ["git", "check-ignore", "-v", relpath],
+        cwd=str(REPO),
+        capture_output=True,
+        text=True,
+        timeout=30,
+    )
+    return r.returncode, (r.stdout or "").strip()
+
+
+def test_new_file_under_docs_reports_is_not_ignored():
+    probe_dir = REPO / "docs" / "reports"
+    probe = probe_dir / PROBE_NAME
+    assert probe_dir.is_dir(), "docs/reports/ evidence plane must exist"
+    probe.write_text("visibility probe\n", encoding="utf-8")
+    try:
+        code, out = _check_ignore(f"docs/reports/{PROBE_NAME}")
+        assert code != 0, (
+            "evidence plane re-shadowed: a file under docs/reports/ is "
+            f"gitignored ({out!r}) — the #3047 item-19 contract is broken"
+        )
+    finally:
+        probe.unlink(missing_ok=True)
+
+
+def test_root_reports_runtime_outputs_stay_ignored():
+    probe_dir = REPO / "reports"
+    probe = probe_dir / PROBE_NAME
+    created_dir = not probe_dir.exists()
+    probe_dir.mkdir(parents=True, exist_ok=True)
+    probe.write_text("runtime output probe\n", encoding="utf-8")
+    try:
+        code, out = _check_ignore(f"reports/{PROBE_NAME}")
+        assert code == 0, (
+            "root runtime health-report outputs are no longer ignored "
+            f"(exit={code}) — restore the root-anchored /reports/ rule"
+        )
+        assert "/reports/" in out, f"expected the root-anchored rule to match, got {out!r}"
+    finally:
+        probe.unlink(missing_ok=True)
+        if created_dir:
+            try:
+                probe_dir.rmdir()
+            except OSError:
+                pass
