+    onend: (() => void) | null = null;
+    static instances: FakeRecognition[] = [];
+    constructor() {
+      FakeRecognition.instances.push(this);
+    }
+    start() {
+      this.started = true;
+    }
+    stop() {
+      this.stopped = true;
+    }
+    abort() {
+      this.aborted = true;
