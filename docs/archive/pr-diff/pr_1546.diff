+      return {
+        results: {
+          0: { 0: { transcript: text }, isFinal: true },
+          length: 1,
+        },
+      };
+    }
+    static interimEvent(text: string) {
+      return {
+        results: {
+          0: { 0: { transcript: text }, isFinal: false },
+          length: 1,
+        },
+      };
+    }
+  }
+
+  afterEach(() => {
