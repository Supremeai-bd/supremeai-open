{
  "mcpServers": {
    "github-reader": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "<GITHUB_READONLY_TOKEN_FROM_INFISICAL>"
      }
    },
    "supremeai-control-tower": {
      "url": "https://<YOUR-MCP-HOST>/mcp",
      "headers": {
        "Authorization": "Bearer <TOKEN_FROM_ADMIN_DASHBOARD>"
      }
    }
  },
  "connection": {
    "protocol": "streamable-http",
    "authentication": "bearer-token",
    "defaultRole": "viewer",
    "note": "github-reader is read-only (GITHUB_READONLY_TOKEN). Tower uses admin-issued bearer token. Replace placeholders and keep this file out of source control."
  }
}
