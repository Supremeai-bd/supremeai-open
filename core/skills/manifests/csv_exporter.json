{
  "id": "csv_exporter",
  "name": "CSV Exporter",
  "version": "1.0.0",
  "description": "Export a list of dictionaries to a CSV file.",
  "capabilities": ["export", "csv", "data"],
  "tags": ["csv", "export", "data", "table"],
  "triggers": ["export", "csv", "table"],
  "dependencies": ["pandas"],
  "system_packages": [],
  "entrypoint": "skills.dynamic.csv_exporter:run",
  "owner": "Skill_System",
  "allowed_roles": ["Standard_User", "Manager", "Admin"],
  "human_approval_points": {
    "on_ingestion": false,
    "on_execution": false
  },
  "budget": {
    "max_cost_per_invocation_usd": 0.01,
    "max_latency_seconds": 5.0
  },
  "audit_logging": ["filepath", "rows_exported", "execution_time_ms"]
}
