{
  "id": "core_doc_summarizer",
  "name": "Core Doc Summarizer",
  "version": "1.0.0",
  "description": "Summarize core documentation and long-form technical text into concise bullets.",
  "capabilities": ["summarize", "documentation", "core_docs"],
  "tags": ["docs", "summary", "summarize", "core"],
  "triggers": ["summarize", "docs", "documentation"],
  "dependencies": [],
  "system_packages": [],
  "entrypoint": "core_doc_summarizer.py",
  "owner": "Operations_Security_Team",
  "allowed_roles": ["Standard_User", "Manager", "Admin"],
  "allowed_data": {
    "Admin": ["*"],
    "Manager": ["shared_documents", "team_reports"],
    "Standard_User": ["temporary_uploads"]
  },
  "tools_allowed": ["docker_sandbox_parser"],
  "human_approval_points": {
    "on_ingestion": true,
    "on_execution": false
  },
  "budget": {
    "max_cost_per_invocation_usd": 0.03,
    "max_latency_seconds": 8.0
  },
  "audit_logging": ["user_id", "file_hash", "file_size_bytes", "execution_time_ms"]
}
