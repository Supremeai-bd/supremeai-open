# STATUS NOTE (audit F-9): currently ORPHANED — no compose file, workflow or doc
# references this Dockerfile. Verify intent before use; see production audit F-9.
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir fastapi==0.115.6 "uvicorn[standard]==0.34.0" pydantic==2.10.4 httpx==0.28.1 sse-starlette==2.1.3
COPY . /app/ecosystem/
WORKDIR /app/ecosystem
ENV PYTHONPATH=/app
EXPOSE 8000
# Create and switch to non-root user for security compliance (Trap #97)
RUN addgroup --system appuser && adduser --system appuser --ingroup appuser && \
    chown -R appuser:appuser /app
USER appuser

CMD ["python", "-c", "import sys; sys.path.insert(0, '/app'); from ecosystem.standalone_app import app; import uvicorn; uvicorn.run(app, host='0.0.0.0', port=int(__import__('os').getenv('PORT', '8000')))"]
