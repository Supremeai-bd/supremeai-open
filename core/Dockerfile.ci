# STATUS NOTE (audit F-9): currently ORPHANED — no compose file, workflow or doc
# references this Dockerfile. Verify intent before use; see production audit F-9.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libpq-dev build-essential git && rm -rf /var/lib/apt/lists/*

# ১. আগে Torch ইন্সটল করুন (এটি সেটআপটুলস ৮৩ টানবে)
RUN pip install --no-cache-dir torch==2.4.1

# ২. তারপর আমাদের প্রয়োজনীয় সেটআপটুলস ভার্সনটি এনফোর্স করুন
RUN pip install --no-cache-dir setuptools==68.0.0 wheel

# ৩. সবশেষে Whisper ইন্সটল করুন
RUN pip install --no-cache-dir openai-whisper==20240930 --no-build-isolation

RUN pip install --no-cache-dir poetry==2.4.1
RUN poetry config virtualenvs.create false
WORKDIR /app
# বাংলা মন্তব্য (#19 fix): আগে শুধু UID 1001 ব্যবহার হতো, কোনো passwd entry
# ছাড়াই -- কিছু লাইব্রেরি/টুল (getpwuid ইত্যাদি) একটা নামযুক্ত user আশা করে ও
# fail করতে পারে। এখন প্রকৃত non-root user/group তৈরি করা হলো।
RUN groupadd --gid 1001 appuser && \
    useradd --uid 1001 --gid appuser --shell /bin/bash --create-home appuser && \
    chown -R appuser:appuser /app
USER appuser
