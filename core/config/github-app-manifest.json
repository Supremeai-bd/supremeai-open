{
  "name": "supremeai-paykaribazaronline",
  "url": "https://github.com/paykaribazaronline/supremeai",
  "redirect_url": "https://github.com/paykaribazaronline/supremeai",
  "hook_attributes": {
    "url": "https://supremeai-mcp-tower.onrender.com/webhooks/github",
    "active": false
  },
  "public": false,
  "default_permissions": {
    "actions": "write",
    "administration": "read",
    "checks": "write",
    "contents": "write",
    "deployments": "write",
    "discussions": "write",
    "issues": "write",
    "metadata": "read",
    "pull_requests": "write",
    "repository_hooks": "write",
    "repository_projects": "write",
    "statuses": "write",
    "workflows": "write"
  },
  "default_events": [
    "check_run",
    "check_suite",
    "commit_comment",
    "discussion",
    "discussion_comment",
    "issue_comment",
    "issues",
    "pull_request",
    "pull_request_review",
    "pull_request_review_comment",
    "pull_request_review_thread",
    "push",
    "release",
    "repository",
    "status",
    "workflow_dispatch",
    "workflow_job",
    "workflow_run"
  ]
