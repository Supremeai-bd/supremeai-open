# Coverage configuration for SupremeAI Backend
# বাংলা মন্তব্য: আগে শুধু core/ এর coverage মাপা হতো, ফলে api/, tools/, ws/, workers/
# প্যাকেজগুলোর আসল লাইন-কভারেজ কখনো গণনা হতো না (ব্লাইন্ড স্পট)। এখন সব প্রডাকশন
# প্যাকেজ একসাথে মাপা হয় যাতে রিপোর্ট সত্যিকারের কভারেজ দেখায়। CI command এবং
# pyproject.toml উভয়ের সাথে consistent।

[run]
# memory added 2026-09-15 (PR-CI measurement integrity): backend/memory/ was
# a measurement blind spot — CI's --cov list never included it. This local
# source list mirrors the CI contract (see ci.yml pytest --cov comment).
source = core
       api
       tools
       ws
       workers
       memory
branch = True
omit =
    */site-packages/*
    */distutils/*
    */tests/*
    */__pycache__/*
    */migrations/*
    */alembic/*
    */__init__.py
    tools/cli.py
    core/worker_main.py
    # in-package test file — never CI-collected (uses the repo-root `backend.`
    # import prefix); a functional CI-collected twin lives at
    # tests/memory/test_memory_pkg_integrity.py. Measuring a test FILE as
    # production coverage is noise, not honesty.
    memory/test_hierarchical_tree.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abstractproperty

omit =
    core/constants.py
    core/telemetry.py
    core/base.py
    core/logging_config.py
    core/logging.py
    core/exceptions.py
    core/playwright_manager.py
    api/__init__.py
    api/v1/__init__.py
    api/routes/__init__.py
    tools/__init__.py
    ws/__init__.py
    workers/__init__.py

[html]
directory = htmlcov

[json]
output = coverage.json
