#!/bin/bash
# SyncGuard Pre-Push Hook
# This script runs the SyncGuard Agent audit before pushing code.
# If the audit fails, the push is aborted.

# বাংলা মন্তব্য (ROOT-CAUSE FIX): `main` branch-এ কোনো GitHub branch-protection
# ছিল না, তাই যেকোনো লোকাল সেশন (autonomous agent সহ) `git push --force` করে
# আগের কমিট মুছে ফেলতে পারত -- যেমনটা 2026-08-28-এ ঘটেছিল (cf1d07a কমিট
# ac0b1bd-এর উপর force-push হয়ে 8eab72e-এর ফিক্স হারিয়ে ফেলেছিল)। GitHub-এ
# branch protection সেট করার জন্য admin/Administration permission দরকার, যা
# বর্তমান টোকেনে নেই -- তাই এই লোকাল গার্ডটা defense-in-depth হিসেবে যোগ করা
# হলো: main/master-এ force-push করার চেষ্টা হলে এখানেই আটকে দেওয়া হয়।
protected_branches="main master"
current_branch=$(git rev-parse --abbrev-ref HEAD)

# বাংলা: stdin-এর ref-পেয়ারগুলো সংগ্রহ করে রাখা হচ্ছে — নিচের CI-parity ম্যাট্রিক্স
# push-range বোঝার জন্য এগুলো ব্যবহার করবে (loop stdin খেয়ে ফেলে, তাই আগেই জমা)
PUSHED_REFS=""
while read -r local_ref local_sha remote_ref remote_sha; do
    PUSHED_REFS="$PUSHED_REFS$local_ref $local_sha $remote_ref $remote_sha"$'\n'
    remote_branch=$(echo "$remote_ref" | sed 's#refs/heads/##')
    for protected in $protected_branches; do
        if [ "$remote_branch" = "$protected" ]; then
            # remote_sha সবগুলো-শূন্য মানে নতুন ব্রাঞ্চ তৈরি হচ্ছে, এটা স্কিপ করা হলো
            if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
                if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
                    echo "❌ [SyncGuard] Rejected: non-fast-forward push to protected branch '$protected'."
                    echo "   এটা history rewrite/force-push detect করেছে (remote commit $remote_sha আপনার লোকাল history-তে ancestor নয়)।"
                    echo "   আগে 'git fetch origin $protected && git rebase origin/$protected' চালিয়ে conflict মিটিয়ে আবার push করুন।"
                    echo "   সত্যিই এই push force করতে চাইলে এই hook বাইপাস করতে হবে: 'git push --no-verify' (অত্যন্ত সতর্কতার সাথে, এবং শুধু আপনি নিশ্চিত হলে যে কারো কাজ হারাবে না)।"
                    exit 1
                fi
            fi
        fi
    done
done

echo "🛡️ SyncGuard Agent: Initiating Pre-Push Audit..."

# বাংলা মন্তব্য (V8 ফরেনসিক ফিক্স): আগের লাইনটি ছিল
# `python -m backend.src.agents.syncguard.syncguard_agent` — এই মডিউল পাথ
# রিপোতেই নেই (ModuleNotFoundError) → প্রতিটি push ব্লক হতো; আর সঠিক পাথেও
# syncguard_agent.py-তে `__main__` এন্ট্রি নেই → `-m` নীরবে import করে exit 0
# (fake gate!)। এছাড়া run_full_audit() Redis + GitHub network চায় — প্রতিটি
# push-এ নেটওয়ার্ক-নির্ভর গেট = ভঙ্গুর স্তর-ভুল। তাই সৎ সিদ্ধান্ত:
# SyncGuard full audit এখান থেকে বাদ (repo থেকে মুছিনি — nightly CI-তে
# যুক্ত করার ক্যান্ডিডেট হিসেবে নথিভুক্ত), নিচের CI-Parity Matrix-ই
# প্রমাণিত প্রতি-push গেট (V4–V7-এর সব লাল CI-এর কারণ এটাই ধরে)।
echo "  ℹ️ SyncGuard full audit এখানে বাদ — নেটওয়ার্ক/Redis-নির্ভর হওয়ায় nightly-CI স্তরের (V8 audit §১-খ নোট)"

# =============================================================================
# বাংলা: CI-Parity Matrix (V8) — যা CI-তে চলবে, push-এর আগে লোকালেই তা চলুক।
# V4–V7 চক্রের প্রতিটি লাল CI-এর মূল কারণগুলো (formatter drift, generated
# evidence drift, mission regression) এখানে আগেই ধরা পড়ে — CI লাল হওয়ার আগেই।
# Bypass (এক push-এর জন্য): SKIP_CI_PARITY=1 git push
# =============================================================================
if [ "${SKIP_CI_PARITY:-0}" != "1" ]; then
    echo "🧪 [CI-Parity] Running pre-push verification matrix..."

    # গেট ০ (#1821): slot-registry drift — AGENT_SLOT_REGISTRY.yaml-ই একমাত্র সত্য;
    # অন্য কোনো ফাইল (agent_registry.json, dispatch script, heartbeat doc,
    # push_as_agent) স্লট→রোল দাবি করলে বা YAML-এর সাথে অসামঞ্জস্য হলে push আটকাও।
    # লোকাল-অনলি, নেটওয়ার্কমুক্ত, ~২ সেকেন্ড — তাই প্রতি push-এ চলে।
    if command -v python3 >/dev/null 2>&1; then
        if ! python3 scripts/agents/check_slot_registry_drift.py --quiet; then
            echo "❌ [CI-Parity] slot-registry drift detected — AGENT_SLOT_REGISTRY.yaml-এর সাথে অসামঞ্জস্য (উপরের লগ দেখুন)।"
            echo "   ফিক্স: অফেন্ডিং ফাইলটি YAML অনুযায়ী ঠিক করে আবার commit + push করুন।"
            exit 1
        fi
        echo "  ✅ Gate 0: slot-registry drift clean (single source of truth)"
    fi

    # বাংলা: push-range-এ কোন ফাইল বদলেছে — backend/scripts বদলালে তবেই ভারী গেট
    CHANGED_FILES=""
    while IFS=' ' read -r lref lsha rref rsha; do
        [ -z "$lref" ] && continue
        if [ "$rsha" != "0000000000000000000000000000000000000000" ]; then
            CHANGED_FILES="$CHANGED_FILES$(git diff --name-only "$rsha..$lsha" 2>/dev/null)"$'\n'
        else
            CHANGED_FILES="$CHANGED_FILES$(git diff --name-only HEAD 2>/dev/null)"$'\n'
        fi
    done <<EOF
$PUSHED_REFS
EOF

    BACKEND_CHANGED=$(echo "$CHANGED_FILES" | grep -cE "^(backend/|scripts/)" || true)

    if [ "$BACKEND_CHANGED" -gt 0 ]; then
        # গেট ১: formatter — V5-এর 121-অক্ষর লাইন-কাণ্ড ঠিক এখানেই ধরা পড়ত
        if command -v ruff >/dev/null 2>&1; then
            if ! ruff format --check backend/ >/dev/null 2>&1; then
                echo "❌ [CI-Parity] ruff format --check backend/ FAILED — CI-তে একই কারণে লাল হবে।"
                echo "   ফিক্স: cd backend && ruff format . && git add -u && git commit --amend --no-edit"
                exit 1
            fi
            echo "  ✅ Gate 1/3: ruff format (backend)"
        else
            echo "  ⚠️ [CI-Parity] ruff পাওয়া যায়নি — গেট ১ লোকালে স্কিপ (CI-তে তবু চলবে; নীরব নয়)"
        fi

        # গেট ২: generated evidence — কোড বদলালে evidence drift স্বয়ংক্রিয় আটকাওয়া (V7-পাঠ)
        if python3 scripts/ci/generate_route_inventory.py >/dev/null 2>&1 \
            && python3 scripts/ci/generate_route_graph.py >/dev/null 2>&1 \
            && python3 scripts/ci/generate_topology_mermaid.py >/dev/null 2>&1 \
            && python3 scripts/ci/generate_module_capability_matrix.py >/dev/null 2>&1 \
            && python3 scripts/ci/generate_domain_dependency_graph.py >/dev/null 2>&1; then
            if ! git diff --exit-code -- docs/generated/ >/dev/null 2>&1; then
                git add docs/generated/
                git commit -m "chore(ci-evidence): auto-regen generated evidence (pre-push parity hook)" >/dev/null
                echo "❌ [CI-Parity] generated evidence drift পাওয়া গেছে — নতুন commit তৈরি হয়েছে:"
                git log --oneline -1
                echo "   শুধু আবার push করুন: git push (drift এখন এই push-এই যাবে)।"
                exit 1
            fi
            echo "  ✅ Gate 2/3: generated evidence in sync"
        else
            echo "  ⚠️ [CI-Parity] generator চলেনি (python env সমস্যা?) — গেট ২ লোকালে স্কিপ; CI-তে তবু চলবে"
        fi
    else
        echo "  ⏭️ Gate 1-2/3: backend/scripts অপরিবর্তিত — সংশ্লিষ্ট গেট প্রযোজ্য নয় (dynamic skip, লোকাল সময় বাঁচল)"
    fi

    # গেট ৩: mission regression — শুধু protected branch push-এ (fast smooth: feature ব্রাঞ্চে বাদ)
    PUSHING_PROTECTED=0
    for p in $protected_branches; do
        echo "$PUSHED_REFS" | grep -q "refs/heads/$p" && PUSHING_PROTECTED=1
    done
    if [ "$PUSHING_PROTECTED" = "1" ] && command -v python3 >/dev/null 2>&1; then
        echo "  ▶️ Gate 3/3: mission suite (protected push) — প্রায় ২০-৩০ সেকেন্ড..."
        if (cd backend && DATABASE_URL="sqlite+aiosqlite:///./test.db" python3 -m pytest tests/missions/ -q --no-cov >/dev/null 2>&1); then
            echo "  ✅ Gate 3/3: missions PASS"
        else
            echo "❌ [CI-Parity] Mission suite FAILED — main-এ push করলে CI লাল হবে। আগে ঠিক করুন:"
            echo "   cd backend && DATABASE_URL=\"sqlite+aiosqlite:///./test.db\" python3 -m pytest tests/missions/ -q --no-cov"
            exit 1
        fi
    else
        echo "  ⏭️ Gate 3/3: protected-branch push নয় — missions স্কিপ (dynamic)"
    fi

    echo "🧪 [CI-Parity] Matrix PASSED — push এগোচ্ছে।"
fi

exit 0
