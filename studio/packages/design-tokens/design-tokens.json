{
  "version": "2.0.0",
  "name": "SupremeAI Design System",
  "description": "Unified design tokens for all SupremeAI platforms",

  "colors": {
    "background": {
      "base": "#0a0e1a",
      "elevated": "#111827",
      "overlay": "#1a2236",
      "modal": "#0f172a"
    },
    "surface": {
      "default": "#111827",
      "hover": "#1a2236",
      "active": "#1e293b",
      "disabled": "#0f172a"
    },
    "border": {
      "default": "#1f2937",
      "hover": "#374151",
      "focus": "#6366f1",
      "error": "#ef4444"
    },
    "text": {
      "primary": "#f9fafb",
      "secondary": "#e5e7eb",
      "muted": "#9ca3af",
      "disabled": "#6b7280",
      "inverse": "#111827"
    },
    "accent": {
      "primary": "#6366f1",
      "primaryLight": "#818cf8",
      "primaryDark": "#4f46e5",
      "secondary": "#a855f7",
      "tertiary": "#ec4899"
    },
    "semantic": {
      "success": "#22c55e",
      "successLight": "#86efac",
      "successBg": "rgba(34,197,94,0.1)",
      "warning": "#f59e0b",
      "warningLight": "#fcd34d",
      "warningBg": "rgba(245,158,11,0.1)",
      "danger": "#ef4444",
      "dangerLight": "#fca5a5",
      "dangerBg": "rgba(239,68,68,0.1)",
      "info": "#06b6d4",
      "infoLight": "#67e8f9",
      "infoBg": "rgba(6,182,212,0.1)"
    },
    "gradient": {
      "primary": "linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%)",
      "success": "linear-gradient(135deg, #22c55e 0%, #10b981 100%)",
      "info": "linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%)",
      "warning": "linear-gradient(135deg, #f59e0b 0%, #ef4444 100%)",
      "dark": "linear-gradient(180deg, #0a0e1a 0%, #111827 100%)"
    }
  },

  "typography": {
    "fontFamily": {
      "primary": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', 'SF Mono', monospace",
      "bangla": "'Noto Sans Bengali', 'Hind Siliguri', 'Baloo Da 2', sans-serif"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem"
    },
    "fontWeight": {
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.25,
      "normal": 1.5,
      "relaxed": 1.75
    }
  },

  "spacing": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "borderRadius": {
    "none": "0",
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "18px",
    "2xl": "24px",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0,0,0,0.3)",
    "md": "0 4px 12px rgba(0,0,0,0.4)",
    "lg": "0 8px 32px rgba(0,0,0,0.5)",
    "glow": "0 0 20px rgba(99,102,241,0.15)",
    "glowSuccess": "0 0 20px rgba(34,197,94,0.15)",
    "glowDanger": "0 0 20px rgba(239,68,68,0.15)"
  },
  "animation": {
    "duration": {
      "fast": "150ms",
      "normal": "300ms",
      "slow": "500ms"
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "bounce": "cubic-bezier(0.68, -0.55, 0.265, 1.55)",
      "smooth": "cubic-bezier(0.25, 0.1, 0.25, 1)"
    }
  },
  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },
  "zIndex": {
    "dropdown": 100,
    "modal": 200,
    "tooltip": 300,
    "toast": 400,
    "overlay": 500
  }
}
